---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import EternalChat from '../components/EternalChat.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { buildBreadcrumbs, breadcrumbSchema, schemaFromPageBreadcrumbs } from '../data/breadcrumbs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object;
  lang?: string;
  keywords?: string;
  /** 三语对页（动态路由必须显式传，见 SEOHead 注释） */
  alternates?: { en?: string; zh?: string; ru?: string };
  /** 面包屑末级自定义名（动态路由如博客文章用它显示文章标题，优于 slug 兜底） */
  breadcrumbTitle?: string;
  /**
   * 页面自带的可见面包屑（PageLayout 传入）。有它就以它为准生成 BreadcrumbList，
   * 保证 schema 与用户看到的导航逐字一致；没有才回落到按 URL 推导。
   */
  breadcrumbItems?: { label: string; href?: string }[];
}

const { title, description, schema, lang, keywords, alternates, breadcrumbTitle, breadcrumbItems } = Astro.props;
const pageLang = lang || (Astro.url.pathname.startsWith('/ru') ? 'ru' : Astro.url.pathname.startsWith('/zh') ? 'zh' : 'en');

// Site-wide Organization structured data (helps search engines / AI engines
// identify a real, registered Shenzhen business and disambiguate from unrelated
// entities that also use the "eternalcnc.com" domain in legacy directories)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Eternal CNC Precision Machining',
  legalName: 'Xinyongheng (Shenzhen) Precision Industrial Co., Ltd.',
  url: 'https://eternalcnc.com',
  logo: 'https://eternalcnc.com/images/logo/home-logo-brand-mark.webp',
  image: 'https://eternalcnc.com/images/og-default.webp',
  description: 'Precision CNC machining, 5-axis milling, turning, wire EDM and surface treatment for prototypes and production.',
  slogan: 'Precision CNC Machining for Global Engineers',
  areaServed: 'Worldwide',
  knowsAbout: ['CNC Machining', '5-Axis Milling', 'CNC Turning', 'Wire EDM', 'Precision Grinding', 'DFM Analysis', 'Surface Treatment'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '101, Comprehensive Building, No. 33 Guangjin Road, Shapu Community, Songgang Street, Bao\'an District',
    addressLocality: 'Shenzhen',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  telephone: '+86 181 2398 3352',
};

// BreadcrumbList：优先用页面自带的可见面包屑（PageLayout 传入），
// 没有才按 URL 路径推导（设备详情页等直接用 BaseLayout 的页面）。
// 首页 / 404 自动不发；跳板页（/contact/ 用 Astro.redirect(301)、/equipment/ 是空文件）
// 都不经过本布局，因此不会误加面包屑。
const breadcrumb =
  schemaFromPageBreadcrumbs(breadcrumbItems, Astro.url.pathname, Astro.site) ??
  breadcrumbSchema(buildBreadcrumbs(Astro.url.pathname, Astro.site, breadcrumbTitle));
---

<!DOCTYPE html>
<html lang={pageLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 神马验证改用根目录文件 /shenma-site-verification.txt（public/ 直出），meta 方式已废弃 -->
    <meta name="sogou_site_verification" content="pMUajSopW3" />
    <!-- Google 站点验证走【域名提供商 / DNS TXT】方式，不需要 head 内 meta。
         2026-09-29 经 GSC 后台确认：属性 https://eternalcnc.com/ 显示「您是经过验证的
         所有者」，使用的验证方法 = 域名提供商，状态「已成功通过验证」。
         ⚠️ 此前根据 public/googleac7098c299dddb44.html 被 Cloudflare Pages 的
         「.html 去扩展名」规则 308 一事所作的推断（"验证文件失效会导致掉验证"）
         已作废 —— 那个文件从来不是本属性的验证方式。
         如需增加第二种验证方式，请从 GSC「所有权验证 → HTML 标记」复制官方原文，
         不要从验证文件名反推 token。 -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <SEOHead {title} {description} {keywords} schema={schema} alternates={alternates} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <EternalChat />
    <CookieConsent />
  </body>
</html>
