---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import CozeChat from '../components/CozeChat.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object;
  lang?: string;
}

const { title, description, schema, lang } = Astro.props;
const pageLang = lang || (Astro.url.pathname.startsWith('/zh') ? 'zh' : 'en');

// Site-wide Organization structured data (GEO: helps AI engines identify a real business)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Eternal CNC Precision Machining',
  url: 'https://www.eternalcnc.com',
  logo: 'https://www.eternalcnc.com/images/logo/home-logo-brand-mark.webp',
  image: 'https://www.eternalcnc.com/images/og-default.webp',
  description: 'Precision CNC machining, 5-axis milling, turning, wire EDM and surface treatment for prototypes and production.',
  slogan: 'Precision CNC Machining for Global Engineers',
  areaServed: 'Worldwide',
  knowsAbout: ['CNC Machining', '5-Axis Milling', 'CNC Turning', 'Wire EDM', 'Precision Grinding', 'DFM Analysis', 'Surface Treatment'],
};
---

<!DOCTYPE html>
<html lang={pageLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <SEOHead {title} {description} schema={schema} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <CozeChat />
    <CookieConsent />
  </body>
</html>
