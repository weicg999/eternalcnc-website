---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EternalChat from '../components/EternalChat.astro';
// import AIChatWidget from '../components/AIChatWidget.astro'; // SDK版，暂保留
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title: string;
  description: string;
  schema?: object;
}

const { title, description, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <SEOHead {title} {description} schema={schema} />
  </head>
  <body class="font-['Inter',sans-serif] text-gray-800 antialiased bg-white">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <EternalChat />
    <!-- <AIChatWidget /> --> <!-- SDK版，暂保留 -->
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #222222;
    --color-metal: #666666;
    --color-cta: #8B0000;
  }
</style>
