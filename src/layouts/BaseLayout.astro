---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import EternalChat from '../components/EternalChat.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object;
  lang?: string;
}

const { title, description, schema, lang } = Astro.props;
const pageLang = lang || (Astro.url.pathname.startsWith('/zh') ? 'zh' : 'en');

// Site-wide Organization structured data (helps search engines / AI engines
// identify a real, registered Shenzhen business and disambiguate from unrelated
// entities that also use the "eternalcnc.com" domain in legacy directories)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Eternal CNC Precision Machining',
  legalName: 'Xinyongheng (Shenzhen) Precision Industrial Co., Ltd.',
  url: 'https://eternalcnc.com',
  logo: 'https://eternalcnc.com/images/logo/home-logo-brand-mark.webp',
  image: 'https://eternalcnc.com/images/og-default.webp',
  description: 'Precision CNC machining, 5-axis milling, turning, wire EDM and surface treatment for prototypes and production.',
  slogan: 'Precision CNC Machining for Global Engineers',
  areaServed: 'Worldwide',
  knowsAbout: ['CNC Machining', '5-Axis Milling', 'CNC Turning', 'Wire EDM', 'Precision Grinding', 'DFM Analysis', 'Surface Treatment'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Room 101, Comprehensive Building, No.33 Guangjin Road, Shapu Community, Songgang Street',
    addressLocality: 'Shenzhen',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  telephone: '+86 181 2398 3352',
};
---

<!DOCTYPE html>
<html lang={pageLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 神马验证改用根目录文件 /shenma-site-verification.txt（public/ 直出），meta 方式已废弃 -->
    <meta name="sogou_site_verification" content="pMUajSopW3" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <SEOHead {title} {description} schema={schema} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <EternalChat />
    <CookieConsent />
  </body>
</html>
