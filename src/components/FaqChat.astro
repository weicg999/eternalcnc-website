      chips: ['Solicitar presupuesto', '¿Qué materiales?', '¿Tolerancias?', '¿Plazos?'],
      noMatch: 'No tengo una respuesta inmediata. Escriba a nuestros ingenieros: ' + COMPANY.email + ' — solemos responder en 2 horas laborables.',
      noMatchTitle: 'Hablar con un ingeniero',
    },
    de: {
      title: 'Eternal CNC',
      status: 'Online · antworten meist innerhalb von 2 Stunden',
      placeholder: 'Geben Sie Ihre Frage ein…',
      welcome: 'Hallo! Ich bin der Assistent von Eternal CNC. Ich beantworte Fragen zu unseren Leistungen, Materialien, Toleranzen, Lieferzeiten und Angeboten. Wie kann ich helfen?',
      chips: ['Angebot anfordern', 'Materialien?', 'Toleranzen?', 'Lieferzeit?'],
      noMatch: 'Dazu habe ich keine fertige Antwort. Schreiben Sie unseren Ingenieuren: ' + COMPANY.email + ' — Antwort meist innerhalb von 2 Stunden.',
      noMatchTitle: 'Ingenieur kontaktieren',
    },
    fr: {
      title: 'Eternal CNC',
      status: 'En ligne · réponse généralement sous 2 heures',
      placeholder: 'Saisissez votre question…',
      welcome: 'Bonjour ! Je suis l\u2019assistant d\u2019Eternal CNC. Je réponds à vos questions sur nos services, matériaux, tolérances, délais et devis. Comment puis-je vous aider ?',
      chips: ['Demander un devis', 'Quels matériaux ?', 'Tolérances ?', 'Délais ?'],
      noMatch: 'Je n\u2019ai pas de réponse toute prête. Écrivez à nos ingénieurs : ' + COMPANY.email + ' — réponse généralement sous 2 heures ouvrées.',
      noMatchTitle: 'Contacter un ingénieur',
    },
    ar: {
      title: 'Eternal CNC',
      status: 'متصل · نرد عادة خلال ساعتين',
