---
// FaqChat - 静态 FAQ 客服组件（方案 A：零后端 / 零出网 / 零维护）
// 本地关键词匹配，命中返回预设答案，未命中引导联系工程师。
// 与 EternalChat.astro（依赖 /api/chat 扣子转发）互斥使用，本组件不发起任何网络请求。
import { faqItems, COMPANY } from '../data/faq';
const pageLang = Astro.url.pathname.startsWith('/zh') ? 'zh' : (Astro.url.pathname.startsWith('/ru') ? 'ru' : 'en');
---

<div id="faq-chat-widget" class="fixed bottom-6 right-6 z-50">
  <!-- 悬浮按钮 -->
  <button
    id="faq-chat-toggle"
    type="button"
    class="w-14 h-14 text-white flex items-center justify-center transition-all duration-300 hover:scale-105"
    style="background-color: var(--brand-red, #8B0000); border-radius: 50%; box-shadow: 0 4px 20px rgba(139,0,0,.3); position: relative;"
    aria-label="Open chat"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
  </button>

  <!-- 聊天面板 -->
  <div
    id="faq-chat-panel"
    class="bg-white overflow-hidden flex flex-col"
    style="width: 400px; height: 560px; max-height: calc(100vh - 120px); display: none; position: fixed; bottom: 88px; right: 24px; z-index: 100; border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,.14); flex-direction: column;"
  >
    <!-- 头部（清爽白底 + 女头像 + 海外横版 LOGO 居中） -->
    <div class="flex items-center justify-between gap-3 flex-shrink-0" style="position:relative; background:#fff; border-bottom:1px solid #f0f0f0; border-radius:16px 16px 0 0; padding:12px 16px; min-height:64px;">
      <div class="flex items-center flex-shrink-0">
        <div class="w-10 h-10 rounded-full flex-shrink-0 overflow-hidden" style="background:#f2f2f2;">
          <img src="/images/avatar.png" alt="Eternal CNC" style="width:100%;height:100%;object-fit:cover;" />
        </div>
      </div>
      <!-- 品牌块：绝对居中，左右按钮宽度变化不会把它挤偏 -->
      <div id="faq-chat-brand" style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); max-width:calc(100% - 150px); text-align:center;">
        <img src="/images/logo-full.svg" alt="Eternal CNC" style="height:26px; width:auto; display:block; margin:0 auto;" />
        <p class="text-xs flex items-center gap-1.5 mt-0.5" style="color:#999; justify-content:center; white-space:nowrap; overflow:hidden;">
          <span class="w-2 h-2 rounded-full" style="background:#4ade80; flex-shrink:0;"></span>
          <span id="faq-chat-status" style="overflow:hidden; text-overflow:ellipsis;">Online</span>
        </p>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <div id="faq-chat-lang-wrap" style="position: relative;">
          <button id="faq-chat-lang" type="button" class="text-xs font-semibold px-2 py-1 rounded flex items-center gap-1" style="color:#555; border:1px solid #ddd; background:#fff;" aria-label="Switch language">EN</button>
          <div id="faq-chat-lang-menu" style="display:none; position:absolute; top:calc(100% + 6px); right:0; min-width:150px; background:#fff; border-radius:10px; box-shadow:0 8px 30px rgba(0,0,0,.18); overflow:hidden; z-index:200;"></div>
        </div>
        <button id="faq-chat-close" type="button" class="w-8 h-8 flex items-center justify-center rounded-full" style="color:#999;" aria-label="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- 消息区 -->
    <div id="faq-chat-messages" class="flex-1 overflow-y-auto px-4 py-4" style="background-color: var(--brand-bgAlt, #F4F3EE);"></div>

    <!-- 快捷问题 chips -->
    <div id="faq-chat-chips" class="px-3 pb-2 flex-shrink-0" style="display:none;"></div>

    <!-- 输入区 -->
    <div class="p-3 flex-shrink-0" style="border-top: 1px solid #eee; background:#fff; border-radius: 0 0 16px 16px;">
      <!-- 图片预览（选中待发送的图片） -->
      <div id="faq-chat-img-preview" class="flex items-center gap-2 pb-2" style="display:none;"></div>
      <!-- 语音/错误提示条：独立成行、可换行，不再挤进窄输入框的 placeholder -->
      <div id="faq-chat-hint" role="status" aria-live="polite">
        <span id="faq-chat-hint-text" class="fhint-text"></span>
        <button id="faq-chat-hint-close" class="fhint-close" type="button" aria-label="Close">&times;</button>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-2 border rounded-full" style="background:#f7f7f7; border-color:#eee;">
        <button id="faq-chat-image" type="button" class="w-8 h-8 flex items-center justify-center rounded-full flex-shrink-0" style="color:#666;" aria-label="Attach image" title="Attach image">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.6-4.6a2 2 0 012.8 0L16 16m-2-2l1.6-1.6a2 2 0 012.8 0L20 14m-6-8h.01M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </button>
        <button id="faq-chat-mic" type="button" class="w-8 h-8 flex items-center justify-center rounded-full flex-shrink-0" style="color:#666;" aria-label="Voice input" title="Voice input">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-14 0M12 18v3m-3 0h6m-3-3a5 5 0 005-5V7a5 5 0 00-10 0v6a5 5 0 005 5z"/></svg>
        </button>
        <input id="faq-chat-input" type="text" autocomplete="off" class="flex-1 text-sm" style="background:transparent; outline:none; border:none; min-width:0;" />
        <button id="faq-chat-send" type="button" class="w-8 h-8 text-white flex items-center justify-center rounded-full flex-shrink-0" style="background-color: var(--brand-red,#8B0000);" aria-label="Send">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        </button>
      </div>
      <input id="faq-chat-file" type="file" accept="image/*" style="display:none;" />
    </div>
  </div>
</div>

<style is:global>
  #faq-chat-widget .fmsg { display: flex; align-items: flex-start; margin-bottom: 12px; word-break: break-word; }
  #faq-chat-widget .fmsg.user { justify-content: flex-end; }
  #faq-chat-widget .fmsg.bot { justify-content: flex-start; }
  /* 微信式圆形小头像 */
  #faq-chat-widget .favatar {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; overflow: hidden;
  }
  #faq-chat-widget .fmsg.bot .favatar { margin-right: 8px; order: 0; }
  #faq-chat-widget .fmsg.user .favatar { margin-left: 8px; order: 2; }
  #faq-chat-widget .fbubble {
    max-width: 72%; padding: 8px 13px; font-size: 13.5px; line-height: 1.6; order: 1;
    border-radius: 12px; white-space: pre-wrap; box-shadow: 0 1px 2px rgba(0,0,0,.05);
  }
  #faq-chat-widget .fmsg.user .fbubble { background: var(--brand-red,#8B0000); color: #fff; border-bottom-right-radius: 4px; }
  #faq-chat-widget .fmsg.bot .fbubble { background: #fff; color: #1a1a1a; border-bottom-left-radius: 4px; border: 1px solid #eee; }
  #faq-chat-widget .fmsg.bot .fbubble a { color: var(--brand-red,#8B0000); text-decoration: underline; }
  /* 富文本：模型返回的 Markdown 渲染后的样式 */
  #faq-chat-widget .fbubble strong, #faq-chat-widget .fcard strong { font-weight: 600; }
  #faq-chat-widget .fbubble code {
    background: #f1f1f1; color: #8B0000; padding: 1px 5px; border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px;
  }
  #faq-chat-widget .fmsg.user .fbubble code { background: rgba(255,255,255,.22); color: #fff; }
  #faq-chat-widget .fbubble a { word-break: break-all; }
  /* 头部按钮 hover（浅色背景） */
  #faq-chat-widget #faq-chat-lang { transition: background .15s ease; }
  #faq-chat-widget #faq-chat-lang:hover { background: #f2f2f2; }
  #faq-chat-widget #faq-chat-close { transition: background .15s ease; }
  #faq-chat-widget #faq-chat-close:hover { background: #f2f2f2; }
  #faq-chat-widget .fchip {
    display: inline-block; padding: 6px 13px; margin: 0 6px 6px 0; font-size: 12px;
    background: #fff; color: #4a4a4a; border: 1px solid #ddd; border-radius: 999px;
    cursor: pointer; transition: all .15s ease; white-space: nowrap;
  }
  #faq-chat-widget .fchip:hover { background: var(--brand-red,#8B0000); color: #fff; border-color: var(--brand-red,#8B0000); }
  #faq-chat-widget .fcard {
    background: #fff; border: 1px solid #eee; border-left: 3px solid var(--brand-red,#8B0000);
    border-radius: 10px; padding: 10px 12px; font-size: 13px; line-height: 1.7;
    order: 1; max-width: 72%;
  }
  #faq-chat-widget .flang {
    display: block; width: 100%; text-align: left; padding: 9px 14px; font-size: 13px;
    color: #333; background: #fff; border: none; cursor: pointer; transition: background .12s ease;
  }
  #faq-chat-widget .flang:hover { background: #f4f3ee; }
  #faq-chat-widget .flang.active { color: var(--brand-red,#8B0000); font-weight: 600; background: #faf7f7; }
  #faq-chat-widget .flang-divider { height: 1px; background: #eee; margin: 4px 0; }
  /* 朗读按钮（语音播报） */
  #faq-chat-widget .fspeak {
    align-self: flex-end; margin-left: 4px; color: #999; cursor: pointer;
    background: transparent; border: none; padding: 3px; flex-shrink: 0;
    width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    transition: all .15s ease;
  }
  #faq-chat-widget .fspeak:hover { color: var(--brand-red,#8B0000); background: #f2f2f2; }
  /* 输入区图片/麦克风按钮 */
  #faq-chat-widget #faq-chat-image, #faq-chat-widget #faq-chat-mic { transition: color .15s ease, background .15s ease; }
  #faq-chat-widget #faq-chat-image:hover, #faq-chat-widget #faq-chat-mic:hover { color: var(--brand-red,#8B0000); background: #eee; }
  #faq-chat-widget #faq-chat-mic.listening { color: var(--brand-red,#8B0000); background: #fdeaea; animation: faq-pulse 1.2s infinite; }
  @keyframes faq-pulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }
  /* 语音/错误提示条：整行显示，自动换行，避免长文案被输入框截断 */
  #faq-chat-widget #faq-chat-hint {
    display: none; align-items: flex-start; gap: 6px;
    margin-bottom: 8px; padding: 8px 10px;
    border-radius: 10px; border: 1px solid transparent;
    font-size: 12px; line-height: 1.55;
  }
  #faq-chat-widget #faq-chat-hint.show { display: flex; }
  #faq-chat-widget #faq-chat-hint .fhint-text { flex: 1; min-width: 0; word-break: break-word; }
  #faq-chat-widget #faq-chat-hint .fhint-close {
    flex-shrink: 0; width: 16px; height: 16px; padding: 0; border: none;
    background: transparent; color: inherit; opacity: .55; cursor: pointer;
    font-size: 15px; line-height: 1; display: flex; align-items: center; justify-content: center;
  }
  #faq-chat-widget #faq-chat-hint .fhint-close:hover { opacity: 1; }
  #faq-chat-widget #faq-chat-hint.hint-error { background: #fdeaea; border-color: #f2c4c4; color: #9b1c1c; }
  #faq-chat-widget #faq-chat-hint.hint-warn  { background: #fff8e6; border-color: #f0dfae; color: #8a6100; }
  #faq-chat-widget #faq-chat-hint.hint-info  { background: #eef4ff; border-color: #cddffb; color: #1e429f; }
  /* 图片缩略图（预览 + 消息内） */
  #faq-chat-widget .fimg-thumb { position: relative; width: 56px; height: 56px; border-radius: 8px; overflow: hidden; border: 1px solid #eee; flex-shrink: 0; }
  #faq-chat-widget .fimg-thumb img { width: 100%; height: 100%; object-fit: cover; }
  #faq-chat-widget .fimg-remove { position: absolute; top: 2px; right: 2px; width: 16px; height: 16px; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; font-size: 10px; line-height: 1; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; }
  #faq-chat-widget .fimg-msg { max-width: 60%; border-radius: 10px; overflow: hidden; border: 1px solid #eee; }
  #faq-chat-widget .fimg-msg img { display: block; max-width: 100%; height: auto; }
  #faq-chat-messages::-webkit-scrollbar { width: 4px; }
  #faq-chat-messages::-webkit-scrollbar-thumb { background: #ccc; border-radius: 2px; }
  @media (max-width: 640px) {
    #faq-chat-widget { bottom: 0; right: 0; left: 0; width: 100%; pointer-events: none; }
    #faq-chat-widget #faq-chat-toggle, #faq-chat-widget #faq-chat-panel { pointer-events: auto; }
    #faq-chat-widget #faq-chat-toggle { position: fixed; bottom: 16px; right: 16px; }
    #faq-chat-widget #faq-chat-panel {
      position: fixed !important; bottom: 0 !important; right: 0 !important; left: 0 !important;
      width: 100% !important; height: 82vh !important; max-height: 82vh !important;
      border-radius: 16px 16px 0 0 !important;
    }
  }
</style>

<script define:vars={{ faqItems, COMPANY, pageLang }}>
(function () {
  'use strict';
  const widget = document.getElementById('faq-chat-widget');
  const toggle = document.getElementById('faq-chat-toggle');
  const panel = document.getElementById('faq-chat-panel');
  const messagesEl = document.getElementById('faq-chat-messages');
  const chipsEl = document.getElementById('faq-chat-chips');
  const inputEl = document.getElementById('faq-chat-input');
  const sendBtn = document.getElementById('faq-chat-send');
  const closeBtn = document.getElementById('faq-chat-close');
  const langBtn = document.getElementById('faq-chat-lang');
  const statusEl = document.getElementById('faq-chat-status');
  const imageBtn = document.getElementById('faq-chat-image');
  const micBtn = document.getElementById('faq-chat-mic');
  const fileInput = document.getElementById('faq-chat-file');
  const imgPreview = document.getElementById('faq-chat-img-preview');
  if (!widget || !panel) return;

  // 语言：初始取页面语言（zh/ru/en 三语站）
  let lang = (pageLang === 'zh' || pageLang === 'ru') ? pageLang : 'en';
  // 手动选择的语言（空 = 自动检测客户消息语言）。选中后 UI 文案 + 客服回答都强制跟随。
  let forcedLang = '';
  let greeted = false;

  // 方案 B：多轮对话状态。Workers AI 无服务端会话，历史由前端维护并随请求上报。
  let history = [];
  // 对话消息持久化：存 localStorage，刷新/切换语言都不丢（"客服有记忆"）
  let messages = [];
  function saveMessages() {
    try { localStorage.setItem('eternal_chat_messages', JSON.stringify(messages)); } catch (e) {}
  }
  function loadMessages() {
    try {
      const raw = localStorage.getItem('eternal_chat_messages');
      messages = raw ? (JSON.parse(raw) || []) : [];
    } catch (e) { messages = []; }
  }
  let busy = false;
  let userId = '';
  let convId = '';
  try {
    userId = localStorage.getItem('eternal_chat_user_id') || '';
    if (!userId) {
      userId = 'u_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
      localStorage.setItem('eternal_chat_user_id', userId);
    }
    convId = localStorage.getItem('eternal_chat_conversation_id') || '';
  } catch (e) {}

  const T = {
    en: {
      title: 'Eternal CNC',
      status: 'Online · typically replies in 2 hours',
      placeholder: 'Type your question…',
      welcome: 'Hello! I\u2019m the Eternal CNC assistant. I can answer questions about our services, materials, tolerances, lead time and quoting. What can I help you with?',
      chips: ['Get a quote', 'What materials?', 'What tolerances?', 'Lead time?'],
      noMatch: 'I could not find a ready answer for that. Please email our engineers at ' + COMPANY.email + ' — we typically reply within 2 business hours.',
      noMatchTitle: 'Talk to an engineer',
    },
    zh: {
      title: '鑫永恒 CNC',
      status: '在线 · 通常 2 小时内回复',
      placeholder: '请输入您的问题…',
      welcome: '您好！我是鑫永恒 CNC 助手，可以解答关于加工服务、材料、公差、交期和报价的问题。请问有什么可以帮您？',
      chips: ['获取报价', '能加工哪些材料', '公差精度', '交期多久'],
      noMatch: '这个问题我暂时没有现成答案，请直接邮件联系工程师 ' + COMPANY.email + '，工作日通常 2 小时内回复。',
      noMatchTitle: '联系工程师',
    },
    ja: {
      title: 'Eternal CNC',
      status: 'オンライン · 通常2時間以内に返信',
      placeholder: 'ご質問を入力してください…',
      welcome: 'こんにちは！Eternal CNCのアシスタントです。加工サービス、材料、公差、納期、見積もりについてご案内します。何かお手伝いできることはありますか？',
      chips: ['見積もりを依頼', '対応材料は？', '公差精度は？', '納期は？'],
      noMatch: 'こちらの質問には即答できる回答がありません。エンジニア ' + COMPANY.email + ' までメールでお問い合わせください。平日は通常2時間以内に返信します。',
      noMatchTitle: 'エンジニアに相談',
    },
    ko: {
      title: 'Eternal CNC',
      status: '온라인 · 보통 2시간 내 답변',
      placeholder: '질문을 입력하세요…',
      welcome: '안녕하세요! Eternal CNC 어시스턴트입니다. 가공 서비스, 재료, 공차, 납기, 견적에 대해 안내해 드립니다. 무엇을 도와드릴까요?',
      chips: ['견적 요청', '가공 재료는?', '공차 정밀도?', '납기는?'],
      noMatch: '이 질문에 대한 답변을 바로 찾지 못했습니다. 엔지니어 ' + COMPANY.email + ' 로 이메일 주시면 보통 2시간 내에 답변드립니다.',
      noMatchTitle: '엔지니어에게 문의',
    },
    ru: {
      title: 'Eternal CNC',
      status: 'Онлайн · обычно отвечаем в течение 2 часов',
