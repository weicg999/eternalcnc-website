            {g:'By Process'},{l:'CNC Machining Cases',h:'/cases/cnc'},{l:'Turning Cases',h:'/cases/turning'},{l:'5-Axis Cases',h:'/cases/5-axis'},
            {g:'By Scale'},{l:'Prototype',h:'/cases/prototype'},{l:'Mass Production',h:'/cases/mass-production'}
          ]}
          ,          {label:'Knowledge',href:'/knowledge',children:[
            {l:'DFM Design Guide',h:'/knowledge/dfm-guide'},{l:'Case Studies',h:'/knowledge/case-studies'},{l:'Whitepapers',h:'/knowledge/whitepapers'},{l:'Material Handbook',h:'/knowledge/material-handbook'},{l:'How to Choose a Supplier',h:'/knowledge/choose-cnc-supplier'},{l:'Industry & News',h:'/knowledge/news'},{l:'FAQ',h:'/knowledge/faq'}
          ]},
          {label:'Resources',href:'/resources'}
        ]).map((link) => (
          <div class="mobile-nav-item">
            {link.children ? (
              <div class="w-full flex items-center">
                <a href={link.href} class="flex-1 px-4 py-3 text-sm font-medium" style="color:#1A1A1A">{link.label}</a>
                <button class="mobile-nav-toggle px-3 py-3" aria-label="Toggle submenu">
                  <svg class="w-4 h-4 mobile-nav-arrow transition-transform" style="color: #1A1A1A;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </div>
            ) : (
              <a href={link.href} class="block px-4 py-3 text-sm font-medium" style="color:#1A1A1A">{link.label}</a>
            )}
            {link.children && (
              <div class="mobile-nav-children hidden">
                {link.children.map((c) => (
                  c.g ? (
                    <div class="px-6 pt-2 pb-1 text-xs font-semibold uppercase tracking-wider" style="color:#9CA3AF">{c.g}</div>
                  ) : (
                    <a href={c.h} class="block px-6 py-2 text-sm" style="color:#6B7280">{c.l}</a>
                  )
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="border-t mt-2 p-4" style="border-color: var(--border-color);">
        <a href={isZh ? '/zh/contact/get-a-quote' : '/contact/get-a-quote'} class="block w-full text-center text-white font-semibold text-sm py-3 bg-[#8B0000] rounded-lg hover:bg-[#6B0000]">{isZh ? '获取报价' : 'Get a Quote'}</a>
        <div class="flex items-center justify-center gap-4 mt-3 text-sm">
          <a href={enHref} class={!isZh ? 'font-semibold' : ''} style={!isZh ? 'color:#8B0000' : 'color:#6B7280'}>English</a>
          <span style="color:var(--border-color)">|</span>
          <a href={zhHref} class={isZh ? 'font-semibold' : ''} style={isZh ? 'color:#8B0000' : 'color:#6B7280'}>中文</a>
        </div>
      </div>
    </div>
  </div>
</header>
<style>
  .nav-primary-item { position: relative; }
  .nav-primary-item::after {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 0; height: 2px; background-color: #8B0000; transition: width 0.2s ease;
  }
  .nav-primary-item:hover::after { width: 100%; }
  .nav-primary-item:hover { color: #8B0000 !important; }
  .dropdown-item:hover { background-color: #F9FAFB !important; color: #8B0000 !important; border-left: 2px solid #8B0000; }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('mobile-menu-close');
  const overlay = document.getElementById('mobile-menu-overlay');
  const navbar = document.getElementById('main-navbar');

  function openMenu() { menu?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
  function closeMenu() { menu?.classList.add('hidden'); document.body.style.overflow = ''; }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.querySelectorAll('.mobile-nav-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const children = toggle.closest('.mobile-nav-item').querySelector('.mobile-nav-children');
      const arrow = toggle.querySelector('.mobile-nav-arrow');
      if (children) {
        children.classList.toggle('hidden');
        arrow?.classList.toggle('rotate-180');
      }
    });
  });

  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('shadow-md', window.scrollY > 10);
    });
  }
</script>
