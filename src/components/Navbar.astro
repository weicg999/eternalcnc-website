---
const currentPath = Astro.url.pathname;
const isZh = currentPath.startsWith('/zh');

// 枚举真实存在的路由，语言切换只在对应译文存在时才切换，否则回到目标语言首页
const allModules = import.meta.glob('../pages/**/*.astro', { eager: true });
const routes = new Set<string>();
for (const p of Object.keys(allModules)) {
  let r = p.replace(/^\.\.\/pages\//, '').replace(/\.astro$/, '');
  r = r.replace(/\/index$/, '');
  if (r === 'index') r = '';
  routes.add('/' + r);
}
// 命名不对称的双语页（slug 不同），其余仅前缀不同
const LANG_MAP: Record<string, string> = {
  '/zh/knowledge/dfm-guides': '/knowledge/dfm-guide',
  '/zh/knowledge/machining-tolerances': '/knowledge/tolerance',
  '/zh/knowledge/material-guide': '/knowledge/material-handbook',
  '/zh/knowledge/quality-certification': '/knowledge/quality',
  '/knowledge/dfm-guide': '/zh/knowledge/dfm-guides',
  '/knowledge/tolerance': '/zh/knowledge/machining-tolerances',
  '/knowledge/material-handbook': '/zh/knowledge/material-guide',
  '/knowledge/quality': '/zh/knowledge/quality-certification',
};
const norm = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const np = norm(currentPath);
const counterPath = norm(LANG_MAP[np] || (isZh ? (np.replace(/^\/zh/, '') || '/') : '/zh' + (np === '/' ? '' : np)));
const counterExists = routes.has(counterPath);
// 对页存在 → 直达译文；不存在 → 目标语言首页（不再 404）
// 404 页本身没有译文，语言切换一律回目标语言首页
const enHref = np === '/404' ? '/' : (!isZh ? np : (counterExists ? counterPath : '/'));
const zhHref = np === '/404' ? '/zh/' : (isZh ? np : (counterExists ? counterPath : '/zh/'));
