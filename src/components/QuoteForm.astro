    material_chip_other: '其他…',
    material_cat_aluminum: '铝',
    material_cat_stainless: '不锈钢',
    material_cat_steel: '钢',
    material_cat_copper: '铜',
    material_cat_titanium: '钛',
    material_cat_plastic: '塑料',
