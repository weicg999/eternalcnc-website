};
const isZh = lang === 'zh';
---

<div id="quote-form" data-lang={lang} data-back={texts[lang].back} data-next={texts[lang].next} data-submit={texts[lang].submit} class="w-full max-w-3xl mx-auto">
  <!-- Progress bar -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium text-brand-text" id="step-label">{isZh ? '第 1 步，共 3 步' : 'Step 1 of 3'}</span>
      <span class="text-sm text-brand-silver" id="step-percent">33%</span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-1.5">
      <div id="progress-bar" class="h-1.5 rounded-full transition-all duration-300" style="width: 33%; background-color: var(--brand-red);"></div>
    </div>
  </div>

  <form id="quote-form-element" class="space-y-0">
    <!-- Step 1: Upload Drawings -->
    <div class="form-step" data-step="1">
      <h3 class="text-xl font-bold text-brand-text mb-2">{texts[lang].title}</h3>
      <p class="text-sm text-brand-secondary mb-6">{texts[lang].formats}</p>
      <div class="border-2 border-dashed border-gray-200 rounded-xl p-10 text-center hover:border-brand-text transition-colors cursor-pointer bg-white" id="drop-zone">
        <svg class="w-10 h-10 text-brand-silver mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <p class="text-sm text-brand-secondary mb-1">{texts[lang].drag}<span class="text-brand-text font-medium underline">{texts[lang].browse}</span></p>
        <p class="text-xs text-brand-silver">{texts[lang].formats_small}</p>
        <input type="file" multiple accept=".step,.stp,.iges,.igs,.stl,.pdf,.dxf,.dwg" class="hidden" id="file-input" />
      </div>
      <div id="file-list" class="mt-4 space-y-2"></div>
      <div class="mt-5">
        <label for="qf-part" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].partName}</label>
        <input type="text" id="qf-part" name="partName" placeholder={texts[lang].partNamePh}
          class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
      </div>
    </div>

    <!-- Step 2: Material & Quantity & Tolerance -->
    <div class="form-step hidden" data-step="2">
      <h3 class="text-xl font-bold text-brand-text mb-2">{texts[lang].title2}</h3>
      <p class="text-sm text-brand-secondary mb-6">{texts[lang].subtitle2}</p>

      <p class="text-sm font-medium text-brand-text mb-2">{texts[lang].material_label}</p>
      <div class="mb-4" id="material-chips">
        <div class="mb-3">
          <label class="material-chip active"><input type="radio" name="material" value="per-drawing" class="hidden" checked /><span>{texts[lang].material_chip_per_drawing}</span></label>
        </div>
        <p class="text-xs text-brand-silver mb-2">{texts[lang].material_quick_hint}</p>
        <div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2 items-center">
          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_aluminum}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip"><input type="radio" name="material" value="6061-T6" class="hidden" /><span>6061-T6</span></label>
            <label class="material-chip"><input type="radio" name="material" value="7075-T6" class="hidden" /><span>7075-T6</span></label>
          </div>

          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_stainless}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip"><input type="radio" name="material" value="304 SS" class="hidden" /><span>{texts[lang].material_chip_304}</span></label>
            <label class="material-chip"><input type="radio" name="material" value="316 SS" class="hidden" /><span>{texts[lang].material_chip_316}</span></label>
          </div>

          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_steel}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip"><input type="radio" name="material" value="Carbon Steel" class="hidden" /><span>{texts[lang].material_chip_steel}</span></label>
          </div>

          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_copper}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip"><input type="radio" name="material" value="Brass / Copper" class="hidden" /><span>{texts[lang].material_chip_brass}</span></label>
          </div>

          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_titanium}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip"><input type="radio" name="material" value="Titanium" class="hidden" /><span>{texts[lang].material_chip_titanium}</span></label>
          </div>

          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_plastic}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip"><input type="radio" name="material" value="Engineering Plastic" class="hidden" /><span>{texts[lang].material_chip_plastic}</span></label>
          </div>

          <span class="text-xs font-medium text-brand-silver text-right">{texts[lang].material_cat_others}</span>
          <div class="flex flex-wrap gap-2">
            <label class="material-chip" id="qf-chip-other"><input type="radio" name="material" value="other" class="hidden" /><span>{texts[lang].material_chip_other}</span></label>
          </div>
        </div>
      </div>
      <div id="qf-material-detail-wrap" class="mb-6 hidden">
        <input type="text" id="qf-material-detail" name="material_detail" placeholder={texts[lang].material_detail_ph}
          class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
        <p class="text-xs text-brand-silver mt-1">{texts[lang].material_detail_hint}</p>
      </div>

      <p class="text-sm font-medium text-brand-text mb-2">{texts[lang].qty_label}</p>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="1-10" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_1_10}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="11-50" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_11_50}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="51-200" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_51_200}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="201-500" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_201_500}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="501-1000" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_501_1000}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="1000-5000" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_1000_5000}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="5000+" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_5000_plus}</span>
        </label>
        <label class="quantity-card flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-brand-text transition-colors bg-white">
          <input type="radio" name="quantity" value="ongoing" class="mr-3" /> <span class="font-medium text-sm">{texts[lang].qty_ongoing}</span>
        </label>
      </div>

      <label for="qf-tolerance" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].tolerance_label}</label>
      <input type="text" id="qf-tolerance" name="tolerance" placeholder={texts[lang].tolerance_ph}
        class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
    </div>

    <!-- Step 3: Contact Info -->
    <div class="form-step hidden" data-step="3">
      <h3 class="text-xl font-bold text-brand-text mb-2">{texts[lang].title3}</h3>
      <p class="text-sm text-brand-secondary mb-6">{texts[lang].subtitle3}</p>
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="qf-name" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].contact_name} *</label>
          <input type="text" id="qf-name" name="name" required placeholder={texts[lang].name_placeholder}
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
        </div>
        <div>
          <label for="qf-company" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].contact_company}</label>
          <input type="text" id="qf-company" name="company" placeholder={texts[lang].company_placeholder}
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
        </div>
        <div>
          <label for="qf-email" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].contact_email} *</label>
          <input type="email" id="qf-email" name="email" required placeholder={texts[lang].email_placeholder}
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
        </div>
        <div>
          <label for="qf-phone" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].contact_phone}</label>
          <div class="flex gap-2">
            <select id="qf-country-code" name="country_code" class="w-24 px-2 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white">
              <option value="+86">🇨🇳 +86</option>
              <option value="+1">🇺🇸 +1</option>
              <option value="+44">🇬🇧 +44</option>
              <option value="+49">🇩🇪 +49</option>
              <option value="+33">🇫🇷 +33</option>
              <option value="+81">🇯🇵 +81</option>
              <option value="+82">🇰🇷 +82</option>
              <option value="+61">🇦🇺 +61</option>
              <option value="+91">🇮🇳 +91</option>
              <option value="+971">🇦🇪 +971</option>
              <option value="+65">🇸🇬 +65</option>
              <option value="+60">🇲🇾 +60</option>
              <option value="+66">🇹🇭 +66</option>
              <option value="+39">🇮🇹 +39</option>
              <option value="+34">🇪🇸 +34</option>
              <option value="+7">🇷🇺 +7</option>
              <option value="+55">🇧🇷 +55</option>
              <option value="+52">🇲🇽 +52</option>
              <option value="+27">🇿🇦 +27</option>
              <option value="+90">🇹🇷 +90</option>
            </select>
            <input type="tel" id="qf-phone" name="phone" placeholder={texts[lang].phone_placeholder}
              class="flex-1 px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition bg-white" />
          </div>
        </div>
      </div>
      <div class="mt-5">
        <label for="qf-notes" class="block text-sm font-medium text-brand-text mb-1">{texts[lang].contact_notes}</label>
        <textarea id="qf-notes" name="notes" rows="3" placeholder={texts[lang].notes_placeholder}
          class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-[#8B0000] focus:border-transparent outline-none transition resize-none bg-white"></textarea>
      </div>
      <div id="qf-success" class="text-sm mt-3 hidden">
        <p id="qf-success-msg" class="text-green-700 mb-2"></p>
        <div id="qf-mailto-actions" style="display:none;">
          <a id="qf-mailto-link" href="#"
            class="inline-block px-4 py-2 bg-[#8B0000] text-white rounded-lg text-sm font-medium hover:bg-[#6a0000] transition mb-2">
            {texts[lang].open_email}
          </a>
          <p class="text-xs text-gray-500 mb-2" id="qf-mailto-hint">{texts[lang].mailto_hint}</p>
          <div class="border rounded-lg p-3 bg-gray-50 mt-2">
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-medium text-gray-600">{texts[lang].email_preview}</span>
              <button type="button" id="qf-copy-btn"
                class="text-xs text-[#8B0000] underline hover:no-underline">{texts[lang].copy_email}</button>
            </div>
            <textarea id="qf-mail-body" readonly rows="6"
              class="w-full text-xs font-mono bg-transparent border-0 resize-none outline-none text-gray-700"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation buttons (rendered by client-side JS) -->
    <div class="form-actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:2rem;gap:1rem;"></div>

    {lang === 'zh' ? (
      <p style="font-size:0.75rem;color:#888;margin-top:1rem;line-height:1.5;">
        提交即表示您同意我们的 <a href="/zh/privacy-policy" style="color:#8B0000;text-decoration:underline;">隐私政策</a>。
      </p>
    ) : (
      <p style="font-size:0.75rem;color:#888;margin-top:1rem;line-height:1.5;">
        By submitting, you agree to our <a href="/privacy-policy" style="color:#8B0000;text-decoration:underline;">Privacy Policy</a>.
      </p>
    )}
  </form>
</div>

<style>
  .form-actions {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f3f4f6;
    gap: 1rem;
  }
  .form-actions .btn {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
    font-family: inherit;
    line-height: 1.2;
  }
  .form-actions .btn-back {
    background-color: transparent !important;
    border: 1.5px solid #8B0000 !important;
    color: #8B0000 !important;
    box-shadow: 0 2px 8px rgba(139, 0, 0, 0.2) !important;
  }
  .form-actions .btn-back:hover {
    background-color: #8B0000 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.35) !important;
  }
  .form-actions .btn-next {
    background-color: #8B0000 !important;
    border: 1.5px solid #8B0000 !important;
    color: #FFFFFF !important;
    box-shadow: 0 2px 8px rgba(139, 0, 0, 0.25) !important;
  }
  .form-actions .btn-next:hover {
    background-color: #6B0000 !important;
    border-color: #6B0000 !important;
    box-shadow: 0 4px 12px rgba(139, 0, 0, 0.4) !important;
  }
  #material-chips .material-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1.5px solid #e5e7eb;
    border-radius: 9999px;
    cursor: pointer;
    background: #fff;
    color: #1A1A1A;
    transition: all 0.18s ease;
    user-select: none;
    line-height: 1.2;
  }
  #material-chips .material-chip:hover { border-color: #1A1A1A; }
  #material-chips .material-chip.active {
    border-color: #8B0000;
    background-color: #8B0000;
    color: #fff;
    box-shadow: 0 2px 8px rgba(139, 0, 0, 0.25);
  }
  .quantity-card { transition: all 0.18s ease; }
  .quantity-card:has(input:checked) {
    background-color: #8B0000;
    border-color: #8B0000;
    color: #fff;
    box-shadow: 0 2px 8px rgba(139, 0, 0, 0.25);
  }
  .quantity-card:has(input:checked) input[type="radio"] {
    accent-color: #fff;
  }
</style>
<script>
  (function() {
    let currentStep = 1;
    const totalSteps = 3;
    const steps = document.querySelectorAll('.form-step');
    const progressBar = document.getElementById('progress-bar');
    const stepLabel = document.getElementById('step-label');
    const stepPercent = document.getElementById('step-percent');
    const formEl = document.getElementById('quote-form');
    const texts = formEl ? { back: formEl.dataset.back, next: formEl.dataset.next, submit: formEl.dataset.submit } : { back: 'Back', next: 'Next', submit: 'Submit' };
    const uploadedFiles = [];
    const isZh = formEl && formEl.dataset.lang === 'zh';

    function updateUI() {
      steps.forEach(function(s) {
        s.classList.toggle('hidden', parseInt(s.dataset.step) !== currentStep);
      });
      const pct = Math.round((currentStep / totalSteps) * 100);
      if (progressBar) progressBar.style.width = pct + '%';
      if (stepLabel) stepLabel.textContent = isZh ? '第 ' + currentStep + ' 步，共 ' + totalSteps + ' 步' : 'Step ' + currentStep + ' of ' + totalSteps;
      if (stepPercent) stepPercent.textContent = pct + '%';
      renderActions();
    }

    function renderActions() {
      const container = document.querySelector('.form-actions');
      if (!container) return;
      const isLast = currentStep === totalSteps;
      const backStyle = "display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.7rem 1.8rem;font-size:0.95rem;font-weight:600;border-radius:6px;cursor:pointer;transition:all 0.2s ease;font-family:inherit;line-height:1.2;background-color:transparent;border:1.5px solid #8B0000;color:#8B0000;box-shadow:0 2px 8px rgba(139,0,0,0.2);";
      const nextStyle = "display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.7rem 1.8rem;font-size:0.95rem;font-weight:600;border-radius:6px;cursor:pointer;transition:all 0.2s ease;font-family:inherit;line-height:1.2;background-color:#8B0000;border:1.5px solid #8B0000;color:#FFFFFF;box-shadow:0 2px 8px rgba(139,0,0,0.25);";
      const backHtml = currentStep > 1 ? "<button type=\"button\" id=\"backBtn\" style=\"" + backStyle + "\">" + texts.back + "</button>" : "<div style=\"width:1px;flex:0 0 auto;\"></div>";
      const nextHtml = !isLast ? "<button type=\"button\" id=\"nextBtn\" style=\"" + nextStyle + "\">" + texts.next + "</button>" : "<button type=\"submit\" id=\"submitBtn\" style=\"" + nextStyle + "\">" + texts.submit + "</button>";
      container.innerHTML = backHtml + nextHtml;
      const bb = document.getElementById('backBtn');
      if (bb) {
        bb.addEventListener('click', goBack);
        bb.addEventListener('mouseover', function() { this.style.backgroundColor = "#8B0000"; this.style.color = "#FFFFFF"; this.style.boxShadow = "0 4px 12px rgba(139,0,0,0.35)"; });
        bb.addEventListener('mouseout', function() { this.style.backgroundColor = "transparent"; this.style.color = "#8B0000"; this.style.boxShadow = "0 2px 8px rgba(139,0,0,0.2)"; });
      }
      const nb = document.getElementById('nextBtn');
      if (nb) {
        nb.addEventListener('click', goNext);
        nb.addEventListener('mouseover', function() { this.style.backgroundColor = "#6B0000"; this.style.boxShadow = "0 4px 12px rgba(139,0,0,0.4)"; });
        nb.addEventListener('mouseout', function() { this.style.backgroundColor = "#8B0000"; this.style.boxShadow = "0 2px 8px rgba(139,0,0,0.25)"; });
      }
      const sb = document.getElementById('submitBtn');
      if (sb) {
        sb.addEventListener('mouseover', function() { this.style.backgroundColor = "#6B0000"; this.style.boxShadow = "0 4px 12px rgba(139,0,0,0.4)"; });
        sb.addEventListener('mouseout', function() { this.style.backgroundColor = "#8B0000"; this.style.boxShadow = "0 2px 8px rgba(139,0,0,0.25)"; });
      }
    }

    function goBack() { if (currentStep > 1) { currentStep--; updateUI(); } }
    function goNext() { if (currentStep < totalSteps) { currentStep++; updateUI(); } }

    // Material chips
    const materialChips = document.querySelectorAll('#material-chips .material-chip');
    const materialDetailWrap = document.getElementById('qf-material-detail-wrap');
    const materialDetailInput = document.getElementById('qf-material-detail');
    function syncMaterial() {
      const sel = document.querySelector('input[name="material"]:checked');
      materialChips.forEach(function(c) { c.classList.toggle('active', c.querySelector('input').checked); });
      const show = sel && sel.value === 'other';
      if (materialDetailWrap) materialDetailWrap.classList.toggle('hidden', !show);
      if (!show && materialDetailInput) materialDetailInput.value = '';
    }
    materialChips.forEach(function(c) { c.querySelector('input').addEventListener('change', syncMaterial); });
    syncMaterial();

    // File upload handling
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const fileList = document.getElementById('file-list');

    if (dropZone) dropZone.addEventListener('click', () => fileInput?.click());
    if (dropZone) dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-brand-text'); });
    if (dropZone) dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-brand-text'));
    if (dropZone) dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-text');
      if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
    });
    if (fileInput) fileInput.addEventListener('change', () => { if (fileInput.files) handleFiles(fileInput.files); });

    function handleFiles(files) {
      if (!fileList) return;
      Array.from(files).forEach(f => {
        uploadedFiles.push(f);
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between bg-brand-bgAlt rounded-lg px-4 py-2';
        div.innerHTML = `<span class="text-sm text-brand-text truncate mr-2">${f.name}</span><span class="text-xs text-brand-silver whitespace-nowrap">${(f.size / 1024 / 1024).toFixed(2)} MB</span>`;
        fileList.appendChild(div);
      });
    }

    // Submit -> POST /api/quote (Cloudflare Worker 收图纸并发邮件)
    const form = document.getElementById('quote-form-element');
    const API_BASE = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
      ? 'http://localhost:8787'   // 本地：wrangler dev 端口
      : '';                        // 生产：与官网同域
    function setSubmitting(on) {
      const sb = document.getElementById('submitBtn');
      if (sb) { sb.disabled = on; sb.style.opacity = on ? '0.6' : '1'; sb.textContent = on ? (isZh ? '提交中…' : 'Submitting…') : texts.submit; }
    }
    function showResult(msg, isError, keepMailto) {
      const ok = document.getElementById('qf-success');
      const msgEl = document.getElementById('qf-success-msg');
      const mailtoActions = document.getElementById('qf-mailto-actions');
      if (!ok) return;
      if (msgEl) msgEl.textContent = msg;
      if (mailtoActions && !keepMailto) mailtoActions.style.display = 'none';
      ok.classList.remove('hidden');
      if (msgEl) msgEl.style.color = isError ? '#B91C1C' : '#15803D';
    }
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const data = new FormData(form);
        const name = (data.get('name') || '').toString().trim();
        const mail = (data.get('email') || '').toString().trim();
        if (!name || !mail) { form.reportValidity(); return; }

        const fd = new FormData();
        fd.append('name', name);
        fd.append('company', (data.get('company') || '').toString().trim());
        fd.append('email', mail);
        fd.append('country_code', (data.get('country_code') || '').toString().trim());
        fd.append('phone', (data.get('phone') || '').toString().trim());
        fd.append('partName', (data.get('partName') || '').toString().trim());
        fd.append('material', (data.get('material') || '').toString().trim());
        fd.append('material_detail', (data.get('material_detail') || '').toString().trim());
        fd.append('quantity', (data.get('quantity') || '').toString().trim());
        fd.append('tolerance', (data.get('tolerance') || '').toString().trim());
        fd.append('notes', (data.get('notes') || '').toString().trim());
        uploadedFiles.forEach(f => fd.append('drawings', f, f.name));

        setSubmitting(true);

        // Helper: 当后端不可用时，降级为 mailto 方案
        function fallbackToMailto() {
          const cc = (data.get('country_code') || '').toString().trim();
          const phone = (data.get('phone') || '').toString().trim();
          const mat = (data.get('material') || '').toString().trim();
          const matDetail = (data.get('material_detail') || '').toString().trim();
          const qty = (data.get('quantity') || '').toString().trim();
          const tol = (data.get('tolerance') || '').toString().trim();
          const notes = (data.get('notes') || '').toString().trim();
          const part = (data.get('partName') || '').toString().trim();

          const bodyLines = [
            isZh ? '【EternalCNC 在线报价请求】' : '[EternalCNC Online Quote Request]',
            '',
            isZh ? '姓名：' : 'Name: ', name,
            isZh ? '公司：' : 'Company: ', (data.get('company') || '').toString().trim(),
            isZh ? '邮箱：' : 'Email: ', mail,
            isZh ? '电话：' : 'Phone: ', (cc && phone ? cc + ' ' + phone : phone || 'N/A'),
            '',
            isZh ? '零件名/图号：' : 'Part Name / Drawing No.: ', part || 'N/A',
            isZh ? '材料：' : 'Material: ', (mat === 'per-drawing' ? (isZh ? '按图纸标注' : 'As per drawing') : (matDetail || mat || 'N/A')),
            isZh ? '数量：' : 'Quantity: ', qty || 'N/A',
            isZh ? '公差：' : 'Tolerance: ', tol || 'N/A',
            '',
            isZh ? '补充说明：' : 'Additional Notes:',
            notes || (isZh ? '无' : 'None'),
            '',
            '---',
            isZh ? '【请手动附上图纸文件（STEP / PDF / DXF 等）再发送此邮件】' : '[Please manually attach your drawing files (STEP / PDF / DXF) before sending this email.]',
            '',
            isZh ? '发送成功后，我们将在 24 小时内回复。' : 'We will reply within 24 hours after receiving.'
          ];
          const subject = isZh
            ? ('【报价请求】' + (part || name) + ' — EternalCNC')
            : ('[Quote Request] ' + (part || name) + ' — EternalCNC');
          const mailto = 'mailto:sales@eternalcnc.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(bodyLines.join('\n'));

          // 先在页面上显示可点击的链接 + 可复制的内容（保底）
          const mailtoLink = document.getElementById('qf-mailto-link');
          const mailBody = document.getElementById('qf-mail-body');
          const mailtoActions = document.getElementById('qf-mailto-actions');
          const copyBtn = document.getElementById('qf-copy-btn');
          if (mailtoLink) mailtoLink.href = mailto;
          if (mailBody) mailBody.value = bodyLines.join('\n');
          if (mailtoActions) mailtoActions.style.display = 'block';
          if (copyBtn) {
            copyBtn.onclick = function() {
              if (!mailBody) return;
              mailBody.select();
              document.execCommand('copy');
              const original = copyBtn.textContent;
              copyBtn.textContent = texts.copied;
              setTimeout(function() { copyBtn.textContent = original; }, 2000);
            };
          }

          // 再尝试自动打开邮件客户端（延迟 200ms，避免中断上面 DOM 更新）
          setTimeout(function() {
            window.location.href = mailto;
          }, 200);

          showResult(isZh
            ? '已为您生成邮件草稿，请确认邮件内容并附上图纸后发送。'
            : 'An email draft has been prepared for you. Please review, attach your drawings, and send.', false, true);
        }

        fetch(API_BASE + '/api/quote', { method: 'POST', body: fd })
          .then(async r => {
            const j = await r.json().catch(() => ({}));
            if (r.ok && j.ok) {
              showResult(isZh ? '已收到您的询盘与图纸，我们将在 24 小时内回复。' : 'Quote request and drawings received — we will reply within 24 hours.', false);
              form.reset();
              if (fileList) fileList.innerHTML = '';
              uploadedFiles.length = 0;
            } else if (!r.ok) {
              // 后端接口未部署或返回错误 → 降级 mailto
              fallbackToMailto();
            } else {
              showResult(isZh ? ('提交失败：' + (j.error || '请稍后重试，或直接发邮件到 sales@eternalcnc.com')) : ('Submission failed: ' + (j.error || 'Please retry later or email sales@eternalcnc.com directly.')), true);
            }
          })
          .catch(() => {
            // 网络错误（后端不存在）→ 降级 mailto
            fallbackToMailto();
          })
          .finally(() => setSubmitting(false));
      });
    }

    updateUI();
  })();
</script>
