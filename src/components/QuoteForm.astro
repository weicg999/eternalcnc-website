    tolerance_label: '公差（选填）',
    tolerance_ph: '如：±0.01 mm',
    // --- Step 3 ---
    title3: '您的联系方式',
    subtitle3: '我们将把报价发送给您',
    contact_name: '姓名',
    contact_company: '公司',
    contact_email: '邮箱',
    contact_phone: '电话',
    contact_notes: '补充说明',
    name_placeholder: '张三',
    company_placeholder: '您的公司名称',
    email_placeholder: 'example@company.com',
    phone_placeholder: '138 0000 0000',
    notes_placeholder: '收货地址、特殊要求……',
    success: '您的询盘已收到，我们将在 24 小时内回复。',
    // --- Navigation ---
    back: '← 上一步',
    next: '下一步 →',
    submit: '提交报价请求',
    open_email: '打开邮件客户端',
