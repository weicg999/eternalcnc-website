    <div class="container-custom py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <img src="/images/logo/logo-full.png" alt="Eternal CNC" class="h-6 w-auto" />
        <p class="text-xs" style="color: var(--text-muted);">
          &copy; {currentYear} {isZh ? '鑫永恒（深圳）精密实业有限公司' : 'Eternal CNC'}. {isZh ? '版权所有.' : 'All rights reserved.'}
