---
/**
 * v7 Footer - Light industrial style with three layers
 * Updated: email moved to right column, sales@eternalcnc.com, all hover effects
 */
const currentYear = '2024-2026';
const currentPath = Astro.url.pathname;
const isZh = currentPath.startsWith('/zh');
---

<footer style="background-color: var(--footer-bg);">
  <!-- Layer 1: Quick Contact Bar -->
  <div class="border-b" style="border-color: var(--border-color);">
    <div class="container-custom py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href={isZh ? '/zh/contact/get-a-quote' : '/contact/get-a-quote'} class="flex items-center gap-3 p-3 rounded-lg hover:bg-white transition-all duration-300 group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <div class="text-sm font-medium transition-all duration-300 group-hover:text-[#8B0000]" style="color: var(--brand-dark);">{isZh ? '产品咨询' : 'Product Inquiry'}</div>
            <div class="text-xs" style="color: var(--text-muted);">{isZh ? '技术选型与报价' : 'Technical advice & quotes'}</div>
          </div>
        </a>
        <a href="mailto:sales@eternalcnc.com" class="flex items-center gap-3 p-3 rounded-lg hover:bg-white transition-all duration-300 group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <div class="text-sm font-medium transition-all duration-300 group-hover:text-[#8B0000]" style="color: var(--brand-dark);">{isZh ? '销售对接' : 'Sales Contact'}</div>
            <div class="text-xs" style="color: var(--text-muted);">sales@eternalcnc.com</div>
          </div>
        </a>
        <a href={isZh ? '/zh/contact/get-a-quote' : '/contact/get-a-quote'} class="flex items-center gap-3 p-3 rounded-lg hover:bg-white transition-all duration-300 group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.26-.904 2.95l-.102.085"/></svg>
          </div>
          <div>
            <div class="text-sm font-medium transition-all duration-300 group-hover:text-[#8B0000]" style="color: var(--brand-dark);">{isZh ? '售后支持' : 'After-Sales'}</div>
            <div class="text-xs" style="color: var(--text-muted);">{isZh ? '技术支持与服务' : 'Technical support'}</div>
          </div>
        </a>
        <a href={isZh ? '/zh/knowledge/' : '/knowledge/'} class="flex items-center gap-3 p-3 rounded-lg hover:bg-white transition-all duration-300 group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.253 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.246 18 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </div>
          <div>
            <div class="text-sm font-medium transition-all duration-300 group-hover:text-[#8B0000]" style="color: var(--brand-dark);">{isZh ? '知识库' : 'Knowledge Base'}</div>
            <div class="text-xs" style="color: var(--text-muted);">{isZh ? '技术指南与行业洞察' : 'Guides & industry insights'}</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Layer 2: Three Column Layout -->
  <div class="container-custom py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-8">
      
      <!-- Column 1: Products -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-5" style="color: var(--brand-dark); font-family: Inter, system-ui, sans-serif;">
          {isZh ? '产品' : 'Products'}
        </h4>
        <ul class="space-y-3">
          {(isZh ? [
            { label: 'CNC 精密加工', href: '/zh/services/cnc-machining' },
            { label: '数控车削', href: '/zh/services/cnc-turning' },
            { label: '精密磨削', href: '/zh/services/precision-grinding' },
            { label: '线切割 (EDM)', href: '/zh/services/wire-edm' },
            { label: '质量检测', href: '/zh/services/quality-inspection' },
          ] : [
            { label: 'CNC Machining', href: '/services/cnc-machining' },
            { label: 'CNC Turning', href: '/services/cnc-turning' },
            { label: 'Precision Grinding', href: '/services/precision-grinding' },
            { label: 'Wire EDM', href: '/services/wire-edm' },
            { label: 'Quality Inspection', href: '/services/quality-inspection' },
          ]).map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 inline-block transition-all duration-300 hover:text-[#8B0000] hover:translate-x-0.5">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Company -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-5" style="color: var(--brand-dark); font-family: Inter, system-ui, sans-serif;">
          {isZh ? '公司' : 'Company'}
        </h4>
        <ul class="space-y-3">
          {(isZh ? [
            { label: '关于我们', href: '/zh/about' },
            { label: '联系我们', href: '/zh/contact/get-a-quote' },
          ] : [
            { label: 'About Us', href: '/about' },
            { label: 'Contact Us', href: '/contact/get-a-quote' },
          ]).map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 inline-block transition-all duration-300 hover:text-[#8B0000] hover:translate-x-0.5">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Social + Email + Company -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-5" style="color: var(--brand-dark); font-family: Inter, system-ui, sans-serif;">
          {isZh ? '社交媒体' : 'Social'}
        </h4>
        <div class="flex items-center gap-4">
          {isZh ? (
            <!-- WeChat -->
            <a href="tel:+8618123983352" class="w-10 h-10 rounded-full flex items-center justify-center bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5" aria-label="微信">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.914 6.109.853 2.62 3.297 4.222 6.146 4.222.826 0 1.622-.12 2.361-.336a.722.722 0 01.598.082l1.584.926a.272.272 0 00.14.045c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.49.49 0 01.177-.554C23.016 18.115 24 16.405 24 14.479c0-3.197-3.098-5.621-7.062-5.621zm-2.36 2.63c.535 0 .969.44.969.982a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.542.434-.982.97-.982zm4.72 0c.535 0 .969.44.969.982a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.542.434-.982.97-.982z"/></svg>
            </a>
