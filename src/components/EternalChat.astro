      submit: 'Submit',
      success: "Received, we'll contact you within 1 business day",
    };
  }

  // typing 提示文字
  function getTypingText() {
    return isChineseLang() ? '工程师正在输入...' : 'Engineer is typing...';
  }

  // ========== 访客信息收集 ==========
  function getVisitorInfo() {
    try {
      const pageCat = getPageCategory();
      return {
        language: navigator.language || 'en',
        referrer: document.referrer || '',
        current_page: location.pathname + location.search,
        page_category: pageCat ? pageCat.label : '',
        page_category_en: pageCat ? pageCat.labelEn : '',
        user_agent: navigator.userAgent || '',
        screen_size: (window.screen ? window.screen.width + 'x' + window.screen.height : ''),
      };
    } catch (e) {
      return { language: 'en', referrer: '', current_page: '', page_category: '', page_category_en: '' };
    }
  }

  // 生成唯一ID
  function generateId(prefix) {
    return prefix + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 9);
  }

  // 获取或创建 user_id
  function getUserId() {
    let userId = localStorage.getItem(STORAGE_USER_ID);
    if (!userId) {
      userId = generateId('user');
      localStorage.setItem(STORAGE_USER_ID, userId);
    }
    return userId;
  }

  // 获取或创建 conversation_id
  function getConversationId() {
    let convId = localStorage.getItem(STORAGE_CONVERSATION_ID);
    if (!convId) {
      convId = generateId('conv');
      localStorage.setItem(STORAGE_CONVERSATION_ID, convId);
    }
    return convId;
  }

  // 保存会话历史
  function saveMessages(messages) {
    try {
      localStorage.setItem(STORAGE_MESSAGES, JSON.stringify(messages));
    } catch (e) {
      console.warn('Failed to save chat messages:', e);
    }
  }

  // 加载会话历史
  function loadMessages() {
    try {
      const raw = localStorage.getItem(STORAGE_MESSAGES);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  // 主动触发计数
  function getProactiveCount() {
    try {
      return parseInt(localStorage.getItem(STORAGE_PROACTIVE_COUNT) || '0', 10);
    } catch (e) {
      return 0;
    }
  }

  function incrementProactiveCount() {
    try {
      const count = getProactiveCount() + 1;
      localStorage.setItem(STORAGE_PROACTIVE_COUNT, String(count));
      return count;
    } catch (e) {
      return 0;
    }
  }

  function hasOpenedPanel() {
    try {
      return localStorage.getItem(STORAGE_PANEL_OPENED) === '1';
    } catch (e) {
      return false;
    }
  }

  function markPanelOpened() {
    try {
      localStorage.setItem(STORAGE_PANEL_OPENED, '1');
    } catch (e) {}
  }

  // ========== DOM 元素 ==========
  const widget = document.getElementById('eternal-chat-widget');
  const toggleBtn = document.getElementById('eternal-chat-toggle-btn');
  const closeBtn = document.getElementById('eternal-chat-close-btn');
  const panel = document.getElementById('eternal-chat-panel');
  const messagesEl = document.getElementById('eternal-chat-messages');
  const inputEl = document.getElementById('eternal-chat-input');
  const sendBtn = document.getElementById('eternal-chat-send-btn');
  const titleEl = document.getElementById('eternal-chat-title');
  const statusEl = document.getElementById('eternal-chat-status');
  const proactiveBubble = document.getElementById('eternal-chat-proactive-bubble');
  const proactiveText = document.getElementById('eternal-chat-proactive-text');
  const faqContainer = document.getElementById('eternal-chat-faq');
  const minimizeBtn = document.getElementById('eternal-chat-minimize-btn');
  const humanBtn = document.getElementById('eternal-chat-human-btn');
  const unreadDot = document.getElementById('eternal-chat-unread-dot');

  if (!widget || !panel) return;

  // 状态
  let messages = loadMessages();
  let isStreaming = false;
  let currentBotMsgEl = null;
  let currentBotBubbleEl = null;
  let abortController = null;
  let isFirstMessage = messages.length === 0; // 是否是第一条用户消息
  let proactiveBubbleTimer = null;

  // 已触发的类型集合（内存级，单页面生命周期内不重复）
  const triggeredTypes = {};

  // 设置输入框占位符
  inputEl.placeholder = getPlaceholderText();

  // 标题语言
  const zh = isChineseLang();
  titleEl.textContent = zh ? 'AI 项目工程师' : 'AI Project Engineer';
  statusEl.textContent = zh ? '在线 · 通常几分钟内回复' : 'Online · Usually replies in minutes';

  // ========== 消息渲染 ==========
  function scrollToBottom() {
    try {
      messagesEl.scrollTop = messagesEl.scrollHeight;
    } catch (e) {}
  }

  // 创建头像 SVG 图标
  // 创建头像
  function createAvatarEl(role) {
    if (role === 'bot') {
      var img = document.createElement('img');
      img.src = '/images/bot-avatar.jpg';
      img.alt = '客服';
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;';
      return img;
    } else {
      var svgNS = 'http://www.w3.org/2000/svg';
      var svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('width', '20');
      svg.setAttribute('height', '20');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'white');
      svg.setAttribute('stroke-width', '2');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      var path1 = document.createElementNS(svgNS, 'path');
      path1.setAttribute('d', 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2');
      svg.appendChild(path1);
      var circle = document.createElementNS(svgNS, 'circle');
      circle.setAttribute('cx', '12');
      circle.setAttribute('cy', '7');
      circle.setAttribute('r', '4');
      svg.appendChild(circle);
      return svg;
    }
  }

  function createMessageEl(role, content) {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'chat-msg ' + role;

    // 头像
    const avatar = document.createElement('div');
    avatar.className = 'chat-avatar';
    avatar.appendChild(createAvatarEl(role));

    // 气泡
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';
    bubble.textContent = content;

    msgDiv.appendChild(avatar);
    msgDiv.appendChild(bubble);
    return { msgDiv, bubble };
  }

  function createTypingEl() {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'chat-msg bot';

    // 头像
    const avatar = document.createElement('div');
    avatar.className = 'chat-avatar';
    avatar.appendChild(createAvatarEl('bot'));

    // 气泡
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';

    const dots = document.createElement('div');
    dots.className = 'typing-dots';
    dots.style.display = 'inline-flex';
    dots.style.verticalAlign = 'middle';
    dots.innerHTML = '<span></span><span></span><span></span>';

    const typingText = document.createElement('span');
    typingText.className = 'typing-text';
    typingText.textContent = getTypingText();

    bubble.appendChild(dots);
    bubble.appendChild(typingText);
    msgDiv.appendChild(avatar);
    msgDiv.appendChild(bubble);
    return { msgDiv, bubble };
