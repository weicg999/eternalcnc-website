  // ========== FAQ 快捷按钮 ==========
  function renderFaqButtons() {
    if (!faqContainer) return;
    // 只有消息列表里只有1条欢迎语时才显示
    const shouldShow = messages.length <= 1;
    if (!shouldShow) {
      faqContainer.style.display = 'none';
      return;
    }
    const faqs = getFaqQuestions();
    const inner = faqContainer.querySelector('.flex');
    inner.innerHTML = '';
    for (let i = 0; i < faqs.length; i++) {
      (function(q) {
        const btn = document.createElement('button');
        btn.className = 'faq-btn';
        btn.type = 'button';
        btn.textContent = q;
        btn.addEventListener('click', function() {
          // 直接发送这个问题
          inputEl.value = q;
          sendMessage();
        });
        inner.appendChild(btn);
      })(faqs[i]);
    }
    faqContainer.style.display = 'block';
  }

  function hideFaqButtons() {
    if (faqContainer) {
      faqContainer.style.display = 'none';
    }
  }

  function renderExistingMessages() {
    messagesEl.innerHTML = '';
    messages.forEach(function(msg) {
      const { msgDiv } = createMessageEl(msg.role, msg.content);
      messagesEl.appendChild(msgDiv);
    });
    renderFaqButtons();
    scrollToBottom();
  }

  // ========== 主动提示气泡 ==========
  function showProactiveBubble(message, triggerType) {
    // 检查：已打开过面板 → 不触发
    if (hasOpenedPanel()) return false;
    // 检查：超过最大触发次数 → 不触发
    if (getProactiveCount() >= PROACTIVE_CONFIG.maxTriggers) return false;
    // 检查：该类型已触发过 → 不触发
    if (triggeredTypes[triggerType]) return false;
    // 检查：气泡当前正在显示 → 不重复显示
    if (proactiveBubble.classList.contains('show')) return false;

    try {
      triggeredTypes[triggerType] = true;
      incrementProactiveCount();

      proactiveText.textContent = message;
      proactiveBubble.classList.add('show');

      // 3秒后自动消失
      if (proactiveBubbleTimer) {
        clearTimeout(proactiveBubbleTimer);
      }
      proactiveBubbleTimer = setTimeout(function() {
        hideProactiveBubble();
      }, PROACTIVE_CONFIG.bubbleDuration);

      return true;
    } catch (e) {
      console.warn('showProactiveBubble error:', e);
      return false;
    }
  }

  function hideProactiveBubble() {
    try {
      proactiveBubble.classList.remove('show');
      if (proactiveBubbleTimer) {
        clearTimeout(proactiveBubbleTimer);
        proactiveBubbleTimer = null;
      }
    } catch (e) {}
  }

  // 点击气泡 → 打开聊天面板
  proactiveBubble.addEventListener('click', function() {
    hideProactiveBubble();
    toggleChatPanel(true);
  });

  // ========== 转人工表单 ==========
  function showHumanForm() {
    if (isStreaming) return;

    const texts = getHumanFormTexts();

    // 检查是否已提交过
    try {
      if (localStorage.getItem(STORAGE_HUMAN_FORM_SUBMITTED) === '1') {
        const successMsg = texts.success;
        messages.push({ role: 'bot', content: successMsg });
        saveMessages(messages);
        const { msgDiv } = createMessageEl('bot', successMsg);
        messagesEl.appendChild(msgDiv);
        hideFaqButtons();
        scrollToBottom();
        return;
      }
    } catch (e) {}

    // 以 bot 消息形式插入表单
    const msgDiv = document.createElement('div');
    msgDiv.className = 'chat-msg bot';

    const avatar = document.createElement('div');
    avatar.className = 'chat-avatar';
    avatar.appendChild(createAvatarEl('bot'));

    const formBubble = document.createElement('div');
    formBubble.className = 'human-form-bubble';

    const titleEl = document.createElement('h4');
    titleEl.textContent = texts.title;
    formBubble.appendChild(titleEl);

    // 邮箱字段
    const emailField = document.createElement('div');
    emailField.className = 'form-field';
    const emailLabel = document.createElement('label');
    emailLabel.textContent = texts.emailLabel;
    const emailInput = document.createElement('input');
    emailInput.type = 'email';
    emailInput.placeholder = texts.emailPlaceholder;
    emailField.appendChild(emailLabel);
    emailField.appendChild(emailInput);
    formBubble.appendChild(emailField);

    // 描述字段
    const descField = document.createElement('div');
    descField.className = 'form-field';
    const descLabel = document.createElement('label');
    descLabel.textContent = texts.descLabel;
    const descTextarea = document.createElement('textarea');
    descTextarea.rows = 3;
    descTextarea.placeholder = texts.descPlaceholder;
    descField.appendChild(descLabel);
    descField.appendChild(descTextarea);
    formBubble.appendChild(descField);

    // 提交按钮
    const submitBtn = document.createElement('button');
    submitBtn.className = 'submit-btn';
    submitBtn.type = 'button';
    submitBtn.textContent = texts.submit;
    formBubble.appendChild(submitBtn);

    msgDiv.appendChild(avatar);
    msgDiv.appendChild(formBubble);
    messagesEl.appendChild(msgDiv);
    hideFaqButtons();
    scrollToBottom();

    submitBtn.addEventListener('click', function() {
      var email = emailInput.value.trim();
      var desc = descTextarea.value.trim();
      if (!email) {
        emailInput.focus();
        return;
      }
      if (!desc) {
        descTextarea.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = texts.submit + '...';

      const userId = getUserId();
      const conversationId = getConversationId();
      const visitorInfo = getVisitorInfo();

      fetch(HUMAN_LEAD_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email,
          description: desc,
          user_id: userId,
          conversation_id: conversationId,
          visitor_info: visitorInfo,
        }),
      }).then(function() {
        // 无论成功还是404，都显示成功状态
        showHumanFormSuccess(formBubble, texts.success);
        try {
          localStorage.setItem(STORAGE_HUMAN_FORM_SUBMITTED, '1');
        } catch (e) {}
        messages.push({ role: 'bot', content: texts.success });
        saveMessages(messages);
      }).catch(function() {
        // 出错也显示成功状态（按需求）
        showHumanFormSuccess(formBubble, texts.success);
        try {
          localStorage.setItem(STORAGE_HUMAN_FORM_SUBMITTED, '1');
        } catch (e) {}
        messages.push({ role: 'bot', content: texts.success });
        saveMessages(messages);
      });
    });
  }

  function showHumanFormSuccess(formBubble, successText) {
    formBubble.innerHTML = '';
    var successDiv = document.createElement('div');
    successDiv.className = 'human-form-success';
    successDiv.textContent = successText;
    formBubble.appendChild(successDiv);
  }

  // ========== 发送消息 ==========
  function sendMessage() {
    if (isStreaming) return;

    const text = inputEl.value.trim();
    if (!text) return;

    inputEl.value = '';
    inputEl.focus();

    // 添加用户消息
    messages.push({ role: 'user', content: text });
    saveMessages(messages);

    const { msgDiv: userMsgEl } = createMessageEl('user', text);
    messagesEl.appendChild(userMsgEl);
    hideFaqButtons();
    scrollToBottom();

    // 显示加载动画
    const { msgDiv: typingEl, bubble: typingBubble } = createTypingEl();
    messagesEl.appendChild(typingEl);
    scrollToBottom();

    isStreaming = true;
    sendBtn.disabled = true;

    const userId = getUserId();
    const conversationId = getConversationId();

    abortController = new AbortController();

    // 构建请求体
    const requestBody = {
      message: text,
      user_id: userId,
      conversation_id: conversationId,
    };

    // 第一条消息附带访客信息和页面上下文
    if (isFirstMessage) {
      requestBody.visitor_info = getVisitorInfo();
      requestBody.is_first_message = true;
    }

    // 调用API
    fetch(API_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(requestBody),
      signal: abortController.signal
    }).then(function(response) {
      if (!response.ok) {
        throw new Error('HTTP ' + response.status);
      }

      // 移除loading，创建bot消息气泡
      typingEl.remove();

      const { msgDiv: botMsgEl, bubble: botBubble } = createMessageEl('bot', '');
      botBubble.classList.add('streaming');
      messagesEl.appendChild(botMsgEl);
      currentBotMsgEl = botMsgEl;
      currentBotBubbleEl = botBubble;

      // 处理流式响应
      const reader = response.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let buffer = '';
      let fullContent = '';

      function readStream() {
        return reader.read().then(function(result) {
          if (result.done) {
            finishStreaming(fullContent);
            return;
          }

          buffer += decoder.decode(result.value, { stream: true });

          // 解析SSE事件（按行分割）
          const lines = buffer.split('\n');
          buffer = lines.pop() || ''; // 保留不完整的行

          for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (!line) continue;
            if (line.startsWith('data:')) {
              const dataStr = line.slice(5).trim();
              if (dataStr === '[DONE]') {
                finishStreaming(fullContent);
                return;
              }
              try {
                const data = JSON.parse(dataStr);
                // v2格式: { event: 'message', message: { content: '...' } }
                // v3格式: { event_type: 'conversation.message.delta', data: { content: '...' } }
                let delta = '';
                if (data.event === 'message' && data.message && data.message.content) {
                  delta = data.message.content;
                } else if (data.event_type === 'conversation.message.delta' && data.data && data.data.content) {
                  delta = data.data.content;
                } else if (data.event === 'done' || data.event_type === 'conversation.chat.completed') {
                  continue;
                }
                if (delta) {
                  fullContent += delta;
                  currentBotBubbleEl.textContent = fullContent;
                  scrollToBottom();
                }
              } catch (e) {
                // 忽略解析错误
              }
            }
          }

          return readStream();
        });
      }

      return readStream();

    }).catch(function(err) {
      if (err.name === 'AbortError') return;

      // 移除loading，显示错误
      if (typingEl.parentNode) {
        typingEl.remove();
      }
      const errorMsg = zh ? '抱歉，服务暂时不可用，请稍后再试。' : 'Sorry, service is temporarily unavailable. Please try again later.';
      const { msgDiv: errMsgEl } = createMessageEl('bot', errorMsg);
      messagesEl.appendChild(errMsgEl);
      messages.push({ role: 'bot', content: errorMsg });
      saveMessages(messages);
      scrollToBottom();

      isStreaming = false;
      sendBtn.disabled = false;
    });

    function finishStreaming(content) {
      if (currentBotBubbleEl) {
        currentBotBubbleEl.classList.remove('streaming');
      }
      if (content) {
        messages.push({ role: 'bot', content: content });
        saveMessages(messages);
      }
      isStreaming = false;
      sendBtn.disabled = false;
      currentBotMsgEl = null;
      currentBotBubbleEl = null;
      abortController = null;
      // 第一条消息发送完成，标记为非首次
      isFirstMessage = false;
      updateUnreadDot();
    }
  }

  // ========== 未读/对话中状态指示 ==========
  function updateUnreadDot() {
    if (!unreadDot) return;
    // 有对话进行中（消息数 > 1）且面板关闭时显示
    const isPanelOpen = panel.style.display === 'flex';
    const hasConversation = messages.length > 1;
    if (!isPanelOpen && hasConversation) {
      unreadDot.style.display = 'block';
    } else {
      unreadDot.style.display = 'none';
    }
  }

  // ========== 聊天面板开关 ==========
  function toggleChatPanel(forceOpen) {
    const isHidden = panel.style.display === 'none' || panel.style.display === '';
    const shouldOpen = forceOpen === true ? true : (forceOpen === false ? false : isHidden);

    if (shouldOpen) {
      panel.style.display = 'flex';
      markPanelOpened();
      hideProactiveBubble();

      // 首次展开：如果没有消息，发送欢迎语
      if (messages.length === 0) {
        const welcome = getWelcomeMessage();
        messages.push({ role: 'bot', content: welcome });
        saveMessages(messages);
        renderExistingMessages();
      } else {
        renderExistingMessages();
      }
      // 延迟聚焦输入框
      setTimeout(function() { inputEl.focus(); }, 100);
    } else {
      panel.style.display = 'none';
      if (isStreaming && abortController) {
        abortController.abort();
      }
    }
    updateUnreadDot();
  }

  // ========== 最小化 ==========
  function minimizeChatPanel() {
    // 最小化 = 关闭面板但保留对话状态
    panel.style.display = 'none';
    if (isStreaming && abortController) {
      abortController.abort();
    }
    updateUnreadDot();
  }

  // ========== 事件绑定 ==========
  toggleBtn.addEventListener('click', function() {
    toggleChatPanel();
  });

  closeBtn.addEventListener('click', function() {
    toggleChatPanel(false);
  });

  if (minimizeBtn) {
    minimizeBtn.addEventListener('click', function() {
      minimizeChatPanel();
    });
  }

  if (humanBtn) {
    humanBtn.addEventListener('click', function() {
      // 先打开面板（如果没打开）
      if (panel.style.display !== 'flex') {
        toggleChatPanel(true);
      }
      showHumanForm();
    });
  }

  sendBtn.addEventListener('click', sendMessage);

  inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  // ========== 行为触发逻辑 ==========

  // 1. 停留30秒触发
  try {
    setTimeout(function() {
      const msg = getProactiveMessage('stay');
      showProactiveBubble(msg, 'stay');
    }, PROACTIVE_CONFIG.stayDuration);
  } catch (e) {}

  // 2. 滚动到底部触发
  try {
    let bottomTriggered = false;
    function handleScroll() {
      if (bottomTriggered) return;
      if (hasOpenedPanel()) {
        window.removeEventListener('scroll', handleScroll);
        return;
      }
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const distanceToBottom = docHeight - scrollTop - windowHeight;

      if (distanceToBottom <= PROACTIVE_CONFIG.bottomThreshold) {
        bottomTriggered = true;
        const msg = getProactiveMessage('bottom');
        showProactiveBubble(msg, 'bottom');
        window.removeEventListener('scroll', handleScroll);
      }
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
  } catch (e) {}

  // 3. 鼠标离开顶部（即将关闭标签）触发
  try {
    function handleMouseLeave(e) {
      if (hasOpenedPanel()) {
        document.removeEventListener('mouseleave', handleMouseLeave);
        return;
      }
      // 只检测从顶部离开（鼠标移向浏览器标签关闭区域）
      if (e.clientY <= PROACTIVE_CONFIG.mouseleaveTopThreshold) {
        const msg = getProactiveMessage('exit');
        const shown = showProactiveBubble(msg, 'exit');
        if (shown) {
          // exit 类型只触发一次
          document.removeEventListener('mouseleave', handleMouseLeave);
        }
      }
    }
    document.addEventListener('mouseleave', handleMouseLeave);
  } catch (e) {}

  // 初始化渲染（如果有历史消息）
  if (messages.length > 0) {
    // 不立即渲染，等展开时再渲染
    isFirstMessage = false; // 有历史消息说明不是首次对话
    updateUnreadDot();
  }

})();
</script>
