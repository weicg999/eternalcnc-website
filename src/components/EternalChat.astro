---
// EternalChat - API 版智能客服组件（第二层优化）
// 功能：
// 1. 页面上下文感知 - 根据当前页面动态调整开场白
// 2. 访客信息预收集 - 语言/来源/当前页自动传给Bot
// 3. 行为触发 - 30秒停留/滚动到底部/鼠标离开顶部 主动提示
// 设计风格：简约大气，对话式布局，左右气泡错开，带头像
---

<div id="eternal-chat-widget" class="fixed bottom-6 right-6 z-50">
  <!-- 主动提示气泡 -->
  <div
    id="eternal-chat-proactive-bubble"
    class="proactive-bubble"
    role="button"
    aria-label="Open chat"
  >
    <span id="eternal-chat-proactive-text"></span>
  </div>

  <!-- 悬浮按钮 -->
  <button
    id="eternal-chat-toggle-btn"
    class="w-14 h-14 text-white flex items-center justify-center transition-all duration-300 hover:scale-105"
    style="background-color: var(--brand-red, #8B0000); border-radius: 50%; box-shadow: 0 4px 20px rgba(139, 0, 0, 0.3);"
    aria-label="Open AI Chat"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
    <span id="eternal-chat-unread-dot" class="absolute top-0 right-0 w-3 h-3 bg-green-400 rounded-full border-2" style="border-color: var(--brand-red, #8B0000); display: none;"></span>
  </button>

  <!-- 聊天面板 -->
  <div
    id="eternal-chat-panel"
    class="bg-white overflow-hidden flex flex-col"
    style="width: 380px; height: 520px; max-height: calc(100vh - 120px); display: none; position: fixed; bottom: 88px; right: 24px; z-index: 100; border-radius: 16px; box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);"
  >
    <!-- 头部 -->
    <div class="text-white p-4 flex items-center gap-3 flex-shrink-0" style="background: linear-gradient(135deg, var(--brand-red, #8B0000) 0%, var(--brand-red-hover, #6B0000) 100%); border-radius: 16px 16px 0 0;">
      <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <h4 class="font-semibold text-base" id="eternal-chat-title">AI 项目工程师</h4>
        <p class="text-xs text-white/70 flex items-center gap-1.5">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          <span id="eternal-chat-status">在线 · 通常几分钟内回复</span>
        </p>
      </div>
      <div class="flex items-center gap-1">
        <button id="eternal-chat-minimize-btn" class="text-white/70 hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10" aria-label="Minimize chat">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
          </svg>
        </button>
        <button id="eternal-chat-human-btn" class="text-white/70 hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10" aria-label="Talk to human">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 18v-6a9 9 0 0118 0v6" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z" />
          </svg>
        </button>
        <button id="eternal-chat-close-btn" class="text-white/70 hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10" aria-label="Close chat">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 消息区域 -->
    <div
      id="eternal-chat-messages"
      class="flex-1 overflow-y-auto px-4 py-4 space-y-4"
      style="background-color: var(--warm-white, #F4F3EE);"
    >
      <!-- 消息动态插入 -->
    </div>

    <!-- 快捷FAQ区域 -->
    <div id="eternal-chat-faq" class="px-3 pb-2 flex-shrink-0" style="display: none;">
      <div class="flex flex-wrap gap-2 justify-center">
      </div>
    </div>

    <!-- 输入区域 -->
    <div class="p-3 border-t border-gray-100 bg-white flex-shrink-0" style="border-radius: 0 0 16px 16px;">
      <div class="flex items-center gap-2 bg-gray-50 rounded-full px-4 py-2 border border-gray-100 focus-within:border-gray-300 focus-within:bg-white transition-all">
        <input
          id="eternal-chat-input"
          type="text"
          placeholder="请输入您的问题..."
          class="flex-1 text-sm bg-transparent focus:outline-none"
          autocomplete="off"
        />
        <button
          id="eternal-chat-send-btn"
          class="w-8 h-8 text-white flex items-center justify-center transition-all flex-shrink-0 rounded-full hover:scale-105"
          style="background-color: var(--brand-red, #8B0000);"
          aria-label="Send"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ========== 主动提示气泡 ========== */
  #eternal-chat-widget .proactive-bubble {
    position: absolute;
    right: 70px;
    bottom: 6px;
    max-width: 240px;
    padding: 10px 14px;
    background-color: #fff;
    color: #1A202C;
    font-size: 13px;
    line-height: 1.5;
    border-radius: 14px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
    pointer-events: none;
    z-index: 10;
  }

  #eternal-chat-widget .proactive-bubble.show {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  #eternal-chat-widget .proactive-bubble::after {
    content: '';
    position: absolute;
    right: -6px;
    bottom: 14px;
    width: 12px;
    height: 12px;
    background-color: #fff;
    transform: rotate(45deg);
    border-radius: 2px;
    box-shadow: 2px -2px 4px rgba(0, 0, 0, 0.04);
  }

  #eternal-chat-widget .proactive-bubble:hover {
    transform: translateX(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
  }

  /* ========== 消息气泡基础样式 ========== */
  #eternal-chat-widget .chat-msg {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    word-break: break-word;
    white-space: pre-wrap;
    animation: msgFadeIn 0.25s ease-out;
  }

  @keyframes msgFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 用户消息：右侧，头像在右 */
  #eternal-chat-widget .chat-msg.user {
    justify-content: flex-end;
    margin-left: auto;
    flex-direction: row;
    gap: 6px;
  }
  #eternal-chat-widget .chat-msg.user .chat-avatar {
    order: 2;
  }

  /* Bot消息：左侧，头像在左 */
  #eternal-chat-widget .chat-msg.bot {
    justify-content: flex-start;
    margin-right: auto;
    gap: 6px;
  }

  /* 头像 */
  #eternal-chat-widget .chat-avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    flex-grow: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #eternal-chat-widget .chat-avatar img {
    width: 100% !important;
    height: 100% !important;
    min-width: 100% !important;
    min-height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }
  #eternal-chat-widget .chat-msg.user .chat-avatar {
    background: linear-gradient(135deg, var(--brand-red, #8B0000), var(--brand-red-hover, #6B0000));
  }
  #eternal-chat-widget .chat-msg.bot .chat-avatar {
    background: linear-gradient(135deg, #4A5568, #2D3748);
  }
  #eternal-chat-widget .chat-avatar svg {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    flex-shrink: 0;
  }

  /* 气泡 - 微信风格 */
  #eternal-chat-widget .chat-bubble {
    max-width: 78%;
    padding: 10px 14px;
    font-size: 14px;
    line-height: 1.65;
    border-radius: 6px;
    position: relative;
    word-break: break-word;
  }
  #eternal-chat-widget .chat-msg.user .chat-bubble {
    background-color: var(--brand-red, #8B0000);
    color: #fff;
    order: 1;
  }
  /* 用户气泡尾巴 - 指向右边头像 */
  #eternal-chat-widget .chat-msg.user .chat-bubble::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 12px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 6px solid var(--brand-red, #8B0000);
  }
  #eternal-chat-widget .chat-msg.bot .chat-bubble {
    background-color: #F5F5F5;
    color: #1A1A1A;
  }
  /* Bot气泡尾巴 - 指向左边头像 */
  #eternal-chat-widget .chat-msg.bot .chat-bubble::after {
    content: '';
    position: absolute;
    left: -6px;
    top: 12px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 6px solid #F5F5F5;
  }

  /* 加载动画：三个点 */
  #eternal-chat-widget .typing-dots {
    display: inline-flex;
    gap: 4px;
    padding: 2px 4px;
  }
  #eternal-chat-widget .typing-dots span {
    width: 6px;
    height: 6px;
    background-color: #A0AEC0;
    border-radius: 50%;
    animation: eternal-chat-bounce 1.4s infinite ease-in-out both;
  }
  #eternal-chat-widget .typing-dots span:nth-child(1) { animation-delay: -0.32s; }
  #eternal-chat-widget .typing-dots span:nth-child(2) { animation-delay: -0.16s; }
  @keyframes eternal-chat-bounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* 滚动条样式 */
  #eternal-chat-messages::-webkit-scrollbar {
    width: 4px;
  }
  #eternal-chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #eternal-chat-messages::-webkit-scrollbar-thumb {
    background: #CBD5E0;
    border-radius: 2px;
  }
  #eternal-chat-messages::-webkit-scrollbar-thumb:hover {
    background: #A0AEC0;
  }

  /* 光标闪烁（流式输出时） */
  #eternal-chat-widget .chat-bubble.streaming::after {
    content: '▍';
    display: inline-block;
    margin-left: 1px;
    animation: eternal-chat-cursor 1s infinite;
    font-weight: 300;
    opacity: 0.5;
    font-size: 0.9em;
  }
  @keyframes eternal-chat-cursor {
    0%, 50% { opacity: 0.5; }
    51%, 100% { opacity: 0; }
  }

  /* ========== 快捷FAQ按钮 ========== */
  #eternal-chat-widget .faq-btn {
    padding: 6px 14px;
    font-size: 12px;
    background-color: #EDF2F7;
    color: #4A5568;
    border: 1px solid #E2E8F0;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  #eternal-chat-widget .faq-btn:hover {
    background-color: #CBD5E0;
    color: #2D3748;
    border-color: #A0AEC0;
  }

  /* ========== 正在输入文字提示 ========== */
  #eternal-chat-widget .typing-text {
    font-size: 12px;
    color: #A0AEC0;
    margin-left: 6px;
    vertical-align: middle;
  }

  /* ========== 转人工表单 ========== */
  #eternal-chat-widget .human-form-bubble {
    max-width: 85%;
    padding: 14px;
    background-color: #FFFFFF;
    color: #1A202C;
    border: 1px solid #E2E8F0;
    border-bottom-left-radius: 6px;
    border-radius: 18px;
    border-bottom-left-radius: 6px;
    font-size: 13px;
    line-height: 1.5;
  }
  #eternal-chat-widget .human-form-bubble h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #1A202C;
  }
  #eternal-chat-widget .human-form-bubble .form-field {
    margin-bottom: 10px;
  }
  #eternal-chat-widget .human-form-bubble .form-field label {
    display: block;
    font-size: 12px;
    color: #718096;
    margin-bottom: 4px;
  }
  #eternal-chat-widget .human-form-bubble .form-field input,
  #eternal-chat-widget .human-form-bubble .form-field textarea {
    width: 100%;
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #F7FAFC;
    font-family: inherit;
    box-sizing: border-box;
    resize: vertical;
  }
  #eternal-chat-widget .human-form-bubble .form-field input:focus,
  #eternal-chat-widget .human-form-bubble .form-field textarea:focus {
    outline: none;
    border-color: var(--brand-red, #8B0000);
    background-color: #fff;
  }
  #eternal-chat-widget .human-form-bubble .submit-btn {
    width: 100%;
    padding: 8px;
    font-size: 13px;
    color: #fff;
    background-color: var(--brand-red, #8B0000);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  #eternal-chat-widget .human-form-bubble .submit-btn:hover {
    background-color: var(--brand-red-hover, #6B0000);
  }
  #eternal-chat-widget .human-form-bubble .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  #eternal-chat-widget .human-form-success {
    text-align: center;
    padding: 10px 0;
    color: #2F855A;
    font-size: 13px;
  }

  /* ========== 未读提示点 ========== */
  #eternal-chat-widget #eternal-chat-toggle-btn {
    position: relative;
  }
  #eternal-chat-widget #eternal-chat-unread-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    background-color: #48BB78;
    border-radius: 50%;
    border: 2px solid var(--brand-red, #8B0000);
    display: none;
  }

  /* 移动端适配 */
  @media (max-width: 640px) {
    #eternal-chat-widget {
      bottom: 0;
      right: 0;
      left: 0;
      width: 100%;
    }
    #eternal-chat-toggle-btn {
      position: fixed;
      bottom: 16px;
      right: 16px;
    }
    #eternal-chat-panel {
      position: fixed !important;
      bottom: 0 !important;
      right: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 85vh !important;
      max-height: 85vh !important;
      border: none;
      border-radius: 16px 16px 0 0 !important;
    }
    #eternal-chat-widget .chat-bubble {
      max-width: 82%;
    }
    #eternal-chat-widget .proactive-bubble {
      right: 70px;
      bottom: 6px;
      max-width: 200px;
    }
    #eternal-chat-widget .chat-avatar {
      width: 28px;
      height: 28px;
      min-width: 28px;
      min-height: 28px;
      max-width: 28px;
      max-height: 28px;
    }
  }
</style>

<script>
(function() {
  'use strict';

  // ========== 常量配置 ==========
  const STORAGE_USER_ID = 'eternal_chat_user_id';
  const STORAGE_CONVERSATION_ID = 'eternal_chat_conversation_id';
  const STORAGE_MESSAGES = 'eternal_chat_messages';
  const STORAGE_HAS_GREETED = 'eternal_chat_has_greeted';
  const STORAGE_PROACTIVE_COUNT = 'eternal_chat_proactive_count';
  const STORAGE_PANEL_OPENED = 'eternal_chat_panel_opened';
  const STORAGE_HUMAN_FORM_SUBMITTED = 'eternal_chat_human_submitted';
  const API_ENDPOINT = '/api/chat';
  const HUMAN_LEAD_API = '/api/chat-lead';

  // 行为触发配置
  const PROACTIVE_CONFIG = {
    maxTriggers: 2,           // 每会话最多触发次数
    stayDuration: 30000,      // 停留30秒触发
    bottomThreshold: 300,     // 距底部300px触发
    bubbleDuration: 3000,     // 气泡显示时长（毫秒）
    mouseleaveTopThreshold: 20, // 鼠标离开顶部多少px算离开
  };

  // ========== 页面上下文感知 ==========
  function getPageCategory() {
    try {
      const pathname = location.pathname.toLowerCase();
      const categories = [
        { patterns: ['/milling/', 'milling', '铣削'], label: '铣削加工', labelEn: 'Milling' },
        { patterns: ['/turning/', 'turning', '车削'], label: '车削加工', labelEn: 'Turning' },
        { patterns: ['/grinding/', 'grinding', '磨削'], label: '磨削加工', labelEn: 'Grinding' },
        { patterns: ['/wire-edm/', 'wire', '线切割'], label: '线切割', labelEn: 'Wire EDM' },
        { patterns: ['/materials/', 'material', '材料'], label: '材料选择', labelEn: 'Materials' },
        { patterns: ['/about/', 'about', '关于', '公司'], label: '公司介绍', labelEn: 'About Us' },
        { patterns: ['/contact/', 'contact', '联系'], label: '联系我们', labelEn: 'Contact' },
      ];

      for (let i = 0; i < categories.length; i++) {
        const cat = categories[i];
        for (let j = 0; j < cat.patterns.length; j++) {
          if (pathname.indexOf(cat.patterns[j]) !== -1) {
            return cat;
          }
        }
      }
    } catch (e) {
      console.warn('getPageCategory error:', e);
    }
    return null;
  }

  // 语言检测
  function isChineseLang() {
    try {
      const lang = (navigator.language || 'en').toLowerCase();
      return lang.indexOf('zh') === 0;
    } catch (e) {
      return false;
    }
  }

  // 欢迎语（结合页面上下文 + 语言）
  function getWelcomeMessage() {
    try {
      const zh = isChineseLang();
      const pageCat = getPageCategory();

      if (pageCat) {
        if (zh) {
          return '看起来您对' + pageCat.label + '感兴趣，有什么零件需要报价吗？';
        } else {
          return "It looks like you're interested in " + pageCat.labelEn + ". Do you have any parts that need a quote?";
        }
      }

      // 通用问候
      return zh
        ? '您好，我是鑫永恒的项目工程师，请问有什么可以帮您？'
        : 'Hello, I am a project engineer from Eternal CNC. How can I help you?';
    } catch (e) {
      return 'Hello, how can I help you?';
    }
  }

  // 占位符文本（按语言）
  function getPlaceholderText() {
    return isChineseLang() ? '请输入您的问题...' : 'Type your question...';
  }

  // 主动提示文案（按触发类型 + 语言）
  function getProactiveMessage(triggerType) {
    const zh = isChineseLang();
    const pageCat = getPageCategory();
    const serviceName = pageCat ? (zh ? pageCat.label : pageCat.labelEn) : '';

    switch (triggerType) {
      case 'stay':
        if (zh) {
          return serviceName
            ? '对' + serviceName + '有疑问？我可以帮您报价 👋'
            : '有任何问题都可以问我，随时为您报价 👋';
        } else {
          return serviceName
            ? 'Questions about ' + serviceName + '? I can help quote 👋'
            : 'Have questions? I can help with quotes 👋';
        }
      case 'bottom':
        if (zh) {
          return '看完了？聊聊您的项目需求吧 💬';
        } else {
          return 'Finished reading? Let us discuss your project 💬';
        }
      case 'exit':
        if (zh) {
          return '等等！先留下您的需求，我们马上回复您 ⚡';
        } else {
          return 'Wait! Leave your requirements, we will reply soon ⚡';
        }
      default:
        return zh ? '有什么可以帮您的吗？' : 'How can I help you?';
    }
  }

  // FAQ快捷问题
  function getFaqQuestions() {
    const zh = isChineseLang();
    if (zh) {
      return ['获取报价', '能加工哪些材料？', '加工精度是多少？', '提供哪些服务？'];
    }
    return ['Get a quote', 'What materials do you work with?', "What's your tolerance?", 'What services do you offer?'];
  }

  // 转人工表单文案
  function getHumanFormTexts() {
    const zh = isChineseLang();
    if (zh) {
      return {
        title: '转人工',
        emailLabel: '您的邮箱',
        emailPlaceholder: 'example@email.com',
        descLabel: '请描述您的需求',
        descPlaceholder: '简单描述您的项目需求...',
        submit: '提交',
        success: '已收到，我们会在1个工作日内联系您',
      };
    }
