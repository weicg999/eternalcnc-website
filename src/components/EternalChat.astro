---
// EternalChat - API 版智能客服组件
// 自建前端 UI + Cloudflare Pages Function 后端调扣子 Open API
// 解决 SDK 串聊问题，每个访客独立 user_id
// 设计风格：简约大气，对话式布局，左右气泡错开，带头像
---

<div id="eternal-chat-widget" class="fixed bottom-6 right-6 z-50">
  <!-- 悬浮按钮 -->
  <button
    id="eternal-chat-toggle-btn"
    class="w-14 h-14 text-white flex items-center justify-center transition-all duration-300 hover:scale-105"
    style="background-color: #8B0000; border-radius: 50%; box-shadow: 0 4px 20px rgba(139, 0, 0, 0.3);"
    aria-label="Open AI Chat"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
  </button>

  <!-- 聊天面板 -->
  <div
    id="eternal-chat-panel"
    class="bg-white overflow-hidden flex flex-col"
    style="width: 380px; height: 520px; max-height: calc(100vh - 120px); display: none; position: fixed; bottom: 88px; right: 24px; z-index: 100; border-radius: 16px; box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);"
  >
    <!-- 头部 -->
    <div class="text-white p-4 flex items-center gap-3 flex-shrink-0" style="background: linear-gradient(135deg, #8B0000 0%, #6B0000 100%); border-radius: 16px 16px 0 0;">
      <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <h4 class="font-semibold text-base" id="eternal-chat-title">AI 项目工程师</h4>
        <p class="text-xs text-white/70 flex items-center gap-1.5">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          <span id="eternal-chat-status">在线 · 通常几分钟内回复</span>
        </p>
      </div>
      <button id="eternal-chat-close-btn" class="text-white/70 hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10" aria-label="Close chat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- 消息区域 -->
    <div
      id="eternal-chat-messages"
      class="flex-1 overflow-y-auto px-4 py-4 space-y-4"
      style="background-color: #F8F9FA;"
    >
      <!-- 消息动态插入 -->
    </div>

    <!-- 输入区域 -->
    <div class="p-3 border-t border-gray-100 bg-white flex-shrink-0" style="border-radius: 0 0 16px 16px;">
      <div class="flex items-center gap-2 bg-gray-50 rounded-full px-4 py-2 border border-gray-100 focus-within:border-gray-300 focus-within:bg-white transition-all">
        <input
          id="eternal-chat-input"
          type="text"
          placeholder="请输入您的问题..."
          class="flex-1 text-sm bg-transparent focus:outline-none"
          autocomplete="off"
        />
        <button
          id="eternal-chat-send-btn"
          class="w-8 h-8 text-white flex items-center justify-center transition-all flex-shrink-0 rounded-full hover:scale-105"
          style="background-color: #8B0000;"
          aria-label="Send"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* ========== 消息气泡基础样式 ========== */
  #eternal-chat-widget .chat-msg {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    word-break: break-word;
    white-space: pre-wrap;
    animation: msgFadeIn 0.25s ease-out;
  }

  @keyframes msgFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 用户消息：右侧，头像在右 */
  #eternal-chat-widget .chat-msg.user {
    justify-content: flex-end;
    margin-left: auto;
    flex-direction: row;
  }
  #eternal-chat-widget .chat-msg.user .chat-avatar {
    order: 2;
  }
  #eternal-chat-widget .chat-msg.user .chat-bubble {
    order: 1;
  }

  /* Bot消息：左侧，头像在左 */
  #eternal-chat-widget .chat-msg.bot {
    justify-content: flex-start;
    margin-right: auto;
  }

  /* 头像 */
  #eternal-chat-widget .chat-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
  }
  #eternal-chat-widget .chat-msg.user .chat-avatar {
    background: linear-gradient(135deg, #8B0000, #6B0000);
  }
  #eternal-chat-widget .chat-msg.bot .chat-avatar {
    background: linear-gradient(135deg, #4A5568, #2D3748);
  }
  #eternal-chat-widget .chat-avatar svg {
    width: 16px;
    height: 16px;
  }

  /* 气泡 */
  #eternal-chat-widget .chat-bubble {
    max-width: 78%;
    padding: 10px 14px;
    font-size: 14px;
    line-height: 1.65;
    border-radius: 18px;
    position: relative;
  }
  #eternal-chat-widget .chat-msg.user .chat-bubble {
    background-color: #8B0000;
    color: #fff;
    border-bottom-right-radius: 6px;
  }
  #eternal-chat-widget .chat-msg.bot .chat-bubble {
    background-color: #FFFFFF;
    color: #1A202C;
    border: 1px solid #E2E8F0;
    border-bottom-left-radius: 6px;
  }

  /* 加载动画：三个点 */
  #eternal-chat-widget .typing-dots {
    display: inline-flex;
    gap: 4px;
    padding: 2px 4px;
  }
  #eternal-chat-widget .typing-dots span {
    width: 6px;
    height: 6px;
    background-color: #A0AEC0;
    border-radius: 50%;
    animation: eternal-chat-bounce 1.4s infinite ease-in-out both;
  }
  #eternal-chat-widget .typing-dots span:nth-child(1) { animation-delay: -0.32s; }
  #eternal-chat-widget .typing-dots span:nth-child(2) { animation-delay: -0.16s; }
  @keyframes eternal-chat-bounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* 滚动条样式 */
  #eternal-chat-messages::-webkit-scrollbar {
    width: 4px;
  }
  #eternal-chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #eternal-chat-messages::-webkit-scrollbar-thumb {
    background: #CBD5E0;
    border-radius: 2px;
  }
  #eternal-chat-messages::-webkit-scrollbar-thumb:hover {
    background: #A0AEC0;
  }

  /* 光标闪烁（流式输出时） */
  #eternal-chat-widget .chat-bubble.streaming::after {
    content: '▍';
    display: inline-block;
    margin-left: 1px;
    animation: eternal-chat-cursor 1s infinite;
    font-weight: 300;
    opacity: 0.5;
    font-size: 0.9em;
  }
  @keyframes eternal-chat-cursor {
    0%, 50% { opacity: 0.5; }
    51%, 100% { opacity: 0; }
  }

  /* 移动端适配 */
  @media (max-width: 640px) {
    #eternal-chat-widget {
      bottom: 0;
      right: 0;
      left: 0;
      width: 100%;
    }
    #eternal-chat-toggle-btn {
      position: fixed;
      bottom: 16px;
      right: 16px;
    }
    #eternal-chat-panel {
      position: fixed !important;
      bottom: 0 !important;
      right: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 85vh !important;
      max-height: 85vh !important;
      border: none;
      border-radius: 16px 16px 0 0 !important;
    }
    #eternal-chat-widget .chat-bubble {
      max-width: 82%;
    }
  }
</style>

<script>
(function() {
  'use strict';

  // ========== 常量配置 ==========
  const STORAGE_USER_ID = 'eternal_chat_user_id';
  const STORAGE_CONVERSATION_ID = 'eternal_chat_conversation_id';
  const STORAGE_MESSAGES = 'eternal_chat_messages';
  const STORAGE_HAS_GREETED = 'eternal_chat_has_greeted';
  const API_ENDPOINT = '/api/chat';

  // 欢迎语（按浏览器语言）
  function getWelcomeMessage() {
    const lang = (navigator.language || 'en').toLowerCase();
    if (lang.startsWith('zh')) {
      return '您好，我是鑫永恒的项目工程师，请问有什么可以帮您？';
    }
    return 'Hello, I am a project engineer from Eternal CNC. How can I help you?';
  }

  // 占位符文本（按语言）
  function getPlaceholderText() {
    const lang = (navigator.language || 'en').toLowerCase();
    if (lang.startsWith('zh')) {
      return '请输入您的问题...';
    }
    return 'Type your question...';
  }

  // 生成唯一ID
  function generateId(prefix) {
    return prefix + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 9);
  }

  // 获取或创建 user_id
  function getUserId() {
    let userId = localStorage.getItem(STORAGE_USER_ID);
    if (!userId) {
      userId = generateId('user');
      localStorage.setItem(STORAGE_USER_ID, userId);
    }
    return userId;
  }

  // 获取或创建 conversation_id
  function getConversationId() {
    let convId = localStorage.getItem(STORAGE_CONVERSATION_ID);
    if (!convId) {
      convId = generateId('conv');
      localStorage.setItem(STORAGE_CONVERSATION_ID, convId);
    }
    return convId;
  }

  // 保存会话历史
  function saveMessages(messages) {
    try {
      localStorage.setItem(STORAGE_MESSAGES, JSON.stringify(messages));
    } catch (e) {
      console.warn('Failed to save chat messages:', e);
    }
  }

  // 加载会话历史
  function loadMessages() {
    try {
      const raw = localStorage.getItem(STORAGE_MESSAGES);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  // ========== DOM 元素 ==========
  const widget = document.getElementById('eternal-chat-widget');
  const toggleBtn = document.getElementById('eternal-chat-toggle-btn');
  const closeBtn = document.getElementById('eternal-chat-close-btn');
  const panel = document.getElementById('eternal-chat-panel');
  const messagesEl = document.getElementById('eternal-chat-messages');
  const inputEl = document.getElementById('eternal-chat-input');
  const sendBtn = document.getElementById('eternal-chat-send-btn');
  const titleEl = document.getElementById('eternal-chat-title');
  const statusEl = document.getElementById('eternal-chat-status');

  if (!widget || !panel) return;

  // 状态
  let messages = loadMessages();
  let isStreaming = false;
  let currentBotMsgEl = null;
  let currentBotBubbleEl = null;
  let abortController = null;

  // 设置输入框占位符
  inputEl.placeholder = getPlaceholderText();

  // 标题语言
  const isZh = (navigator.language || 'en').toLowerCase().startsWith('zh');
  titleEl.textContent = isZh ? 'AI 项目工程师' : 'AI Project Engineer';
  statusEl.textContent = isZh ? '在线 · 通常几分钟内回复' : 'Online · Usually replies in minutes';

  // ========== 消息渲染 ==========
  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  // 创建头像SVG
  function createAvatarSvg(role) {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('viewBox', '0 0 24 24');

    if (role === 'user') {
      // 用户头像：人形图标
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('d', 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z');
      svg.appendChild(path);
    } else {
      // Bot头像：齿轮图标
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('d', 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z');
      svg.appendChild(path);
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      circle.setAttribute('stroke-linecap', 'round');
      circle.setAttribute('stroke-linejoin', 'round');
      circle.setAttribute('stroke-width', '2');
      circle.setAttribute('d', 'M15 12a3 3 0 11-6 0 3 3 0 016 0z');
      svg.appendChild(circle);
    }

    return svg;
  }

  function createMessageEl(role, content) {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'chat-msg ' + role;

    // 头像
    const avatar = document.createElement('div');
    avatar.className = 'chat-avatar';
    avatar.appendChild(createAvatarSvg(role));

    // 气泡
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';
    bubble.textContent = content;

    msgDiv.appendChild(avatar);
    msgDiv.appendChild(bubble);
    return { msgDiv, bubble };
  }

  function createTypingEl() {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'chat-msg bot';

    // 头像
    const avatar = document.createElement('div');
    avatar.className = 'chat-avatar';
    avatar.appendChild(createAvatarSvg('bot'));

    // 气泡
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';

    const dots = document.createElement('div');
    dots.className = 'typing-dots';
    dots.innerHTML = '<span></span><span></span><span></span>';

    bubble.appendChild(dots);
    msgDiv.appendChild(avatar);
    msgDiv.appendChild(bubble);
    return { msgDiv, bubble };
  }

  function renderExistingMessages() {
    messagesEl.innerHTML = '';
    messages.forEach(function(msg) {
      const { msgDiv } = createMessageEl(msg.role, msg.content);
      messagesEl.appendChild(msgDiv);
    });
    scrollToBottom();
  }

  // ========== 发送消息 ==========
  function sendMessage() {
    if (isStreaming) return;

    const text = inputEl.value.trim();
    if (!text) return;

    inputEl.value = '';
    inputEl.focus();

    // 添加用户消息
    messages.push({ role: 'user', content: text });
    saveMessages(messages);

    const { msgDiv: userMsgEl } = createMessageEl('user', text);
    messagesEl.appendChild(userMsgEl);
    scrollToBottom();

    // 显示加载动画
    const { msgDiv: typingEl, bubble: typingBubble } = createTypingEl();
    messagesEl.appendChild(typingEl);
    scrollToBottom();

    isStreaming = true;
    sendBtn.disabled = true;

    const userId = getUserId();
    const conversationId = getConversationId();

    abortController = new AbortController();

    // 调用API
    fetch(API_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        message: text,
        user_id: userId,
        conversation_id: conversationId
      }),
      signal: abortController.signal
    }).then(function(response) {
      if (!response.ok) {
        throw new Error('HTTP ' + response.status);
      }

      // 移除loading，创建bot消息气泡
      typingEl.remove();

      const { msgDiv: botMsgEl, bubble: botBubble } = createMessageEl('bot', '');
      botBubble.classList.add('streaming');
      messagesEl.appendChild(botMsgEl);
      currentBotMsgEl = botMsgEl;
      currentBotBubbleEl = botBubble;

      // 处理流式响应
      const reader = response.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let buffer = '';
      let fullContent = '';

      function readStream() {
        return reader.read().then(function(result) {
          if (result.done) {
            finishStreaming(fullContent);
            return;
          }

          buffer += decoder.decode(result.value, { stream: true });

          // 解析SSE事件（按行分割）
          const lines = buffer.split('\n');
          buffer = lines.pop() || ''; // 保留不完整的行

          for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (!line) continue;
            if (line.startsWith('data:')) {
              const dataStr = line.slice(5).trim();
              if (dataStr === '[DONE]') {
                finishStreaming(fullContent);
                return;
              }
              try {
                const data = JSON.parse(dataStr);
                // v2格式: { event: 'message', message: { content: '...' } }
                // v3格式: { event_type: 'conversation.message.delta', data: { content: '...' } }
                let delta = '';
                if (data.event === 'message' && data.message && data.message.content) {
                  delta = data.message.content;
                } else if (data.event_type === 'conversation.message.delta' && data.data && data.data.content) {
                  delta = data.data.content;
                } else if (data.event === 'done' || data.event_type === 'conversation.chat.completed') {
                  continue;
                }
                if (delta) {
                  fullContent += delta;
                  currentBotBubbleEl.textContent = fullContent;
                  scrollToBottom();
                }
              } catch (e) {
                // 忽略解析错误
              }
            }
          }

          return readStream();
        });
      }

      return readStream();

    }).catch(function(err) {
      if (err.name === 'AbortError') return;

      // 移除loading，显示错误
      if (typingEl.parentNode) {
        typingEl.remove();
      }
      const errorMsg = isZh ? '抱歉，服务暂时不可用，请稍后再试。' : 'Sorry, service is temporarily unavailable. Please try again later.';
      const { msgDiv: errMsgEl } = createMessageEl('bot', errorMsg);
      messagesEl.appendChild(errMsgEl);
      messages.push({ role: 'bot', content: errorMsg });
      saveMessages(messages);
      scrollToBottom();

      isStreaming = false;
      sendBtn.disabled = false;
    });

    function finishStreaming(content) {
      if (currentBotBubbleEl) {
        currentBotBubbleEl.classList.remove('streaming');
      }
      if (content) {
        messages.push({ role: 'bot', content: content });
        saveMessages(messages);
      }
      isStreaming = false;
      sendBtn.disabled = false;
      currentBotMsgEl = null;
      currentBotBubbleEl = null;
      abortController = null;
    }
  }

  // ========== 事件绑定 ==========
  toggleBtn.addEventListener('click', function() {
    const isHidden = panel.style.display === 'none' || panel.style.display === '';
    if (isHidden) {
      panel.style.display = 'flex';
      // 首次展开：如果没有消息，发送欢迎语
      if (messages.length === 0) {
        const welcome = getWelcomeMessage();
        messages.push({ role: 'bot', content: welcome });
        saveMessages(messages);
        renderExistingMessages();
      } else {
        renderExistingMessages();
      }
      // 延迟聚焦输入框
      setTimeout(function() { inputEl.focus(); }, 100);
    } else {
      panel.style.display = 'none';
      if (isStreaming && abortController) {
        abortController.abort();
      }
    }
  });

  closeBtn.addEventListener('click', function() {
    panel.style.display = 'none';
    if (isStreaming && abortController) {
      abortController.abort();
    }
  });

  sendBtn.addEventListener('click', sendMessage);

  inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  // 初始化渲染（如果有历史消息）
  if (messages.length > 0) {
    // 不立即渲染，等展开时再渲染
  }

})();
</script>
