---
// Coze (扣子) 智能客服组件
// 仅在英文站（路径不以 /zh 开头）注入；中文页不显示。
// 机器人本身多语（跟随客户语言），英文站已覆盖海外多语客户。
const isZh = Astro.url.pathname.startsWith('/zh');

// 从 .env 读取（.env 已 gitignore，不会进仓库）。
// ⚠️ 安全提示：Astro 构建会把此处引用的值内联进客户端 bundle，
//    因此 PAT 仍会出现在构建产物源码里。本地测试 OK；
//    上线 Cloudflare Pages 前必须改成「Worker 代理」方案（PAT 不进前端 bundle）。
const COZE_BOT_ID = import.meta.env.COZE_BOT_ID || '';
const COZE_PAT    = import.meta.env.COZE_PAT    || '';

// SDK 版本来自扣子「安装」页（1.2.0-beta.19，beta 版，留意稳定性）
const COZE_SDK_SRC = 'https://lf-cdn.coze.cn/obj/unpkg/flow-platform/chat-app-sdk/1.2.0-beta.19/libs/cn/index.js';
---

{!isZh && (
  <>
    <!-- 自定义悬浮球头像按钮 -->
    <button id="coze-custom-fab" aria-label="Open chat">
      <img src="/images/chat-avatar.png" alt="Chat assistant" />
    </button>

    <script src={COZE_SDK_SRC} is:inline></script>

    {(COZE_BOT_ID && COZE_PAT) && (
      <script is:inline define:vars={{ COZE_BOT_ID, COZE_PAT }}>
        var fab = document.getElementById('coze-custom-fab');

        var client = new CozeWebSDK.WebChatClient({
          config: { bot_id: COZE_BOT_ID, isIframe: false },
          componentProps: { title: 'EternalCNC Assistant' },
          auth: {
            type: 'token',
            token: COZE_PAT,
            onRefreshToken: function () { return COZE_PAT }
          },
          ui: {
            asstBtn: { isNeed: false }, // 隐藏默认蓝色悬浮球
            chatBot: {
              title: 'EternalCNC Assistant',
              onShow: function () {
                // 聊天框打开时，隐藏自定义悬浮球
                if (fab) fab.style.display = 'none';
              },
              onHide: function () {
                // 聊天框关闭时，显示自定义悬浮球
                if (fab) fab.style.display = '';
              }
            }
          }
        });

        // 点击自定义悬浮球 → 打开聊天框
        if (fab) {
          fab.addEventListener('click', function () {
            client.showChatBot();
          });
        }
      </script>
    )}

    {!(COZE_BOT_ID && COZE_PAT) && (
      <script is:inline>
        var fab = document.getElementById('coze-custom-fab');
        if (fab) fab.style.display = 'none';
      </script>
    )}

    <style is:global>
      /* 自定义悬浮球样式 */
      #coze-custom-fab {
        position: fixed;
        right: 24px;
        bottom: 24px;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        padding: 0;
        overflow: hidden;
        z-index: 10000;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: transparent;
      }
      #coze-custom-fab:hover {
        transform: scale(1.08);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
      }
      #coze-custom-fab img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    </style>
  </>
)}
