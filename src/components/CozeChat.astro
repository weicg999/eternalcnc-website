---
// Coze 自建聊天 UI（方案 A：彻底隔离 + PAT 不进前端）
//
// 设计要点：
// 1. 不使用 Coze Web SDK，改用 Coze Chat API（/open_api/v1/chat）自建浮球面板。
// 2. 隔离原理：每个访客在 localStorage 存独立标识 visitor-<uuid> 与 conversation_id，
//    聊天时连同 user + conversation_id 发给 /api/coze/chat，
//    Coze 按 user + conversation 天然隔离，不同访客/不同设备互不串聊。
// 3. PAT 仅存在于服务端 Functions 环境变量，前端只跟同源 /api/coze/* 打交道。
// 4. 保留品牌色纪律：暖白底 + 黑字 + 品牌红(#8B0000)点缀；红不做大底色。
---

<>
  <!-- 悬浮球 -->
  <button id="ec-fab" aria-label="Open chat" type="button">
    <img src="/images/chat-avatar.png" alt="Chat assistant" />
  </button>

  <!-- 聊天面板 -->
  <div id="ec-panel" class="ec-hidden" role="dialog" aria-label="Chat with EternalCNC Assistant">
    <div id="ec-header">
      <div class="ec-title">EternalCNC Assistant</div>
      <button id="ec-new" type="button" title="开启新对话">新对话</button>
      <button id="ec-close" type="button" title="关闭" aria-label="Close chat">×</button>
    </div>
    <div id="ec-messages" aria-live="polite"></div>
    <div id="ec-inputbar">
      <textarea id="ec-input" rows="1" placeholder="输入您的问题，Enter 发送…" aria-label="Message"></textarea>
      <button id="ec-send" type="button">发送</button>
    </div>
    <div id="ec-hint">对话用于售前服务与溯源；共享设备请及时点「新对话」清空。</div>
  </div>

  <style is:global>
    /* 悬浮球（复用原样式） */
    #ec-fab {
      position: fixed;
      right: 24px;
      bottom: 24px;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      border: 2px solid #fff;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      cursor: pointer;
      padding: 0;
      overflow: hidden;
      z-index: 10000;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      background: transparent;
    }
    #ec-fab:hover { transform: scale(1.08); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2); }
    #ec-fab img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* 面板 */
    #ec-panel {
      position: fixed;
      right: 24px;
      bottom: 96px;
      width: 380px;
      max-width: calc(100vw - 32px);
      height: 600px;
      max-height: calc(100vh - 120px);
      background: #fff;
      border: 1px solid #e7e3da;
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
      z-index: 10001;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      font-family: Inter, "Noto Sans SC", Arial, sans-serif;
      color: #1a1a1a;
    }
    #ec-panel.ec-hidden { display: none; }

    #ec-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 14px;
      border-bottom: 2px solid #8B0000; /* 品牌红点缀：标题下划线 */
      background: #f4f3ee;
    }
    #ec-title {
      font-weight: 600;
      font-size: 15px;
      flex: 1;
      color: #1a1a1a;
    }
    #ec-header button {
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 13px;
      color: #555;
      padding: 4px 8px;
      border-radius: 6px;
    }
    #ec-new:hover { color: #8B0000; }
    #ec-close { font-size: 20px; line-height: 1; }

    #ec-messages {
      flex: 1;
      overflow-y: auto;
      padding: 14px;
      background: #fbfaf7;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .ec-msg { max-width: 85%; padding: 9px 12px; border-radius: 12px; font-size: 14px; line-height: 1.5; word-wrap: break-word; white-space: pre-wrap; }
    .ec-msg.user { align-self: flex-end; background: #8B0000; color: #fff; border-bottom-right-radius: 4px; }
    .ec-msg.bot { align-self: flex-start; background: #fff; color: #1a1a1a; border: 1px solid #e7e3da; border-bottom-left-radius: 4px; }
    .ec-msg.sys { align-self: center; background: #f0e9df; color: #8B0000; font-size: 12px; max-width: 92%; text-align: center; }

    #ec-inputbar {
      display: flex;
      gap: 8px;
      padding: 10px;
      border-top: 1px solid #e7e3da;
      background: #fff;
    }
    #ec-input {
      flex: 1;
      resize: none;
      border: 1px solid #d8d3c8;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 14px;
      font-family: inherit;
      max-height: 120px;
      outline: none;
    }
    #ec-input:focus { border-color: #8B0000; }
    #ec-send {
      border: none;
      background: #8B0000; /* 品牌红点缀：发送按钮 */
      color: #fff;
      border-radius: 8px;
      padding: 0 16px;
      font-size: 14px;
      cursor: pointer;
    }
    #ec-send:disabled { opacity: 0.5; cursor: default; }
    #ec-hint { font-size: 11px; color: #999; padding: 0 14px 10px; background: #fff; text-align: center; }

    .ec-typing::after {
      content: '…';
      animation: ecblink 1.2s steps(4, start) infinite;
    }
    @keyframes ecblink { to { visibility: hidden; } }

    /* 移动端：面板占满全屏 */
    @media (max-width: 820px) {
      #ec-panel {
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        max-width: none !important;
        max-height: none !important;
        border-radius: 0 !important;
        border: none !important;
      }
      #ec-fab { right: 16px; bottom: 16px; }
    }
  </style>

  <script is:inline>
  (function () {
    var STORE_KEY = 'eternalcnc_coze_state';
    var DAY = 86400000;
    var RETAIN_MS = 7 * DAY;

    // ---------- 状态（每访客独立） ----------
    function genId() {
      var raw = (window.crypto && crypto.randomUUID)
        ? crypto.randomUUID()
        : ('u' + Date.now().toString(16) + Math.random().toString(16).slice(2));
      return 'visitor-' + raw;
    }
    function readState() {
      try { var r = localStorage.getItem(STORE_KEY); if (r) return JSON.parse(r); } catch (e) {}
      return null;
    }
    function writeState(s) {
      try { localStorage.setItem(STORE_KEY, JSON.stringify(s)); } catch (e) {}
    }
    function freshState() {
      var s = { user: genId(), conversation_id: '', ts: Date.now() };
      writeState(s);
      return s;
    }
    var state = readState();
    if (!state || !state.user) state = freshState();
    if (Date.now() - (state.ts || 0) > RETAIN_MS) {
      // 超 7 天硬上限：旋转到全新身份 + 新会话
      state = freshState();
    }

    // ---------- DOM ----------
    var fab = document.getElementById('ec-fab');
    var panel = document.getElementById('ec-panel');
    var messages = document.getElementById('ec-messages');
    var input = document.getElementById('ec-input');
    var sendBtn = document.getElementById('ec-send');
    var closeBtn = document.getElementById('ec-close');
    var newBtn = document.getElementById('ec-new');

    var convReady = !!state.conversation_id;
    var busy = false;

    function scrollBottom() { messages.scrollTop = messages.scrollHeight; }

    function addMsg(role, text) {
      var el = document.createElement('div');
      el.className = 'ec-msg ' + role;
      el.textContent = text;
      messages.appendChild(el);
      scrollBottom();
      return el;
    }
    function addSys(text) {
      var el = document.createElement('div');
      el.className = 'ec-msg sys';
      el.textContent = text;
      messages.appendChild(el);
      scrollBottom();
      return el;
    }

    // ---------- 会话准备：打开面板时若没有 conversation_id 则创建 ----------
    function ensureConversation() {
      if (convReady) return Promise.resolve(state.conversation_id);
      return fetch('/api/coze/conversation', { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || !data.conversation_id) throw new Error(data && data.error ? data.error : 'no conversation_id');
          state.conversation_id = data.conversation_id;
          state.ts = Date.now();
          writeState(state);
          convReady = true;
          return state.conversation_id;
        });
    }

    // ---------- 流式聊天 ----------
    function streamChat(query) {
      busy = true;
      sendBtn.disabled = true;

      var botEl = addMsg('bot', '');
      botEl.classList.add('ec-typing');
      var full = '';

      fetch('/api/coze/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user: state.user,
          conversation_id: state.conversation_id,
          query: query
        })
      }).then(function (res) {
        if (!res.ok || !res.body) {
          return res.text().then(function (t) { throw new Error(t || ('HTTP ' + res.status)); });
        }
        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var buf = '';

        function pump() {
          return reader.read().then(function (r) {
            if (r.done) {
              botEl.classList.remove('ec-typing');
              if (!full) botEl.textContent = '（暂无回复，请稍后再试）';
              busy = false; sendBtn.disabled = false;
              return;
            }
            buf += decoder.decode(r.value, { stream: true });

            var idx;
            while ((idx = buf.indexOf('\n\n')) !== -1) {
              var raw = buf.slice(0, idx);
              buf = buf.slice(idx + 2);
              var dataStr = '';
              raw.split('\n').forEach(function (ln) {
                if (ln.indexOf('data:') === 0) dataStr += ln.slice(5).replace(/^\s/, '');
              });
              if (!dataStr) continue;
              var data;
              try { data = JSON.parse(dataStr); } catch (e) { continue; }
              // Coze 错误体（非 SSE 时返回 JSON）
              if (data && data.code && data.code !== 0) {
                botEl.classList.remove('ec-typing');
                botEl.textContent = '（服务暂不可用：' + (data.msg || ('code ' + data.code)) + '）';
                busy = false; sendBtn.disabled = false;
                return;
              }
              if (data && data.content && typeof data.content === 'string') {
                var ev = (raw.match(/event:\s*(\S+)/) || [])[1] || '';
                if (ev.indexOf('delta') !== -1) {
                  full += data.content;            // 增量累加
                } else if (ev.indexOf('completed') !== -1) {
                  full = data.content;             // 完成时以完整内容覆盖，避免重复
                } else {
                  full += data.content;
                }
                botEl.textContent = full;
                scrollBottom();
              }
            }
            return pump();
          });
        }
        return pump();
      }).catch(function (err) {
        botEl.classList.remove('ec-typing');
        botEl.textContent = '（发送失败：' + (err && err.message ? err.message : err) + '）';
        busy = false; sendBtn.disabled = false;
      });
    }

    // ---------- 交互 ----------
    function openPanel() {
      panel.classList.remove('ec-hidden');
      if (fab) fab.style.display = 'none';
      ensureConversation().catch(function (e) {
        addSys('会话初始化失败：' + (e && e.message ? e.message : e));
      });
      setTimeout(function () { input.focus(); }, 50);
    }
    function closePanel() {
      panel.classList.add('ec-hidden');
      if (fab) fab.style.display = '';
    }
    function send() {
      var q = input.value.trim();
      if (!q || busy) return;
      addMsg('user', q);
      input.value = '';
      input.style.height = 'auto';
      ensureConversation().then(function () {
        streamChat(q);
      }).catch(function (e) {
        addSys('无法开始对话：' + (e && e.message ? e.message : e));
      });
    }
    function startNew() {
      state = freshState();
      convReady = false;
      messages.innerHTML = '';
      addSys('已开启新对话。');
      ensureConversation().catch(function (e) {
        addSys('会话初始化失败：' + (e && e.message ? e.message : e));
      });
    }

    if (fab) fab.addEventListener('click', openPanel);
    if (closeBtn) closeBtn.addEventListener('click', closePanel);
    if (newBtn) newBtn.addEventListener('click', startNew);
    if (sendBtn) sendBtn.addEventListener('click', send);
    if (input) {
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
      });
      input.addEventListener('input', function () {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 120) + 'px';
      });
    }
  })();
  </script>
</>
