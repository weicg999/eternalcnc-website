---
const isZh = Astro.url.pathname.startsWith('/zh');

const heading = isZh
  ? '精度不是规格，而是习惯。'
  : 'Precision is not a specification. It\'s a habit.';

const subtitle = isZh
  ? '23 年制造行业深耕，15 年 CNC 精密机加，始终如一。'
  : '23 years in manufacturing, 15 years in CNC precision machining, continuously.';

const ctaPrimaryText = isZh ? '获取报价' : 'Get a Quote';
const ctaPrimaryHref = isZh ? '/zh/contact/get-a-quote' : '/contact/get-a-quote';

const ctaSecondaryText = isZh ? '查看加工能力' : 'View Capabilities';
const ctaSecondaryHref = isZh ? '/zh/services/cnc-machining' : '/services/cnc-machining';
---

<section class="py-16 md:py-24" style="background-color: var(--page-bg);">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-10">
      <!-- 左侧：标语 -->
      <div class="max-w-xl">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 leading-snug" style="color: #1A1A1A; font-family: var(--font-heading);">
          {heading}
        </h2>
        <p class="text-base md:text-lg mb-0 leading-relaxed" style="color: #6B7280;">
          {subtitle}
        </p>
      </div>

      <!-- 右侧：按钮组 -->
      <div class="flex flex-wrap items-center gap-4 flex-shrink-0">
        <a href={ctaPrimaryHref} class="inline-flex items-center gap-2 px-7 py-3 text-[15px] font-semibold text-white bg-[#8B0000] rounded-lg transition-all duration-200 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          {ctaPrimaryText}
        </a>
        <a href={ctaSecondaryHref} class="inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium text-[#1A1A1A] rounded-lg transition-all duration-200 hover:text-[#8B0000]">
          {ctaSecondaryText}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
