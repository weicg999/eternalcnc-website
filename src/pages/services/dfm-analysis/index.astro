---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Services', href: '/services' },
  { label: 'DFM Analysis' },
];

const capabilities = [
  {
    title: 'Design Review',
    items: ['Wall thickness analysis', 'Internal corner radius check', 'Hole depth-to-diameter ratio', 'Thread feasibility assessment'],
    tolerance: 'N/A',
    materials: 'All CNC-machinable materials',
  },
  {
    title: 'Cost Optimization',
    items: ['Material waste reduction', 'Setup count optimization', 'Tolerance relaxation suggestions', 'Surface finish alternatives'],
    tolerance: 'N/A',
    materials: 'Cost models for 20+ materials',
  },
  {
    title: 'Manufacturing Feasibility',
    items: ['Tool access analysis', 'Fixturing recommendations', 'Process sequence planning', 'Lead time estimation'],
    tolerance: 'N/A',
    materials: 'Process-specific DFM rules',
  },
  {
    title: 'Rapid Feedback',
    items: ['24-hour turnaround', 'Annotated PDF reports', '3D markup comparisons', 'Direct engineer consultation'],
    tolerance: 'N/A',
    materials: 'Free for new customers',
  },
];

const standards = [
  { label: 'Expert Review', desc: 'Every DFM report reviewed by a senior manufacturing engineer with 10+ years of CNC experience.' },
  { label: 'Actionable Insights', desc: 'Reports include specific recommendations with before/after comparisons and cost impact estimates.' },
  { label: 'Confidentiality', desc: 'All drawings protected under NDA. Files stored on encrypted servers and deleted after 90 days.' },
  { label: 'No Obligation', desc: 'DFM analysis is free with no commitment. Use our feedback or iterate with your team.' },
];
---

<PageLayout
  title="DFM Analysis | Free Manufacturability Review | Eternal CNC"
  description="Upload your drawings and receive a professional DFM analysis within 24 hours. Reduce costs, shorten lead times, and minimize scrap risk."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Services</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        DFM Analysis
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Upload your drawings and receive a professional manufacturability analysis within 24 hours — helping you reduce costs and lead times.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Contact Engineer →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">What We Cover</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Service Categories</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Our DFM analysis covers four key areas to ensure your design is optimized for manufacturing.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Common Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Why Us</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Service Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We deliver professional, actionable DFM feedback — not generic automated reports.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Ready to Optimize Your Design?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawings. Our engineers will provide a quote and DFM feedback within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Contact Engineer →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
