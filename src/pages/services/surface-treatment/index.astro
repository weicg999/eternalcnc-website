---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Services', href: '/services' },
  { label: 'Surface Treatment' },
];

const capabilities = [
  {
    title: 'Anodizing',
    items: ['Type II — standard decorative', 'Type III — hard coat for wear', 'Color anodizing (black, red, blue)', 'Masked anodizing for selective areas'],
    tolerance: 'Coating thickness 5-25μm',
    materials: 'Aluminum alloys (6061, 7075, 2024)',
  },
  {
    title: 'Electroplating',
    items: ['Nickel plating (electroless & electrolytic)', 'Zinc plating for corrosion', 'Chrome plating for hardness', 'Gold/silver for conductivity'],
    tolerance: 'Coating thickness 3-50μm',
    materials: 'Steel, brass, copper substrates',
  },
  {
    title: 'Passivation & Conversion',
    items: ['Stainless steel passivation', 'Chromate conversion (Alodine)', 'Phosphate coating', 'Black oxide finishing'],
    tolerance: 'Per ASTM A967 / AMS2700',
    materials: 'Stainless steel, aluminum, steel',
  },
  {
    title: 'Painting & Blasting',
    items: ['Powder coating (RAL colors)', 'Wet spray painting', 'Glass bead blasting', 'Sandblasting & satin finishing'],
    tolerance: 'Surface profile per spec',
    materials: 'All metals, some plastics',
  },
];

const standards = [
  { label: 'Adhesion Testing', desc: 'Cross-cut adhesion test (ISO 2409) performed on every batch. Minimum Class 4B required.' },
  { label: 'Thickness Verification', desc: 'Coating thickness measured by eddy current or X-ray fluorescence. Multi-point sampling.' },
  { label: 'Salt Spray Testing', desc: 'Available on request. Neutral salt spray (ASTM B117) for corrosion resistance validation.' },
  { label: 'Appearance Standards', desc: 'Visual inspection under D65 lighting. Color matching by spectrophotometer for custom colors.' },
];
---

<PageLayout
  title="Surface Treatment Services | Anodizing, Plating & More | Eternal CNC"
  description="Anodizing, electroplating, passivation, powder coating, and blasting. Multiple processes to meet aesthetic and functional requirements."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Services</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Surface Treatment
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Anodizing, plating, passivation, painting, and blasting — multiple processes to meet your aesthetic and functional requirements.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/knowledge/surface-finishing" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Surface Finish Guide →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Capabilities</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">By Treatment Process</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We offer four categories of surface treatment to meet diverse aesthetic and functional needs.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Common Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Surface Treatment Gallery -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Finishes</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Surface Finish Gallery</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        The following are 3D renderings illustrating the typical look of each surface treatment. Real sample photos will be added over time.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/surface-treatment/surface-treatment-anodizing-render-01.webp" alt="3D render of anodized aluminum enclosure with matte black finish" width="400" height="400" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Anodizing · Matte Black</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/surface-treatment/surface-treatment-electroplating-render-01.webp" alt="3D render of chrome plated stainless bracket, mirror reflective finish" width="400" height="400" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Electroplating · Mirror Chrome</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/surface-treatment/surface-treatment-black-oxide-render-01.webp" alt="3D render of black oxide steel component, dark matte gunmetal finish" width="400" height="400" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Black Oxide · Gunmetal</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/surface-treatment/surface-treatment-powder-coating-render-01.webp" alt="3D render of powder coated aluminum housing, matte blue RAL finish" width="400" height="400" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Powder Coating · RAL Blue</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/surface-treatment/surface-treatment-bead-blasting-render-01.webp" alt="3D render of bead blasted stainless part, satin matte texture" width="400" height="400" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Bead Blasting · Satin</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/surface-treatment/surface-treatment-mirror-polish-render-01.webp" alt="3D render of mirror polished brass fitting, highly reflective golden finish" width="400" height="400" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Mirror Polishing · Brass</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every surface treatment undergoes strict quality verification before delivery.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need Surface Treatment?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawings. Our engineers will provide a quote and DFM feedback within 2 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/knowledge/surface-finishing" class="inline-block px-8 py-3.5 text-sm font-semibold border border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Surface Finish Guide →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
