---
import PageLayout from '../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Services', href: '/services' },
  { label: 'CNC Machining' },
];

const capabilities = [
  {
    title: '3-Axis Milling',
    items: ['Prototypes & one-offs', 'Mold bases & plates', 'Fixture & jig parts', 'Bracket & housings'],
    tolerance: '±0.01mm',
    materials: 'Aluminum 6061/7075, Steel 1045/4140, Stainless 304/316',
  },
  {
    title: '4-Axis & High-Speed Milling',
    items: ['Cam profiles', 'Helical gears & splines', 'Angular features', 'Multi-face parts'],
    tolerance: '±0.01mm',
    materials: 'Aluminum 6061-T6, Steel P20/H13, Delrin (POM)',
  },
  {
    title: '5-Axis Simultaneous Milling',
    items: ['Complex curved surfaces', 'Impellers & turbines', 'Irregular cavities', 'Satellite structural parts'],
    tolerance: '±0.005mm',
    materials: 'Titanium TC4, Inconel 718, Aluminum 7075',
  },
  {
    title: 'CNC Turning',
    items: ['Shafts & bushings', 'Pistons & pins', 'Flanges & collars', 'Threaded components'],
    tolerance: '±0.01mm',
    materials: 'Steel 1045/4140, Brass C360, Aluminum 2011-T3 / 6061-T6',
  },
  {
    title: 'Mill-Turn Compound',
    items: ['Complex rotary parts', 'Off-center features', 'Cross-drilled holes', 'Integrated multi-process parts'],
    tolerance: '±0.005mm',
    materials: 'Stainless 303/304, Titanium TC4, Inconel 718',
  },
  {
    title: 'Drilling & Tapping',
    items: ['Multi-hole plates', 'Threaded hole clusters', 'Deep-hole drilling', 'Tapping'],
    tolerance: '±0.01mm',
    materials: 'All metals & engineering plastics',
  },
  {
    title: 'Post-Processing & Surface Treatment',
    items: ['Anodizing (sandblasted/polished)', 'Passivation & plating', 'Heat treatment (hardening/carburizing)', 'Painting & silk-screening'],
    processes: 'Anodizing, passivation, plating, heat treatment, painting, silk-screening',
    value: 'Improved corrosion/wear resistance and cosmetic finish for turn-key delivery',
  },
];

const standards = [
  { label: 'Surface Finish Control', desc: 'Roughness measured by profilometer. Anodizing, passivation, plating and painting available.' },
  { label: 'Dimensional Inspection', desc: "First-article and sampling use CMM verification (via our group's shared metrology center on request), compliant with ISO 2768-m and AQL 2.5 sampling standards." },
  { label: 'Material Traceability', desc: 'EN 10204 3.1 material certificates provided for every batch, fully traceable.' },
  { label: 'Quality Documentation', desc: 'PPAP, FAI reports, and full inspection records available for production orders.' },
];
---

<PageLayout
  title="CNC Machining Services | Precision Milling & Turning | Eternal CNC"
  description="Precision CNC machining services — 3-axis, 4-axis, 5-axis, and high-speed milling. From prototype to mass production."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Services</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC Machining Services
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        3-axis, 4-axis, 5-axis, and high-speed milling — one-stop CNC machining from prototype to mass production.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/services/dfm-analysis" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Capabilities</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">By Machining Process</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We machine parts across six core processes. Critical dimensions are checked in-house with precision gauges and 2.5D optical inspection; complete CMM measurement is available via our group's shared metrology center on request.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              {cap.processes ? (
                <>
                  <p class="text-xs mb-1" style="color: var(--text-muted);">Core Processes</p>
                  <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.processes}</p>
                  <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Value Proposition</p>
                  <p class="text-sm" style="color: var(--text-body);">{cap.value}</p>
                </>
              ) : (
                <>
                  <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
                  <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
                  <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Common Materials</p>
                  <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Machining Process Showcase -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">In Action</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Machining Process Gallery</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Real machining scenes and finished parts from our workshop floor.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-machining-milling-process-worm-shaft-coolant-01.webp" alt="CNC machining in action with milling and coolant" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">CNC Milling in Action</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-machining-coolant-spray-aluminum-housing-milling-01.webp" alt="CNC milling with coolant spray on cylindrical part" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Coolant Spray Milling</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/machines/cnc-5axis-machining-center-coolant-cutting-hero-01.webp" alt="5-axis CNC machining center for complex parts" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">5-Axis Machine Center</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-milling-complex-aluminum-part-coolant-01.png" alt="CNC machining center milling complex aluminum profile part with coolant spray" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Complex Aluminum Housings</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-precision-spindle-machining-closeup-01.png" alt="CNC high-precision spindle and tool holder machining close-up" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Precision Components</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-coolant-flush-aluminum-housing-01.png" alt="CNC machining center milling complex aluminum housing with coolant flushing" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Complex Cavity Machining</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/screws-batch/cnc-machined-screw-batch-showcase.webp" alt="5-axis machined sample part" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">5-Axis Sample Part</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-multi-tool-aluminum-bracket-coolant-01.png" alt="CNC machining center multi-flute milling aluminum bracket with coolant spray" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Custom Brackets</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every order follows our full quality control process.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need CNC Machined Parts?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawings. Our engineers will provide a quote and DFM feedback within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
