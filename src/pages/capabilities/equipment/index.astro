const categories = [
  { name: '5-Axis Machining Centers', color: '#8B0000' },
  { name: 'Vertical Machining Centers', color: '#1a1a1a' },
  { name: 'Drill-Tap / Drill-Mill Centers', color: '#2563eb' },
  { name: 'Mold Engraving Machines', color: '#059669' },
];

const standards = [
  { label: 'Equipment Calibration', desc: 'All machines calibrated quarterly. Spindle run-out checked before every production run.' },
  { label: 'Preventive Maintenance', desc: 'Scheduled maintenance ensures consistent accuracy and uptime across all machines.' },
  { label: 'Capacity Monitoring', desc: 'Real-time load tracking allows flexible scheduling for rush orders and mass production.' },
  { label: 'ISO Compliance', desc: 'Quality management system certification in progress. All processes follow ISO-aligned procedures.' },
];

// JSON-LD structured data for SEO
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Eternal CNC Equipment List',
  description: 'Full CNC equipment matrix at Eternal CNC precision machining facility — 5-axis, VMC, drill-tap, and mold engraving — all nameplate verified.',
  itemListElement: equipment.map((eq, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: `${eq.brandEn} ${eq.model} ${eq.type}`,
      category: eq.type,
      brand: { '@type': 'Brand', name: eq.brandEn },
      model: eq.model,
      additionalProperty: eq.specs.map(s => ({
        '@type': 'PropertyValue',
        name: s.label,
        value: s.value,
      })),
    },
  })),
};
---

<PageLayout
  title="CNC Equipment List – 5-Axis · VMC · Drill-Tap · Engraving | Eternal CNC"
  description={`Full CNC equipment matrix at Eternal CNC: 5-axis machining, vertical machining centers, drill-tap centers, and mold engraving — all verified with nameplate photos.`}
  breadcrumbs={breadcrumbs}
  schema={itemListSchema}
>
  {/* Hero */}
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Capabilities</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Equipment List
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Diversified mainstream CNC equipment matrix — covering 5-axis simultaneous machining, high-speed drill-tap production and precision mold engraving.
        Strict calibration and maintenance standards ensure consistent machining precision.
      </p>

      {/* Equipment Categories */}
      <div class="flex flex-wrap gap-x-4 gap-y-2 mt-8">
        {categories.map((cat, i) => (
          <span class="text-sm font-medium" style="color: var(--text-body);">
            {cat.name}{i < categories.length - 1 ? '  |' : ''}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>

  {/* Equipment List */}
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Our Fleet</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Complete Machine List</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Below is every CNC machine in our facility — with real photos, nameplate-verified model numbers, and full technical specifications.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {equipment.map((eq) => (
          <div class={`border rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`} style={`background-color: var(--card-white); border-color: var(--border-color);`}>
            {/* Image */}
            <div class="relative h-48 bg-gray-100 overflow-hidden">
              {eq.image ? (
                <img
                  src={eq.image}
                  alt={eq.imageAlt}
                  width="400" height="300"
                  loading="lazy" decoding="async"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                  Photo coming soon
                </div>
              )}
              {/* Badge */}
              <span class="absolute top-3 left-3 text-xs font-semibold text-white px-2.5 py-1 rounded" style={`background-color: ${eq.badgeColor};`}>
                {eq.typeBadge}
              </span>
                          </div>

            {/* Content */}
            <div class="p-5">
              <p class="text-xs font-medium mb-1" style="color: var(--text-muted);">{eq.brand}</p>
              <h3 class="text-lg font-bold mb-1" style="color: var(--brand-dark);">
                {eq.brandEn} {eq.model}
              </h3>
              <p class="text-sm mb-3" style="color: var(--text-body);">{eq.type}</p>
              {/* Spec table */}
              <table class="w-full text-xs mb-4">
                <tbody>
                  {eq.specs.map((spec) => (
                    <tr class="border-b" style="border-color: var(--border-color);">
                      <th scope="row" class="py-1.5 pr-3 text-left font-medium whitespace-nowrap" style="color: var(--text-muted);">{spec.label}</th>
                      <td class="py-1.5 text-right" style="color: var(--brand-dark);">{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              {/* Applications */}
              <p class="text-xs" style="color: var(--text-body);">
                <span class="font-medium" style="color: var(--text-muted);">Applications: </span>
                {eq.applications}
              </p>

              {eq.detail && (
                <a href={eq.detail} class="inline-flex items-center gap-1 mt-3 text-xs font-semibold transition-colors" style="color: var(--brand-red);">
                  View machine details
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Quality Standards */}
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Equipment Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every machine is maintained and calibrated to ensure consistent part quality.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need precision-machined parts?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and receive a quote within 24 hours with DFM feedback.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>

  {/* Equipment Gallery */}
  <section class="section-padding" style="background-color: var(--page-bg); padding-bottom: 120px;">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">Inside Our Machine Shop</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">A glimpse of our CNC equipment in action.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="rounded-industrial overflow-hidden aspect-square">
          <img src="/images/equipment/gallery/cnc-5axis-machine-01.webp" alt="5-axis CNC machining center close up" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
        </div>
        <div class="rounded-industrial overflow-hidden aspect-square">
          <img src="/images/equipment/gallery/cnc-workshop-cato-vertical-machining-center-lineup-01.webp" alt="CATO CT-80 vertical machining center at Eternal CNC factory" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
        </div>
        <div class="rounded-industrial overflow-hidden aspect-square">
          <img src="/images/equipment/gallery/cnc-5axis-machine-03.webp" alt="5-axis CNC machine spindle in operation" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
        </div>
        <div class="rounded-industrial overflow-hidden aspect-square">
          <img src="/images/equipment/gallery/cnc-machine-closeup-03.webp" alt="Taikan T-V1270S heavy-duty VMC control panel at Eternal CNC" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
        </div>
        <div class="rounded-industrial overflow-hidden aspect-square">
          <img src="/images/equipment/gallery/cnc-workshop-greato-vertical-machining-center-lineup-01.webp" alt="Taikan T-V series drill-mill machining center" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
        </div>
        <div class="rounded-industrial overflow-hidden aspect-square">
          <img src="/images/equipment/gallery/cnc-workshop-machining-center-bay-overview-01.webp" alt="CNC machining center enclosure" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="400" />
