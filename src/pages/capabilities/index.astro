---
import PageLayout from '../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Capabilities' },
];

const capabilities = [
  {
    title: 'Equipment List',
    items: ['Full range of brands & models', '30 machines in family network', 'Complete specs published', 'Workshop photos available'],
    detail: 'Details',
    link: '/capabilities/equipment',
  },
  {
    title: 'Tolerance Standards',
    items: ['Milling ±0.005mm', 'Turning ±0.01mm', 'Grinding ±0.01mm', 'Wire EDM ±0.01mm'],
    detail: 'Details',
    link: '/capabilities/tolerance',
  },
  {
    title: 'Material Range',
    items: ['Aluminum 6061/7075', 'Stainless 304/316/4340', 'Copper Alloy C360', 'Engineering Plastics POM/PEEK'],
    detail: 'Details',
    link: '/capabilities/materials',
  },
  {
    title: 'Size Range',
    items: ['Max travel X-axis 850mm', 'Max turning diameter 400mm', '5-axis simultaneous machining', 'Large parts negotiable'],
    detail: 'Details',
    link: '/capabilities/size-range',
  },
  {
    title: 'Lead Time',
    items: ['Prototyping 3-7 days', 'Mass production 15-30 days', 'Rush orders negotiable', 'Transparent progress tracking'],
    detail: 'Details',
    link: '/capabilities/lead-time',
  },
];

const advantages = [
  { label: 'Full Process Transparency', desc: 'From quote to delivery, every step is visible — no black-box operations.' },
  { label: 'Engineer-Direct', desc: 'Our team of engineers with 15+ years of experience handles your projects directly — zero communication barriers.' },
  { label: 'Strict Quality Control', desc: 'ISO 9001 certification in progress (target 2026). SPC and inspection reports available on request for key characteristics.' },
  { label: 'One-Stop Service', desc: 'From DFM analysis to surface treatment — no need to coordinate multiple suppliers.' },
];
---

<PageLayout
  title="Manufacturing Capabilities | Equipment · Tolerance · Materials · Size · Lead Time | Eternal CNC"
  description="Transparent machining capabilities: 30 CNC machines, ±0.005mm tolerance, full metal range, max 850mm travel, 3-7 day prototyping."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Capabilities</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Transparent Capabilities, Visible Trust
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Equipment · Tolerance · Materials · Size Range · Lead Time — all transparent and verifiable
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/capabilities/equipment" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Equipment List →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities Grid -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Capability List</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Five Core Capability Dimensions</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We believe transparency is the foundation of trust. Here are the five dimensions clients care about most.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {capabilities.map((cap) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <a href={cap.link} class="text-sm font-medium text-[#8B0000] transition-all duration-300 hover:text-[#6B0000] hover:translate-x-0.5">
                {cap.detail} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Advantages -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Core Advantages</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Why Choose Us</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        15 years of precision machining experience, serving global clients with expertise and transparency.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {advantages.map((adv) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{adv.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{adv.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">View Full Capability List</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing for a professional assessment and quote.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
