---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Capabilities', href: '/capabilities' },
  { label: 'Size Range' },
];

const capabilities = [
  {
    title: 'CNC Milling Capacity',
    items: ['Max X-axis travel: 850mm', 'Max Y-axis travel: 500mm', 'Max Z-axis travel: 400mm', 'Suitable for large plates & housings'],
    tolerance: '±0.005mm',
    materials: 'Aluminum, Steel, Stainless, Plastics',
  },
  {
    title: 'CNC Turning Capacity',
    items: ['Max swing diameter: 400mm', 'Max turning length: 700mm', 'Bar feed up to 65mm diameter', 'Live tooling for cross-features'],
    tolerance: '±0.01mm',
    materials: 'Steel, Stainless, Brass, Aluminum',
  },
  {
    title: 'Small & Micro Parts',
    items: ['Minimum feature size: 0.1mm', 'Micro drill down to 0.3mm', 'Thin-wall machining to 0.5mm', 'Ideal for connectors & medical pins'],
    tolerance: '±0.005mm',
    materials: 'Brass C360, POM, PEEK, Stainless 303',
  },
  {
    title: 'Weight & Volume Limits',
    items: ['Max part weight: 25 kg per piece', 'Batch capacity: 1–10,000 pcs', 'Fixture design for heavy parts', 'Pallet system for efficient batching'],
    tolerance: 'CMM verification via our group\'s shared metrology center on request',
    materials: 'All standard metals and plastics',
  },
];

const standards = [
  { label: 'Tolerance Stacking', desc: 'We analyze tolerance chains for multi-feature parts to ensure proper fit in assembly, even with tight specifications.' },
  { label: 'GD&T Compliance', desc: 'All drawings interpreted per ASME Y14.5 / ISO GPS. True position, profile, and runout controls applied.' },
  { label: 'Fixture Engineering', desc: 'Custom fixtures designed for complex parts — ensuring repeatability across production runs.' },
  { label: 'In-Process Verification', desc: "Critical dimensions checked mid-run using precision gauges; coordinate measurement arranged at our group's shared metrology center on request. Deviations caught before final pass." },
];
---

<PageLayout
  title="Machining Size Range – Max 850mm Travel | 400mm Swing | Eternal CNC"
  description="CNC machining size range: max X-axis 850mm, Y-axis 500mm, Z-axis 400mm, max swing diameter 400mm. Micro parts to large housings."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Capabilities</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Machining Size Range
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Max X-axis travel 850mm · Max swing diameter 400mm · Micro parts to large housings.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border transition-colors" style="border-color: var(--border-color); color: var(--text-body); border-radius: 12px;">
          View Services →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Size Envelope</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">What We Can Machine</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        From micro-precision connectors to large structural housings, our equipment covers a wide size range.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Compatible Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Precision Standards</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Size & Tolerance Control</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Advanced metrology ensures every dimension is verified against your drawing specs.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a part to quote?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and our engineers will assess the best approach for your part size.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
