---
import PageLayout from '../../layouts/PageLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const breadcrumbs = [
  { label: 'Contact', href: '#' },
  { label: 'Get a Quote' },
];
---

<PageLayout
  title="Get a Quote – Eternal CNC"
  description="Send us your drawing and get a detailed CNC machining quote within 24 hours."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="quote-hero">
    <div class="hero-container">
      <span class="hero-tag">GET A QUOTE</span>
      <h1>Transparent Quotes, Instant Feedback</h1>
      <p class="hero-subtitle">
        Equipment · Tolerance · Materials · Size Range · Lead Time — upload your drawing for a precise quote within 24 hours.
      </p>
      <div class="hero-actions">
        <a href="/contact/get-a-quote" class="btn btn-primary">Get a Quote</a>
        <a href="/capabilities" class="btn btn-outline">View Equipment List →</a>
      </div>
    </div>
  </section>

  <!-- Quote Form Section -->
  <section class="py-16 bg-brand-bgAlt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteForm />
    </div>
  </section>

  <!-- Contact Info -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl text-brand-text mb-8">Contact Information</h2>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-10 h-10 bg-brand-bgAlt rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-5 h-5 text-brand-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-brand-text mb-1">Address</h3>
                <p class="text-brand-secondary text-sm">Building 101, No.33 Guangjin Road,<br />Shapu, Songgang Street, Bao'an District,<br />Shenzhen, China</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-10 h-10 bg-brand-bgAlt rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-5 h-5 text-brand-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-brand-text mb-1">Email</h3>
                <p class="text-brand-secondary text-sm">sales@eternalcnc.com</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-10 h-10 bg-brand-bgAlt rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-5 h-5 text-brand-silver" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <h3 class="font-medium text-brand-text mb-1">WhatsApp</h3>
                <p class="text-brand-secondary text-sm"><a href="https://wa.me/8618123983352" target="_blank" rel="noopener" style="color: var(--brand-red);">+86 181 2398 3352</a> — fastest reply for drawings &amp; quotes</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-10 h-10 bg-brand-bgAlt rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-5 h-5 text-brand-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-brand-text mb-1">Working Hours</h3>
                <p class="text-brand-secondary text-sm">Mon – Sat, 9:00 AM – 6:00 PM (CST)</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl text-brand-text mb-8">Find Us</h2>
          <div class="rounded-xl h-80 flex items-center justify-center" style="background-color: var(--page-bg); border: 1px solid var(--border-color);">
            <div class="text-center text-brand-silver">
              <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="text-sm">Bao'an District, Shenzhen, China</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
<script>
  // Force page content SVG icons to brand dark red (exclude footer)
  document.querySelectorAll('main svg, section svg, .quote-hero svg').forEach(svg => {
    if (svg.closest('footer')) return;
    svg.style.color = '#8B0000';
    svg.querySelectorAll('[stroke]').forEach(el => {
      el.setAttribute('stroke', '#8B0000');
    });
    svg.querySelectorAll('[fill]:not([fill="none"])').forEach(el => {
      el.setAttribute('fill', '#8B0000');
    });
  });
</script>

<style>
  /* ===== Hero Section ===== */
  .quote-hero {
    min-height: 230px;
    padding: 60px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: #FAFAFA;
    border-bottom: 1px solid #EEEEEE;
  }
  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: left;
  }
  .hero-tag {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #8B0000;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-family: 'Inter', sans-serif;
  }
  .quote-hero h1 {
    font-size: 42px;
    font-weight: 900;
    color: #1A1A1A;
    margin-bottom: 16px;
    font-family: 'Inter', 'Noto Sans SC', 'SimHei', 'Microsoft YaHei', sans-serif;
    line-height: 1.2;
  }
  .hero-subtitle {
    font-size: 16px;
    color: #666666;
    font-weight: 400;
    margin-bottom: 32px;
    line-height: 1.6;
    font-family: 'Inter', 'Noto Sans SC', sans-serif;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
    font-family: 'Inter', 'Noto Sans SC', sans-serif;
  }
  .btn-primary {
    background-color: #8B0000;
    color: #FFFFFF;
    border: 1px solid #8B0000;
  }
  .btn-primary:hover {
    background-color: #6B0000;
    border-color: #6B0000;
  }
  .btn-outline {
    background-color: transparent;
    color: #333333;
    border: 1px solid #CCCCCC;
  }
  .btn-outline:hover {
    border-color: #8B0000;
    color: #8B0000;
  }
  /* ===== Full-page icon brand red override ===== */
  .quote-hero svg,
  form svg,
  [class*="icon"] svg,
  [class*="card"] svg,
  [class*="feature"] svg {
    stroke: #8B0000 !important;
    color: #8B0000 !important;
  }
  [class*="icon-wrapper"],
  [class*="icon-container"],
  [class*="step-num"] {
    background-color: rgba(139, 0, 0, 0.08) !important;
    color: #8B0000 !important;
  }
</style>