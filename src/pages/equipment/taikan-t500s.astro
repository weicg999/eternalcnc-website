---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Taikan T-500S Drill-Mill Machining Center | 500x400x300mm | Eternal CNC" description="Compact BT30 drill-mill center for high-speed batch processing of small to medium aluminum parts, with 500 x 400 x 300 mm travel and 21-tool servo magazine.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Drill-Mill Center</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">Taikan T-500S</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">Compact BT30 drill-mill center for high-speed batch processing of small to medium aluminum parts, with 500 x 400 x 300 mm travel and 21-tool servo magazine.</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT30 20,000 rpm</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">500 mm Travel</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">21 Servo ATC</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-taikan-t500s-hero.webp" alt="Taikan T-500S drill-mill machining center at Eternal CNC factory" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of Taikan T-500S · Multiple units in-house</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">Overview</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">The Taikan T-500S is a compact drill-mill machining center optimized for high-volume small parts. Its BT30 20,000 rpm spindle and 21-tool servo magazine handle drilling, tapping, and light milling operations efficiently on aluminum and non-ferrous alloys.</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">As part of our in-house workshop, the T-500S complements our larger VMCs by handling high-throughput small-part orders with quick changeover times, ensuring fast turnaround for prototype and production quantities alike.</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Technical Specifications</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">Travel (X / Y / Z)</td><td style="padding:0.8rem 1rem;color:var(--text-body)">500 / 400 / 300 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Spindle Taper</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">BT30</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Spindle Speed</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">20,000 rpm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Tool Magazine</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">21 tools, servo-type</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Control System</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">Mitsubishi / Fanuc</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Why This Machine</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">High-Speed BT30 Spindle</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">20,000 rpm spindle delivers clean surface finish on aluminum and non-ferrous parts.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">21-Tool Servo Magazine</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Fast tool changes support complex drill-tap-mill cycles in a single setup.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Compact Footprint</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Space-efficient design allows flexible cell layout and easy integration.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Batch Production Optimized</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Fast rapid traverse and short tool change times maximize throughput for small parts.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">In-House Capacity</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Part of a multi-machine cell — your order scales seamlessly from prototypes to batches.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Reliable Control System</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Mitsubishi or Fanuc control ensures program stability and easy operator familiarity.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Taikan T-500S Drill-Mill Machining Center",
  "brand": { "@type": "Brand", "name": "Taikan" },
  "model": "T-500S",
  "description": "Compact BT30 drill-mill center for high-speed batch processing of small to medium aluminum parts, with 500 x 400 x 300 mm travel and 21-tool servo magazine.",
  "image": "https://eternalcnc.com/images/equipment/equipment-taikan-t500s-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Travel (X / Y / Z)", "value": "500 / 400 / 300 mm" },
    { "@type": "PropertyValue", "name": "Spindle Taper", "value": "BT30" },
    { "@type": "PropertyValue", "name": "Spindle Speed", "value": "20,000 rpm" },
    { "@type": "PropertyValue", "name": "Tool Magazine", "value": "21 tools, servo-type" },
    { "@type": "PropertyValue", "name": "Control System", "value": "Mitsubishi / Fanuc" }
  ]
}
</script>

</BaseLayout>
