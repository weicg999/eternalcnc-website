---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Hexagon INSPECTOR CLASSIC CMM | 06.08.06 | Eternal CNC" description="Bridge-type coordinate measuring machine with 730 kg granite platform and sub-micron accuracy, operated by our group's shared metrology center, available to Eternal CNC for on-request coordinate measurement (not in-house standard equipment at our own plant).">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:#8B0000;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Quality Inspection</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:#1a1a1a;line-height:1.2;margin-bottom:1rem">Hexagon INSPECTOR CLASSIC 06.08.06</h1>
    <p style="font-size:1.05rem;color:#555;margin-bottom:1.5rem;line-height:1.6">Bridge-type coordinate measuring machine with 730 kg granite platform - available to Eternal CNC for on-request coordinate measurement through our group's shared metrology center (not in-house standard equipment; located a certain distance from our workshop).</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background:#8B0000;color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">Sub-Micron Accuracy</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">730 kg Granite</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">PC-DMIS Software</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp" alt="Hexagon INSPECTOR CLASSIC Bridge CMM" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:contain;" />
  </div>
  <p style="font-size:0.8rem;color:#999;text-align:center;margin-top:0.8rem;">Representative unit of Hexagon INSPECTOR CLASSIC · Available for on-request coordinate measurement via our group's shared metrology center</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem">Overview</h2>
    <p style="font-size:0.95rem;color:#555;line-height:1.7;margin-bottom:0.8rem">Eternal CNC parts can be sent to our group's shared metrology center's Hexagon INSPECTOR CLASSIC 06.08.06 - a bridge-type coordinate measuring machine - for inspection. Built on a 730 kg granite platform for thermal stability, it delivers sub-micron 3D inspection on critical dimensions: true position, profile, runout, flatness, you name it.</p>
    <p style="font-size:0.95rem;color:#555;line-height:1.7">For critical parts, we arrange coordinate measurement at this our group's shared metrology center and provide a full CMM report on request. For our buyers, that means verified dimensions on arrival.</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">Technical Specifications</h2>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;width:40%">Brand / Model</td><td style="padding:0.8rem 1rem;color:#555">Hexagon INSPECTOR CLASSIC 06.08.06</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Machine Type</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Bridge-type CMM</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Serial Number</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">100211946CI</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Build Date</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">2021-05</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Travel (X / Y / Z)</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">600 / 800 / 600 mm (class)</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Platform</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Granite, approx. 730 kg</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Software</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Hexagon PC-DMIS (standard)</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Accuracy Class</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Sub-micron (UMC class)</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Power Supply</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Single-phase 220V, approx. 1 kVA</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Certification</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">CE</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Manufacturer</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Hexagon Manufacturing Intelligence (Qingdao)</td></tr>
      </table>
    </div>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:#fafafa;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">Why This Machine</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Hexagon OEM Build Quality</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Factory-built and calibrated by Hexagon Manufacturing Intelligence - the global leader in metrology.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">730 kg Granite Platform</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Massive granite base delivers exceptional thermal stability and vibration damping for consistent readings.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Sub-Micron 3D Accuracy</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">True bridge-CMM precision - position, profile, runout and flatness all verified at micron-level tolerance.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Full-Dimensional Inspection Reports</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Every critical feature gets a signed-off PC-DMIS report - no guesswork, just data you can trust.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">True 3D CMM, Not 2.5D Vision</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Full bridge-type coordinate measurement with tactile probing - capable of complex 3D geometries, not just flat parts.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">CE Certified, China-Built</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Manufactured by Hexagon Qingdao to global standards - European quality control, domestic support network.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem;">Verified Equipment</h3>
    <p style="font-size:0.9rem;color:#666;margin-bottom:1.2rem;line-height:1.6;">This page features the Hexagon INSPECTOR CLASSIC CMM operated by our group's shared metrology center that provides coordinate measurement for Eternal CNC. The nameplate confirms the model, serial number and build record for full traceability.</p>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp" alt="Hexagon INSPECTOR CLASSIC nameplate verification" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:#999;margin-top:0.8rem;">Hexagon INSPECTOR CLASSIC nameplate</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Hexagon INSPECTOR CLASSIC 06.08.06 Bridge CMM",
  "brand": { "@type": "Brand", "name": "Hexagon" },
  "model": "INSPECTOR CLASSIC 06.08.06",
  "description": "Bridge-type coordinate measuring machine with 730 kg granite platform and sub-micron accuracy, operated by our group's shared metrology center, available to Eternal CNC for on-request coordinate measurement (not in-house standard equipment).",
  "image": "https://eternalcnc.com/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Machine type", "value": "Bridge-type CMM" },
    { "@type": "PropertyValue", "name": "X/Y/Z travel", "value": "600/800/600 mm" },
    { "@type": "PropertyValue", "name": "Platform", "value": "Granite, approx. 730 kg" },
    { "@type": "PropertyValue", "name": "Software", "value": "PC-DMIS" },
    { "@type": "PropertyValue", "name": "Accuracy", "value": "Sub-micron (UMC class)" },
    { "@type": "PropertyValue", "name": "Certification", "value": "CE" },
    { "@type": "PropertyValue", "name": "Serial number", "value": "100211946CI" }
  ]
}
</script>

</BaseLayout>
