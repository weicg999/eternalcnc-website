---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Taikan T-700SE Vertical Machining Center | 700x420x520mm | Eternal CNC" description="Heavy-duty VMC with BT40 12000 rpm direct-drive spindle and 24-pocket arm changer for mid-to-large aluminum and steel parts.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:#8B0000;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Vertical Machining Center</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:#1a1a1a;line-height:1.2;margin-bottom:1rem">Taikan T-700SE</h1>
    <p style="font-size:1.05rem;color:#555;margin-bottom:1.5rem;line-height:1.6">Heavy-duty BT40 milling, drilling and tapping for mid-to-large aluminum and steel parts, built for stable production runs.</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background:#8B0000;color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT40 12,000 rpm</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">24 Arm-Type ATC</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">±0.005 mm Repeatability</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-taikan-t700se-hero.webp" alt="Taikan T-700SE Vertical Machining Center" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:#999;text-align:center;margin-top:0.8rem;">Representative unit of Taikan T-700SE · Multiple units in-house</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem">Overview</h2>
    <p style="font-size:0.95rem;color:#555;line-height:1.7;margin-bottom:0.8rem">The Taikan T-700SE is the workhorse of our heavy-duty three-axis cell. With a generous 700 x 420 x 520 mm travel and a rigid BT40 direct-drive spindle running at 12,000 rpm, it powers through 6061/7075 aluminum plates, carbon steel brackets and stainless fixtures without breaking a sweat.</p>
    <p style="font-size:0.95rem;color:#555;line-height:1.7">Multiple units run in our in-house workshop, giving us overflow capacity to scale from 10 prototypes to 10,000 production pieces - all under one roof, with key dimensions verified on our in-house 2.5D vision measuring system before shipment; full CMM verification arranged at our group's shared metrology center on request.</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">Technical Specifications</h2>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;width:40%">Travel (X / Y / Z)</td><td style="padding:0.8rem 1rem;color:#555">700 / 420 / 520 mm</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Table Size</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">900 x 420 mm</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Table Load</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">500 kg (even load)</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Spindle Taper</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">BT40 (BBT40 optional)</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Spindle Speed</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">12,000 rpm (direct-drive)</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Spindle Power</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">7.5 kW (rated) / 11 kW (15 min)</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Tool Magazine</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">24 pockets, arm-type</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Rapid Traverse</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">48 / 48 / 48 m/min</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Positioning Accuracy</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">±0.008 mm / 300 mm</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Repeatability</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">±0.005 mm</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">CNC System</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">Mitsubishi M80B / Fanuc 0i-MF</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Machine Weight</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">~4,800 kg</td></tr>
      </table>
    </div>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:#fafafa;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">Why This Machine</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">BT40 12,000 rpm Direct-Drive Spindle</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">High torque, low vibration, clean surface finish on aluminum - no secondary polishing needed.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">24-Pocket Arm-Type Tool Changer</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Complex drill-tap-mill cycles in one setup, tool-to-tool approximately 3.2 seconds.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">In-House Redundancy</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Multiple T-700SE units in our workshop - your lead time never depends on a single machine.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">±0.005 mm Repeatability</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Critical for batch consistency, key dimensions checked on our in-house 2.5D vision system; full CMM reports on request.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Rigid Cast Iron Base</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Finite-element-optimized structure, stable under heavy chip loads and deep cuts.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Mitsubishi M80B / Fanuc 0i-MF Options</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Global support ecosystem, smooth high-speed contouring and reliable program execution.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem;">Verified Equipment</h3>
    <p style="font-size:0.9rem;color:#666;margin-bottom:1.2rem;line-height:1.6;">This page features a representative Taikan T-700SE unit from our factory. The machine nameplate confirms the model and build record, ensuring full traceability for your project.</p>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/equipment/cnc-machine-taikan-t700se-drill-mill-machining-center-01.webp" alt="Representative nameplate of Taikan T-700SE" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:#999;margin-top:0.8rem;">Representative nameplate of Taikan T-700SE</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Taikan T-700SE Vertical Machining Center",
  "brand": { "@type": "Brand", "name": "Taikan" },
  "model": "T-700SE",
  "description": "Heavy-duty VMC with BT40 12000 rpm direct-drive spindle and 24-pocket arm changer, part of Eternal CNC's in-house manufacturing facility.",
  "image": "https://eternalcnc.com/images/equipment/equipment-taikan-t700se-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "X/Y/Z travel", "value": "700/420/520 mm" },
    { "@type": "PropertyValue", "name": "Spindle", "value": "BT40 12000 rpm direct-drive" },
    { "@type": "PropertyValue", "name": "Tool magazine", "value": "24 pockets, arm-type" },
    { "@type": "PropertyValue", "name": "Repeatability", "value": "±0.005 mm" },
    { "@type": "PropertyValue", "name": "CNC System", "value": "Mitsubishi M80B / Fanuc 0i-MF" }
  ]
}
</script>

</BaseLayout>
