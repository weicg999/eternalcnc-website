---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="XINTENGHUI XTH-T540 Mold Engraving / Drill-Tap Center | Eternal CNC" description="Versatile mold engraving and drill-tap center with high-speed motorized spindle up to 36,000 rpm, capable of aluminum high-gloss finishing, graphite electrode machining and precision mold engraving.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-dark);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Engraving Center</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">XINTENGHUI XTH-T540</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">Versatile mold engraving and drill-tap center with high-speed motorized spindle up to 36,000 rpm, capable of aluminum high-gloss finishing, graphite electrode machining and precision mold engraving.</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-dark);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">24,000-36,000 rpm</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">Mold Engraving</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">High-Gloss Finishing</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-xinthenghui-xtht540-hero.webp" alt="XINTENGHUI CNC XTH-T540 mold engraving machining center at Eternal CNC factory" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of XINTENGHUI XTH-T540 · Multiple units in-house</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">Overview</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">The XINTENGHUI XTH-T540 is a versatile engraving and drill-tap machine equipped with a high-speed motorized spindle ranging from 24,000 to 36,000 rpm. It handles a wide range of applications including aluminum high-gloss finishing, fiberglass machining, graphite electrode production, and precision mold engraving, all with fine surface quality.</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">As part of our in-house workshop, the XTH-T540 fills the gap between standard milling and ultra-precision work. Its BT30 or ER collet tooling options give us flexibility to handle everything from engraving details to standard drilling and tapping operations.</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Technical Specifications</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">Worktable</td><td style="padding:0.8rem 1rem;color:var(--text-body)">~500 x 400 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Spindle</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">High-speed motorized, 24,000-36,000 rpm</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Tool Holder</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">BT30 or ER collet</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Rapid Traverse</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">&gt;= 20,000 mm/min</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Why This Machine</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Ultra-High-Speed Spindle</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Up to 36,000 rpm motorized spindle delivers mirror-quality finish on aluminum and fine detail on molds.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Multi-Process Versatility</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Handles mold engraving, drill-tap, high-gloss finishing and electrode machining on one machine.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Aluminum High-Gloss Capability</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Specialized for high-gloss aluminum finishing that standard VMCs cannot match.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Graphite & Fiberglass Ready</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Capable of machining graphite electrodes and fiberglass materials with appropriate setup.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Flexible Tooling Options</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">BT30 or ER collet tool holders adapt to different job requirements quickly.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Precision Mold Engraving</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Fine detail engraving capability for injection molds, fixtures and precision components.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "XINTENGHUI XTH-T540 Mold Engraving / Drill-Tap Center",
  "brand": { "@type": "Brand", "name": "XINTENGHUI CNC" },
  "model": "XTH-T540",
  "description": "Versatile mold engraving and drill-tap center with high-speed motorized spindle up to 36,000 rpm, capable of aluminum high-gloss finishing, graphite electrode machining and precision mold engraving.",
  "image": "https://eternalcnc.com/images/equipment/equipment-xinthenghui-xtht540-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Worktable", "value": "~500 x 400 mm" },
    { "@type": "PropertyValue", "name": "Spindle", "value": "High-speed motorized, 24,000-36,000 rpm" },
    { "@type": "PropertyValue", "name": "Tool Holder", "value": "BT30 or ER collet" },
    { "@type": "PropertyValue", "name": "Rapid Traverse", "value": ">= 20,000 mm/min" }
  ]
}
</script>

</BaseLayout>
