---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="WANGHUI XH-540 Mold Engraving Machining Center | Eternal CNC" description="Mold engraving and machining center with high-speed motorized spindle, designed for mold engraving, jig machining and batch drilling/tapping of aluminum workpieces.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
    <div>
      <p style="font-size:0.85rem;color:var(--brand-dark);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem;">Engraving / VMC</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;">WANGHUI XH-540</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;">Mold engraving and machining center with high-speed motorized spindle, designed for mold engraving, jig machining and batch drilling/tapping of aluminum workpieces.</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
        <span style="display:inline-block;background-color:var(--brand-dark);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">High-Speed Spindle</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Mold Engraving</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Jig Machining</span>
      </div>
    </div>
    <div style="border-left:2px solid var(--border-color);padding-left:2rem;">
      <p style="font-size:0.85rem;color:var(--brand-dark);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem;text-align:right;">雕铣/加工中心</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;text-align:right;">望辉机械 XH-540</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;text-align:right;">配备高速电主轴的模具雕铣加工中心，适用于模具雕铣、治具加工及铝件批量攻钻。</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:flex-end;">
        <span style="display:inline-block;background-color:var(--brand-dark);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">高速电主轴</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">模具雕铣</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">治具加工</span>
      </div>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-wanghui-xh540-hero.webp" alt="WANGHUI XH-540 mold engraving machining center at Eternal CNC factory" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of WANGHUI XH-540 · Multiple units in our family network</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Overview</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;">The WANGHUI XH-540 is a dedicated mold engraving machining center equipped with a high-speed motorized spindle running at approximately 24,000 rpm. It is purpose-built for mold engraving work, jig and fixture machining, and batch drilling and tapping of aluminum parts, combining engraving precision with general machining versatility.</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;">Within our associated shop network, the XH-540 serves as a specialized engraving resource that complements our standard VMC fleet. Its servo-driven system delivers reliable accuracy for both mold detail work and production drilling/tapping jobs.</p>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;text-align:right;">设备概述</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;text-align:right;">望辉 XH-540 是一款专业模具雕铣加工中心，配备约 24000 转高速电主轴。专为模具雕铣、治具夹具加工以及铝件批量钻攻而设计，兼顾雕铣精度与通用加工灵活性。</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;text-align:right;">在集团协作产能网络中，XH-540 作为专业雕铣资源与标准立加机群形成互补。伺服驱动系统为模具精细加工和量产钻攻提供稳定可靠的精度。</p>
    </div>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;">Technical Specifications</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;">Worktable</td><td style="padding:0.8rem 1rem;color:var(--text-body);">~500 x 400 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Spindle</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">High-speed motorized, ~24,000 rpm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Drive System</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">Servo motor drive</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Application</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">Mold engraving, jig machining, aluminum drilling & tapping</td></tr>
        </table>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;text-align:right;">技术参数</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;">工作台</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;">约 500 x 400 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">主轴</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">高速电主轴，约 24,000 rpm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">驱动系统</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">伺服电机驱动</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">应用</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">模具雕铣、治具加工、铝件攻钻</td></tr>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
