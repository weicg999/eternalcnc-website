---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Jiafu JF-500 Drill-Tap Machining Center | 500x400x300mm | Eternal CNC" description="Compact drill-tap center with BT30 20,000 rpm spindle and servo tool magazine, built for high-speed batch processing of 3C electronics and small aluminum/copper parts.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
    <div>
      <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem;">Drill-Tap Center</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;">Jiafu JF-500</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;">Compact drill-tap center with BT30 20,000 rpm spindle and servo tool magazine, built for high-speed batch processing of 3C electronics and small aluminum/copper parts.</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
        <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">BT30 20,000 rpm</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">500 mm Travel</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Servo Tool Changer</span>
      </div>
    </div>
    <div style="border-left:2px solid var(--border-color);padding-left:2rem;">
      <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem;text-align:right;">钻攻中心</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;text-align:right;">佳富 JF-500</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;text-align:right;">紧凑型钻攻中心，BT30 20000 转主轴配伺服刀库，专为 3C 电子和小型铝铜件的高速批量加工而设计。</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:flex-end;">
        <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">BT30 20000 转</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">500 mm 行程</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">伺服刀库</span>
      </div>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-jiafu-jf500-hero.webp" alt="Jiafu JF-500 CNC drill-tap machining center at Eternal CNC factory" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of Jiafu JF-500 · Multiple units in our family network</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Overview</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;">The Jiafu JF-500 is a compact drill-tap machining center that combines high spindle speed with fast tool changes for efficient small-part production. Its BT30 20,000 rpm spindle and 16/21-tool servo magazine handle drilling, tapping, and light milling on aluminum, copper, and other non-ferrous materials.</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;">As part of our associated shop network, the JF-500 handles high-volume 3C electronics and small hardware orders with reliable repeatability. All parts are quality-checked on our in-house measuring equipment before delivery.</p>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;text-align:right;">设备概述</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;text-align:right;">佳富 JF-500 是一款紧凑型钻攻加工中心，高转速主轴配合快速换刀，小零件生产效率高。BT30 20000 转主轴搭配 16 或 21 把伺服刀库，可完成铝、铜及其他有色金属的钻孔、攻丝和轻铣加工。</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;text-align:right;">作为集团协作产能网络的一员，JF-500 以稳定的重复精度承接大批量 3C 电子和小五金订单。所有零件出货前均经厂内检测设备质量检验。</p>
    </div>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;">Technical Specifications</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;">Travel (X / Y / Z)</td><td style="padding:0.8rem 1rem;color:var(--text-body);">500 / 400 / 300 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Spindle</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">BT30, max 20,000 rpm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Tool Magazine</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">16 or 21 tools, servo-type</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Rapid Traverse</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">48,000-60,000 mm/min</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Control System</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">Mitsubishi or Fanuc</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Serial No.</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">870705107</td></tr>
        </table>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;text-align:right;">技术参数</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;">500 / 400 / 300 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">主轴</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">BT30，最高 20,000 rpm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">刀库容量</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">16 或 21 把，伺服式</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">快速移动</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">48,000-60,000 mm/min</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">控制系统</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">三菱或发那科</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">机械编号</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">870705107</td></tr>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
