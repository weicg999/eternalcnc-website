---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="SUNRISE DMU-400 5-Axis Machining Center | 500x450x400mm | Eternal CNC" description="Gantry-type 5-axis machining center with DD torque motor rotary table, BBT40 12000 rpm spindle and 24-tool arm changer for complex surfaces and impellers.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">5-Axis Machining Center</p>
    <h1 style="font-size:2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">SUNRISE DMU-400<br/>5-Axis VMC</h1>
    <p style="font-size:1rem;color:var(--text-body);line-height:1.7;margin-bottom:1.5rem">
      Gantry-type 5-axis machining center with direct-drive rotary table, engineered for complex 3D surfaces, impellers and molds.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:1.5rem">
      <span style="padding:0.3rem 0.8rem;background:var(--page-bg);border:1px solid var(--border-color);border-radius:4px;font-size:0.8rem;color:var(--text-body)">X 500 mm</span>
      <span style="padding:0.3rem 0.8rem;background:var(--page-bg);border:1px solid var(--border-color);border-radius:4px;font-size:0.8rem;color:var(--text-body)">Y 450 mm</span>
      <span style="padding:0.3rem 0.8rem;background:var(--page-bg);border:1px solid var(--border-color);border-radius:4px;font-size:0.8rem;color:var(--text-body)">Z 400 mm</span>
      <span style="padding:0.3rem 0.8rem;background:var(--page-bg);border:1px solid var(--border-color);border-radius:4px;font-size:0.8rem;color:var(--text-body)">A -120°~+30°</span>
      <span style="padding:0.3rem 0.8rem;background:var(--page-bg);border:1px solid var(--border-color);border-radius:4px;font-size:0.8rem;color:var(--text-body)">C 360°</span>
    </div>
    <div style="display:flex;gap:1rem;align-items:center">
      <span style="color:var(--brand-red);font-weight:700;font-size:0.9rem">Representative unit in our factory</span>
    </div>
  </div>
</section>

<!-- Overview -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">Overview</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.8;margin-bottom:1rem">
      The SUNRISE DMU-400 is a gantry-structured 5-axis vertical machining center designed for high-precision complex part manufacturing. Its direct-drive rotary table delivers smooth, zero-backlash motion on both A and C axes, making it ideal for mold cavities, high-reliability structural parts, medical components and 3D surface work.
    </p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.8">
      Equipped with a high-speed BBT40 spindle and arm-type tool changer, the DMU-400 handles aluminum, steel and alloy materials with consistent accuracy. The machine represents Eternal CNC's capability in simultaneous 5-axis machining for customers requiring single-setup, multi-sided finishing.
    </p>
  </div>
</section>

<!-- Specifications -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.5rem;text-align:center;">Technical Specifications</h2>
  <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;">
      <tbody>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;width:35%;">Machine type</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">5-Axis Gantry-type VMC</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">X / Y / Z travel</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">500 × 450 × 400 mm</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">A-axis swing</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">-120° ~ +30° (trunnion table)</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">C-axis rotation</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">360° continuous</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Table size</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">Ø 400 mm rotary</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Max. table load</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">200 kg</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Spindle taper</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">BBT40</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Spindle speed</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">12,000 rpm (direct-drive</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Tool magazine</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">24T arm-type</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Positioning accuracy</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">±0.006 mm (linear axes</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Repeatability</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">±0.004 mm (linear axes</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Rapid traverse</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">48 / 48 / 48 m/min (X / Y / Z)</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Control system</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">Reinaker N5E (5-axis)</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Drive structure</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">DD torque motor rotary table</td>
        </tr>
        <tr style="background:var(--page-bg);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--brand-dark);font-size:0.9rem;">Structure</td>
          <td style="padding:0.9rem 1.2rem;color:var(--text-body);font-size:0.9rem;">Gantry-type, cast iron frame</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Why This Machine</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">True Simultaneous 5-Axis</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Full 5-axis interpolation for complex 3D surfaces, impellers, molds and undercuts — no 3+2 limitations.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">DD Torque Motor Rotary Table</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Direct-drive A/C trunnion table delivers zero-backlash motion, smooth indexing and long-term accuracy retention.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Gantry-Type Rigidity</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Cast iron gantry frame minimizes deflection during 5-axis cutting, delivering consistent surface finish on steel and alloy.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">BBT40 12,000 rpm Spindle</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Dual-contact spindle ensures full-face taper and face contact at high rpm — less vibration, better surface quality.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Single-Setup Multi-Sided Finishing</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Tilting rotary table lets us machine 5 sides in one setup — fewer fixtures, reduced cumulative error, shorter lead time.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">CMM-Quality Final Inspection</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Critical 5-axis parts can be sent to our group's shared metrology center's Hexagon INSPECTOR CLASSIC CMM for a full report — sub-micron verification on request (not in-house standard equipment).</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Verified Equipment</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">This page features a representative SUNRISE DMU-400 5-axis machining center from our factory. The machine nameplate confirms the model and build record, ensuring full traceability for your project.</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/equipment/cnc-machine-sunrise-dmu400-5axis-machining-center-01.webp" alt="SUNRISE DMU-400 5-axis nameplate verification" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">SUNRISE DMU-400 nameplate</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "SUNRISE DMU-400 5-Axis Machining Center",
  "brand": { "@type": "Brand", "name": "SUNRISE" },
  "model": "DMU-400",
  "description": "Gantry-type 5-axis machining center with DD torque motor rotary table, BBT40 12000 rpm spindle and 24-tool arm changer, part of Eternal CNC's in-house manufacturing facility.",
  "image": "https://eternalcnc.com/images/equipment/equipment-sunrise-dmu400-5axis-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Machine type", "value": "5-Axis Gantry VMC" },
    { "@type": "PropertyValue", "name": "X/Y/Z travel", "value": "500/450/400 mm" },
    { "@type": "PropertyValue", "name": "A-axis", "value": "-120° ~ +30°" },
    { "@type": "PropertyValue", "name": "C-axis", "value": "360° continuous" },
    { "@type": "PropertyValue", "name": "Table size", "value": "Ø 400 mm rotary" },
    { "@type": "PropertyValue", "name": "Spindle", "value": "BBT40 12000 rpm" },
    { "@type": "PropertyValue", "name": "Tool magazine", "value": "24 pockets, arm-type" },
    { "@type": "PropertyValue", "name": "Positioning accuracy", "value": "±0.006 mm" },
    { "@type": "PropertyValue", "name": "Repeatability", "value": "±0.004 mm" },
    { "@type": "PropertyValue", "name": "Control system", "value": "Reinaker N5E" }
  ]
}
</script>

</BaseLayout>
