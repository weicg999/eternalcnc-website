---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="SUNRISE DMU-400 5-Axis Machining Center | 500x450x400mm | Eternal CNC" description="Gantry-type 5-axis machining center with DD torque motor rotary table, BBT40 12000 rpm spindle and 24-tool arm changer for complex surfaces and impellers.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
    <div>
      <p style="font-size:0.85rem;color:var(--color-primary);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem;">5-Axis Machining Center</p>
      <h1 style="font-size:2rem;font-weight:800;color:var(--color-text-primary);line-height:1.2;margin-bottom:1rem;">SUNRISE DMU-400<br/>5-Axis VMC</h1>
      <p style="font-size:1rem;color:var(--color-text-secondary);line-height:1.7;margin-bottom:1.5rem;">
        Gantry-type 5-axis machining center with direct-drive rotary table, engineered for complex 3D surfaces, impellers and molds.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:1.5rem;">
        <span style="padding:0.3rem 0.8rem;background:var(--color-bg-light);border:1px solid var(--color-border);border-radius:4px;font-size:0.8rem;color:var(--color-text-secondary);">X 500 mm</span>
        <span style="padding:0.3rem 0.8rem;background:var(--color-bg-light);border:1px solid var(--color-border);border-radius:4px;font-size:0.8rem;color:var(--color-text-secondary);">Y 450 mm</span>
        <span style="padding:0.3rem 0.8rem;background:var(--color-bg-light);border:1px solid var(--color-border);border-radius:4px;font-size:0.8rem;color:var(--color-text-secondary);">Z 400 mm</span>
        <span style="padding:0.3rem 0.8rem;background:var(--color-bg-light);border:1px solid var(--color-border);border-radius:4px;font-size:0.8rem;color:var(--color-text-secondary);">A -120°~+30°</span>
        <span style="padding:0.3rem 0.8rem;background:var(--color-bg-light);border:1px solid var(--color-border);border-radius:4px;font-size:0.8rem;color:var(--color-text-secondary);">C 360°</span>
      </div>
      <div style="display:flex;gap:1rem;align-items:center;">
        <span style="color:var(--color-primary);font-weight:700;font-size:0.9rem;">Representative unit in our family network</span>
      </div>
    </div>
    <div style="border-radius:10px;overflow:hidden;background:var(--color-bg-light);border:1px solid var(--color-border);">
      <img src="/images/equipment/equipment-sunrise-dmu400-5axis-hero.webp" alt="SUNRISE DMU-400 5-axis machining center" width="600" height="450" loading="lazy" decoding="async" style="width:100%;height:450px;object-fit:contain;display:block;background:#fff;" />
    </div>
  </div>
</section>

<!-- Overview -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--color-text-primary);margin-bottom:1rem;">Overview</h2>
      <p style="font-size:0.95rem;color:var(--color-text-secondary);line-height:1.8;margin-bottom:1rem;">
        The SUNRISE DMU-400 is a gantry-structured 5-axis vertical machining center designed for high-precision complex part manufacturing. Its direct-drive rotary table delivers smooth, zero-backlash motion on both A and C axes, making it ideal for mold cavities, high-reliability structural parts, medical components and 3D surface work.
      </p>
      <p style="font-size:0.95rem;color:var(--color-text-secondary);line-height:1.8;">
        Equipped with a high-speed BBT40 spindle and arm-type tool changer, the DMU-400 handles aluminum, steel and alloy materials with consistent accuracy. The machine represents Eternal CNC"s capability in simultaneous 5-axis machining for customers requiring single-setup, multi-sided finishing.
      </p>
    </div>
    <div style="text-align:right;">
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--color-text-primary);margin-bottom:1rem;">设备概述</h2>
      <p style="font-size:0.95rem;color:var(--color-text-secondary);line-height:1.8;margin-bottom:1rem;">
        SUNRISE DMU-400 是一款门式结构的五轴立式加工中心，专为高精度复杂零件加工而设计。其直驱式转台在 A 轴和 C 轴上均实现零背隙平滑运动，非常适合模具型腔、高可靠性结构件、医疗零件和三维曲面加工。
      </p>
      <p style="font-size:0.95rem;color:var(--color-text-secondary);line-height:1.8;">
        配备高速 BBT400 主轴和臂式刀库，DMU-400 可稳定加工铝、钢及合金材料。该设备体现了鑫永恒在五轴联动加工领域的能力，为客户提供一次装夹、多面精加工的解决方案。
      </p>
    </div>
  </div>
</section>

<!-- Specifications -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <h2 style="font-size:1.4rem;font-weight:700;color:var(--color-text-primary);margin-bottom:1.5rem;text-align:center;">Technical Specifications / 技术参数</h2>
  <div style="border:1px solid var(--color-border);border-radius:10px;overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;">
      <tbody>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;width:35%;">Machine type / 机型</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">5-Axis Gantry-type VMC / 门式五轴立式加工中心</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">X / Y / Z travel / 行程</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">500 × 450 × 400 mm</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">A-axis swing / A轴摆动</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">-120° ~ +30° (trunnion table)</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">C-axis rotation / C轴回转</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">360° continuous / 360° 连续回转</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Table size / 工作台尺寸</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">Ø 400 mm rotary / Ø 400 mm 转台</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Max. table load / 最大负载</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">200 kg</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Spindle taper / 主轴锥孔</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">BBT40</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Spindle speed / 主轴转速</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">12,000 rpm (direct-drive / 直联)</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Tool magazine / 刀库</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">24T arm-type / 24把 臂式刀库</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Positioning accuracy / 定位精度</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">±0.006 mm (linear axes / 直线轴)</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Repeatability / 重复定位精度</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">±0.004 mm (linear axes / 直线轴)</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Rapid traverse / 快速移动</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">48 / 48 / 48 m/min (X / Y / Z)</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Control system / 系统</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">Reinaker N5E (5-axis) / 莱纳克 N5E 五轴系统</td>
        </tr>
        <tr>
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Drive structure / 驱动方式</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">DD torque motor rotary table / DD 力矩电机转台</td>
        </tr>
        <tr style="background:var(--color-bg-light);">
          <td style="padding:0.9rem 1.2rem;font-weight:600;color:var(--color-text-primary);font-size:0.9rem;">Structure / 结构</td>
          <td style="padding:0.9rem 1.2rem;color:var(--color-text-secondary);font-size:0.9rem;">Gantry-type, cast iron frame / 门式铸铁结构</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:var(--color-bg-light);">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--color-text-primary);margin-bottom:1.2rem;">Why This Machine</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">True Simultaneous 5-Axis</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">Full 5-axis interpolation for complex 3D surfaces, impellers, molds and undercuts — no 3+2 limitations.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">DD Torque Motor Rotary Table</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">Direct-drive A/C trunnion table delivers zero-backlash motion, smooth indexing and long-term accuracy retention.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">Gantry-Type Rigidity</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">Cast iron gantry frame minimizes deflection during 5-axis cutting, delivering consistent surface finish on steel and alloy.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">BBT40 12,000 rpm Spindle</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">Dual-contact spindle ensures full-face taper and face contact at high rpm — less vibration, better surface quality.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">Single-Setup Multi-Sided Finishing</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">Tilting rotary table lets us machine 5 sides in one setup — fewer fixtures, reduced cumulative error, shorter lead time.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">CMM-Quality Final Inspection</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">Critical 5-axis parts can be sent to our group's shared metrology center"s Hexagon INSPECTOR CLASSIC CMM for a full report — sub-micron verification on request (not in-house standard equipment).</p>
          </div>
        </div>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--color-text-primary);margin-bottom:1.2rem;text-align:right;">设备亮点</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">真正五轴联动</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">五轴联动插补，可加工复杂曲面、叶轮、模具和倒扣特征，不受 3+2 定位限制。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">DD 力矩电机转台</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">直驱式 A/C 摇篮转台零背隙运行，分度平滑，精度长期保持。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">门式刚性结构</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">铸铁龙门框架最大限度减小五轴切削时的变形，钢件和合金表面质量稳定一致。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">BBT40 12,000 rpm 主轴</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">双接触主轴确保高速下锥面与端面全面贴合——振动更小，表面质量更佳。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">一次装夹多面精加工</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">倾斜回转台实现五面加工一次装夹完成——夹具更少、公差更紧、交期更短。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--color-text-primary);margin-bottom:0.2rem;">三坐标级终检</h4>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.5;">关键五轴零件可送至集团共享计量中心的海克斯康 INSPECTOR CLASSIC 三坐标出具完整报告——按需亚微米级验证（非本公司标配设备）。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--color-text-primary);margin-bottom:1rem;">Verified Equipment / 铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--color-text-secondary);margin-bottom:1.2rem;line-height:1.6;">This page features a representative SUNRISE DMU-400 5-axis machining center from our family workshop. The machine nameplate confirms the model and build record, ensuring full traceability for your project.</p>
    <div style="border:1px solid var(--color-border);border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/equipment/cnc-machine-sunrise-dmu400-5axis-machining-center-01.webp" alt="SUNRISE DMU-400 5-axis nameplate verification" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--color-text-tertiary);margin-top:0.8rem;">SUNRISE DMU-400 nameplate · SUNRISE DMU-400 铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "SUNRISE DMU-400 5-Axis Machining Center",
  "brand": { "@type": "Brand", "name": "SUNRISE" },
  "model": "DMU-400",
  "description": "Gantry-type 5-axis machining center with DD torque motor rotary table, BBT40 12000 rpm spindle and 24-tool arm changer, part of Eternal CNC's family-run manufacturing network.",
  "image": "https://www.eternalcnc.com/images/equipment/equipment-sunrise-dmu400-5axis-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Machine type", "value": "5-Axis Gantry VMC" },
    { "@type": "PropertyValue", "name": "X/Y/Z travel", "value": "500/450/400 mm" },
    { "@type": "PropertyValue", "name": "A-axis", "value": "-120° ~ +30°" },
