---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="CATO (JUGANG) CT-80 Vertical Machining Center | Eternal CNC" description="Compact vertical machining center from CATO (JUGANG), designed for efficient milling, drilling and tapping on small to medium workpieces.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
    <div>
      <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem;">Vertical Machining</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;">CATO CT-80</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;">Compact vertical machining center from CATO (JUGANG), designed for efficient milling, drilling and tapping on small to medium workpieces.</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
        <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">High-Speed VMC</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">CT Series</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Compact Frame</span>
      </div>
    </div>
    <div style="border-left:2px solid var(--border-color);padding-left:2rem;">
      <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem;text-align:right;">立式加工中心</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;text-align:right;">巨冈 CT-80</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;text-align:right;">巨冈 CT 系列紧凑型高速立式加工中心，专为中小型工件的高效钻孔、攻丝及轻铣加工设计。</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:flex-end;">
        <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">立式加工中心</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">CT 系列</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">紧凑结构</span>
      </div>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/cnc-machine-cato-ct80-vertical-machining-center-01.webp" alt="CATO CT-80 vertical machining center" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of CATO CT-80 · Multiple units in our family network</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Overview</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;">The CATO CT-80 is a compact vertical machining center from JUGANG (CATO). Built for efficient milling and high-speed hole making, it provides a reliable solution for small to medium part production across various industries.</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;">Operating within our associated shop network, the CT-80 adds flexible milling capacity that complements our broader machining cell. Its compact design allows efficient cell layout and quick changeovers between jobs.</p>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;text-align:right;">设备概述</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;text-align:right;">巨冈 CT-80 是紧凑型立式加工中心，专为高效铣削与孔加工设计，为各行业中小型零件生产提供可靠的解决方案。</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;text-align:right;">CT-80 在集团协作产能网络中提供灵活的铣削产能，与更广泛的加工单元形成互补。紧凑设计支持高效产线布局和快速换型。</p>
    </div>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;">Technical Specifications</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;">Machine Type</td><td style="padding:0.8rem 1rem;color:var(--text-body);">Vertical Machining Center</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Series</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">CT Series</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Application</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">Drilling, tapping, light milling</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Construction</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">Cast iron frame</td></tr>
        </table>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;text-align:right;">技术参数</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;">机型</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;">立式加工中心</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">系列</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">CT 系列</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">应用</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">钻孔、攻丝、轻铣</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">结构</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">铸铁床身</td></tr>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;">Why This Machine</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">CT Series Platform</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">Proven machine platform from CATO's established CT series of vertical machining centers.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">High-Speed Drilling & Tapping</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">Optimized for rapid hole-making and tapping cycles on small and medium parts.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">Compact Footprint</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">Space-saving design enables efficient production cell layout and easy integration.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">Reliable Construction</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">Cast iron frame provides the rigidity needed for consistent machining accuracy.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">Flexible Production</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">Handles a mix of drilling, tapping and light milling operations in a single setup.</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div>
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">Family-Network Capacity</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">Part of our multi-machine workshop network — scalable capacity for your production needs.</p>
          </div>
        </div>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;text-align:right;">设备亮点</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">CT 系列平台</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">基于巨冈成熟的 CT 系列钻攻中心平台，机型经过市场验证。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">立式加工中心</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">针对中小型零件的快速钻孔与攻丝循环优化。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">紧凑占地</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">节省空间的设计，便于高效产线布局和集成。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">可靠结构</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">铸铁床身提供稳定刚性，确保加工精度一致性。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">灵活生产</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">钻孔、攻丝、轻铣多种工序一次装夹完成。</p>
          </div>
        </div>
        <div style="display:flex;gap:0.8rem;align-items:flex-start;flex-direction:row-reverse;">
          <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;">+</div>
          <div style="text-align:right;">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem;">集团协作产能网络产能</h4>
            <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5;">多机车间网络的一部分，生产需求可灵活扩展。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Verified Equipment / 铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">This page features a representative CATO CT-80 unit from our family workshop. The machine nameplate confirms the model and build record, ensuring full traceability for your project.</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-cato-ct80-vertical-machining-center-01.webp" alt="Representative nameplate of CATO CT-80" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">Representative nameplate of CATO CT-80 · 巨冈 CT-80 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
