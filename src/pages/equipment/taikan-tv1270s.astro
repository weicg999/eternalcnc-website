---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Taikan T-V1270S Heavy-Duty Vertical Machining Center | 1270x700x700mm | Eternal CNC" description="Large-format BT40 VMC built for heavy die-steel milling and large mold work, with a 1270 x 700 x 700 mm working envelope and rigid cast iron construction.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
    <div>
      <p style="font-size:0.85rem;color:var(--brand-dark);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem;">Vertical Machining Center</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;">Taikan T-V1270S</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;">Large-format BT40 VMC built for heavy die-steel milling and large mold work, with a 1270 x 700 x 700 mm working envelope and rigid cast iron construction.</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
        <span style="display:inline-block;background-color:var(--brand-dark);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">BT40 8,000-12,000 rpm</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">1270 mm X-Travel</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">24 Arm-Type ATC</span>
      </div>
    </div>
    <div style="border-left:2px solid var(--border-color);padding-left:2rem;">
      <p style="font-size:0.85rem;color:var(--brand-dark);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem;text-align:right;">立式加工中心</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;text-align:right;">台群 T-V1270S</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;text-align:right;">大行程 BT40 重型立加，1270 x 700 x 700 mm 加工范围，高刚性铸铁床身，专为大型模具与重型模钢铣削设计。</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:flex-end;">
        <span style="display:inline-block;background-color:var(--brand-dark);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">BT40 8000-12000 转</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">1270 mm X 轴行程</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">24 把臂式刀库</span>
      </div>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-taikan-tv1270s-hero.webp" alt="Taikan T-V1270S heavy-duty vertical machining center at Eternal CNC facility" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of Taikan T-V1270S · Multiple units in our family network</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Overview</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;">The Taikan T-V1270S is our largest three-axis vertical machining center, purpose-built for heavy cutting on large workpieces. Its 1,270 mm X-axis travel and 6,250 kg machine mass deliver the stability needed for deep cuts in die steel and large aluminum plates.</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;">Multiple units operate across our associated shop network, giving us scalable capacity for both mold projects and large-part production runs. For full coordinate measurement, critical parts can be sent to our group's shared metrology center"s Hexagon CMM on request (not in-house standard equipment).</p>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;text-align:right;">设备概述</h2>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem;text-align:right;">台群 T-V1270S 是我们最大规格的三轴立式加工中心，专为大型工件的重切削设计。1270 mm X 轴行程与 6250 kg 整机重量，为模钢深切削和大型铝板加工提供充足的稳定性。</p>
      <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;text-align:right;">集团协作产能网络内多台机组协同运行，无论是模具项目还是大件量产均可灵活扩产。关键尺寸厂内检测；完整三坐标测量可送至集团共享计量中心的海克斯康三坐标按需完成（非本公司标配设备）。</p>
    </div>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;">Technical Specifications</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;">Travel (X / Y / Z)</td><td style="padding:0.8rem 1rem;color:var(--text-body);">1270 / 700 / 700 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Table Size</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">1300 x 650 mm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Spindle Taper</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">BT40</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Spindle Speed</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">8,000-12,000 rpm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Rapid Traverse</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">36 / 36 / 30 m/min</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Tool Magazine</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">24 tools, arm-type ATC</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Machine Weight</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">~6,250 kg</td></tr>
        </table>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;text-align:right;">技术参数</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;">1270 / 700 / 700 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">工作台尺寸</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">1300 x 650 mm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">主轴锥度</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">BT40</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">主轴转速</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">8,000-12,000 rpm</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">快速移动</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">36 / 36 / 30 m/min</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">刀库容量</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">24 把，臂式刀库</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">机器重量</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">约 6,250 kg</td></tr>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
    <div>
