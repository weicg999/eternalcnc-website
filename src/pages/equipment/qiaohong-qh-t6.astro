---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Qiaohong QH-T6 High-Speed Drill-Tap Center | 600x400mm | Eternal CNC" description="Dedicated high-speed drill-tap machine optimized for 3C electronics, die-cast parts and hardware components, with 600 x 400 mm working area and rapid feed rates.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Drill-Tap Center</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">Qiaohong QH-T6</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">Dedicated high-speed drill-tap machine optimized for 3C electronics, die-cast parts and hardware components, with 600 x 400 mm working area and rapid feed rates.</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">High-Speed Drill-Tap</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">600 mm Travel</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">10 kW Rated Power</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-qiaohong-qh-t6-hero.webp" alt="Qiao Hong QH-T6 high-speed drill-tap machine at Eternal CNC factory" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Representative unit of Qiaohong QH-T6 · Multiple units in-house</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">Overview</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">The Qiaohong QH-T6 is a purpose-built high-speed drill-tap center designed for high-throughput hole-making and tapping operations. With a 600 x 400 mm work envelope and 48,000 mm/min feed rate, it excels at processing 3C electronic parts, aluminum die-castings, and hardware components efficiently.</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">Operating within our in-house workshop, the QH-T6 adds dedicated drill-tap capacity that complements our vertical machining centers. This specialization means faster cycle times and lower cost per part for high-volume drilling and tapping projects.</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Technical Specifications</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">Travel (X / Y)</td><td style="padding:0.8rem 1rem;color:var(--text-body)">600 / 400 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Feed Rate</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">48,000 mm/min</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Rated Power</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">10 kW</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Rated Voltage</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">380V / 50Hz</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Rated Current</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">50 A</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Why This Machine</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">High-Speed Drill-Tap Specialist</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Purpose-built for rapid hole making and tapping on 3C, die-cast and hardware parts.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Rapid Feed Rate</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">48,000 mm/min feed rate minimizes idle time between holes for maximum throughput.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">10 kW Rated Power</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Sufficient power for consistent performance across a range of drilling and tapping operations.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Rigid Machine Structure</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Stable casting base ensures consistent accuracy even during high-speed continuous operation.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Complementary Cell Capacity</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Dedicated drill-tap capacity frees up VMCs for more complex milling work.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Nameplate-Verified Specs</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Machine specifications verified against actual equipment nameplate for full traceability.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Verified Equipment</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">This page features a representative Qiaohong QH-T6 unit from our factory. The machine nameplate confirms the model and build record, ensuring full traceability for your project.</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-qiaohong-qh-t6-high-speed-drill-tap-01.webp" alt="Representative nameplate of Qiaohong QH-T6" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">Representative nameplate of Qiaohong QH-T6</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Qiaohong QH-T6 High-Speed Drill-Tap Machine",
  "brand": { "@type": "Brand", "name": "Qiaohong" },
  "model": "QH-T6",
  "description": "Dedicated high-speed drill-tap machine optimized for 3C electronics, die-cast parts and hardware components, with 600 x 400 mm working area and rapid feed rates.",
  "image": "https://www.eternalcnc.com/images/equipment/equipment-qiaohong-qh-t6-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Travel (X / Y)", "value": "600 / 400 mm" },
    { "@type": "PropertyValue", "name": "Feed Rate", "value": "48,000 mm/min" },
    { "@type": "PropertyValue", "name": "Rated Power", "value": "10 kW" },
    { "@type": "PropertyValue", "name": "Rated Voltage", "value": "380V / 50Hz" },
    { "@type": "PropertyValue", "name": "Rated Current", "value": "50 A" }
  ]
}
</script>

</BaseLayout>
