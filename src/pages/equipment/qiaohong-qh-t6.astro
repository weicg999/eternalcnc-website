        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;">Travel (X / Y)</td><td style="padding:0.8rem 1rem;color:var(--text-body);">600 / 400 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Feed Rate</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">48,000 mm/min</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Rated Power</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">10 kW</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Rated Voltage</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">380V / 50Hz</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light);">Rated Current</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light);">50 A</td></tr>
        </table>
      </div>
    </div>
    <div>
      <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem;text-align:right;">技术参数</h2>
      <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;">行程（X / Y）</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;">600 / 400 mm</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">进给速度</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">48,000 mm/min</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">额定功率</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">10 kW</td></tr>
          <tr style="background-color:var(--page-bg);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">额定电压</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">380V / 50Hz</td></tr>
          <tr style="background-color:var(--card-white);"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;text-align:right;border-top:1px solid var(--border-light);">额定电流</td><td style="padding:0.8rem 1rem;color:var(--text-body);text-align:right;border-top:1px solid var(--border-light);">50 A</td></tr>
        </table>
      </div>
    </div>
  </div>
</section>

