---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="News & Events – Eternal CNC" description="Company milestones, facility updates, and the latest news from Eternal CNC.">

  <!-- Hero -->
  <section class="relative min-h-[300px] flex items-center overflow-hidden">
    <img src="/images/company/cnc-factory-production-floor-machine-rows-02.webp" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(26,26,26,0.85), rgba(100,0,0,0.6));"></div>
    <div class="relative z-10 container-custom py-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">News & Events</h1>
      <p class="text-lg text-white/80 max-w-2xl">Company milestones and industry updates.</p>
    </div>
  </section>

  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="space-y-8">

        <!-- News: ISO 9001 certification in progress -->
        <div class="card flex flex-col md:flex-row overflow-hidden">
          <div class="md:w-1/3 shrink-0">
            <img src="/images/company/cnc-machinist-operating-control-panel-05.webp" alt="CNC machinist operating a machine control panel" class="w-full h-48 md:h-full object-cover" />
          </div>
          <div class="p-8 flex-1 flex flex-col justify-center">
            <div class="text-sm font-medium mb-2" style="color: var(--brand-red);">January 2026</div>
            <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">ISO 9001:2015 Certification In Progress</h3>
            <p class="mb-4" style="color: var(--text-body);">Eternal CNC is actively pursuing ISO 9001:2015 Quality Management System certification. Our production and inspection processes are being aligned with international quality standards.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="container-custom text-center">
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Have a project in mind?</h2>
      <p class="text-lg mb-8" style="color: var(--text-body);">Send us your drawing. We'll get back to you within 2 hours.</p>
      <a href="/contact/get-a-quote" class="btn-primary text-base px-10 py-4 inline-flex items-center gap-2 group">
        Get a Quote
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>
