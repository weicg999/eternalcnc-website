---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge' },
  { label: 'Технические отчёты' },
];

const capabilities = [
  {
    title: 'Анализ допусков ISO 2768',
    items: ['Точный (f), Средний (m), Грубый (c)', 'Линейные и угловые допуски', 'Допуски формы по умолчанию', 'Сравнение со стандартами ANSI'],
    tolerance: 'Стандарт допусков',
    materials: 'Все материалы',
  },
  {
    title: 'Алюминий 6061 против 7075',
    items: ['Сравнение прочности к массе', 'Различия в обрабатываемости', 'Данные по коррозионной стойкости', 'Анализ стоимости и доступности'],
    tolerance: 'Сравнение материалов',
    materials: 'Алюминиевые сплавы',
  },
  {
    title: 'Выбор чистоты поверхности',
    items: ['Таблица сравнения значений Ra', 'Возможности процесса по методам', 'Влияние класса чистоты на стоимость', 'Рекомендации под применение'],
    tolerance: 'Стандарт поверхности',
    materials: 'Все материалы',
  },
  {
    title: 'Компенсация ошибок 5-осевой обработки',
    items: ['Источники объёмной ошибки', 'Эффекты тепловой деформации', 'Компенсация прогиба инструмента', 'Контроль по щупу'],
    tolerance: 'Анализ точности',
    materials: 'Многоосевая',
  },
];

const standards = [
  { label: 'Справочник ISO 2768', desc: 'Полные таблицы допусков для линейных, угловых и геометрических размеров по ISO 2768.' },
  { label: 'Карты данных материалов', desc: 'Механические свойства, показатели обрабатываемости и рекомендации по применению распространённых материалов ЧПУ.' },
  { label: 'Руководство по чистоте поверхности', desc: 'Стандарты значений Ra, выбор процесса и факторы стоимости для разных классов чистоты.' },
  { label: 'Компенсация 5-осевой', desc: 'Технические подходы к сохранению точности при совмещённой 5-осевой обработке.' },
];
---

<PageLayout
  title="Технические отчёты и исследования | EternalCNC"
  description="Глубокие технические отчёты EternalCNC: анализ допусков ISO, сравнение материалов, выбор чистоты поверхности и компенсация 5-осевой обработки."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">База знаний</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Технические отчёты
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Глубокие технические отчёты для более обоснованных инженерных решений. Скачивайте наши отчёты по анализу допусков, материалам, чистоте поверхности и не только.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Смотреть услуги →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Технические отчёты</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Глубокий анализ</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Подробные технические отчёты по допускам, материалам, чистоте поверхности и продвинутой обработке.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Тема</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Охват</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Нормативные стандарты</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Справочные стандарты</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Все отчёты основаны на международных стандартах и наших внутренних данных по качеству.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Нужны технические данные?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертежи — ответ инженера в течение 2 ч.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Все материалы →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
