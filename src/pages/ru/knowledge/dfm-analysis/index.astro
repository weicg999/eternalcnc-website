---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge' },
  { label: 'Анализ DFM' },
];

const capabilities = [
  {
    title: 'Анализ технологической применимости',
    items: ['Оценка отношения глубины глубокой полости к диаметру', 'Оценка обрабатываемости вырезов (undercut)', 'Классификация риска деформации тонкостенных деталей', 'Выявление требований к спецпроцессам'],
    tolerance: 'Доля раннего выявления ≥ 95%',
    materials: 'Избегайте обнаружения технологических слепых зон после запуска',
  },
  {
    title: 'Анализ оптимизации стоимости',
    items: ['Стратегии повышения использования материала', 'Рекомендации по объединению и упрощению операций', 'Экономическая оценка жёсткости допусков', 'Оптимизация выбора поверхностной обработки'],
    tolerance: 'Средний потенциал снижения стоимости 15–30%',
    materials: 'Баланс требований к характеристикам и стоимости изготовления',
  },
  {
    title: 'Проверка обоснованности допусков',
    items: ['Рекомендации по градации допусков посадочных размеров', 'Проверка применимости GD&T', 'Рекомендация стандарта по умолчанию для неуказанных допусков', 'Выявление и обозначение ключевых характеристик'],
    tolerance: 'Справочно: ISO 2768-m / ASME Y14.5',
    materials: 'Слишком жёсткие допуски напрямую повышают стоимость обработки',
  },
  {
    title: 'Проверка интерференции сборки',
    items: ['Проверка последовательности и доступности сборки', 'Проверка зазора резьбы', 'Анализ интерференции уплотнительного паза и сопрягаемой поверхности', 'Учёт зазора на тепловое расширение'],
    tolerance: 'Доля сборки с первого раза повышена на 40%',
    materials: 'Снижение доработок при сборке и изменений конструкции',
  },
];

const standards = [
  { label: 'Сокращение числа установок', desc: 'Проектируйте детали так, чтобы обработать их за одну установку, где возможно, минимизируя накопленную погрешность.' },
  { label: 'Доступность инструмента', desc: 'Обеспечьте доступ режущего инструмента ко всем обрабатываемым поверхностям — избегайте глубоких полостей и узких пазов, вызывающих помехи.' },
  { label: 'Стандартизированные элементы', desc: 'Используйте стандартные свёрла, метчики и радиусы, где возможно, чтобы сократить спецоснастку.' },
  { label: 'Совместимость материала', desc: 'Учитывайте обрабатываемость при выборе материала. Избегайте труднообрабатываемых материалов для крупносерийных деталей.' },
];
---

<PageLayout
  title="Анализ DFM для ЧПУ обработки | EternalCNC"
  description="Профессиональный анализ DFM от EternalCNC: оценка технологичности, оптимизация стоимости, проверка допусков и интерференции сборки для снижения рисков."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">База знаний</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Руководство по анализу технологичности DFM для ЧПУ
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Системно выявляйте риски обработки и возможности оптимизации — от проектирования до производства
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Бесплатный расчёт
        </a>
        <a href="/ru/services/dfm-analysis" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Подробнее →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Направления анализа</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Четыре ключевых направления анализа DFM</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Системно оценивайте технологичность детали по четырём направлениям: процесс, стоимость, допуски и сборка.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Ключевой показатель</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Польза</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Принципы проектирования</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Принципы технологичности DFM</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Проектируйте с учётом ограничений производственного процесса, чтобы повысить качество детали изначально.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Нужен профессиональный анализ DFM?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертежи и получите полный отчёт по технологичности и расчёт в течение 2 часов.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Бесплатный расчёт
        </a>
        <a href="/ru/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Подробнее →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
