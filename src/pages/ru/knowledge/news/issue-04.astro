const kpis = [
  { metric: '80%', label: 'Максимальный прирост производительности на рабочем месте от контроля SOP на базе ИИ от Hikvision — более 600 ключевых рабочих мест на трёх её заводах', source: 'Shanghai Securities News / Hikvision, 12 окт 2026' },
