---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '02',
  date: '18 сентября 2026',
  blurb: 'Пять вещей, которые заметил цех — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: '+34,6%', label: 'Выпуск промышленных роботов в Китае, г/г, август 2026 (редукторы для роботов: только +11,4%)', source: 'Национальное бюро статистики, 15 сен 2026' },
  { metric: '860 000 шт.', label: 'Прецизионных деталей для гуманоидов поставила Everwin Precision за H1 2026 — больше, чем за весь 2025 год (690 000)', source: 'Раскрытие Everwin Precision, 5 сен 2026' },
  { metric: '$262,31 млрд', label: 'Экспорт механической и электротехнической продукции Китая, август 2026 — рекордный отдельный месяц', source: 'Главное таможенное управление, сентябрь 2026' },
];

const stories = [
  {
    tag: 'Робототехника',
    date: '2026-09-15',
    title: 'Промышленные роботы +34,6% в августе — но настоящий сигнал в редукторах',
    summary: 'Национальное бюро статистики 15 сентября опубликовало данные промышленного производства за август: выпуск промышленных роботов вырос на 34,6% г/г, а выпуск редукторов для роботов — лишь на 11,4%. Раньше эти две кривые шли вместе: в 2025 году выпуск редукторов вырос на 63,9%, в H1 2026 — на 57,3%, оба раза заметно опережая 28,0% у промышленных роботов за тот же период. Но в июле и августе рост редукторов упал до 22,7%, а затем до 11,4%, тогда как рост готовых машин поднялся с 30,2% до 34,6%. Тогда же бюро сообщило, что доля Китая в мировых отгрузках гуманоидных роботов выросла до 97%.',
    what_it_means: 'Редуктор — единственный прецизионный узел в шарнире, который обязан отгружаться подобранным комплектом: корпус, гибкое колесо, жёсткое колесо, выходной фланец. Четыре детали; если хоть одна уйдёт по размеру, комплект не соберётся. Отставание роста его выпуска означает, что производители машин в этом цикле разбирают склад, а не тянут новые редукторы. Для тех, кто присылает нам детали, это работает в две стороны: если ваши детали идут производителю редукторов, ждите более свободного графика в следующем квартале, чем в H1. Если ваши детали идут прямо в конструкцию робота — каркасы, корпуса, фланцы — работа становится плотнее, а не свободнее. Понимать, по какую сторону этой линии вы находитесь, важнее, чем знать, хороша ли отрасль в целом.',
    source: 'Национальное бюро статистики, данные промышленного производства за август 2026 и их разбор, 15 сен 2026',
  },
  {
    tag: 'Робототехника',
    date: '2026-09-12',
    title: 'Завод UBTECH в Лючжоу на 10 000 единиц запущен: один робот каждые 10 минут',
    summary: '12 сентября на юге Китая официально начал работу промышленный суперзавод гуманоидных роботов UBTECH в Лючжоу (Гуанси) — он позиционируется как первая в мире площадка, построенная под мощность класса 10 000 единиц. Площадь 14 000 м², высота корпуса 13,8 м, выпускаются серии Walker S и Cruzr, проектный такт — один робот каждые 10 минут, планируемая мощность свыше 10 000 единиц в год. Завод построен совместно с Siemens на разработанной вместе системе управления производством Yanshee MOM, у каждого робота уникальный SN, что даёт прослеживаемость на уровне единицы изделия. Для станочника важнее всего два числа: в каждом гуманоиде более 2 000 винтов более чем 50 типоразмеров, а финальные испытания каждой машины идут более 4 часов.',
    what_it_means: 'Один робот каждые 10 минут — это такт, но такт держится только при идентичных входящих деталях. 2 000 винтов, более 50 типоразмеров, 4 часа испытаний — эта связка накладывает на всё, что входит на завод, автомобильную стабильность партии. Иначе говоря, в этом цикле заказчик даст вам работу не потому, что ваш первый образец был красив. Он даст её потому, что деталь номер 200 измеряется так же, как деталь номер 1. Если на вашем чертеже допуски стоят на ключевых размерах, а остальное отдано общему допуску по GB/T 1804-m, это ровно та зона, где сборочная линия и ломается.',
    source: 'Economic Daily, сентябрь 2026; Shenzhen Special Zone Daily, 14 сен 2026; People\u2019s Daily Online Guangxi, 13 сен 2026',
  },
  {
    tag: 'Отрасль ЧПУ',
    date: '2026-09-15',
    title: 'Выпуск станков с ЧПУ +18,2% — машины, которые делают детали, покупают',
    summary: 'Данные по продукции за август показывают устойчивый подъём средне- и высокотехнологичного оборудования: выпуск железнодорожных локомотивов, гражданских стальных судов, газовых турбин и металлорежущих станков с ЧПУ вырос соответственно на 133,3%, 38,0%, 36,5% и 18,2%. Добавленная стоимость в производстве оборудования выросла на 12,1% г/г и достигла 38,3% в промышленности выше установленного масштаба — плюс 2,2 процентных пункта. По экспорту: в августе стоимость поставок на экспорт у промышленности выше установленного масштаба составила 1,4 трлн юаней, +11,1% г/г; за январь–август экспорт механической и электротехнической продукции — 12,91 трлн юаней, +21,9% (Главное таможенное управление).',
    what_it_means: 'Рост выпуска станков почти на 20% означает, что низовые звенья наращивают мощности — но наращивают мощности под сложные детали, а не под обычную трёхосевую работу. Вывод прямой: когда все конкуренты покупают пятиосевые, пространство для выигрыша на цене трёхосевой обработки с несколькими установками продолжает сжиматься, а способность держать допуск и срок снова становятся ценовой силой. Для тех, кто присылает нам детали: в этом году «я сделаю на 10% дешевле» продаётся всё хуже, а «я сожму срок с трёх недель до десяти дней, и деталь номер 10 измерится как деталь номер 1» — всё дороже.',
    source: 'Национальное бюро статистики, разбор данных промышленного производства за август 2026, 15 сен 2026',
  },
  {
    tag: 'Жидкостное охлаждение',
    date: '2026-09-15',
    title: 'Первый национальный стандарт по жидкостному охлаждению — у холодных плит и фитингов наконец одна линейка',
    summary: 'Рекомендательный национальный стандарт GB/T 48023-2026 «Технические требования к системам жидкостного охлаждения с холодными плитами для ЦОД» опубликован 30 июля 2026 года и вступает в силу 1 февраля 2027 года. Второй стандарт, GB/T 48097-2026 «Общие требования к стойкам с холодными плитами для ЦОД», опубликован 28 августа 2026 года и вступает в силу 1 марта 2027 года. Оба разработаны совместно более чем 80 организациями промышленности, науки и исследований. Стандарты задают проверяемые по чертежу требования к механически обработанным деталям: для холодных плит одного типоразмера при номинальном расходе отклонение гидравлического сопротивления должно быть в пределах ±10%; при опрессовке падение давления — в пределах 2% и без деформации; быстроразъёмные фитинги одного типоразмера от разных производителей должны быть взаимозаменяемы; разброс расхода по ветвям коллектора — в пределах 10% от среднего арифметического.',
    what_it_means: 'Это самый конкретный пункт выпуска для механического цеха. Как только взаимозаменяемость попадает в национальный стандарт, холодные плиты и фитинги перестают соревноваться в том, кто может это сделать, и начинают соревноваться в том, кто делает это одинаково каждый раз: гидравлическое сопротивление в пределах ±10% от партии к партии берётся не вытачиванием одной идеальной детали, а приспособлениями, управлением стойкостью инструмента и межоперационным контролем. Для тех, кто присылает нам детали: перестаньте относиться к деталям жидкостного охлаждения как к обычному алюминию. Внесите требование по сопротивлению (или расходу) и условие опрессовки в чертёж — потому что с февраля 2027 года ваши заказчики будут мерить вас этой линейкой.',
    source: 'Уведомления о публикации GB/T 48023-2026 и GB/T 48097-2026, сентябрь 2026',
  },
  {
    tag: 'Робототехника',
    date: '2026-09-11',
    title: 'Верхнее звено уже получает деньги: 860 000 деталей, 1 000 000 двигателей — серийные заказы состоялись',
    summary: 'Два набора первичных цифр из раскрытия публичных компаний — доказательство более твёрдое, чем любой доклад на конференции. Everwin Precision, поставщик первого уровня по программе Optimus от Tesla, сообщила инвесторам: за весь 2025 год поставлено около 690 000 деталей для гуманоидных роботов, а за один только H1 2026 — около 860 000. Выручка сегмента воплощённого ИИ и новой технологичной аппаратуры за H1 составила 243 млн юаней, +537,64% г/г. В отчёте Leadshine Technology за H1 2026 раскрыто более 1 000 000 бескорпусных моментных двигателей в портфеле заказов, а планетарные и волновые шарнирные модули и многозвенные ловкие манипуляторы заказаны почти сотней основных заказчиков-робототехников. Отдельно UBTECH раскрыла продажи 921 полноразмерного воплощённого гуманоида за H1 2026 и выручку 590 млн юаней.',
    what_it_means: 'Поставьте количество машин рядом с количеством деталей — и главный вывод этого выпуска выпадает сам: машин пока мало (921), а деталей уже много (860 000). В одном гуманоиде несколько сотен обработанных деталей, значит, 921 машина подразумевает сотни тысяч штук — поэтому деньги сначала пришли на уровень компонентов. Для тех, кто присылает нам детали: если вы всё ещё ждёте разгона серийного выпуска машин, чтобы начать прототипирование, вы опоздали на полгода — заказы уже прошли на уровень ниже. И наоборот: если ваша деталь — это конструкция робота, корпус шарнира, фланец или кронштейн, в этом окне вас вознаграждает не цена, а то, удержите ли вы стабильность на партии 10–50 штук.',
    source: 'Раскрытие Everwin Precision, 5 сен 2026; отчёт Leadshine Technology за H1 2026; промежуточные результаты UBTECH, 28 авг 2026',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Еженедельно. Мы не ведём бегущую строку новостей — мы ведём список для чтения и включаем только то, что меняет действия покупателя деталей ЧПУ в этом квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только первоисточники: Национальное бюро статистики, Главное таможенное управление, Китайская ассоциация станкостроителей и инструментальщиков (CMTBA), отчётность компаний и именная пресса. Мы не перепечатываем аналитические заметки как факты.' },
  { q: 'Почему взгляд OEM, а не рыночный отчёт?', a: 'Потому что рыночный отчёт говорит, куда дует ветер. Взгляд цеха говорит, приземлилась ли работа на самом деле. У каждой новости здесь есть строка «что это значит» — за неё мы и отвечаем.' },
];

const related = [
  { label: 'От чертежа к расчёту', href: '/ru/knowledge/tech-blog/from-drawing-to-cost/' },
  { label: 'Детали шарниров и фланцев роботов', href: '/ru/knowledge/tech-blog/robot-joint-and-flange-parts/' },
  { label: 'Как выбрать поставщика ЧПУ в Китае', href: '/ru/knowledge/tech-blog/how-to-choose-cnc-supplier-in-china/' },
  { label: 'Техблог (все)', href: '/ru/knowledge/tech-blog/' },
];
---

<PageLayout
  title="Новости отрасли с цеха | Eternal CNC"
  description="Что заметил цех ЧПУ в сентябре 2026: промышленные роботы +34,6% при отстающих редукторах, завод UBTECH на 10 000 единиц, первый национальный стандарт по жидкостному охлаждению — и что это значит для ваших деталей."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        В этом выпуске: что заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Выпущено {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, достойные внимания в этом выпуске</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять историй</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что случилось и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, затем строка, которая важна: что меняется для покупателя, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три частых вопроса</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">Похожее в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">25 сентября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
            Сюжеты, за которыми мы следим: вернётся ли рост выпуска редукторов в данных за сентябрь, как цеха холодных плит готовятся к стандарту по жидкостному охлаждению с февраля 2027 года и первые данные отгрузок с заводов, запущенных в этом квартале.
          </p>
          <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите нам следующий чертёж
          </a>
        </div>
      </div>
    </div>
