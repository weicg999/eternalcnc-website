---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge' },
  { label: 'Новости отрасли' },
];

const archive = [
  {
    number: '02',
    date: '18 сентября 2026',
    title: 'Что заметил цех — середина сентября',
    blurb: 'Промышленные роботы +34,6% при отстающих редукторах, завод UBTECH на 10 000 единиц, первый национальный стандарт по жидкостному охлаждению и серийные заказы, уже приземлившиеся на уровень компонентов.',
    href: '/ru/knowledge/news/issue-02/',
    latest: true,
  },
  {
    number: '01',
    date: '11 сентября 2026',
    title: 'Что заметил цех — начало сентября',
    blurb: 'Гуманоиды переходят в серию, ИИ-серверное жидкостное охлаждение становится стандартом, прибыль станкостроения удваивается — что это значит для ваших деталей.',
    href: '/ru/knowledge/news/issue-01/',
    latest: false,
  },
];

const nextIssue = '25 сентября 2026';
---

<PageLayout
  title="Новости отрасли с цеха | Eternal CNC"
  description="Читательский список стратегической консультативной группы Eternal CNC: что заметил цех ЧПУ — прошлые выпуски про робототехнику, жидкостное охлаждение и станки, и что каждый значит для ваших деталей."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Что заметил цех — прошлые выпуски
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Еженедельный список для чтения от стратегической консультативной группы Eternal CNC — только то, что меняет действия покупателя деталей ЧПУ в этом квартале. В каждом выпуске есть строка «что это значит для ваших деталей».
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- Issue list -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Все выпуски</p>
      <div class="space-y-6">
        {archive.map((it) => (
          <a href={it.href} class="block p-8 border rounded-2xl transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">Выпуск {it.number}</span>
              <span class="text-xs" style="color: var(--text-muted);">{it.date}</span>
              {it.latest && (
                <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--brand-red); color: #ffffff;">Последний</span>
              )}
            </div>
            <h2 class="text-2xl font-bold mb-3 leading-snug" style="color: var(--brand-dark);">{it.title}</h2>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{it.blurb}</p>
            <p class="text-sm font-medium" style="color: var(--brand-red);">Читать выпуск {it.number} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Next issue -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
        <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
        <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">{nextIssue}</h3>
        <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
          Сюжеты, за которыми мы следим: вернётся ли рост выпуска редукторов в данных за сентябрь, как цеха холодных плит готовятся к стандарту по жидкостному охлаждению с февраля 2027 года и первые данные отгрузок с заводов, запущенных в этом квартале.
        </p>
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Пришлите нам следующий чертёж
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы дадим расчёт в течение 2 часов в рабочий день и скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Смотреть техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
