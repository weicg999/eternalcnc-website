---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge/' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '05',
  date: '19 октября 2026',
  blurb: 'Пять вещей, которые заметил цех, — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: '1,1 млн штук', label: 'Прецизионных компонентов для гуманоидных роботов отгрузила Changying Precision в январе–августе 2026 года — по данным самой компании', source: 'Ответ Changying Precision в системе раскрытия Шэньчжэньской биржи, 8 окт 2026' },
  { metric: '3,7%', label: 'Средняя рентабельность станкоинструментальной отрасли Китая в первом полугодии 2026 года при выручке 530,9 млрд юаней (+7,6% год к году)', source: 'Данные CMTBA, через Economic Daily, 15 окт 2026' },
  { metric: '12 минут', label: 'Время переналадки на заводе COSMOPlat в Цзяочжоу после запуска кластера промышленных ИИ-агентов — раньше не менее 40 минут', source: 'People\'s Daily Online (Шаньдун) / Dazhong Daily, 12 окт 2026' },
];

const stories = [
  {
    tag: 'Робототехника / поставки',
    date: '2026-10-08',
    title: 'Детали роботов переходят от «скелета» к «сухожилиям»: поставщик отгрузил 1,1 млн штук за восемь месяцев',
    summary: '8 октября Changying Precision сообщила инвесторам на платформе взаимодействия с Шэньчжэньской биржей: компания тесно работает с несколькими ведущими брендами гуманоидных роботов в Китае и за рубежом, за январь–август 2026 года отгрузила более 1,1 млн прецизионных компонентов для гуманоидных роботов, в третьем и четвёртом кварталах заказы растут быстрее, чем в первом полугодии, и под них расширяются мощности. Важна не цифра, а структура номенклатуры. Компания говорит, что её ассортимент охватывает детали трансмиссии ловких рук, детали трансмиссии ротационных приводов, детали трансмиссии на винтах, крупные детали трансмиссии корпуса и скелетные корпусные детали, и что она способна вести работу от ключевого компонента до сборки изделия; её ассоциированная компания Guosenke занимается волновыми редукторами и прецизионной трансмиссией. Для контекста: выручка за первое полугодие 2026 года — 10,729 млрд юаней, +24,18% год к году, из них направление воплощённого интеллекта и новой техники — 243 млн юаней, +537,64%.',
    what_it_means: 'Корпусные детали — это работа по форме, детали трансмиссии — работа по точности. Это две совершенно разные логики расчёта цены. Кронштейн каркаса оценивают по габаритам и расположению отверстий; деталь трансмиссии — по позиционному допуску, шероховатости, стабильности термообработки и стабильности от партии к партии. Как только винты и детали трансмиссии ловких рук выходят в серию, заказчик перестаёт спрашивать, можете ли вы это сделать, и начинает спрашивать, сколько деталей из последней тысячи «поплыли». Разбирайтесь с полем допуска, схемой базирования и требованиями к термообработке до того, как назовёте цену, а не после.',
    source: 'Ответ Changying Precision на платформе взаимодействия с инвесторами Шэньчжэньской биржи, 8 окт 2026; China Securities Journal (cs.com.cn) и National Business Daily, 8 окт 2026.',
  },
  {
    tag: 'ИИ / цех',
    date: '2026-10-12',
    title: 'Кластер ИИ-агентов выходит в цех: переналадка сократилась с 40 минут до 12',
    summary: '12 октября People\'s Daily Online (Шаньдун), перепечатав первую полосу Dazhong Daily, рассказала о заводе COSMOPlat в Цзяочжоу (Циндао): промышленная большая модель Tianzhi выступает «мозгом», несколько десятков агентов — «руками и ногами», три цифровых человека — «командирами», и всё это образует «умный легион». Результат измерим секундомером и отчётом. Когда требуется переналадка, центральный агент следит за состоянием линии и одновременно раздаёт задачи агентам склада, логистики и техпроцесса: время переналадки падает с 40 минут в лучшем случае (20 после автоматизации) до 12 минут, а суточная выработка одной линии растёт на 5%. На участке пайки волной агент собирает данные в реальном времени и правит профиль печи с точностью до миллисекунд — после внедрения доля дефектов пайки упала на 40%, а энергопотребление производства — на 15%. В ремонте опыт старших наладчиков по поиску неисправностей выгрузили в базу знаний, и время ремонта сократилось с двух часов до получаса. В основе — более 4\u00A0700 промышленных моделей механизмов и свыше 200 экспертных алгоритмов; платформа сводит данные десятка с лишним систем — ERP, MES, WMS и других. Каждое решение фиксирует, какие данные оно прочитало и какую модель вызвало, и всё это прослеживается.',
    what_it_means: 'Сокращение переналадки с 40 минут до 12 убирает две трети скрытой стоимости, из-за которой мелкая серия дорога. Раньше заказчики собирали несколько номенклатур в один крупный заказ, чтобы размазать эту стоимость; теперь они чаще будут дробить заказы и размещать их чаще. Для прототипного цеха это больше заказов, но каждый меньше — и давление смещается на то, способны ли вы переваривать дробные заказы: скорость расчёта цены, скорость подтверждения первой детали и гибкость планирования начинают сравнивать раньше, чем цену за штуку.',
    source: 'People\'s Daily Online (Шаньдун), «Умный легион держит завод», 12 окт 2026 (оригинал — Dazhong Daily, 12 окт 2026, стр. 1, автор Ван Инци); Dazhong News, 12 окт 2026.',
  },
  {
    tag: 'Вычисления / жидкостное охлаждение',
    date: '2026-10-09',
    title: 'Жидкостное охлаждение переходит от заказов к поставкам: прибыль поставщика за квартал удвоилась',
    summary: '9 октября Hongfuhan (301086.SZ) опубликовала предварительные итоги за январь–сентябрь 2026 года: чистая прибыль, относимая на акционеров, — 170–200 млн юаней, +108,19%–144,93% год к году; прибыль без учёта разовых статей — 166–198 млн юаней, +108,20%–147,71%. В отчёте причина названа прямо: «приоритетное направление — модули холодных плит для жидкостного охлаждения в сборе на стойку — завершило выход в серийные поставки, мощности по модулям холодных плит постепенно высвобождаются, и это основной прирост прибыли периода»; остальное дали прецизионные функциональные компоненты для потребительской электроники и автоматизированное оборудование. В том же месяце есть и второй срез: 12–15 октября в США прошёл OCP Global Summit 2026, где Hongfuhan показала модули жидкостного охлаждения с холодными плитами, уже находящиеся в серийных поставках, и представила работу по конструкции, терморегулированию и серийной технологии в рамках открытой спецификации стоек OCP.',
    what_it_means: 'Самая «механообрабатываемая» часть модуля с холодной плитой — сама плита, корпус, кронштейны и фитинги — это в основном алюминий, средние серии, средне-высокая точность и, как правило, требование анодирования или проводящего покрытия. Такие детали на чертеже выглядят несложно, но уплотнительные поверхности и стабильность ошибок не прощают. Модульный конец цепочки уже отгружает серийно, значит окно закупок открыто; ограничивать вас будут такт поставки и стабильность партии, а не способность сделать образец.',
    source: 'Предварительные итоги Hongfuhan (301086.SZ) за январь–сентябрь 2026 года, 9 окт 2026 (в тот же день — CNR и China Securities Journal); Shanghai Securities News / cnstock.com, 15 окт 2026 (OCP Global Summit).',
  },
  {
    tag: 'Станкостроение',
    date: '2026-10-15',
    title: 'Оборот 1,6 трлн юаней при рентабельности 3,7%: где станкостроение зарабатывает, а где застряло',
    summary: '15 октября Economic Daily сообщила с конференции по высококачественному развитию цепочки промышленных станков 2026 года: по данным Министерства промышленности и информатизации, в 2025 году выручка китайского станкостроения превысила 1,6 трлн юаней, отрасль более десяти лет занимает первое место в мире и охватывает теперь и съём материала, и формообразование, и аддитивные процессы, а также станки целиком, функциональные узлы, системы ЧПУ, базовые компоненты и промышленное ПО. С прибылью по-прежнему тонко: по данным CMTBA, выручка станкоинструментальной отрасли за первое полугодие 2026 года — 530,9 млрд юаней, +7,6% год к году, а средняя рентабельность — всего 3,7% против 4,5% в машиностроении в целом. О структуре торговли говорит больше: в 2025 году 70,6% стоимости импорта станков пришлось на Германию, Японию и Швейцарию, средняя цена импорта — 685\u00A0000 юаней за единицу, тогда как расчётная средняя цена экспорта — около одной десятой от этого. Есть и реальные подвижки в технологии: Jingdiao Technology и Beijing No.1 Machine Tool Plant совместно построили первый отечественный высокоточный портальный станок с системой ЧПУ Jingdiao JD60, с контролем на станке и адаптивной обработкой; Qinchuan Machine Tool сообщает о прорывах в обработке прецизионных зубчатых колёс, многооперационной обработке сложных деталей и сверхпрецизионном шлифовании винтов, а её зубошлифовальные станки охватывают работу от 5-миллиметровых зубчатых колёс редукторов гуманоидов до 4,2-метровых колёс ветроэнергетики.',
    what_it_means: 'Фраза «цена импорта в десять раз выше цены экспорта» означает одно: высококлассная 5-осевая обработка не подешевеет в ближайшее время только за счёт импортозамещения. Если вы покупаете прецизионные детали, ждать, что амортизация станков дойдёт до цены обработки, придётся годы. Реально экономит сегодня не цена за штуку, а «сделать правильно с первого раза» — подключайте DFM ещё на этапе чертежа и сразу закрывайте вопросы по критичным допускам и базам: каждая не забракованная деталь остаётся вашими деньгами.',
    source: 'Economic Daily, «Цепочка промышленного станкостроения развивается сообща», 15 окт 2026; workercn.cn и портал правительства провинции Шэньси, 15 окт 2026.',
  },
  {
    tag: 'Робототехника / коммерциализация',
    date: '2026-10-09',
    title: 'От продажи роботов к продаже внедрения: цель в 10\u00A0000 штук к 2030 году',
    summary: 'По сообщению официального аккаунта UBTECH Robotics в WeChat, 9 октября UBTECH и Xiamen C&D Inc. подписали в Сямэне соглашение о стратегическом сотрудничестве. Стороны создадут совместное предприятие как оператора «Центра экотехнологий UBTECH — головного офиса в Фуцзяни», объединив сервисное обслуживание, обучение операторов, разработку сценариев, лизинг оборудования и проведение соревнований в единую сервисную платформу, и планируют к 2030 году совместно обеспечить продажи не менее 10\u00A0000 гуманоидных роботов UBTECH, начиная с управления цепочками поставок и девелопмента недвижимости — логистика и склады, охрана и патрулирование, услуги в городских общественных пространствах. Заметно меняется сам способ продажи: вместо стука в дверь к каждому клиенту предложение упаковывает юрлицо, лизинг, обслуживание и обучение во «всё, что происходит после того, как робот принят на работу», и прямо отвечает на вопросы покупателя — кто им управляет, как и что будет, если он сломается. Для ориентира: в первом полугодии 2026 года UBTECH продала 921 полноразмерный гуманоидный робот воплощённого интеллекта на 590 млн юаней, то есть в среднем около 640\u00A0000 юаней за штуку.',
    what_it_means: 'Продавец, готовый превратить бизнес в сотню штук в цель в десять тысяч, считает, что узкое место сместилось с «можем ли мы это собрать» на «можно ли этим пользоваться и обслуживать». Для поставщика компонентов, как только этот скачок доходит до закупок, меняются вопросы: не «можете ли вы сделать деталь», а какая у вас месячная мощность, какой выход годных и приходит ли каждая партия с прослеживаемыми записями по материалу и термообработке. Настоящее окно для прототипного цеха открывается до заморозки конструкции — на стадии образцов заказчик ещё платит за скорость и гибкость, а после заморозки платит за стабильность и себестоимость.',
    source: 'Официальный аккаунт UBTECH Robotics в WeChat; перепечатки Beijing News / Shell Finance и Caijing.com.cn, 11 окт 2026; промежуточная отчётность UBTECH Robotics за 2026 год.',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Еженедельно. Мы не ведём бегущую строку новостей — мы ведём список для чтения и включаем только то, что меняет действия покупателя деталей ЧПУ в этом квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только первоисточники: национальные статистические ведомства, таможня, отраслевые ассоциации, органы по стандартизации, отчётность компаний и именная пресса. Мы не перепечатываем аналитические заметки как факты.' },
  { q: 'Почему взгляд цеха, а не рыночный отчёт?', a: 'Потому что рыночный отчёт говорит, куда дует ветер. Взгляд цеха говорит, приземлилась ли работа на самом деле. У каждой новости здесь есть строка «что это значит» — за неё мы и отвечаем.' },
];

const related = [
  { label: 'Шарниры роботов и фланцевые детали', href: '/ru/knowledge/tech-blog/robot-joint-and-flange-parts/' },
  { label: 'Детали роботов на 5-осевом за одну установку', href: '/ru/knowledge/tech-blog/robotics-5-axis-one-setup/' },
  { label: 'Жидкостное охлаждение, вычисления и роботы', href: '/ru/knowledge/tech-blog/liquid-cooling-compute-and-robots/' },
  { label: 'Срок изготовления и цена', href: '/ru/knowledge/tech-blog/lead-time-and-price/' },
];
---

<PageLayout
  title="Новости отрасли CNC-производства · Выпуск 05 | Eternal CNC"
  description="Конец октября 2026: ИИ-агенты сокращают переналадку до 12 минут, детали роботов переходят к трансмиссии, а рентабельность станкостроения — 3,7%."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Что на этот раз заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Опубликовано {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, которые стоит запомнить</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять новостей</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что произошло и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, потом главная строка: что меняется для заказчика, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три вопроса, которые нам задают</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">По теме в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">26 октября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
За чем мы следим: сентябрьская статистика по выпуску промышленных роботов и станков с ЧПУ от Государственного статистического управления; превратится ли совместное предприятие UBTECH в Фуцзяни в реальные закупочные заказы; и поспевает ли остальная цепочка жидкостного охлаждения за модульными производителями, которые уже отгружают серийно.
          </p>
          <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите следующий чертёж
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы рассчитаем в течение 2 часов в рабочий день и прямо скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
