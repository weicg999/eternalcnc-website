---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge/' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '06',
  date: '26 октября 2026',
  blurb: 'Пять вещей, которые заметил цех, — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: 'Около 100 штук', label: 'За первое полугодие 2026 года в Китае выпустили более 40 000 гуманоидных роботов более чем в 400 моделях — примерно по 100 штук на модель. Деление наше, не министерское. По нашему мнению, оно говорит о реальной форме спроса больше, чем заголовок «100 000 за год».', source: 'Вэй Вэй, директор департамента науки и технологий Министерства промышленности и информатизации (MIIT), пресс-конференция Пресс-канцелярии Госсовета КНР, 19 октября 2026 («более 400 моделей, выпуск свыше 40 000 штук, по итогам года ожидается более 100 000»); деление выполнено редакцией по этим двум цифрам.' },
  { metric: '49 млн юаней', label: 'Суммарные заказы по направлению жидкостного охлаждения, которые Jinzhou Pipe набрала по состоянию на 10 октября 2026 года. Тогда же подразделение получило заказ на 170 комплектов трубной обвязки CDU — конечный заказчик, по описанию компании, крупная интернет-компания; отгрузка до конца октября.', source: 'Jinzhou Pipe (002443.SZ), протокол встречи с инвесторами, 21 октября 2026.' },
  { metric: '95%', label: 'Точность, которую ИИ-агент компании Black Lake Technologies показывает на участке «чертёж заказчика → маршрутная карта»: прочитать размеры и допуски, разбить на операции, выбрать технологический маршрут. Раньше эту работу делал опытный технолог за два-три часа, теперь — за минуты.', source: 'Economic Information Daily, 22 октября 2026.' },
];

const stories = [
  {
    tag: 'Макро / Выпуск',
    date: '2026-10-19',
    title: 'В сентябре две кривые разошлись в разные стороны: роботы замедлились, станки ускорились',
    summary: '19 октября Государственное статистическое управление КНР сообщило: в сентябре выпуск промышленных роботов составил 96 752 штуки, +18,9% год к году, а за январь–сентябрь — 794 781 штука, +29,1%. Месячный темп оказался ниже накопленного — на 10,2 процентного пункта. В той же таблице металлорежущих станков: 80 000 штук в сентябре, +12,5%, против 670 000 штук за девять месяцев, +10,1%, то есть месячный темп выше накопленного на 2,4 пункта. Третья серия смотрит в другую сторону: сервисных роботов в сентябре выпущено 1 658 178 штук, −17,8%, хотя за девять месяцев накопленный рост всё ещё +7,9% — месячная цифра ушла в минус.',
    what_it_means: 'Если сложить эти две картины, прочтение одно — деньги перетекают от «делать роботов» к «делать станки, которые делают роботов». Рост выпуска готовых машин замедляется, а выпуск металлорежущих станков ускоряется: значит, заказчики вкладываются в мощности, а не в готовые изделия. Для тех, кто присылает нам детали, это означает, что через шесть–двенадцать месяцев конкурентных мощностей станет больше, а цены в предложениях пойдут вниз. Завод мелкой серии должен защищать не цену, а ту работу, от которой другие отказываются: тонкие стенки, пятиосевая обработка за один установ, титан и 17-4PH, срочные партии. Цифра по сервисным роботам — отдельное предупреждение: потребительский продукт идёт за акциями и сезоном, его заказы эластичны; промышленные и корпусные детали идут за этапами проекта заказчика, их заказы жёсткие. Если ваш график привязан к потребительскому ритму, закладывайте больше времени на материал.',
    source: 'Государственное статистическое управление КНР, «Промышленное производство в сентябре 2026 года выросло на 5,5%» с приложением, 19 октября 2026.',
  },
  {
    tag: 'Робототехника / Форма заказа',
    date: '2026-10-19',
    title: '400 моделей, 40 000 штук, 100 000 за год: заказ на гуманоида — это примерно сто штук на модель',
    summary: 'На брифинге Пресс-канцелярии Госсовета 19 октября директор департамента науки и технологий MIIT Вэй Вэй привёл три цифры: в первом полугодии 2026 года китайские производители выпустили более 400 моделей гуманоидных роботов и произвели свыше 40 000 штук, по итогам года ожидается более 100 000; продукция уже прошла проверку и развёрнута более чем в 300 приоритетных сценариях — складская логистика, общепит и розница, бытовые услуги. Там же сказано, что будет опубликовано «Руководство по построению системы стандартов национальной индустрии гуманоидных роботов (редакция 2026 года)». Отдельно: Государственное управление по регулированию рынка утвердило первые шесть национальных стандартов для гуманоидных роботов — состав корпуса, архитектура системы, восприятие окружающей среды; вступают в силу 1 апреля 2027 года.',
    what_it_means: 'Разделите 40 000 на 400 моделей — получится 100 штук на модель. Разложите 100 000 на 400 с лишним моделей — на каждую всё равно приходится двести-триста. Вот настоящая форма заказа в этой отрасли сегодня: много номенклатуры, очень мелкая серия. То есть форма завода прототипов, а не контрактного производства массовой серии. Более трёхсот сценариев означают, что одну и ту же машину под каждого заказчика переделывают — корпусные детали, интерфейсы, оболочку, — и каждая переделка это ещё один круг образцов. Поэтому заказы, которые реально доступны сейчас, — это чаще всего несколько десятков штук за раз, три раза в месяц. Считать цену за штуку — уйдёте в минус; считать по числу переналадок — появится экономика. Когда стандарты вступят в силу в апреле 2027 года, заказчики начнут требовать данные контроля по единой шкале — заведите шаблоны отчёта по первой детали и протокола партии сейчас, а не тогда.',
    source: 'Пресс-конференция Пресс-канцелярии Госсовета КНР (департамент науки и технологий MIIT, Вэй Вэй), 19 октября 2026, стенограмма на miit.gov.cn; China Securities Journal (cs.com.cn), 20 октября 2026 (шесть стандартов и дата вступления).',
  },
  {
    tag: 'ИИ / Цех',
    date: '2026-10-22',
    title: 'ИИ читает чертёж и выдаёт маршрут за минуты с точностью 95%: планку в расчёте цены подняли заново',
    summary: '22 октября Economic Information Daily рассказала, как шанхайская Black Lake Technologies подключила ИИ-агентов к заказам, чертежам, оборудованию и цеху завода. Раньше, получив чертёж под заказ, опытный технолог два-три часа читал размеры и допуски, разбивал работу на операции и выбирал маршрут. Теперь агент читает чертёж, соотносит его с технологией и возможностями оборудования предприятия и выдаёт разбивку за минуты. Соучредитель компании Ли Сян говорит, что точность на этом участке уже выше 95%. Та же способность, по словам компании, сократила цикл вывода новинки с трёх месяцев до трёх недель, а минимальную партию — с 10 000 штук до 100. Второй пример из материала: завод крепежа с 7 типоразмерами и более чем 600 исполнениями внедрил цифровые наряды и за год увеличил выручку на 10%.',
    what_it_means: 'Это бьёт прямо по расчёту цены. Раньше заказчик сравнивал поставщиков по принципу «кто ответит за два часа»; теперь, когда программа превращает чертёж в маршрут за минуты, два часа из преимущества превратились в пропуск на входе. Разница сместилась на шаг дальше: когда цена считается быстро, вопрос в том, возьмёте ли вы заказ на 100 штук и отдадите ли по этим ста деталям первую деталь, стабильность от партии к партии и протоколы контроля. Для завода мелкой серии это хорошая новость: программа выравнивает скорость ответа, но не выравнивает приспособления, траекторию инструмента и деформацию тонкой стенки. И одну вещь стоит сказать прямо: ИИ-маршрут даёт операции и оценку времени, но он не знает фактической жёсткости вашего станка, припуска в этой партии материала и того, не уведёт ли зажим тонкую стенку из допуска. Поэтому внятно указанные на чертеже допуски, базы и состояние материала помогают больше, чем ещё один звонок с просьбой ускорить цену.',
    source: 'Economic Information Daily, 22 октября 2026 (корреспонденты Сан Тун, Ван Молин, Ци Синьюань); данные по эффективности и точности — в изложении компании.',
  },
  {
    tag: 'Жидкостное охлаждение / Порог допуска',
    date: '2026-10-21',
    title: 'Охлаждение на подъёме, а у публичной компании весь портфель — 49 млн юаней: порог стоит на мелкой серии',
    summary: '21 октября Jinzhou Pipe (002443.SZ) раскрыла протокол встречи с инвесторами: направление жидкостного охлаждения получило заказ на 170 комплектов трубной обвязки CDU от одного клиента, конечный заказчик — крупная интернет-компания, отгрузка до конца октября 2026 года; суммарно по этому направлению на 10 октября набрано около 49 млн юаней заказов. Бизнес работает в основном по схеме ODM/OEM, прямые клиенты — производители комплектующих и модулей охлаждения, а также системные интеграторы; первая очередь линии в Дунгуане (Huaxing) уже поставляет серийно и выходит на проектную мощность. Описание того, как реально приходит объём, стоит записать дословно: ведущие заказчики сначала проходят свой цикл проб и ошибок, а серийно вводят поставщика, когда его показатель способности к мелкосерийному производству достигает 80% или 85%.',
    what_it_means: '49 млн юаней говорят о сегодняшнем месте отрасли больше, чем любой прогноз про рынок в сотни миллиардов: отрасль всё ещё идёт от образцов и валидации к серии, и объём ещё не пришёл. А фраза про 80% или 85% мелкосерийной способности написана будто про нас: заказчик сначала смотрит не на то, сколько у вас мощностей, а на то, удержите ли вы выход годных, стабильность и ритм поставки на этапе мелкой серии. Холодные плиты, манифолды и быстроразъёмные соединения сложны не геометрией; они сложны плоскостностью, шероховатостью уплотнительных поверхностей в каналах, чистотой перед пайкой и стабильностью от партии к партии — и это ровно те параметры, которые фиксируют на этапе образцов. Поэтому самое ценное, что вы отдаёте вместе с деталью охлаждения, — не деталь, а запись: какие параметры были в этой партии и как их повторить в следующей.',
    source: 'Jinzhou Pipe (002443.SZ), протокол встречи с инвесторами, 21 октября 2026 (по сообщениям Guandian и Sina Finance).',
  },
  {
    tag: 'Станкостроение / Мощности',
    date: '2026-10-19',
    title: 'Выручка станкостроителя +30,4%, линии загружены: портфель уходит вперёд, покупка станка означает более долгое ожидание',
    summary: '19 октября вечером Neway CNC (688697.SH) опубликовала отчёт за третий квартал 2026 года: выручка за девять месяцев — 2,699 млрд юаней, +30,40%, чистая прибыль акционерам — 276 млн юаней, +33,65%; в третьем квартале отдельно выручка 1,032 млрд юаней, +30,35%, чистая прибыль 95,91 млн юаней, +25,78%. Компания объясняет рост выручки притоком заказов. На встрече с инвесторами 31 августа она сообщила, что портфель заказов достаточный, загрузка высокая, и все группы станков загружены практически полностью, кроме четвёртой очереди расточно-фрезерной линии. Контекст отрасли: по данным CMTBA за январь–август выручка отрасли составила 720,9 млрд юаней, +7,5%, в том числе металлорежущие станки +18,6%, кузнечно-прессовое оборудование −4,2%; новые заказы на металлообрабатывающие станки +15,7%, портфель +19,3%.',
    what_it_means: 'Полная загрузка станкостроителей — один сигнал с двумя сторонами. Для заказчика, который думает строить своё производство: портфель растёт быстрее новых заказов (+19,3% против +15,7%), то есть график сдвигается вперёд — закажите обрабатывающий центр сегодня, и ждать придётся дольше, чем год назад; а после поставки ещё приёмка, пусконаладка и выход на режим, так что от решения «делаем сами» до стабильного выпуска проходит квартал, а не месяц. Для завода мелкой серии: в это окно на подряд обычно уходит больше работы, потому что заказчик не может ждать оборудование. Поэтому мы предпочитаем сказать заранее: если образцы нужны в течение трёх месяцев, а мелкая серия — в течение полугода, покупать станок поздно, отдавайте на подряд; если объём стабильно держится на нескольких тысячах в месяц уже год — покупайте станок, и мы передадим вам режимы и схему приспособлений, чтобы вы подхватили сами. Это не отказ от работы, это ясность в вопросе, когда подряд — правильный ответ.',
    source: 'Neway CNC, отчёт за третий квартал 2026 года, 19 октября 2026 (по сообщениям Securities Daily и Hithink RoyalFlush); CMTBA, «Краткий обзор экономики станкоинструментальной отрасли за январь–август 2026 года», 10 октября 2026.',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Еженедельно. Мы не ведём бегущую строку новостей — мы ведём список для чтения и включаем только то, что меняет действия покупателя деталей ЧПУ в этом квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только первоисточники: национальные статистические ведомства, таможня, отраслевые ассоциации, органы по стандартизации, отчётность компаний и именная пресса. Мы не перепечатываем аналитические заметки как факты.' },
  { q: 'Почему взгляд цеха, а не рыночный отчёт?', a: 'Потому что рыночный отчёт говорит, куда дует ветер. Взгляд цеха говорит, приземлилась ли работа на самом деле. У каждой новости здесь есть строка «что это значит» — за неё мы и отвечаем.' },
];

const related = [
  { label: 'От чертежа до стоимости', href: '/ru/knowledge/tech-blog/from-drawing-to-cost/' },
  { label: '60 разных деталей за 10 дней', href: '/ru/knowledge/tech-blog/sixty-skus-ten-days/' },
  { label: 'Жидкостное охлаждение, вычисления и роботы', href: '/ru/knowledge/tech-blog/liquid-cooling-compute-and-robots/' },
  { label: 'Какой станок нужен вашей детали', href: '/ru/knowledge/tech-blog/which-cnc-machine-for-your-part/' },
];
---

<PageLayout
  title="Новости отрасли CNC-производства · Выпуск 06 | Eternal CNC"
  description="Конец октября 2026: у гуманоидов около 100 штук на модель, ИИ сжимает расчёт цены до минут, портфель по охлаждению — 49 млн юаней, станкостроители загружены."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Что на этот раз заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Опубликовано {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, которые стоит запомнить</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять новостей</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что произошло и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, потом главная строка: что меняется для заказчика, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три вопроса, которые нам задают</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">По теме в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">2 ноября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
За чем мы следим: PMI за октябрь и первые данные по заказам четвёртого квартала; изменят ли шесть новых стандартов на гуманоидов то, что заказчики пишут на чертежах; и как быстро инструменты ИИ-расчёта цены расходятся от первых пользователей к обычным заводам.
          </p>
          <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите следующий чертёж
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы рассчитаем в течение 2 часов в рабочий день и прямо скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
