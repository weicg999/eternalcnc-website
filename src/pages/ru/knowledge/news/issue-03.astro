---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge/' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '03',
  date: '29 сентября 2026',
  blurb: 'Пять вещей, которые заметил цех, — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: '+29,9%', label: 'Выпуск оборудования для 3D-печати в Китае, г/г, август 2026 (при +34,6% у промышленных роботов и +57,2% у литиевых элементов)', source: 'Национальное бюро статистики, 15 сен 2026' },
  { metric: '2,782 млрд юаней', label: 'Сумма контракта на оборудование жидкостного охлаждения, подписанного Shenling 16 сен (≈4,15 млрд долл., около 66% выручки за 2025 г.)', source: 'Раскрытие Shenling / Shanghai Securities News, 28 сен 2026' },
  { metric: '60%–70%', label: 'Доля локализации гармонических редукторов для гуманоидов в Китае в Q1 2026 (отечественная цена — 40%–60% от японской)', source: 'CAICT (Китайская академия ИКТ), Q1 2026' },
];

const stories = [
  {
    tag: 'Робототехника / винты',
    date: '2026-09',
    title: 'Планетарные роликовые винты: «сухожилия» гуманоидов выходят в серию',
    summary: '2026 год повсеместно называют «годом серийного производства» гуманоидов, и деталь, ближайшая к механическому цеху, — планетарный роликовый винт — переходит от проверки прототипов к масштабному выпуску. Планы мощностей объявляются один за другим: ZW Precision (Wuzhou Xinchun) к концу 2026 года рассчитывает на 980 000 планетарных роликовых винтов + 2,1 млн микрошариковых в годовом исчислении; первая очередь Shuanglin на 100 000 обратных планетарных роликовых винтов запущена в июне 2026 и поставляет образцы ведущим OEM; проект Xinjian Transmission на 1 000 000 винтов в год прошёл согласование земли; Beite Technology инвестирует 1,85 млрд юаней в базу НИОКР и производства и получила в Таиланде BOI на 330 млн юаней под роликовые винты. Ещё более весомый технический ориентир — Jinwo: её собственная разработка, обработка внутренней резьбы с большим отношением длины к диаметру, достигает точности 1 микрон, выше известного мирового максимума (3 микрона); уже обеспечивает винтами для 50 000 гуманоидов в год с планом 100 000 к концу 2026, 200 000 в 2027 и 1 000 000 в перспективе, плюс завод в Таиланде в 2027. Hengli Hydraulics прошла аудит Tesla Optimus Gen3 в декабре 2025, делает винты точности C3 (ошибка <12 мкм на 300 мм), а завод в Таиланде открывается в 2026 на мощность 80 000 гуманоидов. Наращивание мощностей тянет и оборудование: Huachen получила заказ на 100 резьбошлифовальных станков, а высокоточные раскатные станки Sijin Intelligent и внутрирезьбовые накатные станки Xinzuobiao поднимаются той же волной.',
    what_it_means: 'Винт — самая «цеховая» деталь этого цикла: вал винта — это чистовое точение + шлифовка подшипниковой стали (класс GCr15), где главное ограничение — накопленная ошибка шага; гайка — внутренняя резьба с большим отношением длины к диаметру, тонкостенная, склонная к дребезгу, с трудом держит форму зуба. Самое важное для тех, кто присылает нам детали: если ваш цех умеет чистово точить и шлифовать вал винта класса C3 или держать внутреннюю резьбу гайки с отношением длины к диаметру >10:1, этот раунд заказов найдёт вас первым. Но не отправляйте винт как обычный вал — ошибка шага, средний диаметр резьбы и шероховатость боковой поверхности резьбы (напрямую задают КПД передачи и ресурс) — три жёстких порога. Путь от образцов до «миллиона в год» долгий, и это как раз окно мелкосерийного быстрого прототипирования — до серии кто-то должен сначала сделать образцы стабильными.',
    source: 'All-weather Tech «Планетарные роликовые винты — жизненные нити гуманоидов», 2026; Huaxin Securities «Наращивание мощностей по планетарным роликовым винтам 2026»; Sina Finance, обзор цепочки гуманоидов, 2026; протокол инвесторов Jinwo (через стороннюю базу знаний), 2026.',
  },
  {
    tag: 'Вычисления / жидкостное охлаждение',
    date: '2026-09-28',
    title: 'Заказы на жидкостное охлаждение расписаны на 2027 год: быстроразъёмы и коллекторы — настоящее узкое место',
    summary: 'В Выпуске 02 мы дали жидкостному охлаждению «линейку» (GB/T 48023 / 48097). Этот выпуск — другой конец той же линейки: спрос взорвался. Economic Daily (через United Daily News) 7 сентября сообщила, что производители цепочки жидкостного охлаждения раскрывают крупные заказы: несколько фирм расписаны до конца года, а линии работают в две смены. Shanghai Securities News 28 сентября подтвердила «расписано на 2027-й»: заказы JinFu расписаны на 2027-й, сотрудники работают сверхурочно в праздники середины осени и Национальный праздник; 16 сентября Shenling подписала с зарубежным заказчиком контракт на 4,15 млрд долл (≈2,782 млрд юаней) на холодильное оборудование — около 66% выручки за 2025 год, а в H1 новые заказы её сегмента услуг для дата-центров составили ~2,3× к прошлому году, из них около 1,8 млрд юаней — по жидкостному охлаждению. Выручка Xingrui по аппаратной части AI-серверов достигла 60,5 млн юаней, +221% г/г в H1, с почти 1 млрд юаней новых заказов с начала года. Сильнее всего разрыв между спросом и предложением — на быстроразъёмах UQD — высочайший барьер надёжности, мало квалифицированных поставщиков, расширение не поспевает за сдачей ЦОД; коллекторы и прецизионные насосы/клапаны тоже в дефиците по инженерной точности. CICC оценивает мировой рынок жидкостного охлаждения интеллектуальных вычислительных центров в 2026 году в 114,7 млрд юаней, +273% г/г.',
    what_it_means: 'Это «глава о внедрении» стандарта из Выпуска 02. Стандарт вписал ±10% гидросопротивления и взаимозаменяемость в правила; спрос теперь вписал дефицит мощностей в реальность — самое тугое — не холодная плита (тайваньские заводы уже на миллионе плит в месяц), а быстроразъём UQD и коллектор. Для присылающих нам детали: уже не «делать ли детали охлаждения», а «мощностей не хватает, а крупные игроки борются за стабильных поставщиков». Если ваш корпус разъёма / коллектор держит ±10% расхода от партии к партии и остаётся взаимозаменяемым — это как раз тот класс, за который идёт борьба. На чертеже: подложки / крышки холодных плит (плоскостность, каналы), коллекторы (полости, порты) и корпуса UQD (точение + уплотнительные поверхности) — это 5-осевая фрезеровка + опрессовка на герметичность, обычно 10–500 штук — шероховатость уплотнительной поверхности, скорость течи и гидросопротивление, проставленные до отправки чертежа, важнее всего.',
    source: 'Economic Daily (через United Daily News) «Производители жидкостного охлаждения расписаны до конца года, две смены», 7 сен 2026; Shanghai Securities News «Расписано на 2027-й! Жидкостное охлаждение в цене», 28 сен 2026; Cailian Press, цепочка жидкостного охлаждения, сен 2026; оценка CICC рынка жидкостного охлаждения, 2026.',
  },
  {
    tag: 'Отрасль ЧПУ',
    date: '2026-09-15',
    title: 'Полугодовой отчёт станкостроения, перечитываем: экспорт режущего инструмента +23% обошёл сами станки; отечественное 5-осевое забирает долю импорта',
    summary: 'Данные Китайской ассоциации станкостроителей и инструментальщиков (CMTBA) за первое полугодие (через World Metals, 15 сентября) стоит разобрать по частям: выручка отрасли 530,9 млрд юаней, +7,6%; выпуск металлорежущих станков 432 000 штук, +6,9% (НБС); внешнеторговый оборот 17,2 млрд долл, +5,9%, профицит 6,49 млрд долл. Разделив «станки» и «расходники», видим интересное: ежемесячный обзор высокотехнологичного экспорта Sina (янв–авг 2026) даёт экспорт станков 3,95 млрд долл, -3%, но экспорт режущего инструмента 2,32 млрд долл, +23% (Азия 40% / Европа 37% / Северная Америка 13%). Пока экспорт станков буксует, прецизионный инструмент забирает зарубежную долю. По импорту: ввоз металлообрабатывающих станков 2,61 млрд долл, -2,6% — падение импорта больше падения экспорта, значит импортозамещение в высоком сегменте ускоряется.',
    what_it_means: 'Два вывода, бьющих напрямую: (1) экспорт режущего инструмента +23% означает жёстче конкуренцию среди отечественных производителей, так что ваши расходы на инструмент падают — та же концевая фреза в этом году дешевле, чем в прошлом, и эта экономия ложится в себестоимость штуки. (2) импорт станков падает, долю забирает отечественное 5-осевое — значит всё больше цехов ниже по цепочке работают на отечественных 5-осевых; цеха вроде нашего, умеющие и программировать отечественное 5-осевое, и вести оснастку, становятся привлекательнее. Пометка из Выпуска 01 — «прибыль удвоилась, но маржа лишь 3,7%» — остаётся в силе: если сами станкостроители едва зарабатывают, ценовая война не кончилась, и подрядчику по ЧПУ-обработке не выиграть повышением цен — ценовая сила по-прежнему в «стабильности + сроке + мелкой серии».',
    source: 'CMTBA, данные за H1 2026, через World Metals, 15 сен 2026; выпуск металлорежущих станков НБС; ГТУ / Sina Finance «Ежемесячный обзор высокотехнологичного экспорта (янв–авг 2026)».',
  },
  {
    tag: 'Робототехника / редукторы',
    date: '2026',
    title: 'Отечественные прецизионные редукторы вышли на «ежемесячные поставки десятками тысяч»: ядра шарниров от узкого места к замещению',
    summary: 'Мониторинг CAICT за Q1 2026 показывает: доля локализации гармонических редукторов для гуманоидов в Китае достигла 60%–70%, отечественная цена — 40%–60% от японской, стоимость всего трансмиссионного узла шарнира снижена на 30%–50%, а цена самого гуманоида опустилась до уровня около 100 000 юаней. По мощностям лидеры полностью перешли от «поставок образцов» к «ежегодным рамочным контрактам»: GreenHarmony с её облегчённой P-серией для гуманоидов обеспечивает точность 5 угловых секунд (на уровне топ-моделей Harmonic Drive) и является единственным отечественным поставщиком первого уровня для Tesla Optimus; её линия на 5 000 000 комплектов для гуманоидов полностью запущена в июле 2026 с заказами до конца 2027; у Shuanghuan дочерняя Huandong держит заказы на RV-редукторы свыше 23 млрд юаней с поставкой до 2028; XT-циклоидальный редуктор Giant Wheel прошёл 3 000 часов ресурсных испытаний и легче на 50%; автоматизированные линии Quanzhibo и Laifu Harmonic выдают комплект за 90 секунд, выход >96%. Данные отрасли: ежемесячные отгрузки лидеров устойчиво превысили 10 000 комплектов.',
    what_it_means: '«Невидимые, но самые дорогие» детали редуктора — гибкое колесо (тонкостенный стакан, легко деформируется, трудно точить и фрезеровать), жёсткое колесо (внутренняя шестерня), кольцо гибкого подшипника, выходной фланец — всё это прецизионные обработанные детали. Рост локализации плюс ежемесячные десятки тысяч означают, что их серийная механообработка перешла от «образцов» к годовым рамочным контрактам. Для присылающих нам детали: производители редукторов ищут стабильных поставщиков гибких колёс / жёстких колёс / колец подшипников; если ваши тонкостенные детали не деформируются, а форма внутреннего зуба стабильна, это более спокойный и длинный контракт, чем работа по структурным деталям робота. Но помните историю 1 из Выпуска 02 — редуктор поставляется комплектом из четырёх деталей (гибкое колесо / жёсткое колесо / подшипник / фланец); одно ушедшее по размеру — и комплект не соберётся, поэтому допуски экстремальны, а соперничество идёт за серийную стабильность, а не за отдельный красивый экземпляр.',
    source: 'CAICT (Китайская академия ИКТ), мониторинг Q1 2026; Hangzhou International Humanoid Robot Exhibition / AndroidShow, 2026; Sina Finance, обзор ключевых компонентов, 2026.',
  },
  {
    tag: 'Техпроцесс',
    date: '2026-09-15',
    title: 'Оборудование для 3D-печати +29,9%: аддитив не отбирает работу у ЧПУ, он её подстраховывает',
    summary: 'В августовских данных НБС одна позиция осталась за кадром из-за роботов и литиевых элементов: выпуск оборудования для 3D-печати вырос на +29,9% г/г (при +57,2% у литиевых элементов, +34,6% у промышленных роботов, +16,7% у добавленной стоимости высокотехнологичного производства). Металлическое аддитивное оборудование тоже даёт небольшую экспортную строку (~8 млн долл в августе). За ростом — детали с конформным охлаждением, облегчёнными решётками и сложными внутренними полостями, то есть класс «того, что механообработкой не сделать или делать невыгодно», и он сильно пересекается с историей 2 этого выпуска — холодной плитой (конформные каналы).',
    what_it_means: 'Одно уточнение: аддитив не заменяет ЧПУ, он подстраховывает ЧПУ. Сложные полости, конформное охлаждение и облегчение решётками быстро формуются печатью, но почти каждая напечатанная деталь возвращается на точение / фрезеровку, чтобы получить базы, резьбы и сборочные признаки, — печать отвечает за «форму», ЧПУ — за «посадку, герметичность и замеры». Для присылающих нам детали: если у детали конформное охлаждение или глубокая полость, мы можем оценить гибридный маршрут «3D-печать + последующая ЧПУ-доводка», который часто быстрее и дешевле одной только 5-осевой черновой обработки. Не трюк — ещё один вариант сжать ваш срок.',
    source: 'НБС «Основные данные промышленного производства, август 2026», 15 сен 2026 (Синьхуа, CCTV); ГТУ / Sina Finance, месячник высокотехнологичного экспорта (металлическое оборудование 3D-печати), янв–авг 2026.',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Еженедельно. Мы не ведём бегущую строку новостей — мы ведём список для чтения и включаем только то, что меняет действия покупателя деталей ЧПУ в этом квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только первоисточники: Национальное бюро статистики, Главное таможенное управление, CMTBA, CAICT, отчётность компаний и именная пресса. Мы не перепечатываем аналитические заметки как факты.' },
  { q: 'Почему взгляд цеха, а не рыночный отчёт?', a: 'Потому что рыночный отчёт говорит, куда дует ветер. Взгляд цеха говорит, приземлилась ли работа на самом деле. У каждой новости здесь есть строка «что это значит» — за неё мы и отвечаем.' },
];

const related = [
  { label: 'Шарниры роботов и фланцевые детали', href: '/ru/knowledge/tech-blog/robot-joint-and-flange-parts/' },
  { label: 'Детали роботов на 5-осевом за одну установку', href: '/ru/knowledge/tech-blog/robotics-5-axis-one-setup/' },
  { label: 'Механообработка и финишная обработка поверхности', href: '/ru/knowledge/tech-blog/machining-and-surface-finishing/' },
  { label: 'Срок и цена', href: '/ru/knowledge/tech-blog/lead-time-and-price/' },
];
---

<PageLayout
  title="Новости отрасли CNC-производства · Выпуск 03 | Eternal CNC"
  description="Конец сентября 2026: планетарные роликовые винты вышли в серию, заказы на охлаждение расписаны до 2027 года, экспорт инструмента +23%."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        В этом выпуске: что заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Выпущено {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, достойные внимания в этом выпуске</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять историй</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что случилось и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, затем строка, которая важна: что меняется для покупателя, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три частых вопроса</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">Похожее в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">2 октября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
Сюжеты, за которыми мы следим: кто первым начнёт поставлять мелкосерийные образцы винтов на фоне развёртывания серийного производства; готовы ли чертежи заказчиков к стандарту по жидкостному охлаждению, который вступает в силу в феврале 2027; удержит ли экспорт режущего инструмента +23% в годовом отчёте отрасли.
          </p>
          <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите нам следующий чертёж
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы дадим расчёт в течение 2 часов в рабочий день и скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Смотреть техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
