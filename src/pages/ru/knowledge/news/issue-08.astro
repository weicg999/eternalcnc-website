---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge/' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '08',
  date: '6 ноября 2026',
  blurb: 'Пять вещей, которые заметил цех, — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: '49,3%', label: 'Индекс менеджеров по закупкам (PMI) обрабатывающей промышленности Китая за октябрь. На 0,8 процентного пункта ниже сентябрьских 50,1% — возврат под черту, отделяющую рост от спада. Подиндекс производства — 49,8 (минус 1,9), новых заказов — 49,4 (минус 1,1), новых экспортных заказов — 48,7. Структура важнее общего числа: высокотехнологичное производство — 51,3, производство оборудования — 50,6, тогда как потребительские товары — 48,8, энергоёмкие отрасли — 47,3. По размеру предприятий: крупные — 50,2, средние — 48,4, малые — 47,5.', source: 'Государственное статистическое управление КНР, «Работа индекса менеджеров по закупкам Китая в октябре 2026 года», 31 октября 2026 года.' },
  { metric: '100 штук в день, 10 000 в месяц', label: 'Текущий суточный выпуск гуманоидных роботов на сборочной базе Lens Technology в Куньшане и та месячная мощность, которую компания планирует зарезервировать под серии Q и T своего заказчика со следующего месяца. База начала подготовку в конце августа 2026 года, первое изделие сошло с линии в конце сентября. Оговорка: 10 000 в месяц — это мощность, а не портфель заказов такого объёма и не фактическая отгрузка.', source: 'Lens Technology, «Протокол встречи с инвесторами», раскрыт 1 ноября 2026 года (выездная встреча 30 октября 2026 года).' },
  { metric: '10 млн комплектов', label: 'Планируемый годовой выпуск микроканальных холодных плит после выхода на полную мощность на проекте жидкостного охлаждения стоимостью 1,1 млрд юаней в Чжанцзягане, провинция Цзянсу (годовая выручка 900 млн юаней). Подписанный в тот же день проект оборудования для жидкостного охлаждения рассчитан на 1 500 комплектов нагрузочных устройств и 2 000 блоков распределения хладагента (CDU) в год (выручка 800 млн юаней). Это проектная мощность, а не заказы.', source: 'Народное правительство города Чжанцзяган, «Проект интеллектуального жидкостного охлаждения с инвестициями 1,1 млрд юаней размещён в нашем городе», 31 октября 2026 года.' },
];

const stories = [
  {
    tag: 'Макроэкономика',
    date: '2026-10-31',
    title: 'PMI обрабатывающей промышленности в октябре откатился до 49,3 — но оборудование на 50,6 и высокие технологии на 51,3 держатся выше черты 27 месяцев подряд',
    summary: 'Государственное статистическое управление 31 октября сообщило: индекс PMI обрабатывающей промышленности в октябре составил 49,3%, на 0,8 процентного пункта ниже сентябрьских 50,1%, — возврат в зону сжатия. Подиндекс производства — 49,8 (минус 1,9), новых заказов — 49,4 (минус 1,1), новых экспортных заказов — 48,7: предложение и спрос ослабли одновременно. Главный статистик Центра обследования сферы услуг Хо Лихуэй объясняет откат тем, что часть спроса была выбрана заранее перед праздником «Золотая неделя», а также сложной и изменчивой международной обстановкой. Структура показательнее итоговой цифры: высокотехнологичное производство — 51,3, производство оборудования — 50,6, причём подиндексы производства в обеих отраслях держатся выше 50 уже 27 месяцев подряд, а индекс новых заказов в производстве оборудования вернулся выше 51. Потребительские товары — 48,8, энергоёмкие отрасли — 47,3. По размеру: крупные предприятия — 50,2, средние — 48,4, малые — 47,5. По ценам: индекс закупочных цен на основные сырьё и материалы — 56,8 (минус 4,0), индекс отпускных цен — 51,7 (минус 2,3); оба снизились, но остаются в зоне роста.',
    what_it_means: 'PMI — среднее по стране; то, что ваш цех чувствует в этом месяце, определяется составом заказчиков. У тех, кто работает на автопром и потребительский сектор, заказы сжимаются; у тех, кто работает на электронику и оборудование, ещё растут. Действовать нужно в двух строках коммерческого предложения. Закупочные цены на сырьё стоят на 56,8, отпускные цены — на 51,7, и разницу между ними поглощает механическая обработка, то есть мы. Поэтому срок действия КП на мелкую серию стоит сократить с месяца до двух недель, а оговорку о подвижке цен на материал внести в договор. Фиксированная цена на три месяца означает, что вы берёте на себя колебание рынка материалов вместо заказчика. С другой стороны, малые предприятия на 47,5 который месяц ниже черты — значит, изрядная часть ваших конкурентов сейчас охотится за заказами: именно в такие моменты торг идёт жёстче всего, и именно тогда легче всего согласиться на цену, от которой надо было отказаться.',
    source: 'Государственное статистическое управление КНР, «Работа индекса менеджеров по закупкам Китая в октябре 2026 года» и разъяснение Хо Лихуэй, 31 октября 2026 года.',
  },
  {
    tag: 'Станкостроение / ИИ (главная тема ИИ в этом выпуске)',
    date: '2026-11-02',
    title: 'В Вэньлине убрали ШВП из станка высокого класса: модель с прямым приводом и ИИ, интегральные характеристики на 30–60% выше национального стандарта',
    summary: 'Издание The Paper в материале «Вэньлин поднимается, часть первая» сообщает: Чжэцзянский провинциальный центр технологических инноваций в области высококлассных станков с ЧПУ (создан администрацией Вэньлина совместно с Чжэцзянским университетом, открыт в июле 2023 года) представил линейку высококлассных станков с прямым приводом собственной разработки, где искусственный интеллект встроен в контур управления. Прямой привод заменил классическую связку «серводвигатель плюс шарико-винтовая передача», и интегральные характеристики станка превысили национальный стандарт на 30–60%. Проект пятиосевой обработки под руководством директора центра Фу Цзяньчжуна ранее получил первую премию провинции Чжэцзян в области научно-технического прогресса, результаты уже серийно поставляются NIO, Li Auto и Geely. Позиция Фу: соединение искусственного интеллекта с системой ЧПУ и есть направление прорыва, и «через несколько лет работы у нас есть шанс догнать мировой передовой уровень». Та же формулировка звучит и в отчёте Министерства промышленности и информатизации о программе «ИИ плюс производство»: газета China Industrial News 2 ноября пишет, что «самостоятельно разработанный станок с ЧПУ с прямым приводом и ИИ совершил прорыв, интегральные характеристики на 30–60% выше национального стандарта», и приводит цифру: построено более 13 000 предприятий передового уровня и свыше 500 предприятий уровня превосходства в программе умных заводов.',
    what_it_means: 'Для заказчиков, которые поставляют детали станкостроительным заводам, это смена структуры заказов, а не их постепенное исчезновение. Прямой привод убирает из станков высокого класса целую цепочку деталей трансмиссии — ШВП, соединительные муфты, корпуса подшипников. Взамен появляется другое семейство: посадочные места статора, фланцы ротора, установочные плоскости энкодеров, базовые поверхности под наклейку магнитов. Допуски формы и расположения по ним сжимаются до микронного уровня, большинство таких деталей — прецизионные фрезерованные изделия из алюминиевых сплавов или чугуна, и стабильно они получаются только за один установ на пятиосевом станке. То есть на один и тот же станок идёт меньше деталей, но каждая сложнее. Если среди ваших заказчиков есть станкостроители, спрашивать у них в этом году надо не «как с заказами», а «кто делает посадочные места статора и корпуса энкодеров для ваших моделей с прямым приводом», — вместо того чтобы ждать, пока заказы на ШВП поредеют, и потом искать причину.',
    source: 'The Paper, «Вэньлин поднимается, часть первая: как город, выросший на традиционных кластерах, перестроил свою производственную систему», октябрь 2026 года; China Industrial News, «Прибыль промышленных предприятий выросла на 15,5%, качественное развитие промышленности укореняется», 2 ноября 2026 года.',
  },
  {
    tag: 'Робототехника',
    date: '2026-11-01',
    title: 'База Lens Technology в Куньшане выдаёт 100 гуманоидов в день, со следующего месяца резервирует по 10 000 в месяц под две серии заказчика, а ресурс шарнирных модулей надо поднять с тысячи циклов до десяти тысяч',
    summary: 'В протоколе встречи с инвесторами, раскрытом Lens Technology (300433.SZ) вечером 1 ноября, указано: 30 октября более десяти институциональных инвесторов посетили завод сборки корпусов роботов Qiyuan в куньшаньском парке компании. База в Куньшане начала подготовку в конце августа 2026 года, первое изделие выпустила в конце сентября, сейчас вышла на уровень 100 штук в сутки; по мере поступления собственного полуавтоматического и автоматического оборудования мощность вырастет ещё, и со следующего месяца под серии Q и T заказчика будет зарезервировано более 10 000 штук в месяц по каждой. Линия работает на MES, с полной прослеживаемостью и онлайн-контролем параметров процесса. Одна техническая строка в том же протоколе важнее цифр по мощности: ресурс шарнирных модулей в отрасли обычно измеряется первыми тысячами циклов, и компания заявляет, что за счёт своих компетенций в прецизионном производстве ведёт его к промышленному стандарту в десять тысяч. Обратная сторона — из отчёта за третий квартал, раскрытого 25 октября: выручка за девять месяцев 47,902 млрд юаней, минус 10,74%; чистая прибыль, приходящаяся на акционеров, 1,420 млрд юаней, минус 50,06%; прибыль после исключения разовых статей 998 млн юаней, минус 63,07%. Курсовой убыток в 654 млн юаней стал серьёзным отрицательным фактором, запасы выросли на 35,02% с начала года. Выручку и валовую маржу робототехнического направления компания отдельно не раскрывает.',
    what_it_means: 'Происходит два процесса сразу, и смотреть только на первый — ошибка. Первый: изменилась форма запроса. Производитель, который планирует производство от 10 000 штук в месяц, присылает поставщику деталей запрос на десятки тысяч, одна номенклатура, повторяемо. В такой форме цех мелкосерийного прототипирования может взять только передний край — первую деталь, валидацию мелкой партией, приспособления и оснастку, — а серию обязан отдать поточной линии. Это не плохая новость при одном условии: не выходить на тендер по серийной цене с прототипной себестоимостью. Второй процесс и есть настоящий барьер. Поднять ресурс с тысячи циклов до десяти тысяч — рост в десять раз, и достигается он не сборкой, а стабильностью материала от партии к партии, кривыми термообработки, повторяемостью шероховатости и допусков формы на сопрягаемых поверхностях. На стадии прототипа всё это не проявляется — только на нескольких тысячах циклов. Поэтому в КП на такие работы надо закладывать деньги на доводку при выходе в серию, а себестоимость считать не по выходу годных на первой детали. И ещё: критерии приёмки по ресурсу и схему выборки по партиям лучше согласовать в договоре заранее — это дешевле, чем потом выяснять, кто виноват.',
    source: 'Lens Technology, «Протокол встречи с инвесторами», раскрыт 1 ноября 2026 года; «Отчёт за третий квартал 2026 года», раскрыт 25 октября 2026 года.',
  },
  {
    tag: 'Жидкостное охлаждение',
    date: '2026-10-31',
    title: 'Проект жидкостного охлаждения на 1,1 млрд юаней пришёл в Чжанцзяган: 10 млн микроканальных холодных плит и 2 000 CDU в год',
    summary: 'Народное правительство Чжанцзягана 31 октября сообщило: проект производственной базы холодных плит и оборудования для жидкостного охлаждения под задачи ИИ-вычислений с инвестициями 1,1 млрд юаней подписан для Металлургического парка (городок Цзиньфэн). Проект микроканальных холодных плит компании Yuanjie Smart Manufacturing рассчитан на 10 млн комплектов в год после выхода на мощность при годовой выручке 900 млн юаней; подписанный в тот же день проект оборудования и системной интеграции — на 1 500 комплектов нагрузочных устройств и 2 000 блоков распределения хладагента (CDU) в год при выручке 800 млн юаней. Подписант, чжэцзянская Yuanjie Smart Manufacturing, основана в 2023 году; прежде её профилем были прецизионные металлические компоненты для ноутбуков и планшетов (среди заказчиков Samsung, Huawei, Lenovo, Asus, Huaqin) и системы сбора данных CCS для накопителей и тяговых батарей. Официальная логика проекта: замкнуть на местных металлургических материалах цепочку «специальные металлические материалы — прецизионная механообработка — модули жидкостного охлаждения — интеграция вычислительного оборудования» и закрыть дефицит местных комплектующих для охлаждения ИИ-инфраструктуры. В Чжанцзягане сегодня 146 компаний в сфере ИИ, три вычислительных центра и около 15 000 P вычислительной мощности.',
    what_it_means: 'Логика закупки в этой категории переключается с «найти того, кто умеет делать микроканалы» на «найти того, кто стабильно делает десять миллионов». Десять миллионов — проектная цифра, а не портфель заказов, но она обозначает порог масштаба: позиции «мелкая серия с высокой маржой» в этой категории больше не будет. Цеху мелкосерийного прототипирования надо брать не эти десять миллионов, а работу вокруг них, за которую никто не хочет браться: корпуса быстросъёмных соединений, кронштейны, нестандартные корпусные детали нагрузочных стендов, оснастка и приспособления для линии, а также та партия «сделайте сначала 50 штук на проверку», что идёт перед серией. И ещё одно стоит сказать прямо: выше по цепочке от холодной плиты стоит прецизионная механообработка, и в эту нишу заходят как раз такие же, как мы, — заводы корпусных деталей для ноутбуков. Их компетенции во многом совпадают с нашими, а значит, ценовая конкуренция по холодным плитам будет жёстче, чем сейчас. Не идите на серийную цену с прототипной себестоимостью: это игра против чужой сильной стороны своей слабой.',
    source: 'Народное правительство города Чжанцзяган, «Проект интеллектуального жидкостного охлаждения с инвестициями 1,1 млрд юаней размещён в нашем городе», 31 октября 2026 года; Suzhou News (корреспондент Suzhou Daily в Чжанцзягане), 1 ноября 2026 года.',
  },
  {
    tag: 'Робототехника / Автоматизация линий',
    date: '2026-10-31',
    title: 'Завод Schaeffler в Тайцане «роботы собирают роботов» открыт: пять гуманоидов на сборочной линии, шарнирные модули пошли в серию',
    summary: 'CNR 31 октября сообщил: цифровой завод роботов воплощённого интеллекта Schaeffler в Тайцане (провинция Цзянсу) официально открыт 20 октября. Площадь около 7 500 кв. м; на одной площадке собраны интеллектуальная сборочная линия, центр сценарного обучения и сбора данных, платформа цифрового двойника и вычислительный центр. Планировка — «интенсивное обучение на втором этаже, проверка на реальной линии на первом»: сначала навык отрабатывается, затем проверяется в реальном производстве. Завод выпускает шарнирные модули, включая исполнительные приводы, для гуманоидных роботов следующего поколения. На основной сборочной линии пять колёсных гуманоидов Luoshi Zhuxing H совместно выполняют перемещение лотков, сортировку и захват деталей, запрессовку и завинчивание, функциональный контроль, маркировку и упаковку. У Zhuxing H 23 степени свободы, руки построены по семиосевой антропоморфной схеме с перекрёстными осями в запястье, всенаправленная платформа развивает до 1,5 м/с; модель выдаёт непрерывную последовательность действий прямо по данным зрения и собственному состоянию, а не по жёстко записанным траекториям, — именно поэтому она берёт мелкие партии и широкую номенклатуру. Luoshi заявляет более 10 000 поставленных комплектов в направлении воплощённого интеллекта и работу с более чем 80 отраслевыми партнёрами. Schaeffler и Luoshi подписали соглашение о стратегическом сотрудничестве в апреле этого года — по совместной разработке и внедрению ключевых компонентов, включая шарнирные модули для гуманоидов.',
    what_it_means: 'Автоматизированная сборочная линия предъявляет к входному качеству требования другого порядка, чем ручная, — и это главная мысль выпуска. Человек компенсирует «на ощупь»: отверстие ушло на несколько соток — слесарь сам найдёт совпадение, завинчивая винт, а при запрессовке, если пошло туго, остановится. Робот давит с заданным усилием и на заданное перемещение, отклонение он не поглощает — оно превращается в перекос, трещину или стук после сборки. Поэтому одна и та же деталь на ручной линии проходит, а на роботизированной может уйти в брак всей партией. Когда вы отправляете детали таким заказчикам, допуск по чертежу — только нижняя граница; обсуждать надо индекс воспроизводимости процесса и стабильность от партии к партии. Стоимость полного размерного контроля первой детали и выборочного контроля в процессе закладывайте в КП сразу, а не после возврата из серии. В технологическом смысле всё сводится к трём местам: радиусы и заусенцы на сопрягаемых поверхностях под запрессовку, позиционный допуск отверстий под штифты и деформация тонкостенных деталей под усилием зажима. Именно здесь роботизированная линия кусает первой — и именно это на стадии прототипа легче всего спрятать фразой «подшлифуем вручную».',
    source: 'CNR, «Роботы собирают роботов: гуманоиды Luoshi вышли на завод воплощённого интеллекта Schaeffler», 31 октября 2026 года; PR Newswire, «Мультинациональные компании в Китае, месячный обзор», октябрь 2026 года (завод Schaeffler в Тайцане открыт 20 октября).',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Раз в неделю. Мы не гоняемся за новостным потоком, а ведём список для чтения, и берём только то, что меняет действия заказчика в текущем квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только из первых источников: национальные статистические органы, таможня, отраслевые ассоциации, органы стандартизации, отчётность компаний и подписанные материалы прессы. Аналитические записки брокеров мы не пересказываем как факты.' },
  { q: 'Почему взгляд из цеха, а не рыночный отчёт?', a: 'Рыночный отчёт говорит, куда дует ветер. Взгляд из цеха говорит, дошла ли работа до пола. У каждого сюжета есть строка «что это значит для ваших деталей» — вот за неё отвечаем мы.' },
];

const related = [
  { label: 'От 10 до 1 000: что на самом деле меняется, когда деталь робота идёт в серию', href: '/ru/knowledge/tech-blog/robot-parts-prototype-to-production/' },
  { label: 'Охлаждение — общий предел для вычислений и роботов: почему жидкостное охлаждение стало обязательным, а не опциональным', href: '/ru/knowledge/tech-blog/liquid-cooling-compute-and-robots/' },
  { label: 'Одна и та же деталь — почему цены в двух предложениях так расходятся?', href: '/ru/knowledge/tech-blog/quote-difference-quality-cost/' },
  { label: 'Почему ваши детали не собираются: посадка, накопление и передача баз', href: '/ru/knowledge/tech-blog/why-parts-wont-assemble/' },
];
---

<PageLayout
  title="Новости отрасли CNC-производства · Выпуск 08 | Eternal CNC"
  description="Начало ноября 2026 года: PMI обрабатывающей промышленности вернулся к 49,3, оборудование и высокие технологии держатся выше 50, станок с прямым приводом и ИИ на 30–60% выше национального стандарта, Lens Technology выдаёт 100 гуманоидов в день, в Чжанцзягане планируют 10 млн холодных плит в год, а на сборочной линии Schaeffler работают пять гуманоидов."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Что на этот раз заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Опубликовано {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, которые стоит запомнить</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять новостей</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что произошло и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, потом главная строка: что меняется для заказчика, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три вопроса, которые нам задают</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">По теме в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">13 ноября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
Сюжеты, за которыми мы следим: ноябрьская статистика по выпуску промышленных роботов и станков с ЧПУ от Государственного статистического управления; отразится ли октябрьское падение PMI в портфеле заказов декабря или останется колебанием одного месяца; и начнут ли производители шарнирных модулей для гуманоидов запрашивать у поставщиков деталей данные ресурсных испытаний, а не только размерный протокол.
          </p>
          <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите следующий чертёж
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы рассчитаем в течение 2 часов в рабочий день и прямо скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
