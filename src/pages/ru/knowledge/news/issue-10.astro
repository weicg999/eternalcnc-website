---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge/' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '10',
  date: '20 ноября 2026',
  blurb: 'Пять вещей, которые мы заметили в цеху, — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: '26,0%', label: 'Рост выпуска промышленных роботов в Китае в октябре 2026 года к тому же месяцу прошлого года. За тот же месяц выпуск оборудования для 3D-печати вырос на 85,9%, литий-ионных батарей — на 30,0%. Если растянуть горизонт, картина расходится: за январь — октябрь промышленные роботы прибавили 32,3%, оборудование для 3D-печати — 64,6%. Один месячный показатель идёт ниже накопленного темпа, другой — выше.', source: 'Государственное статистическое управление КНР, данные о социально-экономическом развитии за октябрь 2026 года, 16 ноября 2026 года.' },
  { metric: '2 000 шт. в сутки', label: 'Максимальная суточная производительность кулачка — ключевой детали волнового редуктора — на заводе Zhejiang Zhengqiang. Допуск на эту деталь держат в пределах нескольких микрон, иначе сустав робота начинает дрожать. Направление робототехнических деталей пока на стадии валидации у заказчика и мелкосерийных поставок; заказы размещают скользящими месячными партиями с динамической корректировкой объёма.', source: 'China Securities Journal, «Прорыв в цепочке поставок, мощности на десятки тысяч машин: индустрия воплощённого интеллекта подходит к переломному моменту», 19 ноября 2026 года (корреспонденты Чжэн Цуйин, Ван Цзинхань).' },
  { metric: '+48%', label: 'Выручка направления специального промышленного кондиционирования компании Binglun Environment за первые три квартала 2026 года: 2,73 млрд юаней, +48% год к году — единственный из трёх сегментов с приростом около пятидесяти процентов. Промышленный холод дал 2,88 млрд (+11%), управление тепловой энергией — 400 млн (+5%); итого выручка 6,01 млрд юаней, чистая прибыль 619 млн. По данным компании, выручка дочерней Dunham-Bush, связанная с дата-центрами, в одном только третьем квартале была близка к сумме за всё первое полугодие.', source: 'Binglun Environment (000811), протокол встречи с инвесторами, 19 ноября 2026 года.' },
];

const stories = [
  {
    tag: 'Макроэкономика / Выпуск',
    date: '2026-11-16',
    title: 'В октябре выпуск роботов +26,0%, оборудования для 3D-печати +85,9%: один показатель тормозит, другой разгоняется',
    summary: '16 ноября Государственное статистическое управление КНР на пресс-конференции Госсовета обнародовало данные за октябрь. Промышленное производство крупных предприятий выросло на 4,8% год к году и на 0,21% к сентябрю; обрабатывающая промышленность +5,4%, производство оборудования +10,6%, высокотехнологичные отрасли +17,6% — на 5,8 и 12,8 процентного пункта выше среднего по промышленности. По видам продукции: оборудование для 3D-печати +85,9%, литий-ионные батареи +30,0%, промышленные роботы +26,0%. За январь — октябрь промышленное производство +5,3%, производство оборудования +10,2%, а его доля в промышленности выросла до 37,9% (+1,8 п.п. год к году); накопленный рост по 3D-печати 64,6%, по промышленным роботам 32,3%. Индекс PMI обрабатывающей промышленности в октябре — 49,3%. На той же пресс-конференции сообщили, что прибыль крупных промышленных предприятий за январь — сентябрь составила 6 033,7 млрд юаней, +15,5%.',
    what_it_means: 'Смысл появляется, только если смотреть на обе цифры вместе. Роботы с 26,0% за месяц идут ниже накопленных 32,3%, то есть высокая скорость этого цикла не растёт, а сдаёт — запросы приходить не перестанут, но заказчик уже не гонится за мощностями, а выбирает поставщика, и фраза «у нас всё загружено» в письме больше ничего не решает. Оборудование для печати идёт в другую сторону: 85,9% за месяц более чем на двадцать пунктов выше накопленных 64,6%, значит сервисы печати закупают станки партиями. Не читайте это как «ЧПУ-образцы уходят»: это выпуск машин, а не деталей. Но для пластиковых деталей, сложных внутренних каналов и решётчатых облегчённых конструкций аддитивные технологии действительно выигрывают, и это факт материалов и геометрии, а не рыночное мнение. Полезный шаг — пройти по списку образцов, отдать те категории, где печать дешевле, и собрать силы на прецизионных деталях из алюминия, нержавейки и титана: именно там пятиосевая и токарно-фрезерная обработка дают отрыв.',
    source: 'Государственное статистическое управление КНР, данные за октябрь 2026 года, 16 ноября 2026 года; China News Service, материал того же дня (корреспондент Ван Эньбо).',
  },
  {
    tag: 'Робототехника / Цепочка поставок',
    date: '2026-11-19',
    title: 'Допуск на кулачок в несколько микрон, 2 000 штук в сутки: серийность воплощённого интеллекта упирается в трансмиссию',
    summary: '19 ноября China Securities Journal рассказала про кулачок — ключевую деталь волнового редуктора, полый перфорированный металлический диск. Эллиптический кулачок запрессовывают во внутреннее кольцо тонкостенного подшипника, получая генератор волн; генератор входит в гибкое колесо и вращается внутри жёсткого, а разница чисел зубьев даёт передаточное отношение, недостижимое для обычной зубчатой пары. Технический руководитель завода говорит, что допуск на каждый кулачок держат в несколько микрон — иначе между деталями остаётся зазор, и сустав начинает дрожать. Сейчас Zhejiang Zhengqiang выдаёт до 2 000 таких деталей в сутки; направление робототехнических деталей находится на стадии валидации и мелкосерийных поставок, заказы идут скользящими месячными партиями с динамической корректировкой, объём медленно растёт. Со стороны поставщиков: Центр инноваций человекоподобных роботов провинции Чжэцзян сообщает, что только в Нинбо число площадок, с которыми он работает в этом году, выросло втрое к прошлому году, а квалифицированных поставщиков уже несколько десятков. По отрасли в целом выпуск «ловких рук» (схватов) в прошлом году составил около 20 000 штук, в этом ожидается 60 000—70 000. Со стороны сборщиков: завод UBTech в Лючжоу на десять тысяч машин запущен в сентябре, база EngineAI в Шэньчжэне открыта в мае с заявленной способностью отгружать десятки тысяч штук, AgiBot в сентябре объявил о 20 000 выпущенных машин суммарно. Unitree направит 624 млн юаней из размещения на производственную базу, рассчитанную на 75 000 человекоподобных и 115 000 четырёхногих роботов в год. По неполным данным GGII, 101 публичная компания робототехнической цепочки за январь — сентябрь собрала 353,1 млрд юаней выручки, 77 из них прибыльны.',
    what_it_means: 'Формулировка «скользящие месячные партии с динамической корректировкой» важнее любой цифры по мощностям. Она означает, что планировать производство на год нельзя, закупать материал на год тоже нельзя — надо держать запас по загрузке понедельно и принимать, что в следующем месяце объём могут урезать вдвое. Кулачок — деталь с тонкой маржой и небольшим объёмом, и упирается она в допуск и в стабильность от партии к партии: три годных образца и 980 годных из тысячи — совершенно разные расчёты. Прежде чем брать такой заказ, сделайте одну вещь: разделите долю брака на период наладки и на стабильный период, серийную цену считайте по стабильному выходу годных, а цену образца — по затратам наладки. Если смешать, первая же поставка уйдёт в минус. Что до 2 000 штук в сутки, при 300 рабочих днях это около 600 000 в год — и этот потолок объясняет, почему сборщикам не хватает не заказов, а поставщиков со стабильной отгрузкой: чтобы выйти на сто тысяч машин, им понадобится второй и третий источник.',
    source: 'China Securities Journal, «Прорыв в цепочке поставок, мощности на десятки тысяч машин: индустрия воплощённого интеллекта подходит к переломному моменту», 19 ноября 2026 года (корреспонденты Чжэн Цуйин, Ван Цзинхань).',
  },
  {
    tag: 'Станкостроение / Структура заказов',
    date: '2026-11-17',
    title: 'В портфеле станкозаводов новые имена: холодные плиты, корпуса суставов, титановые конструкции',
    summary: '17 ноября China Industry News разобрала данные Китайской ассоциации станкостроения и инструментальной промышленности за первые три квартала: выручка отрасли 822,3 млрд юаней (+7,5%), прибыль 29,7 млрд (+20,5%), но средняя норма прибыли всего 3,6% — на 2,1 процентного пункта ниже, чем в среднем по крупной промышленности страны. По заказам: новые заказы на металлообрабатывающие станки +16,8%, портфель +18,3%, оба показателя расширились к первому полугодию; внутри этого металлорежущие станки дали +24,9% новых заказов и +19,5% портфеля при выпуске 667 000 штук (+10,1%). Ассоциация относит спрос к трём новым группам покупателей: инфраструктура ИИ-вычислений — холодные плиты и быстроразъёмные соединения, под них идут высокоскоростные сверлильно-резьбонарезные и вертикальные обрабатывающие центры; человекоподобные роботы — корпуса суставов и детали редукторов, под них идут пятиосевые станки и резьбошлифовальные; низковысотная экономика — титановые и композитные конструкции. По компаниям: у Zhejiang Headman заказы из робототехники выросли на 219% (данные первого полугодия компании). Генеральный секретарь ассоциации Мао Юйфэн формулирует так: отрасль переходит от расширения масштабов к созданию стоимости, и нынешний перегрев заказов — это окно для такого перехода.',
    what_it_means: 'Эти станки продают не тем, кто работает на станках, а тем, кто делает холодные плиты и корпуса суставов, — то есть нашим коллегам или тем, кто ими станет. Партия сверлильно-резьбонарезных центров, пришедшая разом, означает, что через год ту же операцию, что вы держите сегодня, смогут делать ещё десяток цехов, причём на новых станках с амортизацией с нуля: они поставят цену ниже вашей себестоимости, и вы их расчёт не переиграете. Поэтому не ставьте всё на «мы это умеем» — такое преимущество стирается за три года. Ставьте на то, что не стирается: на сложное (тонкие стенки, глубокие полости, много плоскостей за одну установку), на доказуемое (Cpk, номер плавки, протокол первого изделия) и на то, что уходит в срок. Норма прибыли 3,6% предупреждает ещё об одном: даже те, кто продаёт станки, живут на тонкой марже, — значит путь «взять объёмом и ценой» отрасль уже прошла за нас.',
    source: 'China Industry News, «Горячие заказы и холодная прибыль: чем станкостроению выходить из тупика», 17 ноября 2026 года.',
  },
  {
    tag: 'ИИ / Производство (главная тема ИИ в этом выпуске)',
    date: '2026-11-19',
    title: 'Две конференции в один день говорят об одном: ИИ сначала съедает работу за столом',
    summary: '19 ноября в Нанкине открылась Всемирная конференция по интеллектуальному производству 2026, где одновременно объявили ежегодные десятки главных достижений в области интеллектуального производства — мировые и китайские. Среди пяти выделенных направлений отдельно названы «облегчённые и недорогие решения для малых и средних предприятий». В числе показательных результатов — промышленный ИИ-агент Siemens Eigen, который по описанию на естественном языке генерирует код автоматизации и отлаживает его, повышая эффективность выполнения в пилотных сценариях в 2—5 раз; и интеграция данных и моделей у XCMG Excavator на всём жизненном цикле изделия и в цепочке поставок, распространённая на 25 предприятий группы и более 500 поставщиков. Тридцать четыре «маяковые» умные фабрики второй волны объявили о совместной программе развития. В тот же день в Ухане открылась конференция China 5G+Industrial Internet 2026: платформа China Mobile Tiangong 2.0 собирает промышленных ИИ-агентов и тиражирует решения для девяти отраслей, включая металлургию, добычу и автопром; China Unicom связывает сбор данных и приложения через Gewu и Wanwu; платформа Xirang у China Telecom доводит общий объём интеллектуальных вычислений до 118 EFLOPS. Ухань отчитался о 11 центрах интеллектуальных вычислений, пяти кластерах по тысяче ускорителей и 9 582P высокопроизводительных мощностей при поддержке ваучеров на вычисления на 100 млн юаней. При этом участники прямо говорят: промышленные агенты прошли пилоты, но до масштаба не дошли.',
    what_it_means: 'Переведите обе конференции на язык цеха. ИИ первым забирает работу за столом — написать программу, подобрать режимы, составить техпроцесс, оформить отчёт, — а не работу руками: установить, выставить, следить за резанием, снять пробный проход. «Код из естественного языка, в два-пять раз быстрее» у Siemens в этой отрасли означает сжатие программирования и технологической подготовки. Отсюда два следствия. Первое: «КП за два часа» перестаёт быть преимуществом и становится входным билетом, потому что у конкурента предложение тоже будет генерироваться само. Второе: сравнивать будут не только цену, но и то, приложите ли вы к предложению работающий техпроцесс — какое приспособление, сколько операций, какие размеры несут риск, как проверяется первое изделие. Вот этого ИИ за вас не сделает, потому что здесь важны ваши реальные станки, ваш инструмент и ваши люди. Начинайте копить три вещи уже сейчас: библиотеку режимов по своим материалам, привычки заказчика по допускам и протоколы первого изделия по каждой партии. Это сырьё для любого инструмента и та часть, которую не скопировать.',
    source: 'People\'s Daily Online, Цзянсу, «В Нанкине открылась Всемирная конференция по интеллектуальному производству 2026», 19 ноября 2026 года (корреспондент Ду Циньмэн); China Industry and Information Technology News, «5G + промышленный интернет + ИИ: выставка достижений конференции 2026 года открылась в Ухане», 19 ноября 2026 года.',
  },
  {
    tag: 'Жидкостное охлаждение / Мощности',
    date: '2026-11-19',
    title: 'У Dunham-Bush выручка от дата-центров за один квартал почти равна всему первому полугодию: узкое место жидкостного охлаждения — оборудование, а не проект',
    summary: 'Протокол встречи с инвесторами Binglun Environment от 19 ноября: за первые три квартала 2026 года промышленный холод дал 2,88 млрд юаней (+11%), специальное промышленное кондиционирование — 2,73 млрд (+48%), управление тепловой энергией — 400 млн (+5%); итого 6,01 млрд юаней выручки и 619 млн чистой прибыли. Компания прямо указывает, что признание выручки по дата-центрам продолжает расти и стало главным драйвером, а у дочерней Dunham-Bush выручка, связанная с дата-центрами, в одном третьем квартале была близка к сумме за всё первое полугодие. По мощностям запущена схема «Яньтай в Китае + Малайзия + Северная Америка»: в Северной Америке работают на арендованных площадях, запуск производства запланирован на начало 2027 года; первая очередь нового завода в Малайзии — к концу 2027 года. Компания добавляет, что строительство IDC в Северной Америке отстаёт от капитальных планов облачных провайдеров, её продукция стоит в поздней стадии строительства IDC, а определённость заказов высокая.',
    what_it_means: '«Один квартал почти равен целому полугодию» — самый жёсткий сигнал недели: спрос растёт не линейно, он ступенчато прыгает внутри квартала. Но в том же протоколе мощности под этот спрос появляются только к 2027 году. Вместе это означает: проекты жидкостного охлаждения сейчас упираются в то, когда придёт оборудование, а не в то, как спроектировать контур. Заказчик, которому надо успеть к пуску, купит только у того, кто отгружает сразу, и на какое-то время срок поставки перевесит цену за штуку. Взять в этом отрезке можно нестандарт второго контура: кронштейны, фланцы трубопроводов, посадочные места под быстроразъёмные соединения, листовые каркасы шкафов, имитаторы нагрузки для испытаний, оснастку линии. Мелкие партии, частые изменения, короткие сроки — ровно тот диапазон, где работает быстрый мелкосерийный участок. А вот чиллеры первого контура и готовые CDU — не наша история, и взяться за них мы всё равно не сможем.',
    source: 'Binglun Environment (000811), протокол встречи с инвесторами, 19 ноября 2026 года; Sina Finance, материал того же дня.',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Раз в неделю. Мы не гонимся за новостным потоком — это список для чтения, и в него попадает только то, что меняет действия заказчика в этом квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только из первых источников: национальная статистика, таможня, отраслевые ассоциации, органы стандартизации, отчётность компаний и подписанные материалы прессы. Мнения брокеров мы не пересказываем как факты.' },
  { q: 'Почему взгляд из цеха, а не рыночный отчёт?', a: 'Рыночный отчёт говорит, куда дует ветер. Взгляд из цеха говорит, дошла ли работа до пола. В каждом сюжете есть строка «что это значит для ваших деталей» — за неё отвечаем мы.' },
];

const related = [
  { label: 'Формулировка в запросе цены изменилась: «ловкие руки» переходят от «пришлите одну на пробу» к «считайте за деталь»', href: '/ru/knowledge/tech-blog/dexterous-hand-rfq-signal/' },
  { label: 'От 10 до 1 000: что на самом деле меняется, когда деталь робота идёт в серию', href: '/ru/knowledge/tech-blog/robot-parts-prototype-to-production/' },
  { label: 'Охлаждение — общий предел для вычислений и роботов: почему жидкостное охлаждение стало обязательным, а не опциональным', href: '/ru/knowledge/tech-blog/liquid-cooling-compute-and-robots/' },
  { label: 'Почему срываются сроки поставки', href: '/ru/knowledge/tech-blog/why-lead-times-slip/' },
];

---

<PageLayout
  title="Новости отрасли CNC-производства · Выпуск 10 | Eternal CNC"
  description="Конец ноября 2026 года: выпуск промышленных роботов +26,0% за месяц против 32,3% накопленных при 85,9% по оборудованию для 3D-печати; кулачки по 2 000 штук в сутки на скользящих месячных заказах; выручка станкостроения 822,3 млрд юаней при норме прибыли 3,6%; две конференции по ИИ в один день; специальное кондиционирование Binglun +48%."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Что на этот раз заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Опубликовано {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, которые стоит запомнить</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять новостей</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что произошло и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, потом главная строка: что меняется для заказчика, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три вопроса, которые нам задают</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">По теме в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">27 ноября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
Сюжеты, за которыми мы следим: ноябрьская статистика по выпуску промышленных роботов и металлорежущих станков; начнут ли поставщики деталей трансмиссии реально наращивать мощности в декабре после года скользящих месячных заказов; оживёт ли поток запросов на нестандарт второго контура жидкостного охлаждения до запуска линий 2027 года; и дойдут ли инструменты вроде Siemens Eigen до реальной работы в небольших цехах, а не останутся в пилотах.
          </p>
          <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите следующий чертёж
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы рассчитаем в течение 2 часов в рабочий день и прямо скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
