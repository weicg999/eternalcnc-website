  { label: 'База знаний', href: '/ru/knowledge/' },
  { label: 'Новости отрасли' },
];

const issue = {
  label: 'Выпуск',
  number: '07',
  date: '30 октября 2026',
  blurb: 'Пять вещей, которые заметил цех, — и что они значат для деталей, которые вы нам присылаете.',
};

const kpis = [
  { metric: '+1,9%', label: 'Годовой рост прибыли в производстве машин и оборудования общего назначения за январь–сентябрь 2026 года. За тот же период производство компьютеров, электронных и оптических изделий дало +103,8%, цветная металлургия — +79,7%, химические сырьё и материалы — +49,2%. При этом производство машин и оборудования специального назначения вышло в минус 1,3%, производство электрического оборудования — в минус 5,9%, производство автомобилей — в минус 22,8%. По промышленности в целом прибыль выросла на 15,5%.', source: 'Государственное статистическое управление КНР, «Прибыль промышленных предприятий выше установленного размера за январь–сентябрь 2026 года выросла на 15,5%» с приложенными таблицами, 27 октября 2026 года, 09:30.' },
  { metric: '1,64%', label: 'CCTV 26 октября со ссылкой на данные исследовательской организации сообщил: из опрошенных этой организацией заказчиков только 1,64% предприятий реально ввели роботов в производственную эксплуатацию, подавляющее большинство остаётся на стадии проверки концепции. Название организации в репортаже не приводится.', source: 'CCTV.com, «От плотного развёртывания к глобальным поставкам: гуманоидные роботы держат экзамен на серийность», 26 октября 2026 года.' },
  { metric: '87 млн тайваньских долларов', label: 'Чистая прибыль, приходящаяся на акционеров, которую завод металлической штамповки Bichuan (1569, Тайвань, Китай) самостоятельно отчитал за сентябрь, — против убытка 46 млн тайваньских долларов годом ранее. Во втором квартале этого года та же компания получила убыток 135 млн, или 0,94 тайваньского доллара на акцию. Разворот дали заказы на быстросъёмные соединения для жидкостного охлаждения, переданные ей в производство.', source: 'Центральное информационное агентство, 29 октября 2026 года, по объявлению Bichuan о самостоятельном расчёте результатов за сентябрь.' },
];

const stories = [
  {
    tag: 'Макро / Расхождение по прибыли',
    date: '2026-10-27',
    title: 'Прибыль промышленности выросла на 15,5%, а у заказчиков, которые берут у вас станины и рамы, — только на 1,9%',
    summary: 'Государственное статистическое управление 27 октября опубликовало данные: за январь–сентябрь прибыль промышленных предприятий выше установленного размера составила 6 033,7 млрд юаней, +15,5% год к году; за один сентябрь — +14,4%. Три крупных сектора разошлись сильно: добыча — +38,2%, обрабатывающая промышленность — +17,0%, производство и распределение электроэнергии, тепла, газа и воды — минус 14,3%. Внутри обрабатывающей промышленности разрыв ещё шире: компьютеры, электронные и оптические изделия — +103,8%, цветная металлургия — +79,7%, химические сырьё и материалы — +49,2%; а производство машин и оборудования общего назначения — всего +1,9%, специального назначения — минус 1,3%, электрического оборудования — минус 5,9%, автомобилей — минус 22,8%. Важнее другая группа цифр: на конец сентября дебиторская задолженность составила 29,77 трлн юаней, +10,0%, а запасы готовой продукции — 7,37 трлн, +11,6%. Оба показателя растут быстрее выручки, которая прибавила 6,6%.',
    what_it_means: 'Производство машин общего назначения, специального назначения, электрического оборудования — это ровно те заказчики, которые присылают нам рамы, приспособления и узлы автоматизации. Их прибыль лежит в коридоре от +1,9% до минус 5,9%, а значит, сбивание цены для них — действие на выживание, а не переговорная поза; не стоит воспринимать это как настроение, которое пройдёт. А дебиторка, растущая на 3,4 процентных пункта быстрее выручки, вместе с запасами +11,6% говорит о том, что деньги возвращаются медленнее, а готовой продукции на складе больше, — и то и другое в итоге выходит на условия платежа. Поэтому в этом выпуске скажем прямо: условия оплаты обсуждаются до приёма заказа, а не после того, как детали сделаны. Постоянным заказчикам можно идти навстречу. Новым — и тем, кто явно сжигает деньги на расширение, — процент предоплаты и график платежей надо вписать в договор. Другой конец стола живёт по другим часам: цепочка электроники с +103,8% не испытывает недостатка в деньгах, она испытывает недостаток в поставщиках, которые успевают за её итерациями. На таких заказах можно торговаться не ценой, а приоритетом в плане, согласованным форматом данных контроля и протоколом первой детали в каждой отгрузке.',
    source: 'Государственное статистическое управление КНР, 27 октября 2026 года; разъяснение — Юй Вэйнин, главный статистик управления промышленной статистики.',
  },
  {
    tag: 'Робототехника / Серийность',
    date: '2026-10-26',
    title: '1,64% — узкое место гуманоидов не в мощностях, а в том, работают ли они у кого-то на самом деле',
    summary: 'CCTV 26 октября сообщил: один гуманоидный робот состоит из сотен и тысяч деталей, а традиционная сборка сильно зависит от ручной подгонки — низкая производительность, плохая повторяемость, масштабировать трудно. Руководитель службы поставок одной из компаний-производителей готовых машин рассказал, что потенциальные заказы появились уже с первым прототипом, и давление целиком в отгрузке; собственный участок они просчитали и пришли к выводу, что затраты на людей и линию для компании, только начинающей серию, неподъёмны, поэтому сосредоточились на том, что умеют. Другая компания, чей первый завод уже способен выпускать 1 000 роботов в год, сказала ещё прямее: общую сборку машины они делают сами, но по таким прецизионным узлам, как «умная кисть», «опыта производства не так много» — в 2025 году они объехали много контрактных заводов по всей стране. В репортаже приведены данные исследовательской организации: реально до эксплуатации дошли лишь 1,64% опрошенных заказчиков, остальные на стадии проверки концепции (организация не названа). Тань Вэйцзя, генеральный секретарь Шэньчжэньской ассоциации робототехники, считает: поскольку аппаратная и программная части гуманоида жёстко связаны и постоянно итерируются, производство обречено быть относительно гибким процессом. В том же материале упоминается, что центр подбора и выбора компонентов для разработки роботов при «Гавани воплощённого интеллекта» в районе Баоань (Шэньчжэнь) официально открылся в 2026 году: предприятие может в одном месте подобрать все детали и свести спрос с предложением.',
    what_it_means: 'Этот сюжет ближе всех — «Гавань воплощённого интеллекта» из репортажа находится в Баоани, и наш цех тоже в Баоани. Но всерьёз стоит принять две фразы: производителям готовых машин не хватает не сборки, а производственного опыта по прецизионным узлам вроде «умной кисти»; и доля реально запущенных в эксплуатацию — 1,64%. В переводе на язык цеха: почти всё, что сейчас попадает к нам по робототехнике, — не серийные детали, а N-я версия образца: чертёж меняется, партия — несколько десятков штук, за месяц приходит три круга. Считать такое поштучно — гарантированный убыток; считать по числу переделок плюс схеме закрепления — единственная рабочая база. Другая сторона — форма возможности: производители ищут контрактное производство, и ищут не самого дешёвого, а того, кто вытянет прецизионные детали малыми партиями. Значит, готовить надо не мощности, а три вещи: схему закрепления и контроля для деталей кисти и шарниров (микроны, тонкие стенки, сложная геометрия), многоразовую техкарту для мелкой серии и честный ответ на вопрос «сколько дней на одну переделку». Когда эти три вещи есть, в тот день, когда 1,64% пойдёт к 10%, заказы придут сами.',
    source: 'CCTV.com, 26 октября 2026 года.',
  },
  {
    tag: 'ИИ / Цех (главная линия выпуска по ИИ)',
    date: '2026-10-25',
    title: 'ИИ уже в трети крупных заводов Китая — следующий шаг: он будет читать вашу смету',
    summary: 'Economic Daily 25 октября в колонке «Новые наблюдения за китайской промышленностью» привёл четыре цифры: охват приоритетных сценариев применения ИИ в обрабатывающей промышленности выше установленного размера превысил треть; по 20 приоритетным отраслям создано более 500 качественных наборов данных и внедрено более 100 промышленных ИИ-агентов; охват цифровой модернизацией промышленных предприятий выше установленного размера достиг 92%, доля цифрового производственного оборудования — 63%; за первые три квартала выпуск цифровой продукции обрабатывающей промышленности дал более трети прироста промышленного производства. Главный тезис статьи: в производстве ИИ перешёл от отдельных демонстраций к масштабному внедрению с измеримой отдачей, а его предпосылка — подключённое оборудование, оцифрованные линии и собираемые данные. Без базы в 92% треть охвата не появилась бы так быстро.',
    what_it_means: '92% и 63% говорят о том, что интерфейс на стороне заказчика уже подключён. Дальше происходит вполне конкретное: запросы, выдача чертежей, входной контроль и оценка поставщиков переходят к системам и агентам. Системе неважно, насколько вежливо написано письмо; она читает поля — марка материала, состояние поставки (T6, закалка с искусственным старением), критические допуски, базы, вид обработки поверхности, метод контроля, идентификация партии, упаковка. Ответите «обработаем по чертежу, цена во вложении» — человек поймёт, система не разберёт и отправит вас в резервный список. Поэтому для небольшого завода выгоднее не покупать софт, а превратить смету в половину техкарты: заполнить эти поля структурно и добавить одну строку — критические размеры по необходимости проходят финальный контроль на КИМ в общей метрологической службе группы, протокол идёт с отгрузкой. Это не стоит ничего, но определяет, числитесь вы у заказчика как работающий поставщик или как строчка в списке для обзвона. Есть и более далёкий слой: первые сто с лишним промышленных агентов внедряются в обслуживание оборудования, планирование и контроль качества, и всем трём нужны производственные данные от поставщика. Умение отдать запись процесса рано или поздно станет условием допуска к тендеру, а не преимуществом.',
    source: 'Economic Daily, колонка «Новые наблюдения за китайской промышленностью», 25 октября 2026 года.',
  },
  {
    tag: 'Станкостроение / Расходники',
    date: '2026-10-29',
    title: 'Инструментальный завод загружен до декабря, сверлильные станки для PCB — до второго квартала 2027-го: на этот раз узко не с мощностями, а с загрузкой шпинделей',
    summary: 'CCTV 29 октября сообщил: за первое полугодие 2026 года выручка станкоинструментальной отрасли Китая составила 530,9 млрд юаней, +7,6%, прибыль — 19,6 млрд, +110,8%. В том числе по подотрасли режущего инструмента выручка 65,5 млрд юаней, +26,4%, прибыль 8,8 млрд, +127,9%. Завод твердосплавного инструмента в Даньяне (провинция Цзянсу) выпускает 250 000 единиц в месяц, загрузка близка к 100%, заказы приняты до декабря, продажи выросли более чем вдвое год к году. Станкозавод в Сучжоу имеет заказы на шестиосевые сверлильные станки для печатных плат до второго квартала 2027 года, а выпуск продвинутой серии уже более чем вдвое превышает весь прошлый год. Предприятие в Чанчжоу поставило в этом году 300 двухшпиндельных горизонтальных обрабатывающих центров для лотков тяговых батарей тяжёлых электрогрузовиков — два шпинделя работают одновременно, производительность вдвое выше. В репортаже упомянут и прецизионный станок для ИИ-серверов с собственной системой технического зрения завода: она компенсирует положение каждого отверстия на плате, а соосность при обратном зенковании удерживается в пределах 75 микрон.',
    what_it_means: 'Три сигнала, каждый про своё. Первый: инструментальные заводы загружены и приняли заказы до декабря — значит, загрузка станков у потребителей высокая, за одни и те же работы конкурирует больше мощностей, а терпимость к цене сужается; в такой момент называть низкую цену — худшее из возможного. Второй: сроки поставки твердосплавного инструмента растягиваются, цены идут вверх, и это прямо входит в нашу себестоимость. Ждать, пока подорожание случится, нельзя — стоимость инструмента в смете надо обновлять раз в квартал, а не раз в год. Третий: сверлильные станки для PCB расписаны до второго квартала 2027 года, то есть производители плат под ИИ-серверы расширяются, — а станины, стойки, столы и приспособления этих станков это литьё или сварные конструкции плюс прецизионная механообработка, ровно та работа, которую мы можем взять. Совет заказчику такой же прямой: если проект сидит на цепочке ИИ-оборудования, не сжимайте срок до предела — оборудование расписано до середины следующего года, и комплектующие поедут в том же графике.',
    source: 'CCTV.com / CCTV Finance, 29 октября 2026 года; отраслевые данные — Китайская ассоциация станкостроительной и инструментальной промышленности, статистика за первое полугодие 2026 года.',
  },
  {
    tag: 'Жидкостное охлаждение / Мощности',
    date: '2026-10-29',
    title: 'Завод металлической штамповки, делавший ножничные петли для клавиатур ноутбуков, взял быстросъёмы для жидкостного охлаждения — и за квартал прошёл путь от убытка 135 млн до прибыли 87 млн за месяц',
    summary: 'Центральное информационное агентство 29 октября сообщило: завод металлической штамповки Bichuan (1569, Тайвань, Китай) вместе с производителем систем охлаждения Auras (3324) вошёл в цепочку поставок компонентов жидкостного охлаждения для платформы Nvidia Vera Rubin. Bichuan отчитался о чистой прибыли за сентябрь 87 млн тайваньских долларов против убытка 46 млн годом ранее, 0,60 тайваньского доллара на акцию; во втором квартале этого года компания получила убыток 135 млн, то есть 0,94 тайваньского доллара на акцию. В начале года Auras объявила, что вложила 254 млн тайваньских долларов в частное размещение Bichuan на 5 930 лотов, доведя пакет до 9 930 лотов — 6,88% выпущенных акций, — и передала Bichuan часть производства быстросъёмных соединений, чтобы улучшить структуру затрат и держать сроки и качество. Uanalyze 28 октября со ссылкой на отраслевые данные сообщил: тайский завод Bichuan начал выпускать детали водяного охлаждения в этом году, выручка за сентябрь подскочила до 401 млн тайваньских долларов — плюс 91,9% к августу и 39,1% год к году. В те же дни Johnson Controls на презентации результатов заявила, что портфель потенциальных проектов по CDU превышает 1 млрд долларов, что компания вложит 900 млн долларов в расширение мощностей по CDU по всему миру и что большая часть запланированных мощностей уже законтрактована.',
    what_it_means: 'Это не история про то, что «жидкостное охлаждение горячее». Это история про то, что барьер смещается с технологии на умение гибко подставлять мощности. Основной бизнес Bichuan — ножничные петли клавиатур ноутбуков, более 30% мирового рынка, и держится он на прецизионной штамповке и оснастке; эта компетенция перешла на коллекторы и корпуса быстросъёмов меньше чем за год. Отчётность развернулась за три месяца, и это говорит о простой вещи: в такое окно заказчик покупает не твою отраслевую родословную, а наличие готовой способности к точному формообразованию и возможность переналадить линию за квартал. Для небольшого завода с механообработкой, как наш, это означает два направления. Первое — работы действительно становится больше: коллекторы на лоток, корпуса быстросъёмов, структуры каналов холодных плит; допуски плотные, партии средние, переналадка частая — это ровно наш диапазон мелкосерийного быстрого прототипирования. Второе — не переоценивайте себя: у штамповки с оснасткой другая структура затрат, и мы можем взять сложные фрезерованные каналы и нестандартные интерфейсы, а не тонкостенные штампованные детали. Эту границу надо обозначать до сметы, а не объяснять после. Сказать прямо — заказ не потерять; не сказать — потерять.',
    source: 'Центральное информационное агентство, 29 октября 2026 года (самостоятельный расчёт результатов Bichuan за сентябрь и доля Auras в частном размещении); Uanalyze, 28 октября 2026 года (выручка тайского завода Bichuan).',
  },
];

const faqs = [
  { q: 'Как часто обновляется эта страница?', a: 'Раз в неделю. Мы не гоняемся за новостным потоком, а ведём список для чтения, и берём только то, что меняет действия заказчика в текущем квартале.' },
  { q: 'Откуда берутся цифры?', a: 'Только из первых источников: национальные статистические органы, таможня, отраслевые ассоциации, органы стандартизации, отчётность компаний и подписанные материалы прессы. Аналитические записки брокеров мы не пересказываем как факты.' },
  { q: 'Почему взгляд из цеха, а не рыночный отчёт?', a: 'Рыночный отчёт говорит, куда дует ветер. Взгляд из цеха говорит, дошла ли работа до пола. У каждого сюжета есть строка «что это значит для ваших деталей» — вот за неё отвечаем мы.' },
];

const related = [
  { label: 'От 10 до 1 000: что на самом деле меняется, когда деталь робота идёт в серию', href: '/ru/knowledge/tech-blog/robot-parts-prototype-to-production/' },
  { label: 'Охлаждение — общий предел для вычислений и роботов', href: '/ru/knowledge/tech-blog/liquid-cooling-compute-and-robots/' },
  { label: 'Одна и та же деталь — почему цены в двух предложениях так расходятся?', href: '/ru/knowledge/tech-blog/quote-difference-quality-cost/' },
  { label: 'Какой станок с ЧПУ на самом деле нужен вашей детали?', href: '/ru/knowledge/tech-blog/which-cnc-machine-for-your-part/' },
];
---

<PageLayout
  title="Новости отрасли CNC-производства · Выпуск 07 | Eternal CNC"
  description="Конец октября 2026: прибыль промышленности +15,5%, а общее машиностроение — всего +1,9%; реально запущено лишь 1,64% роботов; ИИ начинает читать сметы; инструмент расписан до декабря; завод штамповки развернулся на деталях охлаждения."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Новости отрасли — {issue.label} {issue.number}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Что на этот раз заметил цех
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} Подготовлено стратегической консультативной группой Eternal CNC. Опубликовано {issue.date}.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">Три цифры, которые стоит запомнить</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">Источник: {k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Пять новостей</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что произошло и что, по нашему мнению, это значит</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Сначала новость, потом главная строка: что меняется для заказчика, отправляющего детали в цех ЧПУ.
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что это значит для ваших деталей</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">Источник: {s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Как мы пишем эту страницу</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">Три вопроса, которые нам задают</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--brand-dark);">{f.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + subscribe -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Читать дальше</p>
          <h2 class="text-2xl font-bold mb-6" style="color: var(--brand-dark);">По теме в блоге</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-medium hover:underline" style="color: var(--brand-red);">{r.label} →</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Следующий выпуск</p>
          <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">9 ноября 2026</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
За чем мы следим: PMI за октябрь и то, расширится ли снова разрыв в прибыли между электроникой и общим машиностроением; что заказчики начнут добавлять в чертежи до вступления в силу первых стандартов на гуманоидов в апреле 2027 года; и начнут ли сроки поставки инструмента отражаться в ценах предложений.
          </p>
          <a href="/ru/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
            Пришлите следующий чертёж
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь на примете?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите STEP и PDF. Мы рассчитаем в течение 2 часов в рабочий день и прямо скажем, соответствуют ли ваши допуски тому, чем должны быть.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote/" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Читать техблог →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
