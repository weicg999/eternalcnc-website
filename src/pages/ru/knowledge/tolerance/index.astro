---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge' },
  { label: 'Допуски обработки' },
];

const capabilities = [
  {
    title: 'Линейные размерные допуски',
    items: ['Точный класс f: ±0.05мм (мелкие детали)', 'Средний класс m: ±0.1мм (стандарт)', 'Грубый класс c: ±0.2мм (несопрягаемые)', 'Очень грубый класс v: ±0.5мм (сварные узлы)'],
    tolerance: 'Стандарт по умолчанию: ISO 2768-m',
    materials: 'Более жёсткие допуски = выше стоимость обработки',
  },
  {
    title: 'Геометрические допуски (GD&T)',
    items: ['Плоскостность до 0.02мм на 100мм', 'Параллельность до 0.01мм на 100мм', 'Соосность до 0.02мм', 'Позиционный допуск до ±0.01мм'],
    tolerance: 'Контроль на КИМ доступен через общий метрологический центр группы по запросу',
    materials: 'GD&T требует соответствующих возможностей контроля',
  },
  {
    title: 'Шероховатость поверхности',
    items: ['Черновое фрезерование: Ra 3.2-6.3мкм', 'Чистовое фрезерование: Ra 1.6-3.2мкм', 'Шлифование: Ra 0.4-1.6мкм', 'Полировка: Ra 0.05-0.2мкм'],
    tolerance: 'Поставка по умолчанию: Ra 3.2мкм',
    materials: 'Более строгие требования к шероховатости = больше операций',
  },
  {
    title: 'Рекомендации по назначению допусков',
    items: ['Жёсткие допуски назначайте только на сопрягаемых поверхностях', 'Нефункциональные поверхности — по умолчанию неуказанным допускам', 'Для критичных характеристик используйте GD&T', 'Избегайте жёстких допусков на все размеры'],
    tolerance: 'Для сопрягаемых поверхностей достаточно ±0.02–±0.05мм',
    materials: 'Рациональное назначение допусков снижает затраты на 30%+',
  },
];

const standards = [
  { label: 'Накопление допусков', desc: 'Чем длиннее размерная цепь, тем больше накопленный допуск — учитывайте это при проектировании.' },
  { label: 'Сначала база', desc: 'Сначала задайте технологическую базу, затем назначайте размерные допуски.' },
  { label: 'Экономическая точность', desc: 'Выбирайте наиболее свободный допуск, удовлетворяющий функциональным требованиям, чтобы снизить стоимость.' },
  { label: 'Контролепригодность', desc: 'Назначенные допуски должны быть измеримы — иначе они бессмысленны.' },
];
---

<PageLayout
  title="Допуски ЧПУ обработки: ISO 2768, GD&T, шероховатость | EternalCNC"
  description="Руководство по допускам ЧПУ обработки: стандарт ISO 2768, допуски формы GD&T, шероховатость поверхности Ra и советы по назначению точности."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">База знаний</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Допуски и точность ЧПУ обработки
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Стандарты допусков ISO 2768, возможности GD&T и рекомендации по назначению допусков
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Получить расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Спросить инженера
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Система допусков</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Четыре аспекта допусков</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Получите полное представление о возможностях допусков ЧПУ обработки и корректно назначайте требования к точности.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Нормативный стандарт</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Совет по стоимости</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Принципы допусков</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Четыре принципа рационального назначения допусков</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Назначение допусков — это не «как можно жёстче», а «как можно уместнее».
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Не уверены, как назначить допуски?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Пришлите нам чертежи — наши инженеры дадут разумные рекомендации по допускам на основе функциональных требований.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Получить расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Спросить инженера
        </a>
      </div>
    </div>
  </section>
</PageLayout>
