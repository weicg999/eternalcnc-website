---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'База знаний', href: '/ru/knowledge' },
  { label: 'Примеры проектов' },
];

const capabilities = [
  {
    title: '5-осевое рабочее колесо',
    items: ['Сложная геометрия лопастей', 'Нержавеющая сталь 316L', 'Шероховатость поверхности Ra 0.8', 'Достигнут допуск ±0.025 мм'],
    tolerance: '5-осевая синхронная обработка',
    materials: 'Нержавеющая сталь 316L',
  },
  {
    title: 'Медицинский корпус из нержавеющей стали',
    items: ['Поверхность класса чистых помещений', 'Сложные внутренние каналы', 'Биосовместимый материал', 'Требуется полная прослеживаемость'],
    tolerance: '±0.01 мм',
    materials: 'Нержавеющая сталь 316L / Титан',
  },
  {
    title: 'Деталь шарнира робота',
    items: ['Отверстия с высокой соосностью', 'Обработка нескольких граней', 'Облегчённая алюминиевая конструкция', 'Анодированная поверхность'],
    tolerance: '±0.01 мм',
    materials: 'Алюминий 7075-T6',
  },
  {
    title: 'Алюминиевый радиатор',
    items: ['Рёбра с большим соотношением сторон', 'Плоскостность в пределах 0.05 мм', 'Оптимизирована теплопроводность', 'Анодирование Type II'],
    tolerance: '±0.05 мм',
    materials: 'Алюминий 6063-T5',
  },
];

const standards = [
  { label: 'Контроль геометрии', desc: 'Отчёт КИМ (координатно-измерительной машины) с полным анализом GD&T предоставляется по запросу из общего метрологического центра нашей группы для деталей из примеров проектов.' },
  { label: 'Подтверждение шероховатости', desc: 'Значения Ra, измеренные профилометром, проверяются по спецификациям заказчика.' },
  { label: 'Сертификация материала', desc: 'Сертификаты EN 10204 3.1 доступны по запросу; ведётся полная прослеживаемость химического состава.' },
  { label: 'Итоговая документация ОТК', desc: 'Полные отчёты о контроле, фотографии и записи об упаковке по каждой отгрузке.' },
];
---

<PageLayout
  title="Примеры проектов | Реальные детали ЧПУ | EternalCNC"
  description="Реальные проекты ЧПУ обработки — от чертежа до готовой детали. Как мы решаем сложные производственные задачи."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">База знаний</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Примеры проектов
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Реальные проекты ЧПУ обработки — от чертежа до готовой детали. Смотрите, как мы решаем
        сложные производственные задачи в разных отраслях.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Смотреть услуги →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Избранные проекты</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Реальные примеры обработки</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Каждый проект демонстрирует нашу способность поставлять прецизионные детали в разных материалах и уровнях сложности.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Процесс</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Материал</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Стандарты качества</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Обеспечение качества</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Каждая деталь из примера проекта проходит строгий контроль и документирование перед отгрузкой.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть похожий проект?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертежи — обратная связь от инженера в течение 2 ч.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/knowledge" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Все ресурсы →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
