---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'О компании', href: '/ru/about' },
  { label: 'Конфиденциальность' },
];

const protections = [
  {
    title: 'Технические чертежи',
    desc: 'Все 2D/3D CAD-файлы, PDF, STEP, IGES и любые другие форматы проектирования считаются строго конфиденциальными.',
  },
  {
    title: 'Спецификации материалов',
    desc: 'Марки сплавов, требования к допускам, параметры чистоты поверхности и фирменные составы никогда не передаются третьим лицам.',
  },
  {
    title: 'Объёмы и цены',
    desc: 'Объёмы заказов, цены за единицу, условия оплаты и все коммерческие детали остаются строго конфиденциальными.',
  },
  {
    title: 'Специальная оснастка',
    desc: 'Индивидуальные конструкции приспособлений, решения по оснастке и фирменные производственные процессы полностью защищены.',
  },
];

const measures = [
  {
    title: 'Зашифрованное хранилище',
    desc: 'Все файлы клиентов хранятся на зашифрованных серверах, доступных только авторизованным сотрудникам.',
  },
  {
    title: 'Контроль доступа',
    desc: 'Ролевой доступ гарантирует, что ваши файлы видит только ваша проектная группа, с полным аудитом действий.',
  },
  {
    title: 'Соглашение NDA',
    desc: 'Взаимные соглашения о неразглашении (NDA) можно подписать по запросу до получения любых файлов.',
  },
  {
    title: 'Обучение сотрудников',
    desc: 'Весь персонал проходит ежегодное обучение конфиденциальности. Нарушения влекут немедленное увольнение.',
  },
];
---

<PageLayout
  title="Политика конфиденциальности данных — Eternal CNC"
  description="Как Eternal CNC защищает ваши чертежи, спецификации и интеллектуальную собственность: строгая конфиденциальность, NDA и шифрованное хранилище."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Конфиденциальность</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Политика конфиденциальности данных
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Ваши разработки — ваше конкурентное преимущество, и защищать их — наша обязанность.
        Каждый чертёж, каждый размер и каждую спецификацию мы охраняем по высшим стандартам строгой защиты.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded-md transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Получить КП
        </a>
        <a href="/ru/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Наши услуги →
        </a>
      </div>
    </div>
  </section>

  <!-- What We Protect -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Сфера защиты</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что мы защищаем</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Всё, что вы нам передаёте, по умолчанию считается конфиденциальным — без исключений.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {protections.map((item) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-3" style="color: var(--brand-dark);">{item.title}</h3>
            <p style="color: var(--text-body);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Protect -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Меры безопасности</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Как мы защищаем</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Наши протоколы конфиденциальности встроены во все аспекты работы.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {measures.map((item) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{item.title}</h3>
            <p class="text-sm" style="color: var(--text-body);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Нужен надёжный партнёр по конфиденциальному производству?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертежи после подписания NDA. Наши инженеры дадут расчёт КП и DFM-замечания в течение 2 часов.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Бесплатный расчёт КП
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border rounded-lg border-white/30 text-white transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Бесплатный DFM-анализ →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
