---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Кейсы', href: '/ru/cases' },
  { label: 'Робототехника' },
];

const capabilities = [
  {
    title: 'Корпус модуля сочленения',
    items: ['5-осевая обработка из цельной заготовки', 'Соосность посадки подшипника ±0,003 мм', 'Конструкция облегчённых стенок', 'Твёрдое анодирование поверхности'],
    tolerance: '±0,005 мм',
    materials: 'Алюминий 7075-T6',
  },
  {
    title: 'Водило планетарного редуктора',
    items: ['Зубонарезание + финишная ЧПУ', 'Точность профиля зуба 5-й степени', 'Термообработка HRC 58–62', 'Партия 300 шт.'],
    tolerance: '±0,01 мм',
    materials: 'Сталь 20CrMnTi',
  },
  {
    title: 'Основание захватного устройства',
    items: ['Многостороннее фрезерование за одну установку', 'Схема монтажных отверстий ±0,005 мм', 'Облегчённая кармановая конструкция', 'Совместимость с быстросменным адаптером'],
    tolerance: '±0,005 мм',
    materials: 'Алюминий 6061-T6',
  },
  {
    title: 'Кронштейн энкодера',
    items: ['Прецизионное фрезерование ЧПУ', 'Плоскостность базовой поверхности 0,01 мм', 'Компактное исполнение', 'Пассивированное покрытие'],
    tolerance: '±0,01 мм',
    materials: 'Нержавеющая 303',
  },
];

const standards = [
  { label: 'Тест на повторяемость', desc: 'Детали проверены в нескольких партиях на повторяемость ±0,005 мм. Данные контроля доступны по критическим размерам.' },
  { label: 'Шероховатость поверхности', desc: 'Поверхности подшипников доведены до Ra 0,4–0,8. Сопрягаемые поверхности подобраны для оптимальной посадки и движения.' },
  { label: 'Отчёт по термообработке', desc: 'Термообработка шестерён и валов задокументирована с результатами испытаний на твёрдость. Полная прослеживаемость процесса.' },
  { label: 'Проверка стабильности', desc: 'Снятие остаточных напряжений перед финишной обработкой. Детали измеряются при контролируемой температуре для точности.' },
];
---

<PageLayout
  title="Кейсы деталей робототехники | сочленения, редукторы | Eternal CNC"
  description="Реальные кейсы ЧПУ обработки робототехники — корпуса модулей сочленений, водила редукторов, основания захватов, кронштейны энкодеров."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Кейсы</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Кейсы деталей робототехники
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Кейсы прецизионной обработки модулей сочленений, редукторов и управления движением.
        Подтверждённый опыт поставки высокоточных компонентов управления движением.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/cases" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Все кейсы →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Примеры проектов</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Избранные кейсы робототехники</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Отобранные проекты, демонстрирующие наши возможности обработки для робототехники.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Достигнутый допуск</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Материал</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Product Renders -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Галерея изделий</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Избранные визуализации изделий</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Типовые визуализации изделий — материал, процесс и детали поверхности.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/robotics/cnc-robotics-rotary-joint-aluminum-render-01.webp" alt="Поворотное сочленение 6-осевого робота из алюминия" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Поворотное сочленение робота</p>
            <p class="text-xs" style="color: var(--text-muted);">Алюминий · 5-осевое фрезерование · посадка подшипника H7</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/robotics/cnc-robotics-harmonic-reducer-steel-render-01.webp" alt="Корпус волнового редуктора из стали" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Корпус волнового редуктора</p>
            <p class="text-xs" style="color: var(--text-muted);">Сталь · токарно-фрезерная · точность зуба 6-го класса</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/robotics/cnc-robotics-arm-bracket-aluminum-render-01.webp" alt="Облегчённый кронштейн руки робота из алюминия" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Облегчённый кронштейн руки</p>
            <p class="text-xs" style="color: var(--text-muted);">Алюминий 6061 · фрезеровка + снятие напряжений · ±0,02 мм</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Контроль качества</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Стандарты качества робототехники</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Компоненты управления движением требуют самых жёстких допусков и шероховатости поверхности.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть похожий проект?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертёж — наши инженеры предоставят расчёт и DFM-анализ в течение 2 часов.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/cases" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Все кейсы →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
