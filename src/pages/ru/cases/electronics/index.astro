---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Кейсы', href: '/ru/cases' },
  { label: 'Электроника' },
];

const capabilities = [
  {
    title: 'ВЧ-корпус',
    items: ['Прецизионное фрезерование полости', 'Допуск паза ЭМС-уплотнения ±0,01 мм', 'Проводящее анодирование', 'Равномерная толщина стенки 2,0 мм'],
    tolerance: '±0,01 мм',
    materials: 'Алюминий 6061',
  },
  {
    title: 'Радиатор',
    items: ['Плотный массив рёбер', 'Плоскостность основания 0,05 мм', 'Оптимизированная теплопроводность', 'Партия 500+ шт.'],
    tolerance: '±0,025 мм',
    materials: 'Алюминий 6063',
  },
  {
    title: 'Корпус разъёма',
    items: ['Микро токарная + фрезерная ЧПУ', 'Совмещение контактов ±0,005 мм', 'Латунное основание с золочением', 'Полные данные контроля качества'],
    tolerance: '±0,005 мм',
    materials: 'Латунь C360',
  },
  {
    title: 'ЭМС-экран',
    items: ['Рамка экрана уровня платы', 'Точность апертур ±0,01 мм', 'Проверка контактного сопротивления', 'Автоматизированный контроль для серий'],
    tolerance: '±0,01 мм',
    materials: 'Бериллиевая бронза',
  },
];

const standards = [
  { label: 'Управление процессом', desc: 'Межоперационный контроль качества для крупносерийного производства. Cpk ≥ 1,33 по всем критическим размерам.' },
  { label: 'Тест на проводимость', desc: 'Проверка поверхностной проводимости для деталей ЭМС/ВЧ-экранирования. Контактное сопротивление измеряется по ТУ заказчика.' },
  { label: 'Толщина покрытия', desc: 'Толщина анодирования, никелирования и золочения проверяется рентгенофлуоресцентным методом. Доступны покрытия по военным стандартам.' },
  { label: 'Стабильность размеров', desc: 'Системы оптического контроля для крупносерийных партий. Доступны автоматизированная сортировка и упаковка.' },
];
---

<PageLayout
  title="Кейсы электронных деталей | ВЧ-корпуса, радиаторы | Eternal CNC"
  description="Реальные кейсы ЧПУ обработки электроники — ВЧ-корпуса, радиаторы, корпуса разъёмов, ЭМС-экраны. Миниатюрные высокоточные конструкции."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Кейсы</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Кейсы электронных деталей
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Кейсы прецизионной обработки миниатюрных конструкций и высокоточных корпусов.
        Подтверждённый опыт поставки электронных компонентов крупными партиями с жёсткими допусками.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/cases" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Все кейсы →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Примеры проектов</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Избранные кейсы электроники</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Отобранные проекты, демонстрирующие наши возможности обработки для электроники.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Достигнутый допуск</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Материал</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Product Renders -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Галерея изделий</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Избранные визуализации изделий</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Типовые визуализации изделий — материал, процесс и детали поверхности.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-rf-enclosure-7075-render-01.webp" alt="ВЧ-экранирующий корпус 5G из алюминия 7075" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">ВЧ-экранирующий корпус</p>
            <p class="text-xs" style="color: var(--text-muted);">Алюминий 7075 · прецизионное фрезерование · ±0,01 мм</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-heatsink-7075-render-01.webp" alt="Игольчатый радиатор из алюминия 7075" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Игольчатый радиатор</p>
            <p class="text-xs" style="color: var(--text-muted);">Алюминий 7075 · многопазовое фрезерование · анодирование</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-coaxial-connector-brass-render-01.webp" alt="Латунный коаксиальный ВЧ-разъём" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Коаксиальный разъём</p>
            <p class="text-xs" style="color: var(--text-muted);">Латунь · токарная + нарезание резьбы · золочёный контакт</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Контроль качества</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Стандарты качества электроники</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Крупносерийное производство электроники требует стабильности и качества поверхности.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть похожий проект?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертёж — наши инженеры предоставят расчёт и DFM-анализ в течение 2 часов.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/cases" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Все кейсы →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
