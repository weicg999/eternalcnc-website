---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Услуги', href: '/ru/services' },
  { label: 'Анализ DFM' },
];

const capabilities = [
  {
    title: 'Проверка конструкции',
    items: ['Анализ толщины стенок', 'Проверка радиуса внутренних углов', 'Отношение глубины отверстия к диаметру', 'Оценка возможности нарезания резьбы'],
    tolerance: 'Н/Д',
    materials: 'Все материалы для ЧПУ обработки',
  },
  {
    title: 'Оптимизация стоимости',
    items: ['Снижение отходов материала', 'Оптимизация числа установок', 'Рекомендации по ослаблению допусков', 'Альтернативы чистоты поверхности'],
    tolerance: 'Н/Д',
    materials: 'Модели стоимости для 20+ материалов',
  },
  {
    title: 'Производственная применимость',
    items: ['Анализ доступа инструмента', 'Рекомендации по оснастке', 'Планирование последовательности операций', 'Оценка срока изготовления'],
    tolerance: 'Н/Д',
    materials: 'Правила DFM для конкретных процессов',
  },
  {
    title: 'Быстрая обратная связь',
    items: ['Оборот в течение 2 часов', 'Аннотированные PDF-отчёты', 'Сравнение 3D-разметки', 'Прямая консультация с инженером'],
    tolerance: 'Н/Д',
    materials: 'Бесплатно для новых заказчиков',
  },
];

const standards = [
  { label: 'Экспертная проверка', desc: 'Каждый отчёт DFM проверяется ведущим инженером-технологом с опытом ЧПУ обработки более 10 лет.' },
  { label: 'Применимые выводы', desc: 'Отчёты содержат конкретные рекомендации с сравнением «до/после» и оценкой влияния на стоимость.' },
  { label: 'Конфиденциальность', desc: 'Все чертежи защищены соглашением о неразглашении (NDA). Файлы хранятся на зашифрованных серверах и удаляются через 90 дней.' },
  { label: 'Без обязательств', desc: 'Анализ DFM предоставляется бесплатно, без обязательств. Используйте нашу обратную связь или доработайте конструкцию со своей командой.' },
];
---

<PageLayout
  title="Анализ DFM — разбор чертежей ЧПУ | Eternal CNC"
  description="Загрузите чертежи и получите профессиональный анализ DFM (проектирование для производства) в течение 2 часов. Снизьте затраты, сократите срок и брак."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Услуги</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Анализ DFM
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Загрузите чертежи и получите профессиональный анализ технологичности в течение 2 часов — это поможет снизить затраты и сроки изготовления.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Связаться с инженером →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Что мы проверяем</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Категории услуг</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Наш анализ DFM охватывает четыре ключевых направления, чтобы ваша конструкция была оптимизирована для производства.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Точность</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Требует прецизионной доводки и контроля. С учётом проверки чертежа.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Распространённые материалы</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Почему мы</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Стандарты услуги</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Мы даём профессиональную, применимую обратную связь по DFM — а не шаблонные автоматические отчёты.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Готовы оптимизировать свою конструкцию?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите свои чертежи. Наши инженеры предоставят расчёт и обратную связь по DFM в течение 2 часов.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Бесплатный расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Связаться с инженером →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
