---
import PageLayout from '../../../layouts/PageLayout.astro';
import IndustryArticles from '../../../components/IndustryArticles.astro';

const breadcrumbs = [
  { label: 'Отрасли', href: '/ru/industries' },
  { label: 'Медицинское оборудование' },
];

const capabilities = [
  {
    title: 'Корпуса диагностического оборудования',
    items: ['Корпуса компонентов КТ-сканеров', 'Корпуса ультразвуковых датчиков', 'Корпуса гематологических анализаторов', 'Плиты крепления для рентгена'],
    tolerance: '±0.01mm',
    materials: 'Алюминий 6061, нержавеющая сталь 316L, ПОМ',
  },
  {
    title: 'Кронштейны хирургических инструментов',
    items: ['Приспособления выравнивания эндоскопов', 'Направляющие для хирургических свёрл', 'Держатели лапароскопических инструментов', 'Калибровочные кондукторы'],
    tolerance: '±0.005mm',
    materials: 'Нержавеющая сталь 316L, титан Ti-6Al-4V, PEEK',
  },
  {
    title: 'Хирургическая оснастка и кондукторы',
    items: ['Шаблоны хирургических направляющих', 'Плиты крепления для сборки', 'Бесконтактные зажимные кондукторы', 'Контрольные приспособления'],
    tolerance: '±0.01mm',
    materials: 'PEEK, ПОМ, алюминий 6061, нержавеющая сталь 316L',
  },
  {
    title: 'Кронштейны мониторов',
    items: ['Крепления мониторов пациента', 'Кронштейны штативов для капельниц', 'Опоры лотков оборудования', 'Настенные кронштейны-манипуляторы'],
    tolerance: '±0.025mm',
    materials: 'Алюминий 6061, ацетал (аналог ABS), нержавеющая сталь 304',
  },
];

const standards = [
  { label: 'Биосовместимость', desc: 'Материалы подбираются в соответствии с ISO 10993. PEEK, титан и нержавеющая сталь 316L доступны для неимплантируемых медицинских изделий.' },
  { label: 'Сборка в чистом помещении', desc: 'Опциональная сборка и упаковка в чистом помещении для деталей, требующих контролируемого уровня загрязнений.' },
  { label: 'Полная прослеживаемость', desc: 'Партионная прослеживаемость от сертификата сырья до финального контроля; сертификаты материалов предоставляются по запросу.' },
  { label: 'Соответствие стерилизации', desc: 'Детали рассчитаны на выдерживание циклов стерилизации автоклавом, оксидом этилена (EtO) и гамма-излучением без деградации.' },
];
---

<PageLayout
  title="ЧПУ обработка медицинского оборудования | корпуса · кронштейны · оснастка | Eternal CNC"
  description="Точная ЧПУ обработка для медицины — корпуса диагностики, кронштейны хирургических инструментов, оснастка, кронштейны мониторов. Поставщик ЧПУ Китай, фрезерная и токарная обработка ЧПУ."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Отрасли</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Медицинское оборудование
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Корпуса · Кронштейны · Детали диагностического оборудования.
        Точные ЧПУ детали для производителей медицинского оборудования с полной прослеживаемостью.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded-md transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Смотреть услуги →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Возможности</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Компоненты медицинского оборудования</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Мы обрабатываем детали для диагностического, хирургического и мониторингового оборудования.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Точность допуска</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Требуется прецизионная финишная обработка и контроль. Подлежит проверке чертежа.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Распространённые материалы</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Контроль качества</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Стандарты качества для медицины</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Медицинские применения требуют самого высокого уровня документации и целостности материалов.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Showcase -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Примеры продукции</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Галерея компонентов медицинского оборудования</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Визуализации продукции предназначены только для демонстрации процесса. Наглядное представление возможностей обработки. Изображения приведены только для справки в связи с NDA.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-diagnostic-housing-01.webp" alt="ЧПУ обработанный алюминиевый корпус диагностического оборудования" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">ЧПУ обработанный алюминиевый корпус диагностики</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-surgical-instrument-02.webp" alt="Детали хирургических инструментов из нержавеющей стали" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Детали хирургических инструментов из нержавеющей стали</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-monitor-mount-arm-03.webp" alt="Кронштейн-манипулятор монитора пациента" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Кронштейн-манипулятор монитора пациента</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-lab-fixture-tray-04.webp" alt="Лабораторная оснастка и лоток проб медицинского оборудования" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Лабораторная оснастка и лоток проб</p></div>
        </div>
      </div>
    </div>
  </section>

  <IndustryArticles
    system="medical"
    collection="blog"
    basePath="/ru/knowledge/tech-blog"
    eyebrow="Подробные руководства"
    heading="Руководства по обработке для медицины"
    fallbackHeading="Руководства по обработке из нашего технического блога"
    intro="Что нужно знать о материалах, документации и финишной обработке медицинских деталей."
    generalHeading="Общая база"
    generalTag="Цепочка, через которую проходит каждая деталь — чертёж, DFM, материал, станок, финишная обработка, расчёт."
    locale="ru-RU"
  />

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Нужны компоненты медицинского оборудования?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите свой чертёж — наши инженеры подготовят расчёт с рекомендациями по материалам и соответствию требованиям.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Получить бесплатный расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border rounded-lg border border-white/30 text-white transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Бесплатный DFM-анализ →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
