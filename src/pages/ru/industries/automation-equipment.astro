---
import PageLayout from '../../../layouts/PageLayout.astro';
import IndustryArticles from '../../../components/IndustryArticles.astro';

const breadcrumbs = [
  { label: 'Отрасли', href: '/ru/industries' },
  { label: 'Оборудование автоматизации' },
];

const capabilities = [
  {
    title: 'Компоненты конвейеров',
    items: ['Звёздочки, ролики, боковые направляющие', 'Направляющие плиты и полосы износа', 'Износостойкие сплавы и покрытия', 'Индивидуальные длины и конфигурации'],
    tolerance: '±0.025mm',
    materials: 'Сталь 1045, нержавеющая сталь 304, UHMW-PE',
  },
  {
    title: 'Детали захвата и перемещения',
    items: ['Исполнительные органы и вакуумные захваты', 'Прецизионные монтажные плиты', 'Облегчённые алюминиевые конструкции', 'Высокоскоростная оснастка роботов'],
    tolerance: '±0.01mm',
    materials: 'Алюминий 6061/7075, ПОМ (ацеталь)',
  },
  {
    title: 'Приспособления и кондукторы ЧПУ',
    items: ['Индивидуальные решения для закрепления заготовок', 'Системы зажима с нулевой точкой', 'Повторяемое позиционирование', 'Быстросменные интерфейсы инструмента'],
    tolerance: '±0.01mm',
    materials: 'Сталь 4140, алюминий 7075, ПОМ',
  },
  {
    title: 'Заказные сборочные станции',
    items: ['Модульные рамы и поворотные столы', 'Прецизионные штифты', 'Приспособления пневматических и сервопрессов', 'Плиты выравнивания с техническим зрением'],
    tolerance: '±0.005mm',
    materials: 'Сталь, алюминий, конструкционные пластики',
  },
];

const standards = [
  { label: 'Контроль размеров', desc: 'Полный отчёт КИМ (CMM) доступен по запросу через общий метрологический центр нашей группы; соответствие GD&T; первичный контроль каждого приспособления.' },
  { label: 'Контроль качества поверхности', desc: 'Заданные значения Ra, снятые заусенцы, толщина покрытия проверена согласно чертежу.' },
  { label: 'Тестирование повторяемости', desc: 'Внутрипроцессный контроль качества, отчёты Cp/Cpk для деталей автоматизации крупных партий.' },
  { label: 'Поддержка при установке на месте', desc: 'Инженеры доступны для ввода приспособлений в эксплуатацию и интеграции линии.' },
];
---

<PageLayout
  title="ЧПУ обработка оборудования автоматизации | Конвейеры · захват и перемещение · приспособления | Eternal CNC"
  description="Прецизионные ЧПУ детали для промышленной автоматизации — компоненты конвейеров, оснастка захвата и перемещения, приспособления ЧПУ и заказные сборочные станции. Повторяемая точность до ±0,01 мм. Оборудование автоматизации, поставщик ЧПУ Китай."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Отрасли</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Детали оборудования автоматизации
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Конвейерные системы · Захват и перемещение · Приспособления ЧПУ · Заказная сборка.
        Прецизионные детали, которые держат ваши производственные линии в работе без простоев.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/industries" class="inline-block px-6 py-3 text-sm font-medium rounded-lg transition-all duration-200 border" style="border-color: var(--brand-red); color: var(--brand-red);">
          Смотреть отрасли →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Возможности</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Основные компоненты</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Мы обрабатываем прецизионные детали для каждого этапа вашей линии автоматизации. Критические размеры могут быть проверены КИМ (CMM) через общий метрологический центр нашей группы по запросу с полной документацией.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Точность допуска</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Требуется прецизионная финишная обработка и контроль. Подлежит проверке чертежа.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Распространённые материалы</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Контроль качества</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Стандарты качества автоматизации</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Каждое приспособление и компонент созданы для повторяемости и долгосрочной надёжности.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-lg" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  

<!-- 产品展示 -->
<section style="background-color: var(--card-white); padding: 80px 0;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Примеры продукции</p>
    <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Примеры компонентов оборудования автоматизации</h2>
    <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Основные детали оборудования автоматизации — линейные модули, корпуса редукторов, захваты. Визуализации продукции предназначены только для демонстрации процесса. Наглядное представление возможностей обработки. Изображения приведены только для справки в связи с NDA.</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automation-equipment/cnc-automation-linear-slide-rail-01.webp" alt="Направляющая линейного перемещения и каретка" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Направляющая линейного перемещения и каретка</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automation-equipment/cnc-automation-harmonic-reducer-housing-02.webp" alt="Корпус гармонического/RV-редуктора" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Корпус гармонического/RV-редуктора</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automation-equipment/cnc-automation-pneumatic-gripper-03.webp" alt="Палец пневматического захвата" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Палец пневматического захвата</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automation-equipment/cnc-automation-chain-link-04.webp" alt="Звено конвейерной цепи и звёздочка" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Звено конвейерной цепи и звёздочка</p></div>
        </div>
    </div>
  </div>
</section>

  <IndustryArticles
    system="automation-equipment"
    collection="blog"
    basePath="/ru/knowledge/tech-blog"
    eyebrow="Подробные руководства"
    heading="Руководства по обработке для автоматизации"
    fallbackHeading="Руководства по обработке из нашего технического блога"
    intro="Заметки о рамах, приспособлениях и механике движения для линий автоматизации."
    generalHeading="Общая база"
    generalTag="Цепочка, через которую проходит каждая деталь — чертёж, DFM, материал, станок, финишная обработка, расчёт."
    locale="ru-RU"
  />

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Автоматизируйте с уверенностью</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Расскажите о вашем проекте автоматизации — расчёт за 2 часа.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт →
        </a>
        <a href="/ru/industries" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-lg transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Все отрасли →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
