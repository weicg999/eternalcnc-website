---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Возможности', href: '/ru/capabilities' },
  { label: 'Стандарты допусков' },
];

const capabilities = [
  {
    title: 'Линейный допуск — ISO 2768-f',
    items: ['Размеры 6–30 мм: ±0,10 мм', 'Размеры 30–120 мм: ±0,15 мм', 'Размеры 120–400 мм: ±0,20 мм', 'Размеры 400–1000 мм: ±0,30 мм'],
    tolerance: '±0,005 мм (фрезерование ЧПУ)',
    materials: 'Все металлы и конструкционные пластики',
  },
  {
    title: 'Угловой допуск — ±0,01°',
    items: ['Жёсткий угловой контроль фасок', 'Прецизионные конусы', 'Угловые элементы по базам', 'Проверка КИМ доступна через угловые измерения в общем метрологическом центре нашей группы по запросу'],
    tolerance: '±0,01°',
    materials: 'Сталь, алюминий, титан',
  },
  {
    title: 'Шероховатость поверхности — Ra 0,4',
    items: ['Стандарт после обработки: Ra 1,6–3,2', 'Тонкая отделка: Ra 0,8–1,6', 'Прецизионная отделка: Ra 0,4–0,8', 'Зеркальная отделка: Ra 0,1–0,4 (шлифование)'],
    tolerance: 'Ra 0,4 мкм достижимо',
    materials: 'Алюминий, нержавеющая сталь, латунь',
  },
  {
    title: 'Допуск формы — GD&T',
    items: ['Плоскостность, параллельность, перпендикулярность', 'Позиционный допуск (⌀0,02 мм)', 'Соосность и биение', 'Профиль поверхности и кромки'],
    tolerance: 'Согласно ASME Y14.5 / ISO GPS',
    materials: 'Все обрабатываемые материалы',
  },
];

const standards = [
  { label: 'Проверка КИМ (через общий метрологический центр нашей группы, по запросу)', desc: 'Контроль первого образца и выборочный контроль могут быть проверены КИМ через общий метрологический центр нашей группы по запросу, по стандартам выборки AQL 2,5.' },
  { label: 'Измерение поверхности', desc: 'Шероховатость проверяется профилометром. По запросу предоставляем показания Ra для ответственных поверхностей.' },
  { label: 'Размерные отчёты', desc: 'Отчёты о размерном контроле доступны по запросу — отчёты о первом образце (FAI) и ключевых характеристиках, оформленные по вашим требованиям.' },
  { label: 'Возможность жёстких допусков', desc: 'При 5-осевой обработке и контролируемой температуре мы выдерживаем ±0,005 мм на ответственных элементах.' },
];
---

<PageLayout
  title="Стандарты точности – фрезерование ±0,005 мм | точение ±0,01 мм | ISO 2768 | Eternal CNC"
  description="Точность ЧПУ: линейный допуск ±0,005 мм, угловой ±0,01°, шероховатость Ra 0,4, полная проверка GD&T согласно ISO 2768-f."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Возможности</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Стандарты точности
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Фрезерование ±0,005 мм · Точение ±0,01 мм · Проверка КИМ доступна через общий метрологический центр нашей группы по запросу.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/services/quality-inspection" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Контроль качества →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Спецификации допусков</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Возможности точности</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Мы выдерживаем жёсткие допуски во всех процессах обработки, проверяемые калиброванным контрольным оборудованием.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Достижимый допуск</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Применимые материалы</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Процесс контроля</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Как мы проверяем точность</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Каждая деталь проходит строгий контроль перед отгрузкой.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- Оборудование контроля -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">Контрольно-измерительное оборудование</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">Прецизионные измерения, которым можно доверять.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="rounded-industrial overflow-hidden">
          <img src="/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp" alt="Координатно-измерительная машина (КИМ) для прецизионного контроля" class="w-full h-64 object-cover" loading="lazy" width="600" height="256" />
        </div>
        <div class="rounded-industrial overflow-hidden">
          <img src="/images/quality/cnc-quality-micrometer-inspection-02.webp" alt="Контрольно-измерительное оборудование на Eternal CNC" class="w-full h-64 object-cover" loading="lazy" width="600" height="256" />
        </div>
        <div class="rounded-industrial overflow-hidden">
          <img src="/images/quality/cnc-quality-inspecting-machined-part-03.webp" alt="Прецизионные измерительные приборы" class="w-full h-64 object-cover" loading="lazy" width="600" height="256" />
        </div>
      </div>
    </div>
  </section>




  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Нужны детали с жёстким допуском?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертёж с обозначениями GD&T. Наши инженеры подтвердят выполнимость в течение 2 часов.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Бесплатный расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Бесплатный DFM-анализ →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
