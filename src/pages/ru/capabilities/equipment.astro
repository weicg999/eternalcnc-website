// JSON-LD структурированные данные для SEO
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Парк оборудования Eternal CNC',
  description: 'Полная матрица ЧПУ-оборудования на прецизионном производстве Eternal CNC — 5-осевые, VMC, сверлильно-резьбонарезные и гравировальные станки — все проверены по табличкам.',
  itemListElement: equipment.map((eq, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: `${eq.brandEn} ${eq.model} ${eq.type}`,
      category: eq.type,
      brand: { '@type': 'Brand', name: eq.brandEn },
      model: eq.model,
      additionalProperty: eq.specs.map(s => ({
        '@type': 'PropertyValue',
        name: s.label,
        value: s.value,
      })),
    },
  })),
};
---

<PageLayout
  title="Парк оборудования ЧПУ – 5 осей · VMC · сверление-резьба · гравировка | Eternal CNC"
  description={`Полная матрица ЧПУ-оборудования Eternal CNC: 5-осевая обработка, вертикальные обрабатывающие центры, сверлильно-резьбонарезные центры и гравировка пресс-форм — все проверены по табличкам станков.`}
  breadcrumbs={breadcrumbs}
  schema={itemListSchema}
>
  {/* Hero */}
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Возможности</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Парк оборудования
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Разнообразная матрица основного ЧПУ-оборудования — охватывает 5-осевую одновременную обработку, скоростное сверление-нарезку и прецизионную гравировку пресс-форм.
        Строгие стандарты калибровки и обслуживания обеспечивают стабильную точность обработки.
      </p>

      {/* Категории оборудования */}
      <div class="flex flex-wrap gap-x-4 gap-y-2 mt-8">
        {categories.map((cat, i) => (
          <span class="text-sm font-medium" style="color: var(--text-body);">
            {cat.name}{i < categories.length - 1 ? '  |' : ''}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Смотреть услуги →
        </a>
      </div>
    </div>
  </section>

  {/* Список оборудования */}
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Наш парк</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Полный перечень станков</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Ниже перечислен каждый ЧПУ-станок нашего предприятия — с реальными фотографиями, проверенными по табличкам моделями и полными техническими характеристиками.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {equipment.map((eq) => (
          <div class={`border rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`} style={`background-color: var(--card-white); border-color: var(--border-color);`}>
            {/* Изображение */}
            <div class="relative h-48 bg-gray-100 overflow-hidden">
              {eq.image ? (
                <img
                  src={eq.image}
                  alt={eq.imageAlt}
                  width="400" height="300"
                  loading="lazy" decoding="async"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                  Фото скоро появится
                </div>
              )}
              {/* Бейдж */}
              <span class="absolute top-3 left-3 text-xs font-semibold text-white px-2.5 py-1 rounded" style={`background-color: ${eq.badgeColor};`}>
                {eq.typeBadge}
              </span>
                          </div>

            {/* Контент */}
            <div class="p-5">
              <p class="text-xs font-medium mb-1" style="color: var(--text-muted);">{eq.brand}</p>
              <h3 class="text-lg font-bold mb-1" style="color: var(--brand-dark);">
                {eq.brandEn} {eq.model}
              </h3>
              <p class="text-sm mb-3" style="color: var(--text-body);">{eq.type}</p>
              {/* Таблица характеристик */}
              <table class="w-full text-xs mb-4">
                <tbody>
                  {eq.specs.map((spec) => (
                    <tr class="border-b" style="border-color: var(--border-color);">
                      <th scope="row" class="py-1.5 pr-3 text-left font-medium whitespace-nowrap" style="color: var(--text-muted);">{spec.label}</th>
                      <td class="py-1.5 text-right" style="color: var(--brand-dark);">{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              {/* Области применения */}
              <p class="text-xs" style="color: var(--text-body);">
                <span class="font-medium" style="color: var(--text-muted);">Применение: </span>
                {eq.applications}
              </p>

