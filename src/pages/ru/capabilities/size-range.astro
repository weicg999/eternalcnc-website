---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Возможности', href: '/ru/capabilities' },
  { label: 'Диапазон размеров' },
];

const capabilities = [
  {
    title: 'Возможности фрезерования ЧПУ',
    items: ['Макс. ход по X: 1270 мм', 'Макс. ход по Y: 700 мм', 'Макс. ход по Z: 700 мм', 'Подходит для крупных плит и корпусов'],
    tolerance: '±0,005 мм',
    materials: 'Алюминий, сталь, нержавеющая, пластики',
  },
  {
    title: 'Возможности токарной обработки ЧПУ',
    items: ['Макс. диаметр обработки: 400 мм', 'Макс. длина точения: 700 мм', 'Прутковый податчик до 65 мм в диаметре', 'Приводной инструмент для поперечных элементов'],
    tolerance: '±0,01 мм',
    materials: 'Сталь, нержавеющая, латунь, алюминий',
  },
  {
    title: 'Мелкие и микродетали',
    items: ['Минимальный размер элемента: 0,1 мм', 'Микросверление от 0,3 мм', 'Тонкостенная обработка до 0,5 мм', 'Идеально для разъёмов и медицинских штифтов'],
    tolerance: '±0,005 мм',
    materials: 'Латунь C360, POM, PEEK (ПЭЭК), нержавеющая 303',
  },
  {
    title: 'Ограничения по массе и объёму',
    items: ['Макс. масса детали: 25 кг за штуку', 'Серийная ёмкость: 1–10 000 шт.', 'Проектирование оснастки для тяжёлых деталей', 'Паллетная система для эффективной партионности'],
    tolerance: 'Проверка КИМ через общий метрологический центр нашей группы по запросу',
    materials: 'Все стандартные металлы и пластики',
  },
];

const standards = [
  { label: 'Накопление допусков', desc: 'Мы анализируем цепочки допусков для многопризнаковых деталей, чтобы обеспечить правильную посадку при сборке даже при жёстких допусках.' },
  { label: 'Соблюдение GD&T', desc: 'Все чертежи интерпретируются согласно ASME Y14.5 / ISO GPS. Применяются допуски расположения, профиля и биения.' },
  { label: 'Проектирование оснастки', desc: 'Специальная оснастка проектируется для сложных деталей — обеспечивает повторяемость в серийном производстве.' },
  { label: 'Межоперационный контроль', desc: 'Критические размеры проверяются в процессе с помощью прецизионных приборов; координатные измерения организуются в общем метрологическом центре нашей группы по запросу. Отклонения выявляются до финишного прохода.' },
];
---

<PageLayout
  title="Диапазон размеров обработки – ход до 1270 мм | ⌀ 400 мм | Eternal CNC"
  description="Диапазон размеров ЧПУ: макс. ход по X 1270 мм, по Y 700 мм, по Z 700 мм, макс. диаметр обработки 400 мм. От микродеталей до крупных корпусов."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Возможности</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Диапазон размеров обработки
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Макс. ход по X 1270 мм · Макс. диаметр обработки 400 мм · От микродеталей до крупных корпусов.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/ru/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Запросить расчёт
        </a>
        <a href="/ru/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border transition-colors" style="border-color: var(--border-color); color: var(--text-body); border-radius: 12px;">
          Смотреть услуги →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Габаритный охват</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Что мы можем обрабатывать</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        От прецизионных микроразъёмов до крупных несущих корпусов — наше оборудование охватывает широкий диапазон размеров.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Точность допуска</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Требует прецизионной доводки и контроля. Зависит от проверки чертежа.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Подходящие материалы</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Стандарты точности</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Контроль размера и допуска</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Расширенная метрология гарантирует, что каждый размер проверен по вашим требованиям чертежа.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Есть деталь для расчёта?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Загрузите чертёж, и наши инженеры подберут оптимальный подход для вашего размера детали.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Бесплатный расчёт
        </a>
        <a href="/ru/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Бесплатный DFM-анализ →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
