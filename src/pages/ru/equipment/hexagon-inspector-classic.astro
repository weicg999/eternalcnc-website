  "model": "INSPECTOR CLASSIC 06.08.06",
  "description": "Мостовая координатно-измерительная машина с гранитной платформой 730 кг и субмикронной точностью, управляется общим метрологическим центром группы, доступна Eternal CNC для координатных измерений по запросу (не штатное оборудование завода).",
  "image": "https://eternalcnc.com/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Тип станка", "value": "Мостовая КИМ" },
    { "@type": "PropertyValue", "name": "Перемещения X/Y/Z", "value": "600/800/600 mm" },
    { "@type": "PropertyValue", "name": "Платформа", "value": "Гранит, около 730 кг" },
    { "@type": "PropertyValue", "name": "Программное обеспечение", "value": "PC-DMIS" },
    { "@type": "PropertyValue", "name": "Точность", "value": "Субмикрон (класс UMC)" },
    { "@type": "PropertyValue", "name": "Сертификация", "value": "CE" },
    { "@type": "PropertyValue", "name": "Серийный номер", "value": "100211946CI" }
  ]
}
</script>

</BaseLayout>
