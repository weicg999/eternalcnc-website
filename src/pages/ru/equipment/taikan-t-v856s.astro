---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Taikan T-V856S — вертикальный центр | EternalCNC" description="Вертикальный обрабатывающий центр Taikan T-V856S: BT40 12 000 об/мин, 24-поз. магазин, повторяемость ±0.005 мм. ЧПУ оборудование, прецизионная металлообработка, заказать детали ЧПУ.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:#8B0000;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Вертикальный обрабатывающий центр</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:#1a1a1a;line-height:1.2;margin-bottom:1rem">Taikan T-V856S</h1>
    <p style="font-size:1.05rem;color:#555;margin-bottom:1.5rem;line-height:1.6">Высокоточный вертикальный обрабатывающий центр со шпинделем BT40 прямого привода и магазином с манипулятором, создан для стабильного производства средне- и крупногабаритных прецизионных деталей.</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background:#8B0000;color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT40 12 000 об/мин</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">24 магазина с манипулятором</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">Повторяемость ±0.005 мм</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-taikan-tv856s-hero.webp" alt="Вертикальный обрабатывающий центр Taikan T-V856S" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:#999;text-align:center;margin-top:0.8rem;">Типовой экземпляр Taikan T-V856S · Несколько единиц на нашем заводе</p>
</section>

<!-- Specs Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">Технические характеристики</h2>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;width:40%">Рабочий ход (X / Y / Z)</td><td style="padding:0.8rem 1rem;color:#555">800 / 550 / 600 мм</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Шпиндель</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">BT40, прямой привод, 12 000 об/мин</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Инструментальный магазин</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">24 гнезда, рычажного типа</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Повторяемость</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">±0,005 мм</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">Мощность</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">20–25 кВА (по табличке станка)</td></tr>
      </table>
    </div>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:#fafafa;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">Почему этот станок</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Прямоприводный шпиндель BT40 12 000 об/мин</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Жёсткий прямоприводный шпиндель обеспечивает стабильное резание по стали, алюминию и сплавам.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">24-позиционный магазин с манипулятором</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Быстрая и надёжная смена инструмента манипулятором существенно сокращает непроизводительное время в многооперационном производстве.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Повторяемость ±0.005 мм</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Стабильная точность от детали к детали, подтверждённая системными протоколами контроля качества.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">Контроль на Hexagon OPTIV 2.5D</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">Гарантия качества обеспечивается измерительным оборудованием Hexagon OPTIV 2.5D для каждой критической производственной партии.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem;">Проверка таблички</h3>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/equipment/equipment-taikan-tv856s-hero.webp" alt="Типовая заводская табличка Taikan T-V856S" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:#999;margin-top:0.8rem;">Типовая табличка Taikan T-V856S</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Вертикальный обрабатывающий центр Taikan T-V856S",
  "brand": { "@type": "Brand", "name": "Taikan" },
  "model": "T-V856S",
  "description": "Высокоточный вертикальный обрабатывающий центр со шпинделем BT40 12 000 об/мин прямого привода и 24-позиционным магазином с манипулятором.",
  "image": "https://eternalcnc.com/images/equipment/equipment-taikan-tv856s-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Перемещения", "value": "X 800 мм / Y 550 мм / Z 600 мм" },
    { "@type": "PropertyValue", "name": "Шпиндель", "value": "BT40, 12 000 об/мин прямой привод" },
    { "@type": "PropertyValue", "name": "Инструментальный магазин", "value": "24 позиции, с манипулятором" },
    { "@type": "PropertyValue", "name": "Повторяемость", "value": "±0,005 мм" }
  ]
}
</script>

</BaseLayout>
