---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Qiaohong QH-T6 — сверлильно-резьбовой центр | EternalCNC" description="Высокоскоростной сверлильно-резьбонарезной центр Qiaohong QH-T6 для 3C/литья: зона 600×400 мм, подача 48 000 мм/мин. ЧПУ оборудование, прецизионная металлообработка, заказать детали ЧПУ.">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem">Сверлильно-резьбонарезной центр</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">Qiaohong QH-T6</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">Специализированный высокоскоростной сверлильно-резьбонарезной станок, оптимизированный для электроники 3C, литых под давлением деталей и фурнитуры; рабочая зона 600 × 400 мм, высокие скорости подачи.</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">Высокоскоростное сверление-резьба</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">Ход 600 мм</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">Номинальная мощность 10 кВт</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-qiaohong-qh-t6-hero.webp" alt="Высокоскоростной сверлильно-резьбонарезной станок Qiao Hong QH-T6 на производстве Eternal CNC" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">Типовой экземпляр Qiaohong QH-T6 · Несколько единиц на нашем заводе</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">Обзор</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">Qiaohong QH-T6 — специализированный высокоскоростной сверлильно-резьбонарезной центр, созданный для высокопроизводительного сверления и нарезания резьбы. С рабочей зоной 600 × 400 мм и подачей 48 000 мм/мин он эффективно обрабатывает детали электроники 3C, алюминиевые отливки под давлением и фурнитуру.</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">Работая на нашем заводе, QH-T6 добавляет специализированные мощности сверления-резьбонарезки, дополняющие наши вертикальные обрабатывающие центры. Такая специализация означает меньшее время цикла и более низкую себестоимость детали в крупносерийных проектах.</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Технические характеристики</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">Рабочий ход (X / Y)</td><td style="padding:0.8rem 1rem;color:var(--text-body)">600 / 400 мм</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Скорость подачи</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">48 000 мм/мин</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Номинальная мощность</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">10 кВт</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Номинальное напряжение</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">380 В / 50 Гц</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">Номинальный ток</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">50 А</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">Почему этот станок</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Специалист по высокоскоростному сверлению-резьбе</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Специально создан для быстрого сверления и нарезания резьбы на деталях 3C, литья под давлением и фурнитуры.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Высокая скорость подачи</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Подача 48 000 мм/мин минимизирует холостые перемещения между отверстиями для максимальной производительности.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Номинальная мощность 10 кВт</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Достаточная мощность для стабильной работы в широком диапазоне сверлильно-резьбонарезных операций.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Жёсткая конструкция станка</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Устойчивое литое основание обеспечивает стабильную точность даже при высокоскоростной непрерывной работе.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Дополняющая производственная ячейка</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Выделенные мощности сверления-резьбонарезки высвобождают вертикальные центры для более сложной фрезеровки.</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">Параметры, подтверждённые табличкой</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">Параметры станка сверены с заводской табличкой для полной прослеживаемости.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">Проверенное оборудование</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">На этой странице представлен типовой экземпляр Qiaohong QH-T6 из нашего цеха. Заводская табличка подтверждает модель и данные выпуска, обеспечивая полную прослеживаемость вашего проекта.</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-qiaohong-qh-t6-high-speed-drill-tap-01.webp" alt="Типовая заводская табличка Qiaohong QH-T6" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">Типовая табличка Qiaohong QH-T6</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Высокоскоростной сверлильно-резьбонарезной станок Qiaohong QH-T6",
  "brand": { "@type": "Brand", "name": "Qiaohong" },
  "model": "QH-T6",
  "description": "Специализированный высокоскоростной сверлильно-резьбонарезной станок для электроники 3C, литых под давлением деталей и фурнитуры; рабочая зона 600 × 400 мм, высокие скорости подачи.",
  "image": "https://eternalcnc.com/images/equipment/equipment-qiaohong-qh-t6-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Перемещения (X / Y)", "value": "600 / 400 мм" },
    { "@type": "PropertyValue", "name": "Скорость подачи", "value": "48 000 мм/мин" },
    { "@type": "PropertyValue", "name": "Номинальная мощность", "value": "10 кВт" },
    { "@type": "PropertyValue", "name": "Номинальное напряжение", "value": "380 В / 50 Гц" },
    { "@type": "PropertyValue", "name": "Номинальный ток", "value": "50 А" }
  ]
}
</script>

</BaseLayout>
