---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 乔鸿 QH-T6, 钻攻中心" title="乔鸿 QH-T6 钻攻中心 | 鑫永恒精密" description="专业高速钻攻机，600 x 400 mm 加工范围，进给速度快，专为 3C 电子、压铸件和五金件加工优化。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">钻攻中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">乔鸿 QH-T6</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">专业高速钻攻机，600 x 400 mm 加工范围，进给速度快，专为 3C 电子、压铸件和五金件加工优化。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">高速钻攻</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">600 mm 行程</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">10 kW 额定功率</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-qiaohong-qh-t6-hero.webp" alt="乔鸿 QH-T6 钻攻中心 在鑫永恒 CNC 工厂" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">乔鸿 QH-T6 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">乔鸿 QH-T6 是一款专业高速钻攻中心，专为高节拍孔加工和攻丝作业设计。600 x 400 mm 加工范围配 48000 mm/min 进给速度，在 3C 电子零件、铝压铸件和五金件加工中效率突出。</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">QH-T6 作为专用钻攻产能与立式加工中心形成互补。专业化分工意味着大批量钻攻项目的加工周期更短、单件成本更低。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">行程（X / Y）</td><td style="padding:0.8rem 1rem;color:var(--text-body)">600 / 400 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">进给速度</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">48,000 mm/min</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">额定功率</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">10 kW</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">额定电压</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">380V / 50Hz</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">额定电流</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">50 A</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">高速钻攻专用</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">专用于 3C、压铸件、五金件的快速钻孔与攻牙。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">高速进给</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">48000 mm/min 进给速度，孔间移动空程时间短，产能最大化。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">10 kW 额定功率</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">功率充足，各类钻孔攻丝工况下均能稳定输出。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">高刚性结构</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">稳定的铸铁床身，高速连续加工下精度保持性好。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">互补型产能</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">专用钻攻产能释放立加资源，用于更复杂的铣削工序。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">铭牌参数核验</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">设备参数经实机铭牌核验，全程可追溯。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">本页展示的是厂内的Qiaohong QH-T6代表机型。设备铭牌确认了型号与生产记录，确保您的项目全程可追溯。</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-qiaohong-qh-t6-high-speed-drill-tap-01.webp" alt="Representative nameplate of Qiaohong QH-T6" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">乔鸿 QH-T6 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "乔鸿 QH-T6 钻攻中心",
  "brand": { "@type": "Brand", "name": "Qiaohong" },
  "model": "QH-T6",
  "description": "专业高速钻攻机，600 x 400 mm 加工范围，进给速度快，专为 3C 电子、压铸件和五金件加工优化。",
  "image": "https://www.eternalcnc.com/images/equipment/equipment-qiaohong-qh-t6-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "行程（X / Y）", "value": "600 / 400 mm" },
    { "@type": "PropertyValue", "name": "进给速度", "value": "48,000 mm/min" },
    { "@type": "PropertyValue", "name": "额定功率", "value": "10 kW" },
    { "@type": "PropertyValue", "name": "额定电压", "value": "380V / 50Hz" },
    { "@type": "PropertyValue", "name": "额定电流", "value": "50 A" }
  ]
}
</script>

</BaseLayout>
