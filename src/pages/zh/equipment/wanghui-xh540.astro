---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 望辉机械 XH-540, 雕铣/加工中心" title="望辉机械 XH-540 雕铣/加工中心 | 鑫永恒精密" description="配备高速电主轴的模具雕铣加工中心，适用于模具雕铣、治具加工及铝件批量攻钻。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-dark);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">雕铣/加工中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">望辉机械 XH-540</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">配备高速电主轴的模具雕铣加工中心，适用于模具雕铣、治具加工及铝件批量攻钻。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-dark);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">高速电主轴</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">模具雕铣</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">治具加工</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-wanghui-xh540-hero.webp" alt="望辉机械 XH-540 雕铣/加工中心 在鑫永恒 CNC 工厂" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">望辉机械 XH-540 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">望辉 XH-540 是一款专业模具雕铣加工中心，配备约 24000 转高速电主轴。专为模具雕铣、治具夹具加工以及铝件批量钻攻而设计，兼顾雕铣精度与通用加工灵活性。</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">XH-540 作为专业雕铣资源与标准立加机群形成互补。伺服驱动系统为模具精细加工和量产钻攻提供稳定可靠的精度。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">工作台</td><td style="padding:0.8rem 1rem;color:var(--text-body)">约 500 x 400 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">主轴</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">高速电主轴，约 24,000 rpm</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">驱动系统</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">伺服电机驱动</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">应用</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">模具雕铣、治具加工、铝件攻钻</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">高速电主轴</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">约 24000 转主轴，模具及铝件加工表面光洁度好。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">模具雕铣专长</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">专为模具雕铣设计，精细纹路加工精度有保障。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">治具夹具加工</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">高效承接定制治具夹具加工，从原型到小批量均可。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">铝件钻攻</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">可完成铝件的批量钻孔与攻丝作业。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">伺服驱动精度</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">伺服电机驱动系统，定位准确，重复精度可靠。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">厂内特种产能</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">多机车间网络中的专业雕铣产能资源。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">本页展示的是厂内的WANGHUI XH-540代表机型。设备铭牌确认了型号与生产记录，确保您的项目全程可追溯。</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-wanghui-xh540-mold-engraving-machining-center-01.webp" alt="Representative nameplate of WANGHUI XH-540" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">望辉 XH-540 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "望辉机械 XH-540 雕铣/加工中心",
  "brand": { "@type": "Brand", "name": "WANGHUI Machinery" },
  "model": "XH-540",
  "description": "配备高速电主轴的模具雕铣加工中心，适用于模具雕铣、治具加工及铝件批量攻钻。",
  "image": "https://www.eternalcnc.com/images/equipment/equipment-wanghui-xh540-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "工作台", "value": "约 500 x 400 mm" },
    { "@type": "PropertyValue", "name": "主轴", "value": "高速电主轴，约 24,000 rpm" },
    { "@type": "PropertyValue", "name": "驱动系统", "value": "伺服电机驱动" },
    { "@type": "PropertyValue", "name": "应用", "value": "模具雕铣、治具加工、铝件攻钻" }
  ]
}
</script>

</BaseLayout>
