---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 佳富 JF-600, 钻攻中心" title="佳富 JF-600 钻攻中心 | 鑫永恒精密" description="大行程钻攻中心，600 x 420 x 330 mm 行程配滚柱线轨，适合中等精密零件及汽车零部件加工。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">钻攻中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">佳富 JF-600</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">大行程钻攻中心，600 x 420 x 330 mm 行程配滚柱线轨，适合中等精密零件及汽车零部件加工。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT30 20000 转</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">600 mm 行程</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">21 把伺服刀库</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-jiafu-jf600-hero.webp" alt="佳富 JF-600 钻攻中心 在鑫永恒 CNC 工厂" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">佳富 JF-600 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">佳富 JF-600 在 JF-500 基础上升级，600 x 420 x 330 mm 更大行程配滚柱线轨，刚性更强。BT30 直结式 20000 转主轴搭配 21 把伺服刀库，中等精密零件及汽车零部件加工效率高。</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">JF-600 整机重达 3800 kg，铸铁结构稳定，长时间生产中精度保持一致。为中等尺寸钻攻铣项目提供可扩展产能。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:var(--text-body)">600 / 420 / 330 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">工作台</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">720 x 400 mm</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">主轴</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">BT30 直结式，20,000 rpm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">刀库容量</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">21 把，伺服式</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">快速移动</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">60,000 mm/min（滚柱线轨）</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">机床重量</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">约 3,800 kg</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">机械编号</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">861306101</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">更大加工范围</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">600 mm X 轴行程，可加工小型钻攻机无法容纳的中等尺寸零件。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">滚柱线轨</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">滚柱式线轨比滚珠式刚性更高、承载能力更强。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">直结式 BT30 主轴</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">20000 rpm 直结主轴，切削平稳，表面质量优异。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">21 把伺服刀库</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">充足刀位支持复杂多工序零件一次装夹完成。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">6 万米/分快移</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">快速定位减少空程时间，特征分散的零件优势更明显。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">重型铸铁底座</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">3800 kg 筋板铸铁床身，减振效果好，长期精度保持性佳。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">本页展示的是厂内的Jiafu JF-600代表机型。设备铭牌确认了型号与生产记录，确保您的项目全程可追溯。</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-jiafu-jf600-drill-tap-machining-center-01.webp" alt="Representative nameplate of Jiafu JF-600" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">佳富 JF-600 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "佳富 JF-600 钻攻中心",
  "brand": { "@type": "Brand", "name": "JIAFU" },
  "model": "JF-600",
  "description": "大行程钻攻中心，600 x 420 x 330 mm 行程配滚柱线轨，适合中等精密零件及汽车零部件加工。",
  "image": "https://eternalcnc.com/images/equipment/equipment-jiafu-jf600-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "行程（X / Y / Z）", "value": "600 / 420 / 330 mm" },
    { "@type": "PropertyValue", "name": "工作台", "value": "720 x 400 mm" },
    { "@type": "PropertyValue", "name": "主轴", "value": "BT30 直结式，20,000 rpm" },
    { "@type": "PropertyValue", "name": "刀库容量", "value": "21 把，伺服式" },
    { "@type": "PropertyValue", "name": "快速移动", "value": "60,000 mm/min（滚柱线轨）" },
    { "@type": "PropertyValue", "name": "机床重量", "value": "约 3,800 kg" },
    { "@type": "PropertyValue", "name": "机械编号", "value": "861306101" }
  ]
}
</script>

</BaseLayout>
