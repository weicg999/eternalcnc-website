---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 巨冈 CT-80, 立式加工中心" title="巨冈 CT-80 立式加工中心 | 鑫永恒精密" description="巨冈 CT 系列紧凑型高速立式加工中心，专为中小型工件的高效钻孔、攻丝及轻铣加工设计。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">立式加工中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">巨冈 CT-80</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">巨冈 CT 系列紧凑型高速立式加工中心，专为中小型工件的高效钻孔、攻丝及轻铣加工设计。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">立式加工中心</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">CT 系列</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">紧凑结构</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/cnc-machine-cato-ct80-vertical-machining-center-01.webp" alt="CATO CT-80 vertical machining center" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">巨冈 CT-80 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">巨冈 CT-80 是紧凑型立式加工中心，专为高效铣削与孔加工设计，为各行业中小型零件生产提供可靠的解决方案。</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">CT-80 在厂内提供灵活的铣削产能，与更广泛的加工单元形成互补。紧凑设计支持高效产线布局和快速换型。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">机型</td><td style="padding:0.8rem 1rem;color:var(--text-body)">立式加工中心</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">系列</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">CT 系列</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">应用</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">钻孔、攻丝、轻铣</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">结构</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">铸铁床身</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">CT 系列平台</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">基于巨冈成熟的 CT 系列钻攻中心平台，机型经过市场验证。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">立式加工中心</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">针对中小型零件的快速钻孔与攻丝循环优化。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">紧凑占地</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">节省空间的设计，便于高效产线布局和集成。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">可靠结构</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">铸铁床身提供稳定刚性，确保加工精度一致性。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">灵活生产</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">钻孔、攻丝、轻铣多种工序一次装夹完成。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">厂内产能</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">多机车间网络的一部分，生产需求可灵活扩展。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">本页展示的是厂内的CATO CT-80代表机型。设备铭牌确认了型号与生产记录，确保您的项目全程可追溯。</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-cato-ct80-vertical-machining-center-01.webp" alt="Representative nameplate of CATO CT-80" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">巨冈 CT-80 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "巨冈 CT-80 立式加工中心",
  "brand": { "@type": "Brand", "name": "CATO" },
  "model": "CT-80",
  "description": "巨冈 CT 系列紧凑型高速立式加工中心，专为中小型工件的高效钻孔、攻丝及轻铣加工设计。",
  "image": "https://www.eternalcnc.com/images/equipment/equipment-cato-ct80-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "机型", "value": "立式加工中心" },
    { "@type": "PropertyValue", "name": "系列", "value": "CT 系列" },
    { "@type": "PropertyValue", "name": "应用", "value": "钻孔、攻丝、轻铣" },
    { "@type": "PropertyValue", "name": "结构", "value": "铸铁床身" }
  ]
}
</script>

</BaseLayout>
