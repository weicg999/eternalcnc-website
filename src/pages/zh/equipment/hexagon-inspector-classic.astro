---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 海克斯康 INSPECTOR CLASSIC 06.08.06, 质量检测" title="海克斯康 INSPECTOR CLASSIC 06.08.06 质量检测 | 鑫永恒精密" description="桥式三坐标测量机，配备 730 kg 花岗岩平台——由集团共享计量中心运营，可为鑫永恒零件提供按需三坐标检测（非本公司标配设备，距离本厂有一定距离）。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:#8B0000;font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">质量检测</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:#1a1a1a;line-height:1.2;margin-bottom:1rem">海克斯康 INSPECTOR CLASSIC 06.08.06</h1>
    <p style="font-size:1.05rem;color:#555;margin-bottom:1.5rem;line-height:1.6">桥式三坐标测量机，配备 730 kg 花岗岩平台——由集团共享计量中心运营，可为鑫永恒零件提供按需三坐标检测（非本公司标配设备，距离本厂有一定距离）。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background:#8B0000;color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">亚微米级精度</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">730 kg 花岗岩</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">PC-DMIS 软件</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp" alt="Hexagon INSPECTOR CLASSIC Bridge CMM" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:contain;" />
  </div>
  <p style="font-size:0.8rem;color:#999;text-align:center;margin-top:0.8rem;">海克斯康 INSPECTOR CLASSIC 06.08.06 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:#555;line-height:1.7;margin-bottom:0.8rem">鑫永恒的关键零件可送至集团共享计量中心的海克斯康 INSPECTOR CLASSIC 06.08.06 桥式三坐标测量机进行检测。建立在 730 kg 花岗岩平台之上，确保极佳的热稳定性，关键尺寸可进行亚微米级 3D 全尺寸检测：位置度、轮廓度、跳动、平面度，无一遗漏。</p>
    <p style="font-size:0.95rem;color:#555;line-height:1.7">对关键零件，我们安排在该集团共享计量中心完成三坐标测量并出具完整 CMM 检测报告。对客户而言，这意味着到货尺寸可验证。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;width:40%">品牌 / 型号</td><td style="padding:0.8rem 1rem;color:#555">海克斯康 INSPECTOR CLASSIC 06.08.06</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">设备类型</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">桥式三坐标测量机</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">序列号</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">100211946CI</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">生产日期</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">2021-05</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">600 / 800 / 600 mm（量级）</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">平台</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">花岗岩，约 730 kg</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">测量软件</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">海克斯康 PC-DMIS（标配）</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">精度等级</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">亚微米级（UMC 级）</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">电源</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">单相 220V，约 1 kVA</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">认证</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">CE</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">制造商</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">海克斯康制造智能（青岛）</td></tr>
      </table>
    </div>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:#fafafa;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">海克斯康原厂品质</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">由全球计量领导者海克斯康制造智能原厂制造与校准，品质有保障。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">730 kg 花岗岩平台</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">厚重花岗岩基座提供卓越的热稳定性和减震性能，读数始终一致。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">亚微米级 3D 精度</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">真正桥式三坐标精度——位置度、轮廓度、跳动、平面度，全部微米级验证。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">全尺寸检测报告</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">每个关键特征均附带签署的 PC-DMIS 报告——不靠猜测，只看数据。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">真正 3D 三坐标，非 2.5D 影像</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">桥式结构搭配接触式测头，可测量复杂 3D 几何形状，不限于平面零件。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">CE 认证，中国制造</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">海克斯康青岛工厂按全球标准制造——欧洲品控，本土服务网络。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:#666;margin-bottom:1.2rem;line-height:1.6;">This page features the Hexagon INSPECTOR CLASSIC CMM operated by our group's shared metrology center that provides coordinate measurement for Eternal CNC. The nameplate confirms the model, serial number and build record for full traceability.</p>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/quality/cnc-quality-cmm-coordinate-measuring-machine-01.webp" alt="Hexagon INSPECTOR CLASSIC nameplate verification" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:#999;margin-top:0.8rem;">海克斯康 INSPECTOR CLASSIC 铭牌</p>
  </div>
</section>

