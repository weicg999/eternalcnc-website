---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 佳富 JF-500, 钻攻中心" title="佳富 JF-500 钻攻中心 | 鑫永恒精密" description="紧凑型钻攻中心，BT30 20000 转主轴配伺服刀库，专为 3C 电子和小型铝铜件的高速批量加工而设计。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">钻攻中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">佳富 JF-500</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">紧凑型钻攻中心，BT30 20000 转主轴配伺服刀库，专为 3C 电子和小型铝铜件的高速批量加工而设计。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT30 20000 转</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">500 mm 行程</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">伺服刀库</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-jiafu-jf500-hero.webp" alt="佳富 JF-500 钻攻中心 在鑫永恒 CNC 工厂" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">佳富 JF-500 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">佳富 JF-500 是一款紧凑型钻攻加工中心，高转速主轴配合快速换刀，小零件生产效率高。BT30 20000 转主轴搭配 16 或 21 把伺服刀库，可完成铝、铜及其他有色金属的钻孔、攻丝和轻铣加工。</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">JF-500 以稳定的重复精度承接大批量 3C 电子和小五金订单。所有零件出货前均经厂内检测设备质量检验。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:var(--text-body)">500 / 400 / 300 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">主轴</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">BT30，最高 20,000 rpm</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">刀库容量</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">16 或 21 把，伺服式</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">快速移动</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">48,000-60,000 mm/min</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">控制系统</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">三菱或发那科</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">机械编号</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">870705107</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">BT30 高速主轴</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">20000 rpm 转速，铝件铜件加工表面光洁度优异。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">伺服刀库</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">伺服驱动换刀快速可靠，生产循环中非切削时间最短。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">高快移速度</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">最高 60000 mm/min 快移，减少特征间定位时间。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">紧凑高效布局</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">占地小，适合单元式生产和多品种小批量加工。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">成熟控制系统</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">三菱或发那科系统，运行可靠，操作人员熟悉度高。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">批量精度稳定</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">机床结构稳定，长批次加工中尺寸一致性好。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:var(--text-body);margin-bottom:1.2rem;line-height:1.6;">本页展示的是厂内的Jiafu JF-500代表机型。设备铭牌确认了型号与生产记录，确保您的项目全程可追溯。</p>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;background-color:var(--card-white);">
      <img src="/images/equipment/cnc-machine-jiafu-jf500-drill-tap-machining-center-01.webp" alt="Representative nameplate of Jiafu JF-500" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.8rem;">佳富 JF-500 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "佳富 JF-500 钻攻中心",
  "brand": { "@type": "Brand", "name": "JIAFU" },
  "model": "JF-500",
  "description": "紧凑型钻攻中心，BT30 20000 转主轴配伺服刀库，专为 3C 电子和小型铝铜件的高速批量加工而设计。",
  "image": "https://www.eternalcnc.com/images/equipment/equipment-jiafu-jf500-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "行程（X / Y / Z）", "value": "500 / 400 / 300 mm" },
    { "@type": "PropertyValue", "name": "主轴", "value": "BT30，最高 20,000 rpm" },
    { "@type": "PropertyValue", "name": "刀库容量", "value": "16 或 21 把，伺服式" },
    { "@type": "PropertyValue", "name": "快速移动", "value": "48,000-60,000 mm/min" },
    { "@type": "PropertyValue", "name": "控制系统", "value": "三菱或发那科" },
    { "@type": "PropertyValue", "name": "机械编号", "value": "870705107" }
  ]
}
</script>

</BaseLayout>
