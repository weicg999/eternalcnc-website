---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, SUNRISE DMU-400, 五轴加工中心" title="SUNRISE DMU-400 五轴立式加工中心 | 鑫永恒精密" description="门式五轴加工中心，500×450×400mm 行程，DD 力矩电机转台、BBT40 12000 rpm 主轴与 24 把臂式刀库，专攻复杂曲面、叶轮与模具。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
    <div>
      <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem;text-align:right;">五轴立式加工中心</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;text-align:right;">SUNRISE DMU-400</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;text-align:right;">门式五轴加工中心，配备直驱转台，专为复杂三维曲面、叶轮与模具加工而设计。</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:flex-end;">
        <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">X 500 mm</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Y 450 mm</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Z 400 mm</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">A -120°~+30°</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">C 360°</span>
      </div>
    </div><div style="border-left:2px solid var(--border-color);padding-left:2rem;">
      <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.8rem;">5-Axis Vertical Machining Center</p>
      <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem;">SUNRISE DMU-400</h1>
      <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6;">Gantry-type 5-axis machining center with direct-drive rotary table, engineered for complex 3D surfaces, impellers and molds.</p>
      <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
        <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">X 500 mm</span>
        <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px;">Y 450 mm</span>
