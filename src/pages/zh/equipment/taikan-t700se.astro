---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 台群 T-700SE, 立式加工中心" title="台群 T-700SE 立式加工中心 | 鑫永恒精密" description="重型 BT40 铣削、钻孔、攻丝一体，专为中大型铝件与钢件稳定量产而设计。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:#8B0000;font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">立式加工中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:#1a1a1a;line-height:1.2;margin-bottom:1rem">台群 T-700SE</h1>
    <p style="font-size:1.05rem;color:#555;margin-bottom:1.5rem;line-height:1.6">重型 BT40 铣削、钻孔、攻丝一体，专为中大型铝件与钢件稳定量产而设计。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background:#8B0000;color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT40 12000 转</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">24 把臂式刀库</span>
      <span style="display:inline-block;background:#f5f5f5;color:#333;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">±0.005 mm 重复定位</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-taikan-t700se-hero.webp" alt="台群 T-700SE 立式加工中心 在鑫永恒 CNC 工厂" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:#999;text-align:center;margin-top:0.8rem;">台群 T-700SE 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:#555;line-height:1.7;margin-bottom:0.8rem">台群 T-700SE 是我们重型三轴单元的主力机型。700 x 420 x 520 mm 大行程搭配 BT40 12000 转高刚性直联主轴，轻松应对 6061/7075 铝板、碳钢支架和不锈钢夹具的加工需求。</p>
    <p style="font-size:0.95rem;color:#555;line-height:1.7">厂内多台机组并行运行，从 10 件原型到 10000 件量产均可灵活扩产，全程在同一车间内完成，并通过海克斯康 Optiv 2.5D 三次元检测后方可出货。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;width:40%">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:#555">700 / 420 / 520 mm</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">工作台尺寸</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">900 x 420 mm</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">工作台载重</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">500 kg（均载）</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">主轴锥度</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">BT40（可选 BBT40）</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">主轴转速</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">12000 rpm（直联）</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">主轴功率</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">7.5 kW（额定）/ 11 kW（15分钟）</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">刀库容量</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">24 把，臂式</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">快速移动</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">48 / 48 / 48 m/min</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">定位精度</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">±0.008 mm / 300 mm</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">重复定位精度</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">±0.005 mm</td></tr>
        <tr style="background:#fafafa"><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">数控系统</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">三菱 M80B / 发那科 0i-MF</td></tr>
        <tr><td style="padding:0.8rem 1rem;font-weight:600;color:#333;border-top:1px solid #eee">机器重量</td><td style="padding:0.8rem 1rem;color:#555;border-top:1px solid #eee">约 4800 kg</td></tr>
      </table>
    </div>
  </div>
</section>
<!-- Marketing Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background:#fafafa;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:#1a1a1a;margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">BT40 12000 转直联主轴</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">高扭矩、低振动，铝件表面光洁度好，无需二次抛光。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">24 把臂式刀库</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">钻孔-攻丝-铣削一次装夹完成，刀对刀换刀约 3.2 秒。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">厂内冗余产能</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">车间内多台 T-700SE 并行，您的交期从不依赖单一机台。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">±0.005 mm 重复定位精度</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">批次一致性有保障，每个关键尺寸均经海克斯康 Optiv 三次元复核。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">高刚性铸铁底座</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">有限元优化结构，大吃刀量与重切削下仍保持稳定。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background:#8B0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:#1a1a1a;margin-bottom:0.2rem">三菱 M80B / 发那科 0i-MF 可选</h4>
          <p style="font-size:0.85rem;color:#666;line-height:1.5">全球服务生态，高速轮廓加工顺滑，程序执行稳定可靠。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Nameplate -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem;">
  <div style="max-width:600px;margin:0 auto;text-align:center;">
    <h3 style="font-size:1.2rem;font-weight:700;color:#1a1a1a;margin-bottom:1rem;">铭牌验证</h3>
    <p style="font-size:0.9rem;color:#666;margin-bottom:1.2rem;line-height:1.6;">本页展示的是厂内的Taikan T-700SE代表机型。设备铭牌确认了型号与生产记录，确保您的项目全程可追溯。</p>
    <div style="border:1px solid #e5e5e5;border-radius:10px;overflow:hidden;background:#fff;">
      <img src="/images/equipment/cnc-machine-taikan-t700se-drill-mill-machining-center-01.webp" alt="Representative nameplate of Taikan T-700SE" width="600" height="400" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
    </div>
    <p style="font-size:0.8rem;color:#999;margin-top:0.8rem;">台群 T-700SE 代表铭牌</p>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "台群 T-700SE 立式加工中心",
  "brand": { "@type": "Brand", "name": "Taikan" },
  "model": "T-700SE",
  "description": "重型 BT40 铣削、钻孔、攻丝一体，专为中大型铝件与钢件稳定量产而设计。",
  "image": "https://eternalcnc.com/images/equipment/equipment-taikan-t700se-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "行程（X / Y / Z）", "value": "700 / 420 / 520 mm" },
    { "@type": "PropertyValue", "name": "工作台尺寸", "value": "900 x 420 mm" },
    { "@type": "PropertyValue", "name": "工作台载重", "value": "500 kg（均载）" },
    { "@type": "PropertyValue", "name": "主轴锥度", "value": "BT40（可选 BBT40）" },
    { "@type": "PropertyValue", "name": "主轴转速", "value": "12000 rpm（直联）" },
    { "@type": "PropertyValue", "name": "主轴功率", "value": "7.5 kW（额定）/ 11 kW（15分钟）" },
    { "@type": "PropertyValue", "name": "刀库容量", "value": "24 把，臂式" },
    { "@type": "PropertyValue", "name": "快速移动", "value": "48 / 48 / 48 m/min" },
    { "@type": "PropertyValue", "name": "定位精度", "value": "±0.008 mm / 300 mm" },
    { "@type": "PropertyValue", "name": "重复定位精度", "value": "±0.005 mm" },
    { "@type": "PropertyValue", "name": "数控系统", "value": "三菱 M80B / 发那科 0i-MF" },
    { "@type": "PropertyValue", "name": "机器重量", "value": "约 4800 kg" }
  ]
}
</script>

</BaseLayout>
