---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout keywords="数控设备, 精密金属加工, 定制CNC零件, 台群 T-500S, 钻铣中心" title="台群 T-500S 钻铣中心 | 鑫永恒精密" description="紧凑型 BT30 钻铣中心，500 x 400 x 300 mm 行程配 21 把伺服刀库，擅长中小型铝件高速批量加工。">

<!-- Hero Section -->
<section style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;">
  <div>
    <p style="font-size:0.85rem;color:var(--brand-red);font-weight:600;letter-spacing:0.08em;margin-bottom:0.8rem">钻铣中心</p>
    <h1 style="font-size:2.2rem;font-weight:800;color:var(--brand-dark);line-height:1.2;margin-bottom:1rem">台群 T-500S</h1>
    <p style="font-size:1.05rem;color:var(--text-body);margin-bottom:1.5rem;line-height:1.6">紧凑型 BT30 钻铣中心，500 x 400 x 300 mm 行程配 21 把伺服刀库，擅长中小型铝件高速批量加工。</p>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <span style="display:inline-block;background-color:var(--brand-red);color:#fff;font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">BT30 20000 转</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">500 mm 行程</span>
      <span style="display:inline-block;background-color:var(--page-bg);color:var(--brand-dark);font-size:0.75rem;font-weight:600;padding:5px 12px;border-radius:4px">21 把伺服刀库</span>
    </div>
  </div>
</section>

<!-- Hero Image -->
<section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 3rem;">
  <div style="border-radius:12px;overflow:hidden;background-color:var(--page-bg);box-shadow:0 4px 20px rgba(0,0,0,0.08);">
    <img src="/images/equipment/equipment-taikan-t500s-hero.webp" alt="台群 T-500S 钻铣中心 在鑫永恒 CNC 工厂" width="1200" height="600" loading="eager" decoding="async" style="width:100%;height:auto;display:block;object-fit:cover;" />
  </div>
  <p style="font-size:0.8rem;color:var(--text-muted);text-align:center;margin-top:0.8rem;">台群 T-500S 代表机型 · 厂内多台在役</p>
</section>

<!-- Narrative -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1rem">设备概述</h2>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7;margin-bottom:0.8rem">台群 T-500S 是一款紧凑型钻铣加工中心，专为小零件大批量加工优化。BT30 20000 转主轴搭配 21 把伺服刀库，可高效完成铝件及有色金属的钻孔、攻丝和轻铣加工。</p>
    <p style="font-size:0.95rem;color:var(--text-body);line-height:1.7">T-500S 与大型立加形成互补，专门承接高周转小零件订单，换型速度快，原型和批量生产均能快速交付。</p>
  </div>
</section>

<!-- Spec Table -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">技术参数</h2>
    <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden">
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%">行程（X / Y / Z）</td><td style="padding:0.8rem 1rem;color:var(--text-body)">500 / 400 / 300 mm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">主轴锥度</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">BT30</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">主轴转速</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">20,000 rpm</td></tr>
        <tr style="background-color:var(--page-bg)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">刀库容量</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">21 把，伺服式</td></tr>
        <tr style="background-color:var(--card-white)"><td style="padding:0.8rem 1rem;font-weight:600;color:var(--brand-dark);width:40%;border-top:1px solid var(--border-light)">控制系统</td><td style="padding:0.8rem 1rem;color:var(--text-body);border-top:1px solid var(--border-light)">三菱 / 发那科</td></tr>
      </table>
    </div>
  </div>
</section>

<!-- Highlights -->
<section style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem 3rem;background-color:var(--page-bg);">
  <div>
    <h2 style="font-size:1.4rem;font-weight:700;color:var(--brand-dark);margin-bottom:1.2rem">设备亮点</h2>
    <div style="display:flex;flex-direction:column;gap:1rem">
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">高速 BT30 主轴</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">20000 rpm 转速，铝件及有色金属加工表面光洁度好。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">21 把伺服刀库</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">换刀速度快，钻-攻-铣复合工序一次装夹完成。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">紧凑占地</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">占地面积小，产线布局灵活，易于整线集成。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">批量生产优化</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">快移速度快、换刀时间短，小零件产能最大化。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">厂内产能</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">多机产线联动，从原型到批量无缝扩产。</p>
        </div>
      </div>
      <div style="display:flex;gap:0.8rem;align-items:flex-start">
        <div style="width:28px;height:28px;border-radius:50%;background-color:var(--brand-red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0">+</div>
        <div>
          <h4 style="font-size:0.95rem;font-weight:700;color:var(--brand-dark);margin-bottom:0.2rem">可靠控制系统</h4>
          <p style="font-size:0.85rem;color:var(--text-body);line-height:1.5">三菱或发那科系统，程序稳定，操作人员上手快。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "台群 T-500S 钻铣中心",
  "brand": { "@type": "Brand", "name": "Taikan" },
  "model": "T-500S",
  "description": "紧凑型 BT30 钻铣中心，500 x 400 x 300 mm 行程配 21 把伺服刀库，擅长中小型铝件高速批量加工。",
  "image": "https://eternalcnc.com/images/equipment/equipment-taikan-t500s-hero.webp",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "行程（X / Y / Z）", "value": "500 / 400 / 300 mm" },
    { "@type": "PropertyValue", "name": "主轴锥度", "value": "BT30" },
    { "@type": "PropertyValue", "name": "主轴转速", "value": "20,000 rpm" },
    { "@type": "PropertyValue", "name": "刀库容量", "value": "21 把，伺服式" },
    { "@type": "PropertyValue", "name": "控制系统", "value": "三菱 / 发那科" }
  ]
}
</script>

</BaseLayout>
