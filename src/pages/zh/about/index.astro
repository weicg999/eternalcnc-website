---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutHero from '../../../components/AboutHero.astro';

// ── 能力矩阵：材料 × 典型工艺（数据取自本站 materials / capabilities 页，不臆造）──
const capabilityMatrix = [
  { material: '铝合金', grades: 'AL-6061 / AL-7075', process: '三轴 / 四轴 / 五轴铣削、车削', use: '机器人结构件、散热壳体、自动化夹具' },
  { material: '不锈钢', grades: 'SS304 / SS316L / 17-4PH', process: '车铣复合、精密磨削、线切割', use: '医疗器件、真空腔体、连接器外壳' },
  { material: '钛合金', grades: 'Ti-6Al-4V (TC4)', process: '五轴联动、慢走丝、精修工艺', use: '轻量化结构件、医疗植入级工装' },
  { material: '工程塑料', grades: 'PEEK / Delrin(POM) / Nylon / PTFE / UHMW-PE / PC', process: '高速铣削、精车、去毛刺', use: '绝缘件、耐磨衬套、洁净室零件' },
  { material: '碳钢 / 合金钢', grades: '45# / Q235 / H13 / S136', process: '车削、铣削、热处理配合、表面处理', use: '模具镶件、重载结构件、传动部件' },
];

// ── 常见问题（FAQPage schema 同步用同一份数据源）──
const faqs = [
  {
    q: '你们是工厂还是贸易公司？',
    a: '我们是自有工厂的精密加工厂，位于深圳市宝安区，非贸易型中间商。图纸评估、工艺规划、编程、加工、质检全部在厂内完成，工程师全程跟进，沟通链路更短、问题定位更快。',
  },
  {
    q: '能做小批量打样吗？最少多少件？',
    a: '打样与中小批量正是我们的主场。1 件起做，无需开模。从单件验证件到数百件的小批量，我们都按同一套工艺标准执行。',
  },
  {
    q: '报价要多久？需要提供什么？',
    a: '提供 STEP / IGS / DWG / PDF 图纸即可，工程师在 2 小时内完成 DFM 工艺评审并给出报价与最快交期方案。批量件或复杂件通常 1 个工作日内回复。',
  },
  {
    q: '能达到什么精度？',
    a: '常规加工公差为 ±0.05 mm（ISO 2768-m）；配合五轴联动与精密磨削，关键尺寸可稳定做到 ±0.005 mm，高要求场合可达 ±0.003 mm。表面粗糙度常规 Ra 1.6，精修可至更优。',
  },
  {
    q: '质保和售后怎么算？',
    a: '全流程质量可追溯，出货附尺寸检测报告。若确属我方制造原因导致的尺寸或外观问题，我们主动返工或重做，费用由我方承担。',
  },
  {
    q: '支持哪些表面处理？',
    a: '可做阳极氧化、硬质氧化、电镀、钝化、喷砂、拉丝、粉末喷涂、发黑等，也可按客户指定工艺协调外协并统一质检后出货。',
  },
];
---

<BaseLayout
  title="关于我们 – 深圳精密CNC加工厂 | 鑫永恒"
  description="鑫永恒（深圳）精密实业有限公司——宝安自有工厂，23年制造经验、15年CNC精密加工，30台设备含五轴，±0.005mm精度。铝合金/不锈钢/钛合金/工程塑料小批量快打样，2小时出报价。"
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      name: '关于我们 – 鑫永恒（深圳）精密实业有限公司',
      url: 'https://eternalcnc.com/zh/about',
      description: '深圳宝安自有精密CNC加工工厂，23年制造行业经验、15年CNC精密加工，30台设备含五轴加工中心。',
      inLanguage: 'zh-CN',
      mainEntity: {
        '@type': 'Organization',
        name: '鑫永恒（深圳）精密实业有限公司',
        alternateName: 'Eternal CNC Precision Machining',
        legalName: 'Xinyongheng (Shenzhen) Precision Industrial Co., Ltd.',
        url: 'https://eternalcnc.com',
        foundingDate: '2024',
        slogan: '精度不仅是规格，更是习惯。',
        numberOfEmployees: { '@type': 'QuantitativeValue', value: 20 },
        address: {
          '@type': 'PostalAddress',
          streetAddress: '深圳市宝安区松岗街道沙浦社区广进路33号综合楼101',
          addressLocality: '深圳市',
          addressRegion: '广东省',
          addressCountry: 'CN',
        },
        telephone: '+86 181 2398 3352',
        knowsAbout: ['CNC精密加工', '五轴铣削', 'CNC车削', '线切割', '精密磨削', 'DFM工艺评审', '表面处理'],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: 'zh-CN',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>

  <!-- Hero: 米色全宽 + 左文右视频 + 三列 stats + 双 CTA（方案A） -->
  <AboutHero
    label="关于我们"
    titleHtml="我们是你的工程伙伴，<br/>而不只是加工厂。"
    subtitle="23 年制造行业深耕 · 15 年 CNC 精密加工 · 图纸评估 → 工艺规划 → 打样验证 → 量产交付，自有工厂加工，工程师全程跟进。"
    heroVideoSrc="/videos/eternal-cnc-5axis-machining-in-action-01.mp4"
    stats={[
      { num: '23', unit: '年', label: '制造行业经验' },
      { num: '30', unit: '台', label: 'CNC 设备' },
      { num: '24', unit: 'h', label: '图纸报价' },
    ]}
    ctaPrimaryText="了解加工能力"
    ctaPrimaryHref="/zh/capabilities/equipment"
    ctaSecondaryText="获取报价"
    ctaSecondaryHref="/zh/contact/get-a-quote"
  />

  <!-- 公司简介 -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom max-w-3xl">
      <span class="red-line"></span>
      <h2 class="text-3xl font-bold mb-8" style="color: var(--brand-dark);">我们是谁</h2>
      <div class="space-y-6 text-lg leading-relaxed" style="color: var(--text-body);">
        <p><strong style="color: var(--brand-dark);">鑫永恒（深圳）精密实业有限公司</strong>是一家专业的精密CNC加工厂，而非贸易公司。凭借20余年的实战经验，我们为自动化、机器人、医疗器械及工业设备领域提供高品质精密零部件。</p>
        <p>数千个项目的沉淀，让我们的工程师能够直接从图纸中识别并解决潜在的制造难题——在第一刀切削开始之前。</p>
        <p>我们不靠广告生存。车间的硬实力和客户之间的口碑相传，是我们最核心的资产。</p>
      </div>
    </div>
  </section>

  <!-- 创始人寄语 -->
  <section class="py-20" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <div class="w-16 h-16 rounded-full mx-auto mb-6 flex items-center justify-center" style="background-color: var(--brand-dark);">
          <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
        </div>
        <p class="text-2xl md:text-3xl italic leading-relaxed mb-6" style="color: var(--brand-dark);">
          "我们不仅是工程师，更是深耕工艺二十年的实战专家。每一份图纸，都经过深厚的制造经验打磨。"
        </p>
      </div>
    </div>
  </section>

  <!-- 团队：左图右文（交替布局） -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- 图在左 -->
        <div class="order-2 lg:order-1 rounded-industrial overflow-hidden">
          <img src="/images/company/cnc-workshop-interior-machining-centers-01.webp" alt="老师傅操作精密CNC设备" class="w-full h-64 md:h-72 lg:h-80 object-cover" loading="lazy" width="800" height="320" />
        </div>
        <!-- 文在右 -->
        <div class="order-1 lg:order-2">
          <span class="red-line"></span>
          <h2 class="text-3xl font-bold mb-8" style="color: var(--brand-dark);">我们的团队</h2>
          <p class="text-lg mb-6" style="color: var(--text-muted);">不只是员工，更是手艺人。</p>
          <div class="space-y-6 text-lg leading-relaxed" style="color: var(--text-body);">
            <p>我们的核心团队，是一群在CNC行业深耕超过20年的老师傅。</p>
            <p>从三轴到五轴，他们亲眼见证了整个行业的技术迭代，却始终守着机器无法替代的"手感"与匠心。</p>
            <p>在这里，真正值钱的不是昂贵的设备——而是经由这些手打磨出来的每一件精密零件。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 发展时间线 -->
  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">发展历程</h2>
      </div>
      <div class="max-w-3xl mx-auto">
        <div class="relative">
          <div class="absolute left-6 top-0 bottom-0 w-px" style="background-color: var(--border-color);"></div>
          <div class="relative pl-16 pb-12">
            <div class="absolute left-4 top-1 w-5 h-5 rounded-full border-4 border-white" style="background-color: var(--brand-red);"></div>
            <div class="text-sm font-medium mb-1" style="color: var(--brand-red);">2003</div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--brand-dark);">入行起步</h3>
            <p style="color: var(--text-body);">从手板模型制作入行，打下精密制造的扎实基础。2005年进阶为CNC编程工程师，深耕技术一线。</p>
          </div>
          <div class="relative pl-16 pb-12">
            <div class="absolute left-4 top-1 w-5 h-5 rounded-full border-4 border-white" style="background-color: var(--brand-red);"></div>
            <div class="text-sm font-medium mb-1" style="color: var(--brand-red);">2015</div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--brand-dark);">自主创业</h3>
            <p style="color: var(--text-body);">以个体经营模式独立创业，专注服务自动化、机器人及工业设备领域客户，逐步建立行业口碑。</p>
          </div>
          <div class="relative pl-16 pb-12">
            <div class="absolute left-4 top-1 w-5 h-5 rounded-full border-4 border-white" style="background-color: var(--brand-red);"></div>
            <div class="text-sm font-medium mb-1" style="color: var(--brand-red);">2024</div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--brand-dark);">公司成立</h3>
            <p style="color: var(--text-body);">鑫永恒（深圳）精密实业有限公司正式注册成立。设备规模达30台，具备三轴、四轴、五轴全品类加工能力。</p>
          </div>
          <div class="relative pl-16">
            <div class="absolute left-4 top-1 w-5 h-5 rounded-full border-4 border-white" style="background-color: var(--brand-red);"></div>
            <div class="text-sm font-medium mb-1" style="color: var(--brand-red);">2026</div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--brand-dark);">全球拓展</h3>
            <p style="color: var(--text-body);">成立国际贸易部，全面开拓海外市场。同步启动ISO 9001:2015质量管理体系认证。服务全球机器人、医疗、自动化客户。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 能力矩阵：材料 × 工艺 × 典型应用（承接 SEO 长尾词，同时替代空洞的「为什么选我们」） -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">我们擅长的材料与工艺</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">从铝合金到钛合金、从工程塑料到合金钢，按零件工况选材，而不是按库存凑合。</p>
      </div>
      <div class="max-w-5xl mx-auto overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-color);">
              <th class="py-4 pr-4 text-sm font-semibold whitespace-nowrap" style="color: var(--brand-red);">材料类别</th>
              <th class="py-4 pr-4 text-sm font-semibold whitespace-nowrap" style="color: var(--brand-red);">常用牌号</th>
              <th class="py-4 pr-4 text-sm font-semibold" style="color: var(--brand-red);">典型加工工艺</th>
              <th class="py-4 text-sm font-semibold" style="color: var(--brand-red);">常见应用</th>
            </tr>
          </thead>
          <tbody>
            {capabilityMatrix.map((row) => (
              <tr style="border-bottom: 1px solid var(--border-color);">
                <td class="py-5 pr-4 font-semibold align-top whitespace-nowrap" style="color: var(--brand-dark);">{row.material}</td>
                <td class="py-5 pr-4 align-top text-[15px]" style="color: var(--text-body);">{row.grades}</td>
                <td class="py-5 pr-4 align-top text-[15px]" style="color: var(--text-body);">{row.process}</td>
                <td class="py-5 align-top text-[15px]" style="color: var(--text-body);">{row.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-8 text-center text-[15px]" style="color: var(--text-muted);">
        没找到你的材料牌号？<a href="/zh/contact/get-a-quote" class="font-semibold" style="color: var(--brand-red);">把图纸发过来</a>，工程师会给出选材建议与替代方案。
      </p>
    </div>
  </section>

  <!-- 服务流程：六步（复用首页同款叙事，关于页承担「怎么合作」的解释责任） -->
  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">从图纸到成品的六步流程</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">每一步都有明确交付物，你能随时知道零件走到哪儿了。</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {[
          { num: '01', title: '图纸上传', desc: '支持 STEP / IGS / DWG / PDF 格式，图纸保密处理，可先签 NDA。' },
          { num: '02', title: 'DFM 工艺评审', desc: '工程师在 2 小时内完成可制造性分析，指出潜在风险与降本空间。' },
          { num: '03', title: '报价与交期确认', desc: '给出材料、工艺、表面处理的完整报价，同步承诺最快交期。' },
          { num: '04', title: '编程与精密加工', desc: '多台设备并行排产，加工过程全参数管控，首件必检。' },
          { num: '05', title: '质检与出货', desc: '关键尺寸逐项检测，附检测报告，支持快递/空运/海运多渠道。' },
          { num: '06', title: '售后保障', desc: '质量全流程可追溯，制造问题主动返工或重做，不让客户承担。' },
        ].map((s) => (
          <div class="flex gap-5">
            <span class="flex-shrink-0 font-bold leading-none" style="font-size: 34px; color: var(--brand-red); font-family: var(--font-heading);">{s.num}</span>
            <div>
              <h3 class="font-semibold mb-2 text-base" style="color: var(--brand-dark);">{s.title}</h3>
              <p class="text-[14px] leading-relaxed" style="color: var(--text-body);">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 为什么选我们：用可核验的差异点替代「服务好质量高」这类空话 -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">客户为什么选择我们</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">不谈虚的，只讲你能验证的四件事。</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {[
          { title: '自有工厂，不是中间商', desc: '深圳宝安自有车间，30 台 CNC 设备含 DMU400 五轴加工中心。加工、质检、出货全部在厂内闭环，出问题能追到机台和批次。' },
          { title: '工程师直接对接，不是客服转单', desc: '报价和工艺问题由工程师回答，不是销售复述。图纸阶段就能告诉你哪里会难加工、哪里能省钱。' },
          { title: '小批量不挑单，1 件也做', desc: '打样、中试、小批量量产是我们的主战场。1 件起做无需开模，几百件也按同一套标准执行。' },
          { title: '报价快，交期说得准', desc: '图纸发给工程师，2 小时内回复工艺方案与报价。定下交期就按节点推进，不用反复催问进度。' },
        ].map((c) => (
          <div class="p-7 rounded-industrial" style="background-color: var(--page-bg); border: 1px solid var(--border-color);">
            <h3 class="font-bold text-lg mb-3" style="color: var(--brand-dark);">{c.title}</h3>
            <p class="text-[15px] leading-relaxed" style="color: var(--text-body);">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 常见问题：FAQ 是长尾词最密集的载体，同时直接回答采购决策前的疑虑 -->
  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">常见问题</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">下单前客户最常问的六件事。</p>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((f) => (
          <details class="rounded-industrial overflow-hidden" style="background-color: var(--card-white); border: 1px solid var(--border-color);">
            <summary class="cursor-pointer px-6 py-5 font-semibold text-base flex items-center justify-between gap-4" style="color: var(--brand-dark);">
              <span>{f.q}</span>
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-[15px] leading-relaxed" style="color: var(--text-body);">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 车间画廊 -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">车间实拍</h2>
        <p class="mt-4 text-lg" style="color: var(--text-muted);">30台CNC设备，五轴加工能力，真实生产车间。</p>
      </div>
