---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: '材料', href: '#' },
];

const metalCategories = [
  {
    name: '铝合金',
    icon: '🔵',
    color: 'from-[#8B0000] to-[#6B0000]',
    image: '/images/materials/materials-aluminum-render-01.webp',
    grades: [
      { grade: '6061-T6', density: '2.70 g/cm³', tensile: '310 MPa', hardness: '95 HB', features: '加工性优良，良好的强度重量比', applications: '高可靠性夹具、散热器、壳体' },
      { grade: '7075-T6', density: '2.81 g/cm³', tensile: '572 MPa', hardness: '150 HB', features: '最高强度铝合金，高可靠性级', applications: '高可靠性结构件、模具、运动器材' },
      { grade: '2024-T3', density: '2.78 g/cm³', tensile: '476 MPa', hardness: '120 HB', features: '高抗疲劳性，良好损伤容限', applications: '飞机结构、机身、机翼组件' },
      { grade: '5052-H32', density: '2.68 g/cm³', tensile: '228 MPa', hardness: '60 HB', features: '优异耐腐蚀性，海洋级', applications: '海洋部件、化工处理' },
    ]
  },
  {
    name: '不锈钢',
    icon: '⚪',
    color: 'from-gray-300 to-gray-500',
    image: '/images/materials/materials-stainless-steel-render-01.webp',
    grades: [
      { grade: '303', density: '7.90 g/cm³', tensile: '620 MPa', hardness: '228 HB', features: '易切削，优异加工性能', applications: '轴、齿轮、紧固件' },
      { grade: '304', density: '7.93 g/cm³', tensile: '515 MPa', hardness: '201 HB', features: '通用型，优异耐腐蚀性', applications: '食品加工、化工、建筑' },
      { grade: '316L', density: '7.99 g/cm³', tensile: '485 MPa', hardness: '217 HB', features: '医疗级，优异耐氯性', applications: '非植入医疗器械、海洋、制药' },
      { grade: '17-4 PH', density: '7.78 g/cm³', tensile: '930 MPa', hardness: '44 HRC', features: '沉淀硬化，高强度', applications: '高可靠性、化工、石油天然气' },
    ]
  },
  {
    name: '铜及铜合金',
    icon: '🟡',
    color: 'from-amber-400 to-amber-600',
    image: '/images/materials/materials-copper-render-01.webp',
    grades: [
      { grade: 'C360 黄铜', density: '8.49 g/cm³', tensile: '400 MPa', hardness: '90 HRB', features: '极优切削性，装饰性表面', applications: '接头、阀门、装饰五金' },
      { grade: 'C110 紫铜', density: '8.94 g/cm³', tensile: '220 MPa', hardness: '70 HRB', features: '最高导电率', applications: '电气触点、母线、换热器' },
      { grade: 'C172 铍铜', density: '8.25 g/cm³', tensile: '1,100 MPa', hardness: '40 HRC', features: '弹性性能，无火花', applications: '弹簧、连接器、防爆工具' },
    ]
  },
  {
    name: '钛合金',
    icon: '🔘',
    color: 'from-slate-400 to-slate-600',
    image: '/images/materials/materials-titanium-render-01.webp',
    grades: [
      { grade: 'Grade 2 (纯钛)', density: '4.51 g/cm³', tensile: '345 MPa', hardness: '20 HRC', features: '纯钛，优异耐腐蚀性', applications: '化工、医疗、海洋' },
      { grade: 'Grade 5 (Ti-6Al-4V)', density: '4.43 g/cm³', tensile: '950 MPa', hardness: '36 HRC', features: '最广泛使用的钛合金，高可靠性级', applications: '高可靠性、非植入医疗器械、赛车' },
      { grade: 'Grade 9', density: '4.51 g/cm³', tensile: '725 MPa', hardness: '30 HRC', features: '优异焊接性，中等强度', applications: '飞机液压、自行车架' },
    ]
  },
  {
    name: '碳钢',
    icon: '⚫',
    color: 'from-zinc-400 to-zinc-600',
    image: '/images/materials/materials-carbon-steel-render-01.webp',
    grades: [
      { grade: '1018', density: '7.87 g/cm³', tensile: '440 MPa', hardness: '126 HB', features: '良好切削性，低成本', applications: '轴、主轴、夹具' },
      { grade: '1045', density: '7.87 g/cm³', tensile: '570 MPa', hardness: '170 HB', features: '中碳钢，可热处理', applications: '齿轮、车轴、曲轴' },
      { grade: '4140', density: '7.85 g/cm³', tensile: '655 MPa', hardness: '197 HB', features: '合金钢，优异韧性', applications: '模架、工装、高应力零件' },
      { grade: '4340', density: '7.85 g/cm³', tensile: '980 MPa', hardness: '30 HRC', features: '超高强度，镍铬合金', applications: '起落架、传动轴' },
    ]
  },
];

const plasticGrades = [
  { grade: 'POM（赛钢）', density: '1.41 g/cm³', tensile: '70 MPa', hardness: '120 HRM', features: '低摩擦，优异尺寸稳定性', applications: '齿轮、轴承、衬套', image: '/images/materials/materials-delrin-render-01.webp' },
  { grade: '尼龙 (PA6)', density: '1.14 g/cm³', tensile: '85 MPa', hardness: '118 HRM', features: '耐磨，抗冲击', applications: '耐磨垫、滚轮、结构件', image: '/images/materials/materials-nylon-render-01.webp' },
  { grade: 'PEEK', density: '1.32 g/cm³', tensile: '100 MPa', hardness: '25 HRM', features: '耐高温（250°C），耐化学', applications: '非植入医疗器械、半导体、高可靠性', image: '/images/materials/materials-peek-render-01.webp' },
  { grade: 'PTFE（铁氟龙）', density: '2.15 g/cm³', tensile: '21 MPa', hardness: 'Shore D 55', features: '最低摩擦系数，化学惰性', applications: '密封件、垫片、绝缘体', image: '/images/materials/materials-ptfe-render-01.webp' },
  { grade: 'UHMW-PE', density: '0.93 g/cm³', tensile: '48 MPa', hardness: 'Shore D 67', features: '极高抗冲击性，食品级', applications: '食品加工、输送带、医疗', image: '/images/materials/materials-uhmw-pe-render-01.webp' },
  { grade: 'PC（聚碳酸酯）', density: '1.20 g/cm³', tensile: '70 MPa', hardness: '120 HRM', features: '高抗冲击性，光学透明', applications: '透明外壳、镜片、防护罩', image: '/images/materials/materials-pc-render-01.webp' },
];

const useFilters = [
  { label: '高强度', icon: '💪', grades: ['7075-T6', '17-4 PH', 'Grade 5', '4340', 'C172'] },
  { label: '轻量化', icon: '🪶', grades: ['6061-T6', '5052-H32', 'Grade 2', 'PEEK', '尼龙'] },
  { label: '耐腐蚀', icon: '🛡️', grades: ['316L', '5052-H32', 'Grade 2', 'PEEK', 'PTFE'] },
  { label: '耐高温', icon: '🔥', grades: ['Grade 5', '17-4 PH', 'PEEK', '4340'] },
];
---

<BaseLayout
  title="材料中心 – 鑫永恒"
  description="CNC加工材料全面指南。铝合金、不锈钢、钛合金、铜合金、碳钢和工程塑料的性能参数与应用领域。"
  breadcrumbs={breadcrumbs}
>
  <!-- 头部 -->
  <section style="background-color: var(--bg-dark); background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 40px 40px;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-5">材料中心</h1>
      <p class="text-lg max-w-3xl" style="color: var(--text-helper);">我们可加工30+种金属和工程塑料。选择以下材料类别查看详细性能参数、牌号和典型应用。</p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="#metals" class="px-5 py-2.5 bg-white/10 backdrop-blur-sm rounded-md text-white text-sm font-medium border border-white/20 hover:bg-white/20 transition-colors">🔩 金属材料</a>
        <a href="#plastics" class="px-5 py-2.5 bg-white/10 backdrop-blur-sm rounded-md text-white text-sm font-medium border border-white/20 hover:bg-white/20 transition-colors">🧪 工程塑料</a>
        <a href="#comparison" class="px-5 py-2.5 bg-white/10 backdrop-blur-sm rounded-md text-white text-sm font-medium border border-white/20 hover:bg-white/20 transition-colors">📊 材料对比</a>
      </div>
    </div>
  </section>

  <!-- 按用途筛选 -->
  <section class="py-12 border-b border-gray-100" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">按用途筛选</h2>
      <div class="flex flex-wrap gap-3">
        {useFilters.map((f) => (
          <div class="px-4 py-2 rounded-lg border border-gray-200 text-sm text-brand-secondary hover:border-[#8B95A1] hover:text-[#8B95A1] transition-colors cursor-default" style="background-color: var(--page-bg);">
            <span class="mr-1.5">{f.icon}</span>{f.label}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 金属材料 -->
  <section id="metals" class="py-20" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-16">
        <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--text-helper);">Metals</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--brand-dark);">金属材料</h2>
        <p class="text-brand-secondary max-w-2xl text-lg">从轻量铝合金到高可靠性级钛合金——为您的应用选择最合适的金属。</p>
      </div>

      {metalCategories.map((cat) => (
        <div class="mb-16 last:mb-0">
          <div class="flex items-center gap-3 mb-8">
            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${cat.color} flex items-center justify-center text-xl shadow-sm`}>{cat.icon}</div>
            <h3 class="text-2xl font-bold" style="color: var(--brand-dark);">{cat.name}</h3>
            {cat.image && (
              <img src={cat.image} alt={`${cat.name}零件3D渲染示意`} class="ml-auto h-20 w-32 object-cover rounded-lg border border-gray-100 hidden sm:block" loading="lazy" />
            )}
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
            {cat.grades.map((g) => (
              <div class="group rounded-xl border border-gray-200 p-6 hover:border-[#8B95A1] hover:shadow-lg transition-all duration-300" style="background-color: var(--card-white);">
                <h4 class="text-lg font-bold mb-3" style="color: var(--brand-dark);">{g.grade}</h4>
                <div class="space-y-2 text-sm">
                  <div class="flex justify-between"><span class="text-brand-silver">密度</span><span class="font-medium" style="color: var(--brand-dark);">{g.density}</span></div>
                  <div class="flex justify-between"><span class="text-brand-silver">抗拉强度</span><span class="font-medium" style="color: var(--brand-dark);">{g.tensile}</span></div>
                  <div class="flex justify-between"><span class="text-brand-silver">硬度</span><span class="font-medium" style="color: var(--brand-dark);">{g.hardness}</span></div>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100">
                  <p class="text-xs text-brand-secondary leading-relaxed mb-1"><span class="font-semibold style="color: var(--brand-dark);"">特点：</span>{g.features}</p>
                  <p class="text-xs text-brand-silver"><span class="font-medium">应用：</span>{g.applications}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 工程塑料 -->
  <section id="plastics" class="py-20" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--text-helper);">Engineering Plastics</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--brand-dark);">工程塑料</h2>
        <p class="text-brand-secondary max-w-2xl text-lg">高性能工程塑料，适用于绝缘、低摩擦、耐化学和轻量化应用场景。</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        {plasticGrades.map((g) => (
          <div class="group rounded-xl border border-gray-200 p-6 hover:border-[#8B95A1] hover:shadow-lg transition-all duration-300" style="background-color: var(--card-white);">
            {g.image && (
              <img src={g.image} alt={`${g.grade}零件3D渲染示意`} class="w-full h-32 object-cover rounded-lg mb-4 border border-gray-100" loading="lazy" />
            )}
            <h4 class="text-lg font-bold mb-3" style="color: var(--brand-dark);">{g.grade}</h4>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-brand-silver">密度</span><span class="font-medium" style="color: var(--brand-dark);">{g.density}</span></div>
              <div class="flex justify-between"><span class="text-brand-silver">抗拉强度</span><span class="font-medium" style="color: var(--brand-dark);">{g.tensile}</span></div>
              <div class="flex justify-between"><span class="text-brand-silver">硬度</span><span class="font-medium" style="color: var(--brand-dark);">{g.hardness}</span></div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <p class="text-xs text-brand-secondary leading-relaxed mb-1"><span class="font-semibold style="color: var(--brand-dark);"">特点：</span>{g.features}</p>
              <p class="text-xs text-brand-silver"><span class="font-medium">应用：</span>{g.applications}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 完整对比表 -->
  <section id="comparison" class="py-20" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--text-helper);">对比</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--brand-dark);">材料对比表</h2>
        <p class="text-brand-secondary max-w-2xl mx-auto text-lg">一目了然的关键性能参数，帮助您选择合适的材料。</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="text-left py-4 px-4 font-bold" style="color: var(--brand-dark);">材料</th>
              <th class="text-left py-4 px-4 font-bold" style="color: var(--brand-dark);">密度</th>
              <th class="text-left py-4 px-4 font-bold" style="color: var(--brand-dark);">抗拉强度</th>
              <th class="text-left py-4 px-4 font-bold" style="color: var(--brand-dark);">硬度</th>
              <th class="text-left py-4 px-4 font-bold" style="color: var(--brand-dark);">核心特点</th>
              <th class="text-left py-4 px-4 font-bold" style="color: var(--brand-dark);">典型应用</th>
            </tr>
          </thead>
          <tbody>
            {metalCategories.map((cat) => cat.grades.map((g) => (
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td class="py-3 px-4"><span class="font-semibold style="color: var(--brand-dark);"">{g.grade}</span><span class="text-xs text-brand-silver ml-2">({cat.name})</span></td>
                <td class="py-3 px-4 text-brand-secondary">{g.density}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.tensile}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.hardness}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.features}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.applications}</td>
              </tr>
            )))}
            {plasticGrades.map((g) => (
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td class="py-3 px-4"><span class="font-semibold style="color: var(--brand-dark);"">{g.grade}</span><span class="text-xs text-brand-silver ml-2">(塑料)</span></td>
                <td class="py-3 px-4 text-brand-secondary">{g.density}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.tensile}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.hardness}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.features}</td>
                <td class="py-3 px-4 text-brand-secondary">{g.applications}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16" style="background-color: var(--bg-dark);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">不确定选哪种材料？</h2>
      <p class="mb-8" style="color: var(--text-helper);">我们的工程师可以为您推荐最适合的材料，兼顾性能、加工性和成本。</p>
      <a href="/zh/contact/get-a-quote" class="inline-flex items-center px-8 py-3.5 bg-[#8B95A1] hover:bg-gray-800 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300">
        获取材料推荐 →
      </a>
    </div>
  </section>
</BaseLayout>
