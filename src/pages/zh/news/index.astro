---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="新闻动态 – 鑫永恒" description="公司里程碑、工厂动态与鑫永恒最新资讯。">

  <!-- Hero -->
  <section class="relative min-h-[300px] flex items-center overflow-hidden">
    <img src="/images/company/cnc-factory-production-floor-machine-rows-02.webp" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(26,26,26,0.85), rgba(100,0,0,0.6));"></div>
    <div class="relative z-10 container-custom py-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">新闻动态</h1>
      <p class="text-lg text-white/80 max-w-2xl">公司里程碑与行业动态。</p>
    </div>
  </section>

  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="space-y-8">

        <div class="card flex flex-col md:flex-row overflow-hidden">
          <div class="md:w-1/3 shrink-0">
            <img src="/images/company/cnc-machinist-operating-control-panel-05.webp" alt="数控操作员在操作面板前作业" class="w-full h-48 md:h-full object-cover" />
          </div>
          <div class="p-8 flex-1 flex flex-col justify-center">
            <div class="text-sm font-medium mb-2" style="color: var(--brand-red);">2026年1月</div>
            <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">ISO 9001:2015 认证办理中</h3>
            <p class="mb-4" style="color: var(--text-body);">鑫永恒正在积极推进ISO 9001:2015质量管理体系认证工作。我们的生产和检测流程正全面对标国际质量标准。</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="container-custom text-center">
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">有项目想合作？</h2>
      <p class="text-lg mb-8" style="color: var(--text-body);">图纸发过来，2 小时内给您回复。</p>
      <a href="/zh/contact/get-a-quote" class="btn-primary text-base px-10 py-4 inline-flex items-center gap-2 group">
        获取报价
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>
