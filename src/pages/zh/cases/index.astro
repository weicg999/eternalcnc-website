---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '案例展示' },
];

const cases = [
  {
    title: 'CNC 加工案例',
    items: ['铣削加工', '钻孔攻牙', '复杂曲面', '一次成型'],
    tolerance: '±0.005mm',
    materials: '铝合金、不锈钢、工程塑料',
  },
  {
    title: '车削件案例',
    items: ['轴类零件', '套类零件', '盘类零件', '高同心度保障'],
    tolerance: '±0.01mm',
    materials: '钢、铝合金、黄铜',
  },
  {
    title: '五轴加工案例',
    items: ['一次装夹五面加工', '异形零件', '零累计误差', '复杂曲面'],
    tolerance: '±0.005mm',
    materials: '铝合金、钛合金、不锈钢',
  },
  {
    title: '汽车零部件案例',
    items: ['发动机零件', '底盘结构件', '传动系统', '电子系统'],
    tolerance: '±0.01mm',
    materials: '铝合金、钢 4140、铸铁',
  },
  {
    title: '医疗器械案例',
    items: ['设备外壳', '精密支架', '诊断设备零件', '严格质控'],
    tolerance: '±0.01mm',
    materials: '不锈钢 316L、钛合金',
  },
  {
    title: '电子零件案例',
    items: ['微型化结构', '高精度壳体', '散热组件', '连接器'],
    tolerance: '±0.005mm',
    materials: '铝合金、黄铜、POM',
  },
  {
    title: '机器人零件案例',
    items: ['关节零件', '减速器壳体', '运动控制部件', '精密装配'],
    tolerance: '±0.005mm',
    materials: '铝合金、钢、工程塑料',
  },
  {
    title: '小批量打样',
    items: ['1-50 件快速响应', '3-7 天交付首件', '全流程跟进', '快速迭代'],
    tolerance: '按图纸',
    materials: '全材料',
  },
  {
    title: '大批量量产',
    items: ['50 件以上稳定量产', '全程 过程质量管控', '质量一致', '按期交付'],
    tolerance: '按图纸',
    materials: '全材料',
  },
];

const highlights = [
  { label: '真实项目复盘', desc: '每个案例均来自实际加工项目，涵盖图纸分析、工艺选择、加工过程及最终成果。' },
  { label: '全流程透明', desc: '从原材料采购到最终检测，完整记录每个环节，客户可随时追溯。' },
  { label: '多行业覆盖', desc: '汽车、医疗、电子、机器人等多个行业案例，展示跨领域加工能力。' },
  { label: '持续改进', desc: '每个项目结束后进行复盘总结，持续优化工艺流程，提升品质与效率。' },
];
---

<PageLayout
  title="案例展示 | 真实加工项目复盘 | Eternal CNC"
  description="CNC加工、车削件、五轴加工、汽车零部件、医疗器械、电子零件、机器人零件等真实案例，从图纸到成品的全流程解析。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">案例展示</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        真实项目，实力见证
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        真实加工项目复盘，从图纸到成品的全流程解析
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/industries/automotive" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:-translate-y-0.5">
          查看行业应用 →
        </a>
      </div>
    </div>
  </section>

  <!-- Cases Grid -->
  <section class="py-20" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">项目案例</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">九大案例分类</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        按加工工艺、行业应用及生产规模分类，展示不同场景下的加工能力。
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cases.map((c) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{c.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {c.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">精密公差</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{c.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">需精加工与检测工序保障，具体以图纸评审为准</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">适用材料</p>
              <p class="text-sm" style="color: var(--text-body);">{c.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 产品照片画廊 -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">零件渲染</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">零件渲染示意</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        以下为渲染示意图，用于展示典型结构、公差与表面处理效果，并非车间实拍照片。
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-complex-aluminum-housing-01.webp" alt="CNC加工复杂铝合金壳体" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">复杂铝合金壳体</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-aluminum-housing-multi-angle-02.webp" alt="铝合金壳体多角度CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">壳体多角度加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-aluminum-bracket-01.webp" alt="渲染铝支架" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">铝支架渲染</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-robotic-bracket-01.webp" alt="渲染机器人臂支架" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">机械臂支架渲染</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-cast-part-cnc-machining-04.webp" alt="复杂铸造零件CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">铸造零件</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-steel-pin-batch-01.webp" alt="渲染钢销批量" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">钢销渲染</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-brass-connector-01.webp" alt="渲染黄铜连接器" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">黄铜连接器渲染</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-lab-fixture-tray-04.webp" alt="精密塑料流体组件" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">塑料流体件</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/energy/cnc-energy-battery-enclosure-03.webp" alt="铝外壳批量生产" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">铝外壳</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/energy/cnc-energy-wind-gearbox-housing-02.webp" alt="风电齿轮箱壳体CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">风电齿轮箱壳体</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-5axis-bracket-01.webp" alt="渲染五轴航空支架" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">五轴支架渲染</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/robotics/cnc-robotics-precision-motion-control-component-04.webp" alt="微型精密零件质检" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">精密运动控制组件</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">案例特色</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">为什么值得参考</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        每个案例都是真实项目的完整记录，帮助您在下单前了解我们的加工水平。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {highlights.map((h) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{h.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background-color: var(--brand-dark);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">查看您的行业案例</h2>
      <p class="text-lg mb-8 text-gray-300">
        上传图纸，获取针对您行业的专业报价及案例参考。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
