---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '知识库', href: '/zh/knowledge' },
  { label: '行业新闻' },
];

const capabilities = [
  {
    title: '2026 精密制造趋势',
    items: ['智能制造与数字化车间加速落地', '国产高端五轴机床市场份额持续提升', '新材料应用推动加工工艺升级'],
    tolerance: '预计 2026 年市场规模突破 5000 亿元',
    materials: '中国精密制造行业趋势报告，含政策解读与市场分析',
    download: { label: '下载完整报告', file: '/downloads/reports/2026-precision-manufacturing-trends-cn.html' },
  },
  {
    title: '五轴机床国产化',
    items: ['国产五轴精度接近进口水平', '关键功能部件（光栅尺、主轴）国产化加速', '价格优势明显，交期缩短 50%'],
    tolerance: '定位精度已达 ±0.005mm 级别',
    materials: '从进口替代到技术输出的进程分析',
    download: { label: '下载完整报告', file: '/downloads/reports/5-axis-localization-cn.html' },
  },
  {
    title: '新能源汽车需求',
    items: ['电驱系统壳体加工精度要求提升', '电池托盘大型化趋势明显', '轻量化材料（铝合金、碳纤维）需求增长'],
    tolerance: '电驱壳体平面度 ≤0.05mm',
    materials: '新能源汽车对精密零件加工的新需求分析',
    download: { label: '下载完整报告', file: '/downloads/reports/ev-parts-demand-cn.html' },
  },
  {
    title: 'ISO 9001 新版解读',
    items: ['ISO 9001:2025 主要变化点', '基于风险的思维进一步强化', '数字化质量管理新要求'],
    tolerance: '过渡期至 2028 年完成换证',
    materials: 'ISO 9001:2025 新版质量管理体系变化解读',
    download: { label: '下载完整报告', file: '/downloads/reports/iso-9001-update-cn.html' },
  },
];

const standards = [
  { label: '行业洞察', desc: '持续关注精密制造行业动态，定期发布趋势分析。' },
  { label: '技术前沿', desc: '跟踪新材料、新工艺、新设备的发展与应用。' },
  { label: '政策解读', desc: '及时解读影响制造业的产业政策与标准变化。' },
  { label: '市场数据', desc: '基于公开数据和企业调研，提供客观的市场分析。' },
];
---

<PageLayout
  title="CNC行业新闻 | 精密制造趋势·五轴国产化·政策解读 | Eternal CNC"
  description="Eternal CNC 行业新闻——2026 精密制造趋势报告、五轴机床国产化进程、新能源汽车零件需求、ISO 9001:2025 新版解读。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">知识库</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        行业新闻
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        CNC 制造行业动态、技术趋势与市场洞察
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">行业动态</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">最新资讯</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        覆盖行业趋势、技术前沿、政策变化及市场分析。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">关键数据</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">核心内容</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
              {cap.download && (
                <a
                  href={cap.download.file}
                  download
                  class="inline-flex items-center mt-4 text-sm font-semibold transition-colors hover:underline"
                  style="color: var(--brand-red);"
                >
                  <span class="mr-2">↓</span>
                  {cap.download.label}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">内容编制标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        确保每篇行业报道的数据准确、观点客观。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">关注精密制造最新动态</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        联系我们的团队，获取行业报告及技术支持。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
