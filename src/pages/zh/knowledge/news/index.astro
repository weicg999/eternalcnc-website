---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '知识库', href: '/zh/knowledge' },
  { label: '行业新闻' },
];

const archive = [
  {
    number: '02',
    date: '2026 年 9 月 18 日',
    title: '这一期，厂里看到的——九月中',
    blurb: '工业机器人 +34.6% 而减速器掉队、UBTECH 万台工厂、中国首部液冷国标、以及零部件层已经落地的量产订单。',
    href: '/zh/knowledge/news/issue-02/',
    latest: true,
  },
  {
    number: '01',
    date: '2026 年 9 月 11 日',
    title: '这一期，厂里看到的——九月初',
    blurb: '人形机器人量产、AI 服务器液冷从可选变标配、机床行业利润翻倍——每一条都附「对零件意味着什么」那一句。',
    href: '/zh/knowledge/news/issue-01/',
    latest: false,
  },
];

const nextIssue = '2026 年 9 月 25 日';
---

<PageLayout
  title="行业新闻·厂里视角 | Eternal CNC"
  description="鑫永恒战略顾问组的阅读清单：厂里看到的 CNC 行业信号——往期关于机器人、液冷、机床的选题，以及每条对你送来的零件意味着什么。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">行业新闻</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        厂里看到的——往期合集
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        鑫永恒战略顾问组的每周阅读清单——只放那些会改变你本季度该往哪投零件的条目。每一期都带一句「对零件意味着什么」。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          去技术博客 →
        </a>
      </div>
    </div>
  </section>

  <!-- Issue list -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">全部期数</p>
      <div class="space-y-6">
        {archive.map((it) => (
          <a href={it.href} class="block p-8 border rounded-2xl transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">第 {it.number} 期</span>
              <span class="text-xs" style="color: var(--text-muted);">{it.date}</span>
              {it.latest && (
                <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--brand-red); color: #ffffff;">最新</span>
              )}
            </div>
            <h2 class="text-2xl font-bold mb-3 leading-snug" style="color: var(--brand-dark);">{it.title}</h2>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{it.blurb}</p>
            <p class="text-sm font-medium" style="color: var(--brand-red);">读第 {it.number} 期 →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Next issue -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
        <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">下一期</p>
        <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">{nextIssue}</h3>
        <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
          正在跟进的线索：九月数据里减速器产量是否回暖、冷板厂怎么备战 2027 年 2 月的液冷国标、以及本季度刚投产工厂的第一批出货数据。
        </p>
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          把你的下个零件发过来
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">手上有个零件？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        STEP 和 PDF 发过来，工作日 2 小时内报价；公差合不合理，我们也直说。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          浏览技术博客 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
