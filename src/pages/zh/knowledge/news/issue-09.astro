---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '知识库', href: '/zh/knowledge/' },
  { label: '行业新闻' },
];

const issue = {
  label: '第',
  number: '09',
  date: '2026 年 11 月 13 日',
  blurb: '车间里注意到的五件事 —— 以及它们对您送来的零件意味着什么。',
};

const kpis = [
  { metric: '7.9%', label: '2026 年 10 月全国工业生产者购进价格同比涨幅。同月出厂价格同比上涨 5.7%（涨幅比上月扩大 0.7 个百分点），购进价格环比上涨 1.1%。1—10 月平均，出厂价涨 2.7%，购进价涨 4.0%——买进来的比卖出去的贵，这个差额落在加工环节。', source: '国家统计局，《2026 年 10 月份工业生产者出厂价格同比上涨 5.7% 环比上涨 0.7%》，2026 年 11 月 9 日。' },
  { metric: '16.81 万亿元', label: '2026 年前 10 个月中国机电产品出口额，同比增长 25.2%，占同期出口总值的 64.7%，比重比去年同期提高 3.9 个百分点。同期全商品出口 25.99 万亿元，同比增长 17.6%。机电出口规模已超过 2025 年全年水平。', source: '海关总署，2026 年 11 月 10 日发布；中国机电产品进出口商会同期统计。' },
  { metric: '1.5 万小时', label: '北京市对高精度减速器提出的额定寿命攻关目标。同一份文件还给出整机口径：平均无故障工作时间超过 2000 小时、核心运动部件与末端执行器年故障率低于 10%、整机设计寿命超 5 年。这是规划目标，不是现行强制标准，但它第一次把可靠性写成了可考核的数字。', source: '北京市经济和信息化局，《北京市具身智能机器人产业高质量发展行动方案（2026—2028 年）》（京经信发〔2026〕54 号），2026 年 11 月 11 日。' },
];

const stories = [
  {
    tag: '宏观 / 价格',
    date: '2026-11-09',
    title: '10 月出厂价涨 5.7%，可你卖的金属件只涨 1.7%',
    summary: '国家统计局 11 月 9 日发布 10 月工业生产者价格：出厂价格同比上涨 5.7%，涨幅比上月扩大 0.7 个百分点，环比上涨 0.7%；购进价格同比上涨 7.9%，环比上涨 1.1%。拆开看结构比总量刺眼得多——生产资料同比涨 7.4%，其中采掘工业涨 27.9%、原材料工业涨 11.6%，而加工工业只涨 3.5%。购进端，燃料动力类涨 18.6%、化工原料类涨 16.8%、有色金属材料及电线类涨 16.7%；出厂端，有色金属冶炼和压延加工业涨 18.6%，可金属制品业只涨 1.7%，通用设备制造业还是 −0.3%，汽车制造业 −1.8%。同一天公布的 10 月 CPI 同比涨 0.7%、环比持平。1—10 月平均：出厂价涨 2.7%，购进价涨 4.0%。',
    what_it_means: '这是本期最该盯的一组数——买进来的有色金属材料同比贵了 16.7%，卖出去的金属制品只贵了 1.7%，中间约 15 个百分点没有任何人替你补。落在报价单上就三件事：材料按报价当日牌价计、报价有效期从一个月收到两周、超过三个月的单必须写浮动条款或锁价。反过来看，通用设备 −0.3%、汽车 −1.8%，说明下游整机厂自己也在降价，他们压价不是针对你，是他们在别处也补不回来——这种时候接长单，等于替两头扛。',
    source: '国家统计局，2026 年 10 月份工业生产者价格指数发布稿及主要数据表，2026 年 11 月 9 日。',
  },
  {
    tag: '宏观 / 出口',
    date: '2026-11-10',
    title: '前 10 个月机电出口 16.81 万亿元，可工业机器人只涨 17.8%，集成电路涨了 101.9%',
    summary: '海关总署 11 月 10 日发布：前 10 个月货物贸易进出口 44.81 万亿元，同比增长 20%；出口 25.99 万亿元增 17.6%，进口 18.82 万亿元增 23.6%。10 月单月进出口 4.87 万亿元增 31.2%，其中出口 2.79 万亿元增 28.7%、进口 2.08 万亿元增 34.7%。机电产品前 10 个月出口 16.81 万亿元，增 25.2%，占出口总值 64.7%，比重比去年同期提高 3.9 个百分点。分品类差距悬殊：集成电路 +101.9%、存储部件 +132.5%、3D 打印机 +104.8%、数字照相机 +41.4%，而工业机器人只 +17.8%；「新三样」+46.5%、风力发电机组及其零件 +19.7%。中国机电产品进出口商会同期口径：10 月当月机电出口 2779.8 亿美元、增 46.2%，其中通用机械设备 +34.6%、汽车零配件 +32.1%、汽车整车 +37.7%。加工贸易进出口增 28.4%，保税物流增 44.1%。',
    what_it_means: '出口增量在「电」不在「机」。同样叫机器人相关，本体出口只涨 17.8%，给算力配套的集成电路和存储涨了一倍多——今年真正在放量的是服务器、光模块、电源这一侧的结构件，不是机器人本体外壳。你手上的询价单如果两类都有，会发现它们的表面处理和公差要求差一档：服务器件多是铝、大面积、多面孔系、要导电氧化或镀镍；机器人件多是不锈钢和钛的小件、要薄壁和配合面。同一台机、同一批人，报价不能用同一套系数——按类别分开算工时，比统一打折准得多。',
    source: '海关总署，《前 10 个月我国外贸增长 20% 保持强劲增长态势》，2026 年 11 月 10 日；中国机电产品进出口商会，2026 年 11 月 11 日行业统计。',
  },
  {
    tag: '机器人 / 准入',
    date: '2026-11-11',
    title: '北京把「无故障 2000 小时、减速器寿命 1.5 万小时」写进政策，还要求样品 1—2 天交付',
    summary: '北京市经济和信息化局 11 月 11 日印发《北京市具身智能机器人产业高质量发展行动方案（2026—2028 年）》。目标是到 2028 年培育不少于 5 家国际一流、10 家国内领先的人形机器人整机企业，京津冀整机产能占全国 25%、关键零部件配套率超 60%，在京形成 20 万台/年整机制造能力。首次把可靠性写成可考核的数字：整机额定负载达自重 40% 以上、平均无故障工作时间超过 2000 小时、核心运动部件与末端执行器年故障率低于 10%、整机设计寿命超 5 年、连续作业续航 4 小时以上；零部件侧点名扭矩密度 60 牛米/千克的电机、额定寿命 1.5 万小时以上的高精度减速器、单只成本万元以内的高自由度灵巧手。配套措施里有一条直接对着加工环节：在京津冀建设不少于 10 个具备结构件加工、表面处理及热处理、SMT 贴片、线束制造等快速响应能力的共享加工平台，支撑零部件设计变更后的样品交付时间缩短至 1—2 天。',
    what_it_means: '1.5 万小时按 24 小时连续折算约 625 天，接近一年零九个月不停机。这个数在打样阶段测不出来——三件样品跑一周都合格，跟能不能跑到一万五千小时是两件事，中间差的是材料炉批、热处理曲线和形位公差的批间稳定性。所以真正会变的是客户问的问题：从「这个尺寸能不能做到」变成「你的 Cpk 多少、热处理谁做的、能不能给炉批号」。第二件事更要紧：「样品 1—2 天」被写进了政策，等于把打样交期的行业基准往前推了一格；我们现在的三到五天，客户以后会拿这条来比。这不是要不要降价的问题，是接单资格的问题。',
    source: '北京市经济和信息化局，京经信发〔2026〕54 号，2026 年 11 月 11 日；中国青年报客户端同日报道。',
  },
  {
    tag: '机床业 / AI（本期 AI 主线）',
    date: '2026-11-11',
    title: '机床开始自己改参数：华中10型内置 AI 算力跑大模型，已在 100 余台套上验证',
    summary: '上海证券报 11 月 11 日报道，华中数控自主研发的华中10型智能数控系统采用「一个智能底座、两条数字主线、三个智能应用子系统」架构，内置 AI 算力并部署 DeepSeek 等大语言模型，使机床具备自主感知、自主学习、自主决策和自主执行能力；据公司 9 月投资者活动记录，该系统已在 100 余台（套）机床上开展适配验证，并入选工业和信息化部 2026 年度工业母机创新产品典型案例。业绩同向：华中数控三季报显示第三季度营收 4.45 亿元、同比增 34.92%，归母净利润 5389.89 万元、同比增 145.54%；前三季度数控系统与机床板块收入 8.29 亿元、同比增 45.34%。另一端是订单结构：创世纪三季报显示前三季度营收 54.47 亿元、同比增 42.38%，归母净利润 5.76 亿元、同比增 65.60%，新签订单 78.21 亿元、同比增 77.22%，其中 AI 硬件（含液冷、光模块）新签订单 19.97 亿元、占总订单 25.54%，成为第一大来源；新能源 11.11 亿元、具身机器人 4.67 亿元。浙海德曼前三季度营收 8.46 亿元、同比增 39.14%，归母净利润同比增 126.68%，公司口径是国产化替代与机器人零部件加工需求同时释放。',
    what_it_means: '机床业的两头同时被 AI 改了。一头是控制系统：机床不再只是执行你编好的程序，它会在切削中自己调进给和转速；另一头是订单表：买机床的人把新订单的四分之一投向了液冷和光模块。对送件的客户来说，第一头带来一个新要求——件是谁做的、用什么参数做的，会开始被追问。以前小批量厂的优势是「师傅手感好」，往后这个优势得能写下来：参数库、刀具寿命记录、关键尺寸的过程数据。一份带主轴负载曲线的首件报告，在比价时可能比再降三个点更有用。要先建的，不是第五台五轴，是那套记录。',
    source: '上海证券报，《AI 赋能叠加新兴需求 工业母机行业迎来双重机遇》，2026 年 11 月 11 日（记者丁鹏）；数据转述自华中数控、创世纪、浙海德曼三季报与华中数控 9 月投资者活动记录。',
  },
  {
    tag: '液冷',
    date: '2026-11-09',
    title: '格力中标 3 亿元温控集采，但那一单是风冷；液冷的大批量还在共研阶段',
    summary: '证券日报 11 月 9 日报道，格力电器 11 月 7 日发布信息，中标中国移动、中国铁塔温控设备集中采购项目，订单规模超过 3 亿元，中标产品为风冷型氟泵机房专用空调、冷冻水型列间空调、干湿复合机房空调、基站专用空调。同篇报道里，美的集团 2026 年半年报口径显示其液冷布局已覆盖冷源、冷却液分配单元（CDU）、液冷末端及数字化运维；今年上半年在佛山顺德启动液冷智造基地，总投资超 10 亿元，预计 2027 年投产。美的楼宇科技研发中心总监罗彬对记者的表述是：全栈液冷产品「已全面进入国内外大厂的共研项目，后续产品落地及大规模出货可能要到明后年」。',
    what_it_means: '把两条放在一起看，液冷这条线的钱现在分两段，而且不在同一段。3 亿元那一单是机房空调和基站空调，不是液冷；液冷本身还停在「共研加小批交付」，量产窗口要等 2027 年那批基地投产。对加工厂的实际含义是：今年能立刻接到的液冷件，主要是打样与小批结构件——机箱、支架、接口板、测试假负载、产线工装；大批量冷板和钣金件现在是家电系和笔电结构件厂的战场，冲压线一开就是百万级，那个成本结构我们打不过。所以这一段该做的不是抢量产价，是把打样和小批做成可复用的记录：每次设计变更跟到底，把对方的公差习惯和材料偏好摸清。等 2027 年那批线开起来，能直接接的还是那个已经跟过三轮变更的人。',
    source: '证券日报网，《家电企业拓展数据中心温控业务 加快液冷产品与产能布局》，2026 年 11 月 9 日。',
  },
];

const faqs = [
  { q: '这个栏目多久更新一次？', a: '每周。我们不追新闻流，只做阅读清单，而且只收会改变采购方这个季度该怎么做的那几条。' },
  { q: '这些数字从哪来？', a: '只引一手：国家统计机构、海关、行业协会、标准机构、公司公告，以及有署名的报道。券商观点不作为事实转述。' },
  { q: '为什么是车间视角，不是市场报告？', a: '市场报告告诉你风往哪吹，车间视角告诉你活到底有没有落地。每条都有一个「对零件意味着什么」，那部分是我们负责的。' },
];

const related = [
  { label: '60 款散件，10 天交样——鑫永恒，你准备好了吗？', href: '/zh/knowledge/tech-blog/sixty-skus-ten-days/' },
  { label: '报价单的问法变了：灵巧手正在从「买一台试试」走到「按件报」', href: '/zh/knowledge/tech-blog/dexterous-hand-rfq-signal/' },
  { label: '小厂交期为什么不准', href: '/zh/knowledge/tech-blog/why-lead-times-slip/' },
  { label: '公差不是越紧越好：什么尺寸值得花钱', href: '/zh/knowledge/tech-blog/which-dimensions-deserve-tight-tolerance/' },
];
---

<PageLayout
  title="CNC 精密零件加工厂的行业观察 · 第 09 期 | Eternal CNC"
  description="2026 年 11 月中：出厂价涨 5.7% 而金属制品只涨 1.7%；前 10 个月机电出口 16.81 万亿元、工业机器人仅增 17.8%；北京把 2000 小时无故障和 1—2 天出样写进政策；华中10型数控系统内置大模型；格力 3 亿元温控集采全是风冷。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">行业新闻 — {issue.label} {issue.number} 期</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        这一期，厂里看到的几件事
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        {issue.blurb} 鑫永恒战略顾问组 执笔，{issue.date} 发布。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote/" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          去技术博客 →
        </a>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section style="background-color: var(--page-bg); padding: 48px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">这一期值得记的三个数</p>
      <div class="grid md:grid-cols-3 gap-6">
        {kpis.map((k) => (
          <div class="p-6 border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <p class="text-3xl md:text-4xl font-bold mb-2" style="color: var(--brand-dark);">{k.metric}</p>
            <p class="text-sm mb-3" style="color: var(--text-body);">{k.label}</p>
            <p class="text-xs" style="color: var(--text-muted);">来源：{k.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">五件事</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">发生了什么，我们觉得它意味着什么</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        先讲新闻，再讲那一句要紧的——它对送件给机加厂的客户意味着什么。
      </p>
      <div class="space-y-6">
        {stories.map((s) => (
          <article class="p-8 border rounded-2xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">{s.tag}</span>
              <span class="text-xs" style="color: var(--text-muted);">{s.date}</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 leading-snug" style="color: var(--brand-dark);">{s.title}</h3>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{s.summary}</p>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">对零件意味着什么</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{s.what_it_means}</p>
            </div>
            <p class="text-xs mt-4" style="color: var(--text-muted);">来源：{s.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards / FAQs -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">我们怎么写</p>
      <h2 class="text-3xl font-bold mb-12" style="color: var(--brand-dark);">常被问到的三件事</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {faqs.map((f) => (
