---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '知识库', href: '/zh/knowledge' },
  { label: '白皮书' },
];

const capabilities = [
  {
    title: 'ISO 2768-m 公差解析',
    items: ['ISO 2768-f（精密级）适用范围', 'ISO 2768-m（中等级）常规加工', 'GB/T 1804 国标对照及差异说明'],
    tolerance: '线性尺寸 / 角度 / 形位公差全覆盖',
    materials: '帮助设计师合理标注公差，避免过度要求',
  },
  {
    title: '铝合金切削对比',
    items: ['6061-T6 通用结构件加工特性', '7075-T6 高可靠性级高强度切削', '切削速度、进给率及刀具寿命对比'],
    tolerance: '表面粗糙度 Ra 0.4~1.6μm 可达',
    materials: '6061 vs 7075 切削性能与表面质量全面对比',
  },
  {
    title: '表面处理选型',
    items: ['阳极氧化：装饰性 + 耐磨', '镀镍：导电性 + 耐蚀', '达克罗：环保型防腐涂层', '喷砂：均匀哑光纹理'],
    tolerance: '膜厚控制精度 ±2μm',
    materials: '阳极氧化 / 镀镍 / 达克罗 / 喷砂工艺对比',
  },
  {
    title: '五轴误差补偿',
    items: ['RTCP 运动学标定方法', '热变形误差补偿模型', '刀具磨损在线监测与补偿'],
    tolerance: '补偿后精度提升 30%~50%',
    materials: '五轴联动 kinematics 误差补偿与精度验证方法',
  },
];

const standards = [
  { label: '数据来源', desc: '所有技术数据均来自实际加工验证，非理论推算。' },
  { label: '同行评审', desc: '白皮书发布前经工艺工程师和质量团队双重审核。' },
  { label: '定期更新', desc: '根据新材料、新工艺持续更新技术内容，确保时效性。' },
  { label: '免费下载', desc: '完整版白皮书可联系客服获取，用于内部技术参考。' },
];
---

<PageLayout
  title="CNC加工技术白皮书 | 公差标准·材料对比·表面处理 | Eternal CNC"
  description="Eternal CNC 深度技术白皮书——ISO 2768-m 公差解析、铝合金切削对比、表面处理选型指南、五轴误差补偿方法。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">知识库</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        白皮书
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        深度技术报告，助力您的工程设计决策
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">技术报告</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">精选白皮书</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        覆盖公差标准、材料选型、表面处理及五轴加工等核心技术领域。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">覆盖范围</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">核心内容</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">白皮书编制标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        严格的数据来源和审核流程，确保技术内容准确可靠。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">需要完整版白皮书？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        联系我们的工程师，获取完整技术报告及选型建议。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold" style="background-color: var(--brand-red); color: var(--card-white);">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border" style="border-color: rgba(255,255,255,0.3); color: var(--card-white);">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
>
</PageLayout>
