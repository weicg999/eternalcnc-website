---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: '知识库', href: '/zh/knowledge' },
  { label: '技术博客' },
];

const allPosts = (await getCollection('zhBlog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const CATEGORY_META: Record<string, { desc: string }> = {
  加工技巧: { desc: '刀具路径、装夹、深孔、高光面参数——来自一线的实战经验。' },
  选材指南: { desc: '什么零件该用什么料、怎么降本——帮您真正做出决策。' },
  工艺案例: { desc: '真实项目、真实数据：我们怎么把工序、周期和成本降下来。' },
  行业洞察: { desc: '五轴普及、智能制造、新能源与机器人的新需求。' },
};
const categoryOrder = ['加工技巧', '选材指南', '工艺案例', '行业洞察'];

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });

const CAT_STYLE: Record<string, string> = {
  加工技巧: 'background:#8B0000;color:#fff;',
  选材指南: 'background:#1A1A1A;color:#fff;',
  工艺案例: 'background:#4A4A4A;color:#fff;',
  行业洞察: 'background:#6B0000;color:#fff;',
};
---

<BaseLayout
  title="CNC加工技术博客 | 加工技巧·材料选型·工艺优化 | 鑫永恒"
  description="鑫永恒技术博客——CNC 加工技巧、材料选型指南、工艺优化案例、行业发展观察，来自一线工程师的实战经验分享。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">知识库</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC 加工技术博客
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        加工技巧、选材指南与工艺优化深度文章——由我们的工程师从真实项目中写出来。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          咨询工程师
        </a>
        <a href="#latest" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          浏览文章 ↓
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section id="latest" style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">最新文章</p>
      <h2 class="text-3xl font-bold mb-2" style="color: var(--brand-dark);">车间一线，新鲜出炉</h2>
      <p class="mb-10 max-w-2xl" style="color: var(--text-muted);">
        持续更新中，目前已发布 {allPosts.length} 篇。
      </p>

      {allPosts.length === 0 ? (
        <div class="p-12 text-center border rounded-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
          <p class="font-medium" style="color: var(--brand-dark);">文章即将上线。</p>
          <p class="text-sm mt-1" style="color: var(--text-muted);">工程师们正在撰写中，敬请期待。</p>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 gap-6">
          {allPosts.map((p) => (
            <a href={`/zh/knowledge/tech-blog/${p.slug}/`} class="group flex flex-col p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
              <div class="flex items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full" style={CAT_STYLE[p.data.category] || 'background:#8B0000;color:#fff;'}>{p.data.category}</span>
                <span class="text-xs" style="color: var(--text-muted);">{fmt(p.data.pubDate)}</span>
                {p.data.readingTime && <span class="text-xs" style="color: var(--text-muted);">· {p.data.readingTime}</span>}
              </div>
              <h3 class="text-xl font-bold leading-snug mb-2 group-hover:text-[#8B0000] transition-colors" style="color: var(--brand-dark);">{p.data.title}</h3>
              <p class="text-sm leading-relaxed mb-4 flex-1" style="color: var(--text-body);">{p.data.description}</p>
              <span class="text-sm font-semibold" style="color: #8B0000;">阅读全文 →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 内容分类 -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">内容分类</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">四大技术内容方向</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        从实战技巧到行业洞察，全面覆盖 CNC 加工技术。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {categoryOrder.map((cat) => {
          const count = allPosts.filter((p) => p.data.category === cat).length;
          const firstSlug = allPosts.find((p) => p.data.category === cat)?.slug;
          return (
            <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
              <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">{cat}</h3>
              <p class="text-sm mb-4 leading-relaxed" style="color: var(--text-body);">{CATEGORY_META[cat].desc}</p>
              {count > 0 ? (
                <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-full" style="background:#8B0000;color:#fff;">已发布 {count} 篇</span>
              ) : (
                <span class="text-xs font-medium" style="color: var(--text-muted);">即将上线——工程师们正在此分类下撰写。</span>
              )}
              {count > 0 && firstSlug && (
                <a href={`/zh/knowledge/tech-blog/${firstSlug}/`} class="block mt-4 text-sm font-semibold hover:underline" style="color: #8B0000;">阅读最新一篇 →</a>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">有想了解的技术话题？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        告诉我们你想了解的主题——我们会写成专题文章，或直接为你解答。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          咨询工程师
        </a>
        <a href="/zh/knowledge" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          返回知识库 →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
