---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '知识库', href: '/zh/knowledge' },
  { label: '常见问题' },
];

const faqs = [
  {
    q: '最低起订量（MOQ）是多少？',
    a: '我们支持打样（1 件起）和批量生产。没有严格的最低起订量要求 — 小批量起步，后续根据项目需求逐步扩大，我们都很乐意配合。'
  },
  {
    q: '报价接受哪些文件格式？',
    a: '我们接受 STEP、IGES、STL、PDF（2D 图纸）以及 SolidWorks、Creo、CATIA 的原生格式。最快的报价方式是提供 3D 模型（首选 STEP）加上标注关键公差的 2D PDF 图纸。'
  },
  {
    q: '多久能收到报价？',
    a: '大多数报价在 24 小时内交付。涉及多个零件或紧密公差的复杂项目可能需要 48 小时进行详细的工程评审。'
  },
  {
    q: '标准交期是多长？',
    a: '打样：3–5 个工作日。小批量：7–10 个工作日。量产：15–25 个工作日。可接受加急订单 — 如有紧急需求请联系我们。'
  },
  {
    q: '出货时是否附带检测报告？',
    a: '是的。每批出货均附合格证书（COC）及发货前最终照片；尺寸检测报告、材料证书（EN 10204 3.1）可按需提供。如需 RoHS、REACH 等额外文件，亦可申请。'
  },
  {
    q: '能加工哪些材料？',
    a: '我们可加工 30+ 种材料，包括铝合金（6061、7075）、不锈钢（303、304、316L）、钢（1018、4140）、钛合金、铜/黄铜以及工程塑料（Delrin、尼龙、PEEK、PTFE）。'
  },
  {
    q: '能保持什么公差？',
    a: '标准公差为 ±0.05mm（ISO 2768-m）。可按要求保持 ±0.01mm 或更紧公差。配合磨削加工可达到 Ra 0.2μm 的表面粗糙度。'
  },
  {
    q: '是否提供表面处理服务？',
    a: '是的。我们支持阳极氧化、喷砂、电镀、粉末喷涂、钝化、热处理等。所有表面处理均在内部协调完成，确保质量控制。'
  },
  {
    q: '是否通过了 ISO 认证？',
    a: '我们严格执行质量管理标准，相关认证体系正在完善中。'
  },
  {
    q: '可以参观工厂吗？',
    a: '当然可以。我们欢迎工厂参观 — 请提前联系我们，以便安排车间和检测实验室的参观。'
  },
  {
    q: 'Eternal CNC 与鑫永恒是什么关系？',
    a: '鑫永恒（深圳）精密实业有限公司是我们在华注册的法定主体，Eternal CNC 是面向全球客户运营的国际品牌。同一支团队、同一间车间——只是官网上你看到的名字不同。'
  },
  {
    q: '贵司从事精密加工多久了？',
    a: '我们集团自 2003 年进入制造领域，自 2011 年起专注 CNC 精密加工。为支持全球品牌建设，现行法定主体鑫永恒（深圳）精密实业有限公司于 2024 年完成注册。所以虽然公司名称较新，车间的加工积淀早已成熟。'
  },
  {
    q: '你们是工厂还是贸易公司？',
    a: '我们是工厂直营的 CNC 加工车间，不是贸易公司。厂内自有 2.5D 影像仪与精密量具；桥式三坐标（CMM）检测通过集团共享计量中心按需送检。这样成本与质量都掌握在我们自己手中。'
  },
  {
    q: '为什么官网上看不到你们合作过的客户或案例？',
    a: '坦白说，这正是我们过去“重手艺、轻经营”留下的痕迹。我们早年的订单很大一部分来自国内贸易公司——我们做的是幕后的精密加工，而不是在台前经营品牌。\n\n我们的负责人是工程师出身，早年把精力都放在“如何把一个零件做到位”上，对营销和经营确实投入得少。现在时代不一样了，我们也意识到：光靠手上的手艺还不够，还得靠经营把价值传递出去——官网就是我们转型的第一步。\n\n另外要说明的是，我们长期做的是非标定制件，其中相当一部分都签有保密协议（NDA）。按约定，客户名称、图纸和成品照片都不能公开。这不是我们刻意回避，而是守约。\n\n不过，在那些未签保密协议的非标件里，有一部分是可以展示的。我们整理了一部分可公开的零件实物照片（产品图集），标注材料、工艺与表面处理——不编客户名、不编公差，所见即真实。'
  },
];

// FAQPage 结构化数据（与英文版对齐，便于中文搜索引擎 / GEO 收录）
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const standards = [
  { label: '快速响应', desc: '工作日 24 小时内回复所有技术咨询，复杂问题 48 小时内给出详细方案。' },
  { label: '透明报价', desc: '报价单包含材料费、加工费、表面处理费及运费明细，无隐藏费用。' },
  { label: '全程追溯', desc: '从原材料到成品出货，每道工序均有记录，支持扫码查询。' },
  { label: '售后保障', desc: '质量问题免费返工或补发，运费由我方承担。' },
];
---

<PageLayout
  title="常见问题 | CNC加工MOQ·报价·交期·材料·公差 | Eternal CNC"
  description="关于 Eternal CNC 加工服务的常见问题：起订量、报价格式、交期、检测报告、材料、公差、表面处理、工厂参观等。"
  breadcrumbs={breadcrumbs}
  schema={faqSchema}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">知识库</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        常见问题
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        关于与 Eternal CNC 合作的一切常见疑问。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ List -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">常见问题</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">合作常见疑问</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        涵盖起订量、报价、交期、材料、公差及质量检测等核心问题。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {faqs.map((faq) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{faq.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">服务保障承诺</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        从咨询到交付，全流程透明可控。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">还有其他问题？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        我们的团队随时为您解答。欢迎随时联系。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
