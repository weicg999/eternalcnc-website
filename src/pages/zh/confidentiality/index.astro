---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '公司', href: '/zh/about' },
  { label: '保密政策' },
];

const protections = [
  {
    title: '技术图纸',
    desc: '2D/3D CAD 文件、PDF、STEP、IGES 等所有设计格式，均视为严格保密信息。',
  },
  {
    title: '材料规格',
    desc: '材料牌号、公差要求、表面处理参数及专有成分，绝不对外共享。',
  },
  {
    title: '订单与价格',
    desc: '订单数量、单价信息、付款条款及所有商务细节，始终保密。',
  },
  {
    title: '定制工装',
    desc: '定制工装设计方案、夹具方案及专有制造工艺，全程保护。',
  },
];

const measures = [
  {
    title: '加密存储',
    desc: '所有客户文件存储在加密服务器上，仅限授权人员访问。',
  },
  {
    title: '权限管控',
    desc: '基于角色的访问控制确保仅项目团队成员可查看您的文件，全程审计日志。',
  },
  {
    title: '保密协议',
    desc: '可根据需求签署双向保密协议（NDA），在接收任何文件之前完成签署。',
  },
  {
    title: '员工培训',
    desc: '全员每年完成保密培训，违规行为立即解除劳动合同。',
  },
];
---

<PageLayout
  title="数据保密政策 – 鑫永恒精密CNC加工"
  description="了解鑫永恒（深圳）精密实业有限公司如何通过严格的保密措施、NDA协议和加密存储保护您的技术图纸、规格参数和知识产权。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">保密政策</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        数据保密政策
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        您的设计就是您的竞争优势，保护它们是我们的义务。
        我们对待每一份文件、每一个尺寸、每一项规格，都以最高标准严格保护。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded-md transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- 我们保护什么 -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">保护范围</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">我们保护什么</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        您分享给我们的一切信息，默认均为保密信息，无例外。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {protections.map((item) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-3" style="color: var(--brand-dark);">{item.title}</h3>
            <p style="color: var(--text-body);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 我们如何保护 -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">安全措施</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">我们如何保护</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        我们的保密协议贯穿于运营的每一个环节。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {measures.map((item) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{item.title}</h3>
            <p class="text-sm" style="color: var(--text-body);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">需要可靠的保密制造伙伴？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        在签署保密协议后上传您的图纸。我们的工程师将在 24 小时内提供报价和 DFM 反馈。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取免费报价
        </a>
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border rounded-lg border-white/30 text-white transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          免费 DFM 评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
