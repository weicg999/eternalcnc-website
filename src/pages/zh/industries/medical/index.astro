---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '行业应用', href: '/zh/industries' },
  { label: '医疗器械' },
];

const capabilities = [
  {
    title: '诊断设备外壳',
    items: ['超声探头壳体', '血液分析仪面板', 'CT机架零件', '试剂仓'],
    tolerance: '±0.01mm',
    materials: '铝合金 6061、ABS赛钢、PC',
  },
  {
    title: '手术器械零件',
    items: ['手柄壳体', '刀头座', '夹钳关节件', '导向销'],
    tolerance: '±0.005mm',
    materials: '不锈钢 304/316L、钛合金',
  },
  {
    title: '夹具与固定件',
    items: ['医疗装配夹具（非植入件）', '样品托盘', '定位治具', '校准块'],
    tolerance: '±0.01mm',
    materials: '铝合金、PEEK、POM',
  },
  {
    title: '监护仪支架',
    items: ['显示器支架臂', '万向节', '底座零件', '散热壳体'],
    tolerance: '±0.02mm',
    materials: '铝合金、锌合金',
  },
];

const standards = [
  { label: '生物相容性材料追溯', desc: '医用级材料（PEEK、钛合金、316L 不锈钢）提供 ISO 10993 生物相容性证明及批次追溯。' },
  { label: '无尘装配环境', desc: '洁净车间装配，满足医疗级零件的清洁度要求。' },
  { label: '全流程洁净管控', desc: '从原材料入库到成品出库，全程防尘防污。' },
  { label: '尺寸检验报告', desc: '三坐标检测报告由集团共享计量中心提供，关键尺寸按需全检，确保符合设计图纸。' },
];
---

<PageLayout
  title="医疗器械精密零件 | 诊断设备·手术器械·监护仪 | Eternal CNC"
  description="为医疗器械企业提供精密CNC加工服务——诊断设备外壳、手术器械零件、监护仪支架，严格质控与材料追溯。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">行业应用</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        医疗器械
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        为医疗器械企业提供精密CNC加工服务。
        涵盖诊断设备外壳、手术器械零件、夹具与固定件、监护仪支架。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">加工能力</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">按医疗系统分类</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        我们为四大医疗子系统加工零件，关键尺寸可送集团共享计量中心三坐标测量机验证。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">精密公差</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">需精加工与检测工序保障，具体以图纸评审为准</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">常用材料</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">医疗行业质量标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        每批订单均按医疗级质量管控流程执行。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  

<!-- 产品展示 -->
<section style="background-color: var(--card-white); padding: 80px 0;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">产品展示</p>
    <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">医疗器械零件展示</h2>
    <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">以下为工艺演示用的产品渲染图，用于直观呈现本厂的加工能力；因保密协议（NDA）约束，图片仅供参考。</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-diagnostic-housing-01.webp" alt="诊断设备铝外壳CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">诊断设备铝外壳CNC加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-surgical-instrument-02.webp" alt="不锈钢手术器械零件" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">不锈钢手术器械零件</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-monitor-mount-arm-03.webp" alt="监护仪支架CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">监护仪支架CNC加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-lab-fixture-tray-04.webp" alt="医疗夹具与样品托盘" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">医疗夹具与样品托盘</p></div>
        </div>
    </div>
  </div>
</section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">有医疗零件需要加工？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        上传图纸，工程师24小时内提供报价及DFM反馈。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
