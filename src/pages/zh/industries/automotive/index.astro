---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '行业应用', href: '/zh/industries' },
  { label: '汽车制造' },
];

const capabilities = [
  {
    title: '发动机与变速箱',
    items: ['缸盖原型件', '齿轮轴与花键', '壳体支架', '阀体'],
    tolerance: '±0.01mm',
    materials: '铝合金 6061/7075、钢 4140、铸铁',
  },
  {
    title: '底盘与悬挂',
    items: ['控制臂支架', '转向柱零件', '减震器活塞', '安装板'],
    tolerance: '±0.01mm',
    materials: '钢 1045、4340、铝合金 6061-T6',
  },
  {
    title: '电子与传感器',
    items: ['传感器外壳', '连接器本体', 'ECU 测试治具', '线束夹具'],
    tolerance: '±0.005mm',
    materials: '铝合金、黄铜 C360、POM（赛钢）',
  },
  {
    title: '内饰与车身',
    items: ['仪表板支架', '饰板安装点', '灯壳原型', '格栅零件'],
    tolerance: '±0.025mm',
    materials: '铝合金 6061、类ABS赛钢、聚碳酸酯',
  },
];

const standards = [
  { label: '尺寸检测', desc: '首件及抽检可送集团共享计量中心三坐标测量机（CMM）验证，符合 AQL 2.5 标准。' },
  { label: '表面处理控制', desc: '粗糙度由轮廓仪检测。可提供钝化、阳极氧化、粉末涂装等后处理。' },
  { label: '材料追溯', desc: 'EN 10204 3.1 材料证书可按需提供；全程可追溯。' },
  { label: 'PPAP 文件', desc: '批量订单可提供生产件批准程序（PPAP）全套文件。' },
];
---

<PageLayout
  title="汽车精密CNC加工 | 发动机零件·底盘·传感器外壳 | Eternal CNC"
  description="为汽车OEM和一级供应商提供精密CNC加工服务——发动机零件、底盘支架、传感器外壳、装配治具。从原型到量产。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">行业应用</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        汽车制造
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        从原型验证到批量生产，我们为汽车OEM及一级供应商提供精密CNC加工零件。
        涵盖发动机、变速箱、底盘、电子系统及装配工装。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="py-20" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">加工能力</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">按车辆系统分类</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        我们为四大车辆系统加工零件，关键尺寸可送集团共享计量中心三坐标测量机验证。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">精密公差</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">需精加工与检测工序保障，具体以图纸评审为准</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">常用材料</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 产品展示 -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">产品展示</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">汽车零件展示</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        以下为工艺演示用的产品渲染图，用于直观呈现本厂的加工能力；因保密协议（NDA）约束，图片仅供参考。
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-complex-aluminum-housing-01.webp" alt="CNC加工复杂铝合金汽车壳体" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">复杂铝合金壳体</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-aluminum-housing-multi-angle-02.webp" alt="铝合金壳体多角度CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">壳体侧视图</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-precision-parts-batch-03.webp" alt="精密铝汽车零件批量" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">汽车零件批量</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-cast-part-cnc-machining-04.webp" alt="汽车复杂铸造零件CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">铸造零件</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">汽车行业质量标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        每批订单均按汽车级质量管控流程执行。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background-color: var(--brand-dark);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">有汽车零件需要加工？</h2>
      <p class="text-lg mb-8 text-gray-300">
        上传图纸，我们的工程师 24 小时内提供报价及 DFM 可制造性反馈。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
