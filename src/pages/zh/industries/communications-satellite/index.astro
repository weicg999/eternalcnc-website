---
import PageLayout from '../../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '行业应用', href: '/zh/industries' },
  { label: '通信与卫星设备' },
];

const capabilities = [
  {
    title: '卫星支架',
    items: ['卫星平台支架', '太阳能板支架', '天线臂', '结构连接件'],
    tolerance: '±0.01mm',
    materials: '钛合金 Ti-6Al-4V、Inconel 718',
  },
  {
    title: '伺服壳体',
    items: ['作动器壳体', '陀螺支架', '扭矩连杆件', '衬套适配器'],
    tolerance: '±0.005mm',
    materials: '高强度钢 4340、300M',
  },
  {
    title: '天线壳体',
    items: ['射频屏蔽壳体', 'GPS 天线座', '通信机架', '传感器集成板'],
    tolerance: '±0.01mm',
    materials: '铝合金 7075、镁合金',
  },
  {
    title: '结构框架',
    items: ['框架连接件', '面板接头', '波导歧管', '快换接头'],
    tolerance: '±0.005mm',
    materials: '不锈钢 316L、钛合金',
  },
];

const standards = [
  { label: '材料原厂证书', desc: '所有原材料提供EN 10204 3.1或 mill certificate，全程可追溯。' },
  { label: '全程批次追溯', desc: '从原材料炉号到成品序列号，完整质量记录链。' },
  { label: '无损检测报告', desc: '可按需提供渗透检测（PT）、超声波检测（UT）报告。' },
  { label: '尺寸全检报告', desc: '关键尺寸100%检测（厂内 2.5D 影像测量仪+精密量具）；CMM 测量报告可按需提供（集团共享计量中心）。' },
];
---

<PageLayout
  title="通信与卫星设备精密制造 | 卫星支架·天线壳体·结构框架 | Eternal CNC"
  description="为通信与卫星设备行业提供精密CNC加工——卫星支架、天线壳体、伺服壳体、结构框架，全流程质控与材质追溯。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">行业应用</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        通信与卫星设备
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        为通信与卫星设备行业提供精密CNC加工服务。
        涵盖卫星支架、天线壳体、伺服壳体及结构框架。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">加工能力</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">按系统分类</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        我们为卫星结构与通信设备加工关键零件，关键尺寸可送集团共享计量中心三坐标测量机验证。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">精密公差</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">需精加工与检测工序保障，具体以图纸评审为准</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">常用材料</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">行业质量标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        每批订单均按高可靠性质量管控流程执行。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>



<!-- 产品展示 -->
<section style="background-color: var(--card-white); padding: 80px 0;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">产品展示</p>
    <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">零件展示</h2>
    <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">高可靠性零件——卫星结构、舵机壳体、结构框架。以下为工艺演示用的产品渲染图，用于直观呈现本厂的加工能力；因保密协议（NDA）约束，图片仅供参考。</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/aerospace/cnc-aerospace-satellite-bracket-01.webp" alt="卫星结构铝件CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">卫星结构铝件CNC加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/aerospace/cnc-aerospace-servo-actuator-housing-02.webp" alt="舵机壳体精密加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">舵机壳体精密加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/aerospace/cnc-aerospace-turbine-blade-03.webp" alt="精密叶片零件加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">精密叶片零件加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/aerospace/cnc-aerospace-antenna-housing-04.webp" alt="天线外壳CNC加工" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">天线外壳CNC加工</p></div>
        </div>
    </div>
  </div>
</section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">有卫星与通信设备零件需要加工？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        上传图纸，工程师24小时内提供报价及DFM反馈。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
