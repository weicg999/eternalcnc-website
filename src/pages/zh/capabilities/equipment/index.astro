  { name: '立式加工中心', count: 6, color: '#1a1a1a' },
  { name: '钻攻/钻铣中心', count: 7, color: '#2563eb' },
  { name: '模具雕铣机', count: 2, color: '#059669' },
];

const standards = [
  { label: '设备校准', desc: '所有设备按季度校准，每次生产前检测主轴跳动，确保加工精度。' },
  { label: '预防性维护', desc: '严格执行预防性维护计划，定期监测主轴振动值，确保设备稳定运行。' },
  { label: '产能管理', desc: '实时设备负载监控，灵活排产，支持急单和批量生产。' },
  { label: '设备档案', desc: '每台设备建立完整档案，加工参数、维护记录、精度报告全程可查。' },
];

// JSON-LD 结构化数据
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '鑫永恒CNC设备清单',
  description: '鑫永恒精密 CNC 设备矩阵完整清单——五轴加工中心、立式加工中心、钻攻中心和模具雕铣机全覆盖，铭牌实拍参数可查。',
  itemListElement: equipment.map((eq, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: `${eq.brand} ${eq.model} ${eq.type}`,
      category: eq.type,
      brand: { '@type': 'Brand', name: eq.brand },
      model: eq.model,
      additionalProperty: eq.specs.map(s => ({
        '@type': 'PropertyValue',
        name: s.label,
        value: s.value,
      })),
    },
  })),
};
---

<PageLayout
  title="CNC加工设备清单 | 五轴·立加·钻攻·雕铣全工艺覆盖 | Eternal CNC"
  description={`鑫永恒CNC设备矩阵：五轴加工中心、立式加工中心、钻攻中心、模具雕铣机全覆盖，铭牌实拍参数可查。`}
  breadcrumbs={breadcrumbs}
  schema={itemListSchema}
>
  {/* Hero */}
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">工艺能力</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        设备清单
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        厂区配备多元化主流 CNC 设备矩阵——涵盖五轴联动、高速钻攻及精密模具雕铣，覆盖精密零件全工艺链。
        实行严苛的设备校准与维护标准，确保加工精度持续稳定。
      </p>

      {/* 设备类别 */}
      <div class="flex flex-wrap gap-x-4 gap-y-2 mt-8">
        {categories.map((cat, i) => (
          <span class="text-sm font-medium" style="color: var(--text-body);">
            {cat.name}{i < categories.length - 1 ? '  |' : ''}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看加工服务 →
        </a>
      </div>
    </div>
  </section>

  {/* 设备列表 */}
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">设备一览</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">完整设备清单</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        以下是工厂内全部 CNC 设备——配有真实设备照片、铭牌核实型号及完整技术参数。
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {equipment.map((eq) => (
          <div class={`border rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`} style={`background-color: var(--card-white); border-color: var(--border-color);`}>
            {/* 图片 */}
            <div class="relative h-48 bg-gray-100 overflow-hidden">
              {eq.image ? (
                <img
                  src={eq.image}
                  alt={eq.imageAlt}
                  width="400" height="300"
                  loading="lazy" decoding="async"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                  待补充照片
                </div>
              )}
              {/* 类型标签 */}
              <span class="absolute top-3 left-3 text-xs font-semibold text-white px-2.5 py-1 rounded" style={`background-color: ${eq.badgeColor};`}>
                {eq.typeBadge}
              </span>
              
            </div>

            {/* 内容 */}
            <div class="p-5">
              <p class="text-xs font-medium mb-1" style="color: var(--text-muted);">{eq.brand}</p>
              <h3 class="text-lg font-bold mb-1" style="color: var(--brand-dark);">
                {eq.brand.split(' ')[0]} {eq.model}
              </h3>
              <p class="text-sm mb-3" style="color: var(--text-body);">{eq.type}</p>
              {/* 参数表 */}
              <table class="w-full text-xs mb-4">
                <tbody>
                  {eq.specs.map((spec) => (
                    <tr class="border-b" style="border-color: var(--border-color);">
                      <th scope="row" class="py-1.5 pr-3 text-left font-medium whitespace-nowrap" style="color: var(--text-muted);">{spec.label}</th>
                      <td class="py-1.5 text-right" style="color: var(--brand-dark);">{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              {/* 应用领域 */}
              <p class="text-xs" style="color: var(--text-body);">
                <span class="font-medium" style="color: var(--text-muted);">应用领域： </span>
                {eq.applications}
              </p>

              {eq.detail && (
                <a href={eq.detail} class="inline-flex items-center gap-1 mt-3 text-xs font-semibold transition-colors" style="color: var(--brand-red);">
                  查看设备详情（英文）
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 质量管理 */}
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">设备管理与维护标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        严格的设备维护制度确保加工精度持续稳定。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">有零件需要加工？</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        上传图纸，我们的工程师 2 小时内提供报价及 DFM 可制造性反馈。
      </p>
