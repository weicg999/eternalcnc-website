---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustBar from '../../components/TrustBar.astro';
import CapabilitiesSection from '../../components/CapabilitiesSection.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import IndustryCards from '../../components/IndustryCards.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
---

<BaseLayout title="鑫永恒 – 精密CNC加工" description="23年制造行业经验，15年CNC精密机加。30台数控设备，±0.005mm公差。发图纸过来，24小时报价。">

  <!-- 1. HERO -->
  <Hero
    title="我们是你的工程伙伴，而不只是加工厂"
    subtitle="图纸评估 → 工艺规划 → 打样验证 → 量产交付，全流程厂内闭环"
    helperText="专注非标定制 · 五轴联动加工 · 23年制造行业经验，15年CNC精密机加"
    ctaPrimaryText="获取报价"
    ctaPrimaryHref="/zh/contact/get-a-quote"
    ctaSecondaryText="查看加工能力"
    ctaSecondaryHref="/zh/services/cnc-machining"
    heroVideoSrc="/videos/eternal-cnc-5axis-machining-in-action-01.mp4"
  />

  <!-- 2. TRUST BAR -->
  <TrustBar />

  <!-- 3. CORE CAPABILITIES -->
  <CapabilitiesSection />

  <!-- 4. PROCESS STEPS -->
  <ProcessSteps />

  <!-- 4.5 信任承诺带（替换原图片画廊） -->
  <section class="py-16 md:py-24" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">为什么选择鑫永恒</p>
        <h2 class="text-2xl md:text-3xl font-bold" style="color: var(--brand-dark); font-family: var(--font-heading);">值得信赖的制造伙伴</h2>
        <p class="mt-3 text-[17px] max-w-2xl mx-auto" style="color: var(--text-body);">四重承诺，把一张图纸变成你敢放心用的零件。</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[#8B0000]" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1); color: var(--brand-red);">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">全链路材料溯源</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">EN 10204 3.1 材质报告可按需提供，炉号绑定、全程可追溯。</p>
        </div>
        <div class="p-6 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[#8B0000]" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1); color: var(--brand-red);">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">无起订量</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">欢迎打样与小批量，不设最低起订门槛。</p>
        </div>
        <div class="p-6 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[#8B0000]" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1); color: var(--brand-red);">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">工厂直供</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">30 台 CNC 设备（家族集团整体），无中间环节，报价透明。</p>
        </div>
        <div class="p-6 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-[#8B0000]" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1); color: var(--brand-red);">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">免费 DFM 评审</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">工程师评审图纸，24 小时内出具报价。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4.6 中部 CTA -->
  <section class="py-12 md:py-16" style="background-color: var(--card-white);">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--brand-dark); font-family: var(--font-heading);">准备好加工你的零件了吗？</h2>
      <p class="text-[17px] mb-8" style="color: var(--text-body);">发来图纸，24 小时内获取详细报价。</p>
      <a href="/zh/contact/get-a-quote" class="inline-flex items-center gap-2.5 px-8 py-3.5 text-[15px] font-semibold text-white bg-[#8B0000] rounded-lg transition-all duration-200 hover:bg-[#6B0000] hover:text-white hover:shadow-lg hover:-translate-y-0.5">
        获取报价
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="color: rgb(255, 255, 255);"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>

  <!-- 5. INDUSTRY APPLICATIONS -->
  <IndustryCards />

  <!-- 6. 知识库预览 -->
  <section class="py-16 md:py-24" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold" style="color: var(--brand-dark); font-family: var(--font-heading);">知识库</h2>
        <p class="mt-3 text-[17px]" style="color: var(--text-body);">技术指南、行业洞察与公司动态。</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <a href="/zh/knowledge/tech-blog" class="group block p-6 rounded-xl border transition-all duration-200 hover:border-[#8B0000] hover:-translate-y-1 hover:shadow-lg" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1);">
            <svg class="w-5 h-5" style="color: var(--brand-red);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">技术博客</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">CNC 加工工艺、材料选择、可制造性设计 (DFM) 及工程最佳实践等技术文章。</p>
        </a>

        <a href="/zh/knowledge/news" class="group block p-6 rounded-xl border transition-all duration-200 hover:border-[#8B0000] hover:-translate-y-1 hover:shadow-lg" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1);">
            <svg class="w-5 h-5" style="color: var(--brand-red);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">行业与新闻</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">公司里程碑、展会活动、设备升级及行业动态报道。</p>
        </a>

        <a href="/zh/knowledge/dfm-analysis" class="group block p-6 rounded-xl border transition-all duration-200 hover:border-[#8B0000] hover:-translate-y-1 hover:shadow-lg" style="background-color: var(--card-white); border-color: var(--border-color);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background-color: rgba(139,0,0,0.1);">
            <svg class="w-5 h-5" style="color: var(--brand-red);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">DFM 分析指南</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-body);">公差标准、表面粗糙度对比、材料性能参数及 CNC 设计规则等深度资源。</p>
        </a>
      </div>

      <div class="text-center">
        <a href="/zh/knowledge/" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-lg transition-all duration-200 hover:bg-[#8B0000] hover:text-white">
          浏览全部文章
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. QUOTE CTA -->
  <QuoteCTA />

</BaseLayout>
