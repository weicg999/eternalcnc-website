---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: '加工服务', href: '/zh/services' },
  { label: 'CNC 精密加工' },
];

const capabilities = [
  {
    title: '三轴铣削',
    items: ['平面零件', '型腔模具', '安装板', '支架'],
    tolerance: '±0.01mm',
    materials: '铝合金 6061/7075、钢 1045、POM',
  },
  {
    title: '四轴加工',
    items: ['圆柱凸轮', '分度零件', '螺旋槽', '多面体零件'],
    tolerance: '±0.01mm',
    materials: '钢 4140、铝合金 6061-T6、不锈钢 304',
  },
  {
    title: '五轴联动加工',
    items: ['复杂曲面', '叶轮/涡轮', '异形腔体', '高可靠性结构件'],
    tolerance: '±0.005mm',
    materials: '钛合金 TC4、Inconel 718、铝合金 7075',
  },
  {
    title: '高速铣削',
    items: ['薄壁零件', '精密模具', '复杂曲面', '微型结构'],
    tolerance: '±0.005mm',
    materials: '铝合金、黄铜 C360、工程塑料',
  },
  {
    title: '钻攻加工',
    items: ['多孔板件', '螺纹孔群', '深孔加工', '攻丝'],
    tolerance: '±0.01mm',
    materials: '各类金属及工程塑料',
  },
  {
    title: '后处理与表面处理',
    items: ['阳极氧化（喷砂/抛光）', '钝化与电镀', '热处理（淬火/渗碳）', '喷漆与丝印'],
    processes: '阳极氧化、钝化、电镀、热处理、喷漆、丝印',
    value: '提升耐腐蚀性、耐磨性与外观质感，满足一站式交付需求',
  },
];

const standards = [
  { label: '尺寸精度', desc: '三坐标检测可按需委托（集团共享计量中心），关键尺寸由厂内 2.5D 影像测量仪与精密量具复核，确保图纸要求。' },
  { label: '表面质量', desc: '表面粗糙度 Ra 0.8-3.2μm 可选，支持抛光、喷砂、阳极氧化等后处理。' },
  { label: '材料追溯', desc: '材质证明（EN 10204 3.1 或等效 MTC）可按需提供；批次信息全程记录，满足高可靠性、医疗等行业要求。' },
  { label: '交期保障', desc: '标准件 3-5 个工作日出货，急件可加急处理，支持分批交付。' },
];
---

<PageLayout
  title="CNC精密加工服务 | 三轴·四轴·五轴·高速铣削 | Eternal CNC"
  description="专业CNC精密加工服务，支持三轴铣削、四轴加工、五轴加工、高速铣削，从原型到量产一站式交付。"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">加工服务</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC 精密加工
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        三轴/四轴/五轴/高速铣削，从原型到量产的一站式 CNC 加工服务。
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/zh/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          获取报价
        </a>
        <a href="/zh/industries" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          查看行业应用 →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="py-20" style="background-color: var(--page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">加工能力</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">按加工方式分类</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        我们采用六项核心工艺加工零件，关键尺寸由厂内 2.5D 影像测量仪与精密量具复核，必要时可送集团共享计量中心进行三坐标检测。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              {cap.processes ? (
                <>
                  <p class="text-xs mb-1" style="color: var(--text-muted);">核心工艺</p>
                  <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.processes}</p>
                  <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">价值主张</p>
                  <p class="text-sm" style="color: var(--text-body);">{cap.value}</p>
                </>
              ) : (
                <>
                  <p class="text-xs mb-1" style="color: var(--text-muted);">精密公差</p>
                  <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">需精加工与检测工序保障，具体以图纸评审为准</p>
                  <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">常用材料</p>
                  <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 加工过程展示 -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">加工现场</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">加工过程画廊</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        来自车间现场的真实加工场景和成品零件。
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-machining-milling-process-worm-shaft-coolant-01.webp" alt="CNC铣削加工现场（蜗杆工件铣削+冷却液喷淋）" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">CNC铣削现场</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-machining-coolant-spray-aluminum-housing-milling-01.webp" alt="CNC铣削冷却液喷淋（铝合金壳体加工）" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">冷却液铣削</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/machines/cnc-5axis-machining-center-coolant-cutting-hero-01.webp" alt="五轴CNC加工中心（主轴加工+冷却液喷淋）" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">五轴加工中心</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-milling-complex-aluminum-part-coolant-01.png" alt="CNC加工中心铣削复杂铝合金异形件（冷却液喷淋）" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">复杂铝合金壳体</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-precision-spindle-machining-closeup-01.png" alt="CNC高精度主轴与刀柄铣削加工特写" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">精密组件</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-coolant-flush-aluminum-housing-01.png" alt="CNC加工中心铣削复杂铝合金壳体（冷却液冲洗）" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">复杂腔体加工</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/screws-batch/cnc-machined-screw-batch-showcase.webp" alt="五轴加工样件" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">五轴试样</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/process/cnc-workshop-multi-tool-aluminum-bracket-coolant-01.png" alt="CNC加工中心多刃刀铣削（冷却液喷淋）" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">定制支架</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section class="py-20" style="background-color: var(--card-white);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">质量管控</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">CNC 加工质量标准</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        每批订单均按严格的质量管控流程执行，确保产品符合图纸要求。
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background-color: var(--brand-dark);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">有零件需要 CNC 加工？</h2>
      <p class="text-lg mb-8 text-gray-300">
        上传图纸，我们的工程师 2 小时内提供报价及 DFM 可制造性反馈。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/zh/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          免费获取报价
        </a>
        <a href="/zh/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          免费DFM图纸评审 →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
