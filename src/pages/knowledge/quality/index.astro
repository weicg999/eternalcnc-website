---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
  { label: 'Quality Certification' },
];

const capabilities = [
  {
    title: 'Quality Management System',
    items: ['IQC (Incoming) → IPQC (In-Process) → FQC (Final) → OQC (Outgoing)', 'Company-wide quality responsibility system', 'Non-conforming product traceability workflow', 'Continuous improvement PDCA cycle'],
    tolerance: 'Full-process traceability',
    materials: 'Every part is fully documented and traceable',
  },
  {
    title: 'Inspection Equipment & Capability',
    items: ["Bridge CMM (via our group's shared metrology center on request, 2.5μm, not in-house standard)", 'Vision measuring system (2D)', 'Surface roughness tester', 'Hardness tester and microstructure analysis'],
    tolerance: 'Inspection equipment regularly calibrated and traceable',
    materials: 'Critical dimensions 100% inspected',
  },
  {
    title: 'ISO 9001 Certification Progress',
    items: ['Quality manual and procedure documents completed', 'Internal auditor training completed', 'Pilot run and internal audits in progress', 'Target certification completion: 2026'],
    tolerance: 'Certification system being finalized',
    materials: 'ISO 9001 certification in progress (2026)',
  },
  {
    title: 'In-Process Quality Control',
    items: ['First Article Inspection (FAI) before batch production', 'In-process quality control at critical operations', 'First and last part retained per batch', '8D report within 2 hours for anomaly response'],
    tolerance: 'Critical dimension CPK ≥ 1.33',
    materials: 'Prevention-first, continuous improvement',
  },
];

const standards = [
  { label: 'Customer Focus', desc: 'Quality goals are defined around customer needs and satisfaction.' },
  { label: 'Process Approach', desc: 'Manage activities and resources as processes to achieve intended results more efficiently.' },
  { label: 'Continuous Improvement', desc: 'Quality improvement is an eternal goal — decisions are driven by data.' },
  { label: 'Engagement of People', desc: 'Quality is not just the QC department responsibility — it belongs to everyone.' },
];
---

<BaseLayout
  title="Quality System & Certification | ISO 9001 · Full-Process QC · Traceability | Eternal CNC"
  description="Eternal CNC quality management system — full-process quality control, precision inspection equipment, ISO 9001 certification preparation, and in-process quality control ensuring reliable CNC product quality."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Knowledge Base</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Quality System & Certification
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        ISO 9001 quality management system preparation and quality control workflow
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Contact Us
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Request Documentation
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality System</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Four Quality Control Modules</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        From system building to process control, comprehensive quality assurance for stable and reliable product quality.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Core Capability</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Quality Commitment</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Principles</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Quality Management Principles</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Guided by ISO 9001 quality management principles, we continuously improve product and service quality.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Want to Learn More About Quality Control?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Contact us for complete quality control documentation and inspection report samples.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Contact Us
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Request Documentation
        </a>
      </div>
    </div>
  </section>
</PageLayout>
