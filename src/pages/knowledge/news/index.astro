---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
  { label: 'Industry News' },
];

const archive = [
  {
    number: '02',
    date: '18 September 2026',
    title: 'What the shop floor noticed — mid-September',
    blurb: 'Industrial robots up 34.6% while reducers lag, UBTECH’s 10,000-unit plant, China’s first liquid-cooling national standard, and mass-production orders already landing at the component layer.',
    href: '/knowledge/news/issue-02/',
    latest: true,
  },
  {
    number: '01',
    date: '11 September 2026',
    title: 'What the shop floor noticed — early September',
    blurb: 'Humanoid robotics crosses into production, AI-server liquid cooling becomes standard, and the machine-tool industry doubles its profit — what each means for the parts you send.',
    href: '/knowledge/news/issue-01/',
    latest: false,
  },
];

const nextIssue = '25 September 2026';
---

<PageLayout
  title="Industry News from the Shop Floor | Eternal CNC"
  description="The Eternal CNC Strategic Advisory Group's reading list of what the CNC shop floor noticed — past issues on robotics, liquid cooling and machine tools, and what each means for your parts."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Industry news</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        What the shop floor noticed — past issues
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        A weekly reading list from the Eternal CNC Strategic Advisory Group — only items that change what a buyer of CNC parts should do this quarter. Every issue carries a "what it means for your parts" line.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/knowledge/tech-blog/" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Read the Tech Blog →
        </a>
      </div>
    </div>
  </section>

  <!-- Issue list -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--brand-red);">All issues</p>
      <div class="space-y-6">
        {archive.map((it) => (
          <a href={it.href} class="block p-8 border rounded-2xl transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--page-bg); color: var(--brand-dark);">Issue {it.number}</span>
              <span class="text-xs" style="color: var(--text-muted);">{it.date}</span>
              {it.latest && (
                <span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded" style="background-color: var(--brand-red); color: #ffffff;">Latest</span>
              )}
            </div>
            <h2 class="text-2xl font-bold mb-3 leading-snug" style="color: var(--brand-dark);">{it.title}</h2>
            <p class="text-base leading-relaxed mb-4" style="color: var(--text-body);">{it.blurb}</p>
            <p class="text-sm font-medium" style="color: var(--brand-red);">Read Issue {it.number} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Next issue -->
  <section style="background-color: var(--card-white); padding: 64px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 border rounded-2xl" style="background-color: var(--page-bg); border-color: var(--border-color);">
        <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Next issue</p>
        <h3 class="text-xl font-bold mb-3" style="color: var(--brand-dark);">{nextIssue}</h3>
        <p class="text-sm leading-relaxed mb-5" style="color: var(--text-body);">
          Storylines we are following: whether reducer output recovers in the September data, how cold-plate shops are preparing for the February 2027 liquid-cooling standard, and the first shipment figures from plants that went live this quarter.
        </p>
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Send us your next drawing
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a part in mind?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Send the STEP and the PDF. We will quote within 2 hours on a working day, and we will tell you whether your tolerances are what they should be.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/knowledge/tech-blog/" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Browse the Tech Blog →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
