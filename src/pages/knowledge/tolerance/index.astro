---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
  { label: 'Machining Tolerances' },
];

const capabilities = [
  {
    title: 'Linear Dimensional Tolerances',
    items: ['Fine class f: ±0.05mm (small parts)', 'Medium class m: ±0.1mm (standard)', 'Coarse class c: ±0.2mm (non-mating)', 'Very coarse class v: ±0.5mm (weldments)'],
    tolerance: 'Default standard: ISO 2768-m',
    materials: 'Tighter tolerances = higher machining cost',
  },
  {
    title: 'Geometric Tolerances (GD&T)',
    items: ['Flatness up to 0.02mm per 100mm', 'Parallelism up to 0.01mm per 100mm', 'Concentricity up to 0.02mm', 'Position up to ±0.01mm'],
    tolerance: 'CMM verification available via our group\'s shared metrology center on request',
    materials: 'GD&T requires matching inspection capabilities',
  },
  {
    title: 'Surface Roughness',
    items: ['Rough milling: Ra 3.2-6.3μm', 'Finish milling: Ra 1.6-3.2μm', 'Grinding: Ra 0.4-1.6μm', 'Polishing: Ra 0.05-0.2μm'],
    tolerance: 'Default delivery: Ra 3.2μm',
    materials: 'Higher roughness requirements = more operations',
  },
  {
    title: 'Tolerance Specification Guidelines',
    items: ['Only specify tight tolerances on mating surfaces', 'Non-functional surfaces follow default unspecified tolerances', 'Use GD&T for critical characteristics', 'Avoid full-dimension tight tolerance annotation'],
    tolerance: 'Mating surfaces: ±0.02 to ±0.05mm is sufficient',
    materials: 'Rational tolerancing can reduce costs by 30%+',
  },
];

const standards = [
  { label: 'Tolerance Accumulation', desc: 'The longer the dimension chain, the greater the accumulated tolerance — consider this during design.' },
  { label: 'Datum First', desc: 'Establish the machining datum first, then specify dimensional tolerances.' },
  { label: 'Economic Precision', desc: 'Choose the loosest tolerance that meets functional requirements to reduce cost.' },
  { label: 'Inspection Compatibility', desc: 'Specified tolerances must be measurable — otherwise they are meaningless.' },
];
---

<PageLayout
  title="CNC Machining Tolerances & Precision Specifications | ISO 2768 · GD&T · Surface Roughness | Eternal CNC"
  description="Eternal CNC machining tolerance guide — ISO 2768 standard reference, geometric tolerance GD&T capabilities, surface roughness ranges, and tolerance specification tips to help you specify machining precision appropriately."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Knowledge Base</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC Machining Tolerances & Precision
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        ISO 2768 tolerance standards, GD&T capabilities, and tolerance specification recommendations
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Ask an Engineer
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Tolerance System</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Four Tolerance Dimensions</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Gain a comprehensive understanding of CNC machining tolerance capabilities and appropriately specify precision requirements.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Reference Standard</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Cost Tip</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Tolerance Principles</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Four Principles of Rational Tolerancing</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Tolerance specification is not about being as tight as possible — it is about being as appropriate as possible.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Not Sure How to Specify Tolerances?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Send us your drawings — our engineers will provide reasonable tolerance recommendations based on functional requirements.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Ask an Engineer
        </a>
      </div>
    </div>
  </section>
</PageLayout>
