---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
  { label: 'FAQ' },
];

const faqs = [
  {
    q: 'What is your minimum order quantity (MOQ)?',
    a: 'We support both prototyping (from a single piece) and mass production. There is no strict minimum order quantity — we are glad to start with a small batch and scale up as your project grows.'
  },
  {
    q: 'Which file formats do you accept for quoting?',
    a: 'We accept STEP, IGES, STL, PDF (2D drawings), and native formats from SolidWorks, Creo, and CATIA. The fastest quote comes from a 3D model (preferably STEP) plus a 2D PDF with critical tolerances marked.'
  },
  {
    q: 'How fast will I receive a quote?',
    a: 'Most quotes are delivered within 24 hours. Complex projects involving multiple parts or tight tolerances may need up to 48 hours for a detailed engineering review.'
  },
  {
    q: 'What are your standard lead times?',
    a: 'Prototypes: 3–5 business days. Small batches: 7–10 business days. Mass production: 15–25 business days. Rush orders are available on request.'
  },
  {
    q: 'Do you provide inspection reports with shipments?',
    a: 'Yes. Every shipment includes a Certificate of Conformance (CoC) and final photos before delivery. Dimensional inspection reports and material certificates (EN 10204 3.1) are available on request. RoHS and REACH documentation can also be provided upon application.'
  },
  {
    q: 'What materials can you machine?',
    a: 'We machine 30+ materials, including aluminum alloys (6061, 7075), stainless steel (303, 304, 316L), steel (1018, 4140), titanium, copper/brass, and engineering plastics (Delrin, Nylon, PEEK, PTFE).'
  },
  {
    q: 'What tolerances can you hold?',
    a: 'Standard tolerance is ±0.05 mm (ISO 2768-m). We can hold ±0.01 mm or tighter on request. With grinding, a surface finish down to Ra 0.2 μm is achievable.'
  },
  {
    q: 'Do you offer surface finishing services?',
    a: 'Yes. We provide anodizing, sandblasting, plating, powder coating, passivation, and heat treatment. All finishing is coordinated in-house to keep quality control consistent.'
  },
  {
    q: 'Are you ISO certified?',
    a: 'We operate under a rigorous quality management system; our ISO 9001 certification is currently in progress. We are happy to share our quality procedures and inspection workflow on request.'
  },
  {
    q: 'Can I visit your factory?',
    a: 'Absolutely. We welcome factory visits — please contact us in advance so we can arrange a tour of the workshop and inspection area.'
  },
  {
    q: 'What is the relationship between Eternal CNC and Xinyongheng?',
    a: 'Xinyongheng (Shenzhen) Precision Industrial Co., Ltd. is our legal entity registered in China. Eternal CNC is the international brand we operate under for global customers. Same team, same workshop — just the name you see on the website.'
  },
  {
    q: 'How long has your company been in business?',
    a: 'Our group has been in manufacturing since 2003 and in CNC precision machining since 2011. The current legal entity, Xinyongheng (Shenzhen) Precision Industrial Co., Ltd., was incorporated in 2024 to support our global branding. So while the company name is newer, the workshop experience is well established.'
  },
  {
    q: 'Are you a factory or a trading company?',
    a: 'We are a factory-direct CNC machining workshop, not a trading company. We run in-house 2.5D optical inspection and precision measuring tools; bridge-type CMM measurement is handled through our group\'s shared metrology center on request. This keeps both cost and quality under our own control.'
  },
];

const standards = [
  { label: 'Order Process', desc: 'From drawing upload to final delivery — understand each step of working with Eternal CNC.' },
  { label: 'Payment & Terms', desc: 'Standard payment terms, accepted methods, and invoicing procedures for domestic and international orders.' },
  { label: 'Shipping & Logistics', desc: 'Packaging standards, shipping options, and estimated delivery timelines for your region.' },
  { label: 'After-Sales Support', desc: 'Quality issue resolution, rework policies, and ongoing technical support for repeat orders.' },
];

// FAQPage structured data for GEO (AI search answer snippets)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<PageLayout
  title="FAQ | Common Questions About Eternal CNC | Eternal CNC"
  description="Everything you need to know about working with Eternal CNC — MOQ, pricing, lead time, file formats, inspection reports, materials, tolerances, and our company background."
  breadcrumbs={breadcrumbs}
  schema={faqSchema}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Knowledge Base</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        FAQ
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Everything you need to know about working with Eternal CNC.
        Find answers to common questions about ordering, pricing, quality, and our company.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ List -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Common Questions</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Frequently Asked Questions</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Quick answers to the most common questions from our customers — from ordering and pricing to quality and our company background.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {faqs.map((faq) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{faq.q}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-body);">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Standards</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Our Commitment</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We stand behind every part we make. Here is what you can expect from us.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Still Have Questions?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawings — our engineers are ready to help within 24h.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/knowledge" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          View All Resources →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
