---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
  { label: 'Design Guidelines' },
];

const capabilities = [
  {
    title: 'Wall Thickness Design',
    items: ['Aluminum alloy minimum wall thickness ≥ 0.8mm', 'Stainless steel minimum wall thickness ≥ 1.0mm', 'Engineering plastic minimum wall thickness ≥ 1.2mm', 'Height-to-diameter ratio recommended within 4:1'],
    tolerance: 'Recommended wall thickness: 1.5-3mm (optimal)',
    materials: 'Too thin = deformation risk; too thick = increased material cost',
  },
  {
    title: 'Inside Radius & Corner Relief',
    items: ['Inside radius ≥ tool radius × 1.2', 'Bottom radius recommended larger than side radius', 'Corner relief requires extra operations and increases cost', 'Prioritize large radii to reduce machining difficulty'],
    tolerance: 'Recommended inside R ≥ R0.5mm',
    materials: 'Too small inside radius requires micro tools — low efficiency',
  },
  {
    title: 'Hole Design Specifications',
    items: ['Standard drill depth-to-diameter ratio ≤ 5:1', 'Deep hole machining requires gun drilling (≤10:1)', 'Prioritize standard hole diameters: φ1/2/3/4/5/6mm', 'Hole spacing ≥ hole diameter × 1.5'],
    tolerance: 'Leave 0.5mm allowance at bottom of blind holes',
    materials: 'Non-standard hole diameters require custom tools — longer lead time',
  },
  {
    title: 'Thread Design',
    items: ['Metric thread tap drill size reference chart', 'Thread depth ≤ hole diameter × 2.5 (blind holes)', 'Through-hole threads preferred over blind-hole threads', 'Avoid tapping on thin-walled parts'],
    tolerance: 'Recommended 6H/6g accuracy class',
    materials: 'Excessively deep threads risk tap breakage — higher scrap rate',
  },
];

const standards = [
  { label: 'Symmetry Principle', desc: 'Design parts symmetrically whenever possible to reduce flip setups and positioning errors.' },
  { label: 'Unified Datum', desc: 'Align design datum with machining datum to reduce dimension chain conversion errors.' },
  { label: 'Avoid Sharp Corners', desc: 'Internal sharp corners cause stress concentration and cannot be machined — always use radius transitions.' },
  { label: 'Simplify Geometry', desc: 'Use the simplest shape that achieves the function — avoid complex surfaces when not necessary.' },
];
---

<BaseLayout
  title="CNC Machining Design Guidelines | Wall Thickness · Inside Radius · Hole Design · Thread Specs | Eternal CNC"
  description="Eternal CNC machining design guidelines — wall thickness design, inside radius specifications, hole design standards, and thread design essentials to help engineers create more machinable, cost-effective CNC parts."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Knowledge Base</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC Machining Design Best Practices
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Engineering recommendations for wall thickness, inside corners, holes, threads, and other core design elements
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Talk to an Engineer →
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Design Elements</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Four Core Design Elements</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Master these four core design elements to make your parts more machinable, lower cost, and more consistent in quality.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Recommended Value</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Design Note</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Design Principles</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Four Principles of Good Design</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Follow these design principles to reduce machining difficulty and cost from the source.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need Engineering Support During Design?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Our engineering team can provide manufacturability assessments and optimization recommendations for your designs.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Talk to an Engineer →
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Free Quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
