---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
];

const sections = [
  { title: 'DFM Design Guide', desc: 'Design for manufacturability principles and common mistake avoidance for CNC machining', href: '/knowledge/dfm-guide' },
  { title: 'Design Guidelines', desc: 'Best practices for wall thickness, inner corners, holes, threads, and more', href: '/knowledge/design-guidelines' },
  { title: 'Material Handbook', desc: 'Comparison and selection guidance for metals and engineering plastics', href: '/knowledge/material-handbook' },
  { title: 'Machining Tolerances', desc: 'ISO 2768 tolerance standards, GD&T capabilities, and specification guidance', href: '/knowledge/tolerance' },
  { title: 'Surface Finishing', desc: 'Anodizing, passivation, plating, powder coating — 7 processes explained', href: '/knowledge/surface-finishing' },
  { title: 'Quality Certification', desc: 'ISO 9001 system preparation and compliance documentation guidance', href: '/knowledge/quality' },
  { title: 'Technical Resources', desc: 'Unit conversion, tap & drill reference tables, material density data', href: '/knowledge/tech-blog' },
  { title: 'FAQ', desc: 'MOQ, pricing, lead time, materials, tolerances — frequently asked questions', href: '/knowledge/faq' },
  { title: 'Tech Blog', desc: 'CNC machining tips, material selection guides, process optimization', href: '/knowledge/tech-blog' },
  { title: 'Contact Engineers', desc: 'Have specific questions? Reach out to our engineering team for expert support', href: '/contact' },
];
---

<BaseLayout
  title="Knowledge Base | Eternal CNC"
  description="CNC machining knowledge base: DFM guides, design best practices, material selection, tolerance standards, surface finishing processes, and technical resources."
  breadcrumbs={breadcrumbs}
>
  <!-- 1. Banner -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Knowledge Center</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">Knowledge Base</h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        CNC machining technical resource center — from design to delivery, helping you make better manufacturing decisions.
      </p>
    </div>
  </section>

  <!-- 2. Nine-card grid -->
  <section style="background-color: var(--page-bg); padding: 0 0 80px;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sections.map((s) => (
          <a href={s.href} class="p-6 border hover:shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30 group block" style="background-color: var(--card-white); border-color: var(--border-color);">
            <div class="mb-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:bg-[#E8E8E4]" style="color: var(--brand-red);">
              {s.title === 'DFM Design Guide' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              )}
              {s.title === 'Design Guidelines' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h5"/><path d="M17 12h5"/><path d="M12 2v5"/><path d="M12 17v5"/><circle cx="12" cy="12" r="3"/><rect x="7" y="7" width="10" height="10" rx="1"/></svg>
              )}
              {s.title === 'Material Handbook' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v7.5L4 18a1 1 0 0 0 .85 1.5h14.3a1 1 0 0 0 .85-1.5L14 10.5V3"/><line x1="7" y1="15" x2="17" y2="15"/></svg>
              )}
              {s.title === 'Machining Tolerances' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              )}
              {s.title === 'Surface Finishing' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.2H22l-6 4.8 2.4 7.2L12 16.4l-6.4 4.8 2.4-7.2-6-4.8h7.6z"/></svg>
              )}
              {s.title === 'Quality Certification' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              )}
              {s.title === 'Technical Resources' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
              )}
              {s.title === 'FAQ' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              )}
              {s.title === 'Tech Blog' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              )}
              {s.title === 'Contact Engineers' && (
                <svg class="transition-transform duration-300 hover:scale-110" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              )}
            </div>
            <h2 class="text-xl font-bold mb-2" style="color: var(--brand-dark);">{s.title}</h2>
            <p class="text-sm" style="color: var(--text-body);">{s.desc}</p>
            <span class="inline-block mt-4 text-sm font-semibold" style="color: var(--brand-red);">Learn More →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Can't Find What You Need?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Our engineering team is ready to answer your technical questions.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Contact Engineers →
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          Get a Quote →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
