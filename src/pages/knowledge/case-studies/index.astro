---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Knowledge Base', href: '/knowledge' },
  { label: 'Case Studies' },
];

const capabilities = [
  {
    title: '5-Axis Impeller',
    items: ['Complex blade geometry', 'Stainless steel 316L', 'Ra 0.8 surface finish', '±0.025mm tolerance achieved'],
    tolerance: '5-Axis Simultaneous',
    materials: 'SS 316L',
  },
  {
    title: 'Stainless Medical Housing',
    items: ['Cleanroom-grade surface', 'Complex internal channels', 'Biocompatible material', 'Full traceability required'],
    tolerance: '±0.01mm',
    materials: 'SS 316L / Titanium',
  },
  {
    title: 'Robotics Joint Part',
    items: ['High concentricity bores', 'Multi-face machining', 'Lightweight aluminum design', 'Anodized surface treatment'],
    tolerance: '±0.01mm',
    materials: 'Al 7075-T6',
  },
  {
    title: 'Aluminum Heat Sink',
    items: ['High aspect ratio fins', 'Flatness within 0.05mm', 'Thermal conductivity optimized', 'Anodized finish Type II'],
    tolerance: '±0.05mm',
    materials: 'Al 6063-T5',
  },
];

const standards = [
  { label: 'Dimensional Verification', desc: "CMM inspection report with full GD&T analysis available on request from our group's shared metrology center for case study parts." },
  { label: 'Surface Finish Validation', desc: 'Profilometer-measured Ra values, verified against customer specifications.' },
  { label: 'Material Certification', desc: 'EN 10204 3.1 certificates available on request; full chemical composition traceability maintained.' },
  { label: 'Final QC Documentation', desc: 'Complete inspection reports, photos, and packaging records for each shipment.' },
];
---

<PageLayout
  title="Case Studies | Real CNC Machining Projects | Eternal CNC"
  description="Real machining projects — from drawing to finished part. See how we solve complex manufacturing challenges."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Knowledge Base</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Case Studies
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Real machining projects — from drawing to finished part. See how we solve
        complex manufacturing challenges across industries.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Featured Projects</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Real Machining Cases</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Each project demonstrates our capability to deliver precision parts across materials and complexity levels.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Process</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Material</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Standards</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Quality Assurance</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every case study part undergoes rigorous inspection and documentation before delivery.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a Similar Project?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawings — engineer feedback within 2h.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/knowledge" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          View All Resources →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
