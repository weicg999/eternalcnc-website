---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Industries', href: '/industries' },
  { label: 'Energy Equipment' },
];

const capabilities = [
  {
    title: 'Valve Bodies',
    items: ['Pressure-rated valve housings', 'Gate valves and ball valves', 'Machined to API/ASTM standards', 'Seal surface finish to Ra 0.8'],
    tolerance: '±0.01mm',
    materials: 'Stainless Steel 316/316L, Carbon Steel WCB',
  },
  {
    title: 'Pump Housings',
    items: ['Centrifugal and positive displacement casings', 'Sealed interfaces, leak-tested', 'Impeller chambers to tight clearance', 'Flange faces ground flat'],
    tolerance: '±0.01mm',
    materials: 'Stainless Steel 304/316, Duplex 2205',
  },
  {
    title: 'Flange Connectors',
    items: ['ASME B16.5 flanges', 'Gasket surfaces ground flat', 'Bolt-hole precision boring', 'Face finish per spec'],
    tolerance: '±0.025mm',
    materials: 'Carbon Steel, Stainless Steel, Alloy 20',
  },
  {
    title: 'Turbine Fixtures',
    items: ['Mounting brackets for wind and gas turbines', 'Locating fixtures for assembly', 'Large-format machining capability', 'Dynamic balance preparation'],
    tolerance: '±0.05mm',
    materials: 'Steel 4340, Aluminum 7075, Stainless 17-4 PH',
  },
];

const standards = [
  { label: 'Pressure Testing', desc: 'Hydrostatic and pneumatic pressure verification on every pressure-rated part.' },
  { label: 'Corrosion Testing', desc: 'Salt spray, immersion, and accelerated aging tests per ASTM B117.' },
  { label: 'Impact Toughness', desc: 'Charpy V-notch impact testing for low-temperature service parts.' },
  { label: 'Material Certification', desc: 'Mill test reports, material traceability, full chemical analysis on request.' },
];
---

<PageLayout
  title="Energy Equipment CNC Machining | Valve Bodies · Pump Housings · Turbine Parts | Eternal CNC"
  description="Precision CNC machining for energy equipment — valve bodies, pump housings, flange connectors, and turbine fixtures. Pressure-rated, corrosion-resistant, fully traceable."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Industries</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Energy Equipment Manufacturing
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        High-load · Corrosion-resistant · Long service life.
        Precision parts for oil &amp; gas, wind power, and solar energy equipment.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/industries" class="inline-block px-6 py-3 text-sm font-medium rounded-lg transition-all duration-200 border" style="border-color: var(--brand-red); color: var(--brand-red);">
          View Industries →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Capabilities</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Core Components</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We machine critical components for energy equipment. Critical dimensions can be CMM-verified via our group's shared metrology center on request, with full material traceability.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Common Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Showcase -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Showcase</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Energy Parts Gallery</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Aluminum enclosures and precision components for energy and power systems. Product renderings for process demonstration only. Visual representation of machining capabilities. Images are for reference only due to NDA.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/energy/cnc-energy-solar-mount-bracket-01.webp" alt="Mechanical connection parts" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Mechanical Connection Parts</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/energy/cnc-energy-wind-gearbox-housing-02.webp" alt="Complex cavity machining for energy" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Complex Cavity Machining</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/energy/cnc-energy-battery-enclosure-03.webp" alt="CNC aluminum extrusion enclosure" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">CNC Aluminum Extrusion Enclosure</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/energy/cnc-energy-pipe-flange-fitting-04.webp" alt="Complex machined parts for energy applications" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Complex Parts</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Energy Sector Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every order follows energy-industry quality control procedures with full documentation.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-lg" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Energy Parts, Engineered to Last</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Send us your drawings — engineer feedback within 24h.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote →
        </a>
        <a href="/industries" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-lg transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Browse All Industries →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
