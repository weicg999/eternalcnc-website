---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Industries', href: '/industries' },
  { label: 'Electronics & Communications' },
];

const capabilities = [
  {
    title: 'RF Housings',
    items: ['Antenna enclosure bodies', 'RF shield cans', 'Filter housings', 'Waveguide components'],
    tolerance: '±0.05mm',
    materials: 'Aluminum 6061, Brass C360, Copper C110',
  },
  {
    title: 'Heat Sinks',
    items: ['Extrusion-profile heat sinks', 'Custom fin arrays', 'Cold plates', 'LED thermal substrates'],
    tolerance: '±0.025mm',
    materials: 'Aluminum 6063/6061, Copper C110',
  },
  {
    title: 'Connectors',
    items: ['Circular connector bodies', 'Fiber optic alignment parts', 'Pin headers & sockets', 'Coaxial connector housings'],
    tolerance: '±0.005mm',
    materials: 'Brass C360, PEEK, POM, Stainless 303',
  },
  {
    title: 'EMI Shields',
    items: ['Board-level shield frames', 'Gasket grooves', 'Aperture plates', 'Conductive housing inserts'],
    tolerance: '±0.01mm',
    materials: 'Aluminum, Brass, Beryllium Copper',
  },
];

const standards = [
  { label: 'SPC Process Control', desc: 'Statistical process control for high-volume connector and heat sink production. Cpk ≥ 1.33 on critical dimensions.' },
  { label: 'Conductivity Testing', desc: 'Surface conductivity verified for EMI/RF shielding parts. Contact resistance measured per customer spec.' },
  { label: 'Coating Thickness', desc: 'Anodize, nickel, and gold plating thickness verified by X-ray fluorescence. Mil-spec coatings available.' },
  { label: 'Dimensional Consistency', desc: 'Vision inspection systems for high-volume runs. Automated sorting and packaging available.' },
];
---

<PageLayout
  title="Electronics & Communications CNC Machining | RF · Heat Sinks · Connectors | Eternal CNC"
  description="Precision CNC machining for electronics — RF housings, heat sinks, connector bodies, EMI shields. Miniaturized structures with tight tolerances."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Industries</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Electronics & Communications
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Miniaturized structures · Heat sinks · Connector housings.
        High-precision CNC parts for consumer electronics, telecom, and industrial electronics.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded-md transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Capabilities</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Electronics Component Categories</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        From RF shielding to thermal management — precision parts for every electronic system.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Common Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Electronics Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        High-volume electronics production demands consistency and surface finish quality.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  

<!-- 产品展示 -->
<section style="background-color: var(--card-white); padding: 80px 0;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Showcase</p>
    <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Electronics & Telecom Components Showcase</h2>
    <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Precision electronic components — heat sinks, shielded enclosures, RF connectors. Product renderings for process demonstration only. Visual representation of machining capabilities. Images are for reference only due to NDA.</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-aluminum-heat-sink-01.webp" alt="CNC machined aluminum heat sink" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">CNC machined aluminum heat sink</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-rf-shielded-enclosure-02.webp" alt="Telecom equipment RF shielded enclosure" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Telecom equipment RF shielded enclosure</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-rf-connector-03.webp" alt="Precision RF connector" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Precision RF connector</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/electronics/cnc-electronics-pcb-mount-bracket-04.webp" alt="PCB mounting bracket fixture" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">PCB mounting bracket fixture</p></div>
        </div>
    </div>
  </div>
</section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need electronic components machined?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and receive a quote within 24 hours with DFM feedback.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border rounded-lg border border-white/30 text-white transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
