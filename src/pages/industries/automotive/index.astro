---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Industries', href: '/industries' },
  { label: 'Automotive' },
];

const capabilities = [
  {
    title: 'Engine & Transmission',
    items: ['Cylinder head prototypes', 'Gear shafts & splines', 'Housing brackets', 'Valve bodies'],
    tolerance: '±0.01mm',
    materials: 'Aluminum 6061/7075, Steel 4140, Cast Iron',
  },
  {
    title: 'Chassis & Suspension',
    items: ['Control arm brackets', 'Steering column parts', 'Shock absorber pistons', 'Mounting plates'],
    tolerance: '±0.01mm',
    materials: 'Steel 1045, 4340, Aluminum 6061-T6',
  },
  {
    title: 'Electronics & Sensors',
    items: ['Sensor housings', 'Connector bodies', 'ECU test fixtures', 'Wiring harness jigs'],
    tolerance: '±0.005mm',
    materials: 'Aluminum, Brass C360, POM (Acetal)',
  },
  {
    title: 'Interior & Body',
    items: ['Dashboard brackets', 'Trim mounting points', 'Lamp housing prototypes', 'Grille parts'],
    tolerance: '±0.025mm',
    materials: 'Aluminum 6061, ABS-like Acetal, Polycarbonate',
  },
];

const standards = [
  { label: 'Dimensional Inspection', desc: "First-article and sampling can be CMM-verified at our group's shared metrology center on request, compliant with AQL 2.5 standards." },
  { label: 'Surface Treatment Control', desc: 'Roughness measured by profilometer. Passivation, anodizing, and powder coating available as post-processing.' },
  { label: 'Material Traceability', desc: 'EN 10204 3.1 material certificates available on request; full traceability from raw stock to finished part.' },
  { label: 'PPAP Documentation', desc: 'Production Part Approval Process (PPAP) full documentation available for mass production orders.' },
];
---

<PageLayout
  title="Automotive Precision CNC Machining | Engine · Chassis · Sensor Housings | Eternal CNC"
  description="Precision CNC machining for automotive OEMs and Tier-1 suppliers — engine parts, chassis brackets, sensor housings, assembly fixtures. Prototype to mass production."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Industries</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Automotive Manufacturing
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Engine parts · Chassis · Drivetrain precision machining.
        From prototype validation to mass production for OEMs and Tier-1 suppliers.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded-md transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Capabilities</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">By Vehicle System</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        We machine parts for four major vehicle systems. Critical dimensions can be CMM-verified via our group's shared metrology center on request.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Common Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Showcase -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Showcase</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Automotive Parts Gallery</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Product renderings for process demonstration only. Visual representation of machining capabilities. Images are for reference only due to NDA.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-complex-aluminum-housing-01.webp" alt="Complex CNC machined aluminum housings for automotive" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Complex Aluminum Housings</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-aluminum-housing-multi-angle-02.webp" alt="Aluminum alloy housings CNC machined multiple angles" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Housings Side View</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-precision-parts-batch-03.webp" alt="Precision aluminum automotive parts batch" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Automotive Parts Batch</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/automotive/cnc-automotive-cast-part-cnc-machining-04.webp" alt="Complex casting parts CNC machined for automotive" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Casting Parts</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Automotive Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every order follows automotive-grade quality control procedures.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need automotive parts machined?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and our engineers will provide a quote and DFM feedback within 2 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border rounded-lg border border-white/30 text-white transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
