---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Careers – Eternal CNC" description="Join our team of precision machinists. 20+ years of expertise, cutting-edge CNC technology, and a culture built on craft.">

  <!-- Hero -->
  <section class="relative min-h-[300px] flex items-center overflow-hidden">
    <img src="/images/company/cnc-machinist-operating-control-panel-05.webp" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(26,26,26,0.85), rgba(100,0,0,0.6));"></div>
    <div class="relative z-10 container-custom py-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Join Our Team</h1>
      <p class="text-lg text-white/80 max-w-2xl">Be part of a team where precision is a way of life.</p>
    </div>
  </section>

  <!-- Why Work With Us -->
  <section class="section-padding" style="background-color: var(--card-white);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">Why Work With Us</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
        <div class="card p-7 text-center">
          <div class="w-14 h-14 rounded-full mx-auto mb-5 flex items-center justify-center" style="background-color: var(--brand-dark);">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">Mastery</h3>
          <p class="text-sm" style="color: var(--text-body);">Work alongside master machinists with 20+ years of hands-on experience.</p>
        </div>
        <div class="card p-7 text-center">
          <div class="w-14 h-14 rounded-full mx-auto mb-5 flex items-center justify-center" style="background-color: var(--brand-dark);">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">Fair Compensation</h3>
          <p class="text-sm" style="color: var(--text-body);">Competitive salary with performance bonuses and skill-based pay increases.</p>
        </div>
        <div class="card p-7 text-center">
          <div class="w-14 h-14 rounded-full mx-auto mb-5 flex items-center justify-center" style="background-color: var(--brand-dark);">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">Growth</h3>
          <p class="text-sm" style="color: var(--text-body);">Continuous training on latest CNC technology and precision techniques.</p>
        </div>
        <div class="card p-7 text-center">
          <div class="w-14 h-14 rounded-full mx-auto mb-5 flex items-center justify-center" style="background-color: var(--brand-dark);">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">High-Tech</h3>
          <p class="text-sm" style="color: var(--text-body);">Work with 30 advanced CNC machines including 5-axis and wire EDM.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Positions -->
  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div class="text-center mb-14">
        <span class="red-line mx-auto"></span>
        <h2 class="text-3xl font-bold" style="color: var(--brand-dark);">Open Positions</h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        <div class="card p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold" style="color: var(--brand-dark);">CNC Machining Operator</h3>
            <p class="text-sm mt-1" style="color: var(--text-muted);">Shenzhen · Full-time · 3+ years experience</p>
          </div>
          <a href="/contact/get-a-quote" class="btn-outline text-xs px-5 py-2 shrink-0">Apply Now</a>
        </div>

        <div class="card p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold" style="color: var(--brand-dark);">Quality Inspector (CMM)</h3>
            <p class="text-sm mt-1" style="color: var(--text-muted);">Shenzhen · Full-time · 2+ years experience</p>
          </div>
          <a href="/contact/get-a-quote" class="btn-outline text-xs px-5 py-2 shrink-0">Apply Now</a>
        </div>

        <div class="card p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold" style="color: var(--brand-dark);">Process Engineer</h3>
            <p class="text-sm mt-1" style="color: var(--text-muted);">Shenzhen · Full-time · 5+ years experience</p>
          </div>
          <a href="/contact/get-a-quote" class="btn-outline text-xs px-5 py-2 shrink-0">Apply Now</a>
        </div>
      </div>

      <div class="text-center mt-10">
        <p class="text-lg mb-4" style="color: var(--text-body);">Don't see a matching role? Send us your resume anyway.</p>
        <a href="mailto:sales@eternalcnc.com" class="btn-primary text-sm inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          sales@eternalcnc.com
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
