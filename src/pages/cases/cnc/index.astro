---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Cases', href: '/cases' },
  { label: 'CNC Machining' },
];

const capabilities = [
  {
    title: '5-Axis Impeller',
    items: ['Continuous 5-axis toolpath', 'Blade profile accuracy ±0.01mm', 'Balanced surface finish Ra 0.8', 'Titanium Ti-6Al-4V material'],
    tolerance: '±0.01mm',
    materials: 'Titanium Ti-6Al-4V',
  },
  {
    title: 'Complex Cavity',
    items: ['Deep pocket milling 150mm depth', 'Undercut features via 5-axis', 'Corner radius R0.5 fine finish', 'Inconel 718 heat-resistant alloy'],
    tolerance: '±0.005mm',
    materials: 'Inconel 718',
  },
  {
    title: 'Precision Drilled Plate',
    items: ['324 holes ±0.01mm position', 'Through-hole Ra 0.4 finish', 'Deburred edges all holes', 'Stainless 316L plate 20mm'],
    tolerance: '±0.01mm',
    materials: 'Stainless 316L',
  },
  {
    title: 'Mold Insert',
    items: ['Mirror finish Ra 0.2', 'Core & cavity matching', 'EDM-ready surface prep', 'Hardened tool steel P20'],
    tolerance: '±0.005mm',
    materials: 'Tool Steel P20',
  },
];

const standards = [
  { label: "CMM verification (via our group's shared metrology center, on request)", desc: "Coordinate measuring machine inspection (at our group's shared metrology center) for complex geometries on request. Full dimensional reports available on request." },
  { label: 'Surface Finish Ra', desc: 'Profilometer-verified surface finish from Ra 0.2 to Ra 3.2 per drawing requirement.' },
  { label: 'Tolerance Compliance', desc: 'All dimensions verified against ISO 2768-m standards. GD&T callouts confirmed.' },
  { label: 'Final QC', desc: '100% visual inspection, functional gauging, and packaging verification before shipment.' },
];
---

<PageLayout
  title="CNC Machining Cases | Milling · Drilling · Tapping | Eternal CNC"
  description="Real CNC machining case studies — 5-axis impellers, complex cavities, precision drilled plates, mold inserts. Complex geometries made precise."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Cases</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC Machining Cases
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Milling · Drilling · Tapping complex geometries precision machining cases.
        Showcasing our most demanding CNC milling projects across materials and industries.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Case Studies</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured CNC Machining Cases</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Selected projects showcasing complex geometry machining capabilities.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Tolerance Achieved</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Material</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Product Renders -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Gallery</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured Product Renders</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Representative product renders — material, process, and surface detail.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/cnc/cnc-general-flange-stainless-render-01.webp" alt="Stainless steel precision flange" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Precision Flange</p>
            <p class="text-xs" style="color: var(--text-muted);">316L stainless · CNC turning · Ra 1.6</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/cnc/cnc-general-bracket-aluminum-render-01.webp" alt="Aluminum custom mounting bracket" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Custom Mounting Bracket</p>
            <p class="text-xs" style="color: var(--text-muted);">Aluminum 6061 · multi-face milling · bead-blast anodize</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/cnc/cnc-general-valve-body-brass-render-01.webp" alt="Brass valve body" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Brass Valve Body</p>
            <p class="text-xs" style="color: var(--text-muted);">Brass C360 · turn-mill · leak-tested</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">CNC Machining Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Complex geometries require rigorous inspection at every stage.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a similar project?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and our engineers will provide a quote and DFM feedback within 2 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
