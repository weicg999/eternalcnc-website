---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Cases', href: '/cases' },
  { label: '5-Axis Machining' },
];

const capabilities = [
  {
    title: 'Impeller Blade',
    items: ['5-axis continuous machining', 'Blade profile accuracy ±0.005mm', 'Balanced surface Ra 0.4', 'Stainless 17-4 PH material'],
    tolerance: '±0.005mm',
    materials: 'Stainless 17-4 PH',
  },
  {
    title: 'Turbine Housing',
    items: ['Complex internal contouring', 'Multi-angle bore intersections', 'Sealing face flatness 0.01mm', 'Inconel 625 high-temp alloy'],
    tolerance: '±0.01mm',
    materials: 'Inconel 625',
  },
  {
    title: 'Curved Bracket',
    items: ['3D contoured surface finishing', 'Mounting hole true position ±0.02mm', 'Lightweight pocketed design', 'Titanium Ti-6Al-4V material'],
    tolerance: '±0.025mm',
    materials: 'Titanium Ti-6Al-4V',
  },
  {
    title: 'Satellite Fitting',
    items: ['Single-setup 5-face machining', 'Minimizes cumulative error across features', 'Full GD&T compliance', 'Traceable material cert included'],
    tolerance: '±0.005mm',
    materials: 'Aluminum 7075-T6',
  },
];

const standards = [
  { label: "CMM verification (via our group's shared metrology center)", desc: "5-axis parts CMM-verified via for all key geometric tolerances at our group's shared metrology center. Full 3D scan reports available." },
  { label: 'Surface Finish Ra', desc: 'Profilometer-verified from Ra 0.2 to Ra 3.2 per requirement. Polishing available for critical surfaces.' },
  { label: 'Tolerance Compliance', desc: 'ISO 2768-m (fine) and ASME Y14.5 GD&T applied; key dimensions verified and reported on request.' },
  { label: 'Final QC', desc: 'For qualified high-reliability parts, 100% inspection of critical dimensions with dimensional, visual, and material cert verification before shipment (on request).' },
];
---

<PageLayout
  title="5-Axis Machining Cases | Impellers · Turbines · Complex Parts | Eternal CNC"
  description="Real 5-axis CNC machining case studies — impeller blades, turbine housings, curved brackets, satellite fittings. Single-setup 5-face machining minimizes cumulative error."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Cases</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        5-Axis Machining Cases
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Single-setup 5-face machining minimizes cumulative error across features.
        Our most complex 5-axis projects across satellite, energy, and industrial sectors.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Case Studies</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured 5-Axis Cases</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Selected projects showcasing our 5-axis machining precision.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Tolerance Achieved</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Material</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Product Renders -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Gallery</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured Product Renders</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Representative product renders — material, process, and surface detail.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/5-axis/cnc-5axis-impeller-titanium-render-01.webp" alt="Titanium 5-axis impeller" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">5-Axis Titanium Impeller</p>
            <p class="text-xs" style="color: var(--text-muted);">Titanium · simultaneous 5-axis · blade profile 0.05mm</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/5-axis/cnc-5axis-turbo-housing-aluminum-render-01.webp" alt="Aluminum 5-axis turbo volute" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Turbo Volute Housing</p>
            <p class="text-xs" style="color: var(--text-muted);">Aluminum · 5-axis contour milling · R0.5 corner</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/5-axis/cnc-5axis-aerospace-bracket-aluminum-render-01.webp" alt="Aluminum 5-axis satellite bracket" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">5-Axis Satellite Bracket</p>
            <p class="text-xs" style="color: var(--text-muted);">Aluminum 7075 · multi-sided 5-axis · ±0.02mm</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">5-Axis Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        5-axis parts demand the most rigorous inspection methods.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a similar project?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and our engineers will provide a quote and DFM feedback within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
