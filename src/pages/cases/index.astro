---
import PageLayout from '../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Case Studies' },
];

const cases = [
  {
    title: 'CNC Machining Cases',
    items: ['Milling operations', 'Drilling & tapping', 'Complex surfaces', 'One-shot forming'],
    tolerance: '±0.005mm',
    materials: 'Aluminum, Stainless Steel, Engineering Plastics',
  },
  {
    title: 'CNC Turning Cases',
    items: ['Shaft parts', 'Sleeve parts', 'Disc parts', 'High concentricity guaranteed'],
    tolerance: '±0.01mm',
    materials: 'Steel, Aluminum, Brass',
  },
  {
    title: '5-Axis Machining Cases',
    items: ['5-side machining in one setup', 'Complex geometries', 'Zero accumulated error', 'Freeform surfaces'],
    tolerance: '±0.005mm',
    materials: 'Aluminum, Titanium, Stainless Steel',
  },
  {
    title: 'Automotive Parts Cases',
    items: ['Engine components', 'Chassis brackets', 'Drivetrain parts', 'Electronic systems'],
    tolerance: '±0.01mm',
    materials: 'Aluminum, Steel 4140, Cast Iron',
  },
  {
    title: 'Medical Device Cases',
    items: ['Equipment enclosures', 'Precision brackets', 'Diagnostic components', 'Strict QC protocols'],
    tolerance: '±0.01mm',
    materials: 'Stainless Steel 316L, Titanium Alloy',
  },
  {
    title: 'Electronic Parts Cases',
    items: ['Miniaturized structures', 'High-precision housings', 'Heat dissipation components', 'Connectors'],
    tolerance: '±0.005mm',
    materials: 'Aluminum, Brass, POM',
  },
  {
    title: 'Robotics Parts Cases',
    items: ['Joint components', 'Reducer housings', 'Motion control parts', 'Precision assembly'],
    tolerance: '±0.005mm',
    materials: 'Aluminum, Steel, Engineering Plastics',
  },
  {
    title: 'Low-Volume Prototyping',
    items: ['1-50 pcs rapid response', '3-7 day first article', 'Full-process tracking', 'Rapid iteration'],
    tolerance: 'Per drawing',
    materials: 'All Materials',
  },
  {
    title: 'Mass Production',
    items: ['50+ pcs stable production', 'Full in-process quality control', 'Consistent quality', 'On-time delivery'],
    tolerance: 'Per drawing',
    materials: 'All Materials',
  },
];

const highlights = [
  { label: 'Real Project Reviews', desc: 'Every case comes from actual machining projects — covering drawing analysis, process selection, machining workflow, and final results.' },
  { label: 'Full Process Transparency', desc: 'From raw material procurement to final inspection, every step is documented and traceable by clients.' },
  { label: 'Multi-Industry Coverage', desc: 'Cases spanning automotive, medical, electronics, robotics, and more — demonstrating cross-domain machining capability.' },
  { label: 'Continuous Improvement', desc: 'Post-project reviews after every order, continuously optimizing processes for better quality and efficiency.' },
];
---

<PageLayout
  title="Case Studies | Real Machining Project Reviews | Eternal CNC"
  description="CNC machining, turning, 5-axis, automotive, medical, electronics, robotics — real case studies from drawing to finished part."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Case Studies</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Real Projects, Proven Capability
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Real machining project reviews — from drawing to finished part, the full workflow
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/industries/automotive" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Industries →
        </a>
      </div>
    </div>
  </section>

  <!-- Cases Grid -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Projects</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Nine Case Categories</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Organized by process, industry, and production scale — showcasing machining capability across different scenarios.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cases.map((c) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{c.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {c.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Precision Tolerance</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{c.tolerance}</p>
              <p class="text-[11px] mt-1.5 leading-snug" style="color: var(--text-muted);">Requires precision finishing &amp; inspection. Subject to drawing review.</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Materials</p>
              <p class="text-sm" style="color: var(--text-body);">{c.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Photo Gallery -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Renders</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Representative Product Renders</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Showcasing material, process and surface details — 3D renderings used to illustrate typical geometries, tolerances and finishes, not photos of actual shop-floor parts.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-sensor-housing-01.webp" alt="Rendered anodized aluminum sensor housing" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Anodized Sensor Housing Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-stainless-flange-01.webp" alt="Rendered stainless steel CNC flange" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Stainless Steel Flange Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-aluminum-bracket-01.webp" alt="Rendered aluminum custom bracket" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Aluminum Bracket Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-robotic-bracket-01.webp" alt="Rendered robotic arm bracket" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Robotic Bracket Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-rf-enclosure-01.webp" alt="Rendered aluminum RF shielded enclosure" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">RF Enclosure Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-steel-pin-batch-01.webp" alt="Rendered batch of steel locating pins" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Steel Pin Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-brass-connector-01.webp" alt="Rendered brass coaxial connector" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Brass Connector Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-aluminum-housing-01.webp" alt="Rendered aluminum electronic housing" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Aluminum Housing Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-medical-shell-01.webp" alt="Rendered medical instrument aluminum shell" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Medical Instrument Shell Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-prototype-aluminum-01.webp" alt="Rendered prototype aluminum machined part" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Prototype Aluminum Part Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-5axis-bracket-01.webp" alt="Rendered aluminum 5-axis aerospace bracket" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">5-Axis Bracket Render</p></div>
        </div>
        <div class="group overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/index-gallery/cnc-rendered-rotary-joint-01.webp" alt="Rendered aluminum robotic rotary joint" width="400" height="300" loading="lazy" class="w-full h-48 object-cover" />
          <div class="p-3"><p class="text-xs font-medium" style="color: var(--brand-dark);">Rotary Joint Render</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Why It Matters</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">What Makes These Cases Worth Reviewing</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Every case is a complete record of a real project, helping you understand our machining capability before placing an order.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {highlights.map((h) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{h.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">View Cases in Your Industry</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing for an industry-specific quote and case reference.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/services/dfm-analysis" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
