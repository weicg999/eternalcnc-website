---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Cases', href: '/cases' },
  { label: 'CNC Turning' },
];

const capabilities = [
  {
    title: 'Stepped Shaft',
    items: ['Multi-diameter turning ±0.005mm', 'Ground bearing journals Ra 0.4', 'Keyway milling on C-axis', 'Length 320mm, max OD 65mm'],
    tolerance: '±0.005mm',
    materials: 'Steel 4140',
  },
  {
    title: 'Precision Bushing',
    items: ['ID/OD concentricity 0.005mm', 'Boring to H7 tolerance', 'Oil groove turning', 'Brass C360 bar stock'],
    tolerance: '±0.01mm',
    materials: 'Brass C360',
  },
  {
    title: 'Flange',
    items: ['Face finish Ra 0.8', 'Bolt circle drilling ±0.02mm', 'Sealing lip groove turning', 'Aluminum 6061 bar stock'],
    tolerance: '±0.025mm',
    materials: 'Aluminum 6061',
  },
  {
    title: 'Threaded Collar',
    items: ['Precision thread M42x1.5', 'Face runout 0.01mm', 'Knurling pattern uniform', 'Stainless 303 bar stock'],
    tolerance: '±0.01mm',
    materials: 'Stainless 303',
  },
];

const standards = [
  { label: "CMM verification (via our group's shared metrology center)", desc: "Critical turned dimensions can be CMM-verified via our group's shared metrology center on request. Full reports included." },
  { label: 'Surface Finish Ra', desc: 'Ground and polished surfaces verified by profilometer. Ra 0.2–1.6 achievable on cylindrical surfaces.' },
  { label: 'Tolerance Compliance', desc: 'ISO 2768-m tolerance standards applied. GD&T callouts confirmed on first-article inspection (FAI) on request.' },
  { label: 'Final QC', desc: 'Thread gauge inspection, surface finish verification, and visual inspection before shipment.' },
];
---

<PageLayout
  title="CNC Turning Cases | Shafts · Bushings · Flanges | Eternal CNC"
  description="Real CNC turning case studies — stepped shafts, precision bushings, flanges, threaded collars. High concentricity turned parts."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Cases</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        CNC Turning Cases
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Shafts · Bushings · Flanges, high concentricity precision turning cases.
        Proven track record delivering precision turned parts across industries.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Case Studies</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured CNC Turning Cases</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Selected projects demonstrating our CNC turning precision.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Tolerance Achieved</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Material</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">CNC Turning Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Turned parts require concentricity and surface finish precision at every stage.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- Featured Product Renders -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Gallery</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured Product Renders</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Representative product renders — material, process, and surface detail.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/parts/cnc-turning-stepped-shaft-4140-render-01.webp" alt="4140 steel CNC turned stepped shaft" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Stepped Shaft</p>
            <p class="text-xs" style="color: var(--text-muted);">Steel 4140 · turning + grinding · runout 0.005mm</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/parts/cnc-turning-precision-bushing-c360-render-01.webp" alt="C360 brass CNC turned precision bushing" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Precision Bushing</p>
            <p class="text-xs" style="color: var(--text-muted);">Brass C360 · turning + boring · ID H7</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/parts/cnc-turning-flange-6061-render-01.webp" alt="6061 aluminum CNC turned flange" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Flange</p>
            <p class="text-xs" style="color: var(--text-muted);">Aluminum 6061 · turning + drilling · runout 0.01mm</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/parts/cnc-turning-threaded-collar-303-render-01.webp" alt="303 stainless M42 threaded collar" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Threaded Collar</p>
            <p class="text-xs" style="color: var(--text-muted);">Stainless 303 · turned thread · M42</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/parts/cnc-turning-pump-shaft-316l-render-01.webp" alt="316L stainless steel CNC turned pump shaft" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Pump Shaft</p>
            <p class="text-xs" style="color: var(--text-muted);">Stainless 316L · precision turning</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/parts/cnc-turning-parts-collection-render-01.webp" alt="Precision CNC turned parts collection" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Turned Parts Collection</p>
            <p class="text-xs" style="color: var(--text-muted);">Multi-material · multi-process · high consistency</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>



  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a similar project?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and our engineers will provide a quote and DFM feedback within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
