---
import PageLayout from '../../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Cases', href: '/cases' },
  { label: 'Medical Devices' },
];

const capabilities = [
  {
    title: 'Monitor Enclosure',
    items: ['Large-format CNC milling', 'Multi-axis pocketing', 'Ventilation slot arrays', 'Powder-coated finish'],
    tolerance: '±0.025mm',
    materials: 'Aluminum 6061',
  },
  {
    title: 'Surgical Fixture',
    items: ['Biocompatible material PEEK', 'Tight bore tolerance ±0.005mm', 'Mirror surface finish Ra 0.4', 'Cleanroom-packaged delivery'],
    tolerance: '±0.005mm',
    materials: 'PEEK',
  },
  {
    title: 'Diagnostic Probe Part',
    items: ['Miniature 5-axis machining', 'Complex internal channels', 'Stainless 316L electropolished', 'Full dimensional report'],
    tolerance: '±0.01mm',
    materials: 'Stainless 316L',
  },
  {
    title: 'Instrument Shell',
    items: ['Thin-wall housing 1.5mm', 'EMI shielding groove', 'Connector port precision', 'Batch of 100 units'],
    tolerance: '±0.01mm',
    materials: 'Aluminum 6061',
  },
];

const standards = [
  { label: 'Biocompatibility', desc: 'Materials selected per ISO 10993. PEEK, titanium, and 316L stainless available for non-implant medical applications.' },
  { label: 'Cleanroom Assembly', desc: 'Optional cleanroom assembly and packaging for parts requiring controlled contamination levels.' },
  { label: 'Full Traceability', desc: 'Every part tracked from raw material certificate through final inspection. Lot-level traceability standard.' },
  { label: 'Sterilization', desc: 'Parts designed to withstand autoclave, EtO, and gamma sterilization cycles without degradation.' },
];
---

<PageLayout
  title="Medical Device Cases | Enclosures · Brackets · Diagnostic Parts | Eternal CNC"
  description="Real CNC machining case studies for medical devices — monitor enclosures, surgical fixtures, diagnostic probe parts, instrument shells."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Cases</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Medical Device Cases
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Enclosures · Brackets · Diagnostic parts precision machining cases.
        Proven track record delivering medical-grade parts with full traceability.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Case Studies</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured Medical Cases</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Selected projects demonstrating our medical device machining capabilities.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {capabilities.map((cap) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--brand-dark);">{cap.title}</h3>
            <ul class="space-y-2 mb-6" style="color: var(--text-body);">
              {cap.items.map((item) => (
                <li class="text-sm flex items-start">
                  <span class="mr-2" style="color: var(--brand-red);">—</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-4 border-t" style="border-color: var(--border-color);">
              <p class="text-xs mb-1" style="color: var(--text-muted);">Tolerance Achieved</p>
              <p class="text-sm font-semibold" style="color: var(--brand-dark);">{cap.tolerance}</p>
              <p class="text-xs mt-2 mb-1" style="color: var(--text-muted);">Material</p>
              <p class="text-sm" style="color: var(--text-body);">{cap.materials}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Renders -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Product Renders</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Featured Product Renders</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">Representative 3D renders showing materials, finishes, and geometric detail</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-monitor-enclosure-6061-render-01.webp" alt="Aluminum 6061 CNC milled monitor enclosure with ventilation slots" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Monitor Enclosure</p>
            <p class="text-xs" style="color: var(--text-muted);">Aluminum 6061 · CNC milling · ±0.025mm</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-surgical-fixture-peek-render-01.webp" alt="PEEK biocompatible surgical fixture with mirror finish" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Surgical Fixture</p>
            <p class="text-xs" style="color: var(--text-muted);">PEEK · Biocompatible · ±0.005mm · Ra 0.4</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-diagnostic-probe-stainless-316l-render-01.webp" alt="Stainless 316L electropolished diagnostic probe part" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Diagnostic Probe Part</p>
            <p class="text-xs" style="color: var(--text-muted);">Stainless 316L · 5-axis · Electropolished · ±0.01mm</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1" style="border-color: var(--border-color);">
          <img src="/images/cases/medical/cnc-medical-instrument-shell-6061-render-01.webp" alt="Aluminum 6061 thin-wall instrument shell with connector ports" loading="lazy" width="800" height="533" class="w-full aspect-[3/2] object-cover" />
          <figcaption class="p-4">
            <p class="text-sm font-semibold mb-1" style="color: var(--brand-dark);">Instrument Shell</p>
            <p class="text-xs" style="color: var(--text-muted);">Aluminum 6061 · Thin-wall · EMI groove · ±0.01mm</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Quality Control</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">Medical Quality Standards</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Medical applications demand the highest levels of documentation and material integrity.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {standards.map((std) => (
          <div class="p-6 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{std.label}</h3>
            <p class="text-sm" style="color: var(--text-body);">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a similar project?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and our engineers will provide a quote and DFM feedback within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/cases" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          View All Cases →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
