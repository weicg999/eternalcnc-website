---
import PageLayout from '../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Company', href: '/about' },
  { label: 'Confidentiality' },
];

const protections = [
  {
    title: 'Technical Drawings',
    desc: 'All 2D/3D CAD files, PDFs, STEP, IGES, and every other design format are treated as strictly confidential.',
  },
  {
    title: 'Material Specifications',
    desc: 'Alloy grades, tolerance requirements, surface finish parameters, and proprietary compositions are never shared externally.',
  },
  {
    title: 'Volume & Pricing',
    desc: 'Order quantities, unit prices, payment terms, and all commercial details remain strictly confidential.',
  },
  {
    title: 'Custom Tooling',
    desc: 'Bespoke fixture designs, tooling solutions, and proprietary manufacturing processes are fully protected.',
  },
];

const measures = [
  {
    title: 'Encrypted Storage',
    desc: 'All client files are stored on encrypted servers, accessible only to authorized personnel.',
  },
  {
    title: 'Access Control',
    desc: 'Role-based access ensures only your project team can view your files, with full audit trails.',
  },
  {
    title: 'NDA Agreement',
    desc: 'Mutual non-disclosure agreements (NDAs) can be signed upon request before any files are received.',
  },
  {
    title: 'Employee Training',
    desc: 'All staff complete annual confidentiality training. Breaches result in immediate termination.',
  },
];
---

<PageLayout
  title="Data Confidentiality Policy – Eternal CNC Precision"
  description="Learn how Eternal CNC protects your technical drawings, specifications, and intellectual property with strict confidentiality measures, NDA agreements, and encrypted storage."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Confidentiality</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Data Confidentiality Policy
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Your designs are your competitive advantage — protecting them is our obligation.
        We treat every drawing, every dimension, and every specification with the highest standards of strict protection.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded-md transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>

  <!-- What We Protect -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Protection Scope</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">What We Protect</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Everything you share with us is treated as confidential by default — no exceptions.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {protections.map((item) => (
          <div class="p-8 border rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <h3 class="text-lg font-bold mb-3" style="color: var(--brand-dark);">{item.title}</h3>
            <p style="color: var(--text-body);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Protect -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--brand-red);">Security Measures</p>
      <h2 class="text-3xl font-bold mb-4" style="color: var(--brand-dark);">How We Protect</h2>
      <p class="mb-12 max-w-2xl" style="color: var(--text-muted);">
        Our confidentiality protocols are embedded into every aspect of our operations.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {measures.map((item) => (
          <div class="p-6 border rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--page-bg); border-color: var(--border-color);">
            <h3 class="font-semibold mb-2" style="color: var(--brand-dark);">{item.title}</h3>
            <p class="text-sm" style="color: var(--text-body);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Need a Reliable Confidential Manufacturing Partner?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawings after signing an NDA. Our engineers will provide a quote and DFM feedback within 2 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold rounded-lg bg-[#8B0000] text-white transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Get a Free Quote
        </a>
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold border rounded-lg border-white/30 text-white transition-all duration-300 hover:bg-white/10 hover:shadow-md hover:-translate-y-0.5">
          Free DFM Review →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
