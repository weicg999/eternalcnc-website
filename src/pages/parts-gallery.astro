---
import PageLayout from '../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Resources', href: '/knowledge' },
  { label: 'Parts Gallery' },
];

const items = [
  {
    src: '/images/parts-gallery/aluminum-parts-collection.jpg',
    title: 'Aluminum CNC Parts Collection',
    caption: 'Flanges, valve bodies, pump housings and brackets — a cross-section of parts we machine from aluminum alloy.',
  },
  {
    src: '/images/parts-gallery/multi-port-air-manifold.jpg',
    title: 'Multi-Port Air Manifold',
    caption: 'CNC-milled aluminum multi-port distributor for fluid / air routing.',
  },
  {
    src: '/images/parts-gallery/black-anodized-bracket.jpg',
    title: 'Black Anodized Bracket',
    caption: 'Aluminum side-mount bracket with black anodized surface finish.',
  },
  {
    src: '/images/parts-gallery/die-cast-heatsink-flange.jpg',
    title: 'Die-Cast Heatsink Flange',
    caption: 'Die-cast aluminum heatsink housing with CNC finishing.',
  },
  {
    src: '/images/parts-gallery/wheel-hub-bearing-seats.jpg',
    title: 'Wheel Hub Bearing Seats',
    caption: 'Aluminum wheel hub / bearing seat brackets for electric drive systems.',
  },
  {
    src: '/images/parts-gallery/aluminum-impeller.jpg',
    title: 'Aluminum Impeller',
    caption: 'CNC-milled aluminum impeller for cooling / pump applications.',
  },
  {
    src: '/images/parts-gallery/l-shaped-mounting-bracket.jpg',
    title: 'L-Shaped Mounting Bracket',
    caption: 'Special L-shaped aluminum bracket for automation equipment.',
  },
  {
    src: '/images/parts-gallery/vacuum-tee-fitting.jpg',
    title: 'Vacuum Tee Fitting',
    caption: 'Precision-machined aluminum vacuum tee connector.',
  },
];
---

<PageLayout
  title="Parts Gallery | Real Aluminum CNC Parts We've Made | Eternal CNC"
  description="A selection of non-NDA aluminum CNC machined parts we've produced — flanges, manifolds, brackets, impellers, motor housings and more."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section style="background-color: var(--card-white); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--brand-red);">Real Parts</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--brand-dark);">
        Parts Gallery
      </h1>
      <p class="text-lg max-w-3xl leading-relaxed" style="color: var(--text-body);">
        Most of our work is covered by NDAs, so we can't show customer names, logos or specific tolerances. 
        The parts below are from projects without confidentiality restrictions — they give you a real sense of what we make.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact/get-a-quote" class="inline-block px-6 py-3 text-sm font-medium bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/knowledge/faq" class="inline-block px-6 py-3 text-sm font-medium border border-[#8B0000] text-[#8B0000] rounded-md transition-all duration-300 hover:bg-[#8B0000] hover:text-white hover:shadow-md hover:-translate-y-0.5">
          Read FAQ →
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section style="background-color: var(--page-bg); padding: 80px 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item) => (
          <div class="group border rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30" style="background-color: var(--card-white); border-color: var(--border-color);">
            <a href={item.src} target="_blank" rel="noopener noreferrer" class="block aspect-[4/3] overflow-hidden bg-gray-100">
              <img src={item.src} alt={item.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            </a>
            <div class="p-6">
              <h3 class="text-lg font-bold mb-2" style="color: var(--brand-dark);">{item.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--text-body);">{item.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background-color: var(--brand-dark); padding: 80px 0;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-5">Have a part in mind?</h2>
      <p class="text-lg mb-8" style="color: rgba(255,255,255,0.7);">
        Upload your drawing and we'll send a quote within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact/get-a-quote" class="inline-block px-8 py-3.5 text-sm font-semibold bg-[#8B0000] text-white rounded transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services/cnc-machining" class="inline-block px-8 py-3.5 text-sm font-semibold border border-white/30 text-white rounded-md transition-all duration-300 hover:bg-white hover:text-[#8B0000] hover:shadow-md hover:-translate-y-0.5">
          View Services →
        </a>
      </div>
    </div>
  </section>
</PageLayout>
