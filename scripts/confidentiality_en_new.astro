---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Data Confidentiality Policy – Eternal CNC Precision"
  description="Learn how Eternal CNC protects your technical drawings, specifications, and intellectual property with strict confidentiality measures."
>
  <!-- Breadcrumb -->
  <section class="bg-gray-50 py-4 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-gray-500">
        <a href="/" class="transition-all duration-300 hover:text-[#8B0000]">Home</a>
        <span class="mx-2">/</span>
        <span class="text-gray-700">Confidentiality Policy</span>
      </nav>
    </div>
  </section>

  <!-- Hero Header -->
  <section class="py-16 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Data <span class="text-[#8B0000]">Confidentiality</span> Policy
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl">
        Your designs are your competitive advantage. Protecting them is our obligation.
      </p>
    </div>
  </section>

  <!-- What We Protect (2x2 Cards) -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-2">What We Protect</h2>
      <p class="text-gray-600 mb-10">Everything you share with Eternal CNC is covered by strict confidentiality obligations.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">📐</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Technical Drawings</h3>
          <p class="text-gray-600">CAD files, STEP, IGES, DWG, and all proprietary design documents.</p>
        </div>
        <div class="bg-white rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">📋</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Material Specifications</h3>
          <p class="text-gray-600">Alloy grades, heat treatment requirements, and surface finish standards.</p>
        </div>
        <div class="bg-white rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">📊</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Volume & Pricing</h3>
          <p class="text-gray-600">Quotation details, batch quantities, and commercial terms.</p>
        </div>
        <div class="bg-white rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">🔧</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Custom Tooling</h3>
          <p class="text-gray-600">Fixtures, jigs, and specialized tooling designs created for your project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Protect (2x2 Cards) -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-2">How We Protect</h2>
      <p class="text-gray-600 mb-10">Enterprise-grade security measures to safeguard your intellectual property.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">🔒</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Encrypted Storage</h3>
          <p class="text-gray-600">All project files are stored in AES-256 encrypted cloud storage with access logging.</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">📝</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Employee NDAs</h3>
          <p class="text-gray-600">Every employee signs a comprehensive non-disclosure agreement before access is granted.</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">🗑️</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Data Retention & Deletion</h3>
          <p class="text-gray-600">Files are permanently deleted upon request or after project completion per your instructions.</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#8B0000]/30">
          <div class="w-12 h-12 rounded-full bg-[#8B0000] text-white flex items-center justify-center text-xl mb-4">📄</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">NDA Support</h3>
          <p class="text-gray-600">We can sign your standard NDA or provide our template. Contact us to initiate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark CTA -->
  <section class="py-16 bg-gray-900 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Have Questions About Data Security?</h2>
      <p class="text-lg text-gray-300 mb-8">We're transparent about our confidentiality practices. Reach out and our engineering team will respond within 24 hours.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 bg-[#8B0000] text-white px-6 py-3 rounded-md font-medium transition-all duration-300 hover:bg-[#6B0000] hover:shadow-lg hover:-translate-y-0.5">
          Contact Us →
        </a>
        <a href="mailto:sales@eternalcnc.com" class="inline-flex items-center gap-2 border-2 border-white text-white px-6 py-3 rounded-md font-medium transition-all duration-300 hover:bg-white hover:text-gray-900 hover:shadow-md hover:-translate-y-0.5">
          sales@eternalcnc.com
        </a>
      </div>
    </div>
  </section>
</BaseLayout>