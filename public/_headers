# ⚠️ Cloudflare Pages 的 _headers 按「请求路径」匹配，不是文件路径：
#    旧写法 /*.html 只在请求 /xxx.html 时命中，而站内全是目录式 URL（/about/），
#    所以 HTML 一直走 Pages 默认的 max-age=0 → cf-cache-status: DYNAMIC。
# ⚠️ 多条规则同时匹配时是「全部继承 + 同名头逗号拼接」，不是覆盖。
#    所以下面每条都要先 "! Cache-Control" 移除兜底值，再设自己的。
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://lf-cdn.coze.cn; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.coze.cn https://static.cloudflareinsights.com https://www.google-analytics.com https://lf-cdn.coze.cn; frame-src 'self' https://lf-cdn.coze.cn; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=60

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/videos/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, immutable
